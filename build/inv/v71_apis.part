
/* ================= v7: repository API catalogue, reconciled with the government API catalogue; open data pipelines ================= */
const AP = DATA.apis, APIR = Object.entries(AP.apis).map(([key, a]) => ({key, x: XBY[key], ...a})).filter(r => r.x);
const APIBY = Object.fromEntries(APIR.map(r => [r.key, r]));
const API_KINDS = ["Published API definition", "API specification in the code", "API framework in the code", "Named as an API", "API client or SDK"];
const API_KC = {"Published API definition": "green", "API specification in the code": "blue", "API framework in the code": "violet", "Named as an API": "slate", "API client or SDK": "orange"};
const GCAT = AP.catalogue.map((c, i) => ({...c, i, status: !c.match ? "none" : c.match[2].startsWith("linked") ? "linked" : c.match[1] >= .5 ? "matched" : "possible"}));
const GSTAT = {linked: "Linked to its repository", matched: "Matched by organisation and name", possible: "Possible match: check", none: "No public repository found"};
const GSTAT_C = {linked: "green", matched: "blue", possible: "yellow", none: "slate"};
const inGcat = new Set(GCAT.filter(c => c.match && c.status !== "possible").map(c => c.match[0]));
const AS0 = {kind: "", sector: "", q: "", live: "", gap: "", sort: "active", group: "", page: 0, size: 25}, AS = {...AS0};
const GS0 = {status: "", q: ""}, GS = {...GS0};
RENDER.apis = () => {
  const pub = APIR.filter(r => r.kind === "Published API definition" || r.kind === "API specification in the code"), gap = pub.filter(r => !inGcat.has(r.key) && live(r.x));
  const gc = Object.fromEntries(Object.keys(GSTAT).map(s => [s, GCAT.filter(c => c.status === s).length]));
  const kinds = API_KINDS.map(k => [k, APIR.filter(r => r.kind === k).length]);
  const byOrg = Object.entries(APIR.reduce((a, r) => { const n = orgName(r.x.org); a[n] = (a[n] || 0) + 1; return a; }, {})).sort((a, b) => b[1] - a[1]).slice(0, 15);
  vb("apis").innerHTML = `
  <div class="panel" data-new="1"><h2>APIs in public sector code</h2><p class="lede" style="margin-top:6px">${nf(APIR.length)} repositories provide, describe or call an API. ${nf(pub.length)} carry an API specification such as an OpenAPI or RAML file, ${nf(APIR.filter(r => r.kind === "Published API definition").length)} of them in the published format HMRC's Developer Hub uses. They are reconciled below with the ${nf(GCAT.length)} entries in the government API catalogue.</p>
    <div class="bigstats" style="margin-top:12px">${bigStat(nf(APIR.length), "repositories with an API", "blue")}${bigStat(nf(pub.length), "with an API specification in the code", "green")}${bigStat(nf(GCAT.length), "entries in the government API catalogue", "violet")}${bigStat(nf(gc.linked + gc.matched), "catalogue entries matched to a repository", "aqua")}${bigStat(nf(gap.length), "live repositories with a specification but no catalogue entry", "orange")}</div></div>
  ${chartPanel("Reconciliation with the government API catalogue", barList(Object.keys(GSTAT).map(s => ({label: GSTAT[s], v: gc[s], c: GSTAT_C[s], act: `data-gst="${s}"`}))) + `<div class="filters" style="margin-top:12px"><label class="grow" for="g-q">Search the catalogue<input type="search" id="g-q" placeholder="API name, provider or description"></label><label for="g-st">Match<select id="g-st"><option value="">Any</option>${Object.entries(GSTAT).map(([k, v]) => `<option value="${k}">${esc(v)}</option>`).join("")}</select></label><button class="btn sm" type="button" id="g-csv">Download reconciliation (CSV)</button><span class="status-line" id="g-stl" role="status"></span></div><p class="count" id="g-count" role="status" aria-live="polite"></p><div id="g-list"></div>`,
    {isNew: true, count: GCAT.length, lede: `Each API catalogue entry, and the repository found for it. Source: ${AP.catalogue_source.repo}, ${AP.catalogue_source.files.join(" and ")}, commit of ${fmtD(AP.catalogue_source.date)}; duplicates across the two files removed.`, note: "Matches are found three ways: a GitHub link in the entry; the same organisation and a similar name (half or more of the significant words shared); or a possible match with a quarter shared, which needs checking. Many catalogue APIs are built in private repositories, so 'no public repository found' is not a fault."})}
  ${chartPanel("In the code but not in the catalogue", `<div id="gap-list"></div>`, {isNew: true, count: gap.length, lede: "Live repositories with an API specification or published definition that no catalogue entry points to. These are candidates to add to the API catalogue, or are internal APIs that don't belong there; owners decide."})}
  <div class="grid2">${chartPanel("Repositories by kind of API evidence", barList(kinds.map(([k, n]) => ({label: k, v: n, c: API_KC[k], act: `data-akind="${esc(k)}"`}))), {lede: "Strongest evidence for each repository. Select one to list them."})}
  ${chartPanel("Organisations with most API repositories", barList(byOrg.map(([o, n]) => ({label: o, v: n, c: "aqua"}))), {})}</div>
  <div class="panel"><h2 id="a-h" tabindex="-1">Repository API catalogue</h2><div class="filters"><label class="grow" for="a-q">Search<input type="search" id="a-q" placeholder="name, description or organisation"></label>
    <label for="a-kind">Kind<select id="a-kind"><option value="">Any</option>${API_KINDS.map(k => `<option>${esc(k)}</option>`).join("")}</select></label>
    <label for="a-sector">Sector<select id="a-sector"><option value="">Any</option>${SECTORS.map(s => `<option>${esc(s)}</option>`).join("")}</select></label>
    <label for="a-gap">Catalogue<select id="a-gap"><option value="">Any</option><option value="in">In the government API catalogue</option><option value="out">Not in it</option></select></label>
    <label for="a-sort">Sort by<select id="a-sort"><option value="active">Most active</option><option value="name">Name A to Z</option><option value="specs">Most specification files</option></select></label>
    <label for="a-group">Group by<select id="a-group"><option value="">No grouping</option><option value="org">Organisation</option><option value="kind">Kind</option></select></label>
    <label for="a-live" style="flex-direction:row;display:flex;gap:6px;align-items:center"><input type="checkbox" id="a-live"> Live only</label><button class="btn sm" type="button" id="a-csv">Download CSV</button><span class="status-line" id="a-stl" role="status"></span></div>
    <p class="count" id="a-count" role="status" aria-live="polite"></p><div id="a-list"></div></div>
  <div class="panel"><h2>How APIs were found</h2><ul class="small" style="max-width:85ch"><li><b>Published API definition</b>: a file at public/api/conf/&lt;version&gt;/application.raml or .yaml, the layout HMRC's Developer Hub publishes from.</li><li><b>API specification in the code</b>: an OpenAPI, Swagger, RAML, AsyncAPI or GraphQL schema file.</li><li><b>API framework in the code</b>: a dependency such as FastAPI, Django REST framework, springdoc-openapi or Apollo Server.</li><li><b>Named as an API</b>: the repository's name ends in "api" or its description says it's an API. Common for microservices behind a service; weaker evidence. In a random sample ${AP.prec.api_named[0].true} of ${AP.prec.api_named[0].n} were APIs.</li><li><b>API client or SDK</b>: named as a client for someone else's API.</li><li>File trees were read for ${nf(X.length)} git-checked repositories and dependency files for ${nf(DM.deps_fetched)}; catalogue-only records can be found by name only.</li></ul></div>`;
  $$("[data-gst]", vb("apis")).forEach(b => b.onclick = () => { GS.status = b.dataset.gst; $("#g-st").value = GS.status; gList(); $("#g-count").focus?.(); });
  $$("[data-akind]", vb("apis")).forEach(b => b.onclick = () => { AS.kind = b.dataset.akind; $("#a-kind").value = AS.kind; AS.page = 0; aList(); $("#a-h").focus(); });
  $("#g-q").oninput = e => { GS.q = e.target.value; gList(); }; $("#g-st").onchange = e => { GS.status = e.target.value; gList(); };
  $("#g-csv").onclick = () => save("api-catalogue-reconciliation-" + DATA.meta.ref_date + ".csv", "﻿" + [["api_name", "provider", "api_url", "documentation", "match", "repository", "similarity"].join(","), ...GCAT.map(c => [c.name, c.provider, c.url, c.documentation, GSTAT[c.status], c.match ? c.match[0] : "", c.match ? c.match[1] : ""].map(csvCell).join(","))].join("\r\n"), $("#g-stl"));
  [["#a-q", "q", "input"], ["#a-kind", "kind"], ["#a-sector", "sector"], ["#a-gap", "gap"], ["#a-sort", "sort"], ["#a-group", "group"]].forEach(([s, k, ev]) => { $(s).value = AS[k]; $(s).addEventListener(ev || "change", e => { AS[k] = e.target.value; AS.page = 0; aList(); }); });
  $("#a-live").onchange = e => { AS.live = e.target.checked ? "1" : ""; AS.page = 0; aList(); };
  $("#a-csv").onclick = () => save("repository-apis-" + DATA.meta.ref_date + ".csv", "﻿" + [["repository", "url", "organisation", "sector", "status", "kind", "specification_files", "in_government_api_catalogue"].join(","), ...aFiltered().map(r => [r.key, ghUrl(r.key), r.x.org, r.x.sector, r.x.st, r.kind, (r.specs || []).join("; "), inGcat.has(r.key) ? "yes" : "no"].map(csvCell).join(","))].join("\r\n"), $("#a-stl"));
  const gl = gap.sort((a, b) => (b.x.c90 || 0) - (a.x.c90 || 0)); const go2 = Object.entries(gl.reduce((a, r) => { (a[orgName(r.x.org)] ||= []).push(r); return a; }, {})).sort((a, b) => b[1].length - a[1].length);
  $("#gap-list").innerHTML = go2.map(([o, rs]) => `<details class="grpbox"><summary><b>${esc(o)}</b> <span class="muted">${nf(rs.length)}</span></summary><ul class="plist">${rs.slice(0, 40).map(r => `<li>${xBtn(r.key, r.x.n)} <span class="chip">${esc(r.kind)}</span><br><small class="mono">${esc((r.specs || [])[0] || "")}</small></li>`).join("")}</ul></details>`).join("") || `<p class="muted">None.</p>`;
  bindX($("#gap-list")); gList(); aList();
};
function gList() { const q = GS.q.toLowerCase(), l = GCAT.filter(c => (!GS.status || c.status === GS.status) && (!q || (c.name + " " + c.provider + " " + c.description).toLowerCase().includes(q)));
  $("#g-count").textContent = `${nf(l.length)} of ${nf(GCAT.length)} catalogue entries`;
  $("#g-list").innerHTML = `<div class="tbl-wrap"><table><caption class="sr-only">Government API catalogue entries and their repositories</caption><thead><tr><th scope="col">API</th><th scope="col">Provider</th><th scope="col">Match</th><th scope="col">Repository</th></tr></thead><tbody>${l.slice(0, 300).map(c => `<tr><td><b>${esc(c.name)}</b>${safeUrl(c.documentation) ? `<br>${ext(c.documentation, "Documentation")}` : ""}<br><small class="muted">${esc(String(c.description).replace(/\\n/g, " ").slice(0, 160))}</small></td><td>${esc(c.provider)}</td><td><span class="mstat m-${c.status}">${esc(GSTAT[c.status])}</span>${c.match ? `<br><small class="muted">${esc(c.match[2])}${c.status !== "linked" ? ` · ${Math.round(c.match[1] * 100)}% of words shared` : ""}</small>` : ""}</td><td>${c.match && XBY[c.match[0]] ? xBtn(c.match[0]) : "—"}</td></tr>`).join("")}</tbody></table></div>${l.length > 300 ? `<p class="faint small">First 300 of ${nf(l.length)}.</p>` : ""}`;
  bindX($("#g-list")); }
function aFiltered() { const q = AS.q.toLowerCase(); return APIR.filter(r => (!AS.kind || r.kind === AS.kind) && (!AS.sector || r.x.sector === AS.sector) && (!AS.live || live(r.x)) && (!AS.gap || (AS.gap === "in") === inGcat.has(r.key)) && (!q || r.x.q.includes(q))); }
function aList() { const l = aFiltered().sort({active: (a, b) => (b.x.c90 || 0) - (a.x.c90 || 0) || lastAct(b.x) - lastAct(a.x), name: (a, b) => a.key.localeCompare(b.key), specs: (a, b) => (b.nspec || 0) - (a.nspec || 0)}[AS.sort]);
  $("#a-count").textContent = `${nf(l.length)} of ${nf(APIR.length)} repositories`; $("#a-csv").textContent = `Download CSV (${nf(l.length)})`;
  const head = `<thead><tr><th scope="col">Repository</th><th scope="col">Organisation</th><th scope="col">Status</th><th scope="col">Kind and evidence</th><th scope="col">Government API catalogue</th></tr></thead>`;
  const row = r => `<tr><td class="repo">${xBtn(r.key, r.x.n)}<small>${esc(r.x.desc)}</small></td><td>${esc(orgName(r.x.org))}</td><td>${pill(r.x.st)}</td><td><span class="chip">${esc(r.kind)}</span>${(r.specs || []).slice(0, 2).map(s => `<br><span class="mono small muted">${esc(s)}</span>`).join("")}</td><td>${inGcat.has(r.key) ? `<span class="mstat m-matched">Listed</span>` : `<span class="muted">Not listed</span>`}</td></tr>`;
  if (AS.group) { const gk = AS.group === "org" ? r => orgName(r.x.org) : r => r.kind; const g = Object.entries(l.reduce((a, r) => { (a[gk(r)] ||= []).push(r); return a; }, {})).sort((a, b) => b[1].length - a[1].length);
    $("#a-list").innerHTML = g.slice(0, 40).map(([k, rs]) => `<details class="grpbox"><summary><b>${esc(k)}</b> <span class="muted">${nf(rs.length)}</span></summary><div class="tbl-wrap"><table>${head}<tbody>${rs.slice(0, 50).map(row).join("")}</tbody></table></div></details>`).join(""); }
  else { $("#a-list").innerHTML = `<div class="tbl-wrap"><table id="a-tbl"><caption class="sr-only">Repositories with APIs, page ${AS.page + 1}</caption>${head}<tbody>${l.slice(AS.page * AS.size, AS.page * AS.size + AS.size).map(row).join("")}</tbody></table></div>`; $("#a-list").appendChild(pager(AS, l.length, aList, () => $("#a-tbl"))); }
  bindX($("#a-list")); }

/* ---------- OPEN DATA PIPELINES ---------- */
const ODR = Object.entries(DATA.opendata).map(([key, o]) => ({key, x: XBY[key], ...o})).filter(r => r.x);
const PORT = {dgu: "data.gov.uk", ndl: "National Data Library", portal: "Own data portal"}, PORT_C = {dgu: "blue", ndl: "violet", portal: "orange"};
const OS0 = {portal: "", dir: "", pipe: "", sector: "", q: "", sort: "active", group: "org", page: 0, size: 25}, OS = {...OS0};
const odDir = r => r.dir === "publishes|consumes" ? "Both" : r.dir === "publishes" ? "Publishes" : r.dir === "consumes" ? "Consumes" : "Unclear";
RENDER.opendata = () => {
  const pc = Object.keys(PORT).map(p => [p, ODR.filter(r => r.portals.some(q => q[0] === p)).length]);
  const dirs = ["Publishes", "Consumes", "Both", "Unclear"].map(d => [d, ODR.filter(r => odDir(r) === d).length]);
  vb("opendata").innerHTML = `
  <div class="panel" data-new="1"><h2>Open data pipelines</h2><p class="lede" style="margin-top:6px">${nf(ODR.length)} repositories hold routines, ingestion or pipelines linked to open data: publishing to or harvesting from data.gov.uk, the National Data Library, or an organisation's own data portal, or loading open data from them. ${nf(ODR.filter(r => r.pipe).length)} show pipeline or automation evidence.</p>
    <div class="bigstats" style="margin-top:12px">${bigStat(nf(ODR.length), "repositories linked to open data", "blue")}${pc.map(([p, n]) => bigStat(nf(n), "linked to " + PORT[p], PORT_C[p])).join("")}${bigStat(nf(ODR.filter(r => r.pipe).length), "with pipeline or automation evidence", "green")}</div></div>
  <div class="grid2">${chartPanel("Which portal", barList(pc.map(([p, n]) => ({label: PORT[p], v: n, c: PORT_C[p], act: `data-op="${p}"`}))), {lede: "A repository can be linked to more than one. Select one to list them."})}
  ${chartPanel("Publishing or consuming", barList(dirs.map(([d, n]) => ({label: d, v: n, c: d === "Publishes" ? "green" : d === "Consumes" ? "aqua" : d === "Both" ? "violet" : "slate", act: `data-od="${d}"`}))), {lede: "From words in the description and README such as publish, upload or harvest, against ingest, download or scrape."})}</div>
  ${chartPanel("By sector and portal", heatmap({rows: [...new Set(ODR.map(r => r.x.sector))].filter(Boolean).sort().map(s => ({id: s, label: s})), cols: Object.keys(PORT).map(p => ({id: p, label: PORT[p]})), val: (r, c) => ODR.filter(x => x.x.sector === r.id && x.portals.some(q => q[0] === c.id)).length, label: "Open data repositories by sector and portal", act: (r, c) => `data-osec="${esc(r.id)}" data-op="${c.id}"`}), {wide: true})}
  <div class="panel"><h2 id="o-h" tabindex="-1">Repositories</h2><div class="filters"><label class="grow" for="o-q">Search<input type="search" id="o-q" placeholder="name, description or organisation"></label>
    <label for="o-portal">Portal<select id="o-portal"><option value="">Any</option>${Object.entries(PORT).map(([k, v]) => `<option value="${k}">${esc(v)}</option>`).join("")}</select></label>
    <label for="o-dir">Direction<select id="o-dir"><option value="">Any</option><option>Publishes</option><option>Consumes</option><option>Both</option><option>Unclear</option></select></label>
    <label for="o-sector">Sector<select id="o-sector"><option value="">Any</option>${SECTORS.map(s => `<option>${esc(s)}</option>`).join("")}</select></label>
    <label for="o-group">Group by<select id="o-group"><option value="org">Organisation</option><option value="">No grouping</option><option value="portal">Portal</option></select></label>
    <label for="o-pipe" style="flex-direction:row;display:flex;gap:6px;align-items:center"><input type="checkbox" id="o-pipe"> Pipelines only</label><button class="btn sm" type="button" id="o-csv">Download CSV</button><span class="status-line" id="o-stl" role="status"></span></div>
    <p class="count" id="o-count" role="status" aria-live="polite"></p><div id="o-list"></div></div>
  <div class="panel"><h2>How these were found</h2><ul class="small" style="max-width:85ch"><li><b>data.gov.uk</b>: the address, "Find open data", CKAN's API or the ckanapi package, or a CKAN extension folder.</li><li><b>National Data Library</b>: its name, or "NDL" next to open data words.</li><li><b>Own data portal</b>: a data portal or datastore, data.&lt;place&gt;.gov.uk addresses, Socrata, Opendatasoft, ArcGIS Hub or a statistics.gov site.</li><li>Repositories that only mention open data count when they also show a pipeline: words such as pipeline, ETL, scheduled or scripts, or a GitHub Actions workflow.</li><li>These are matches on names, descriptions, READMEs, dependencies and files, not owner-confirmed. Precision, from random samples: ${AP.prec.opendata.map(r => `round ${r.round}, ${r.true} of ${r.n} correct (${esc(r.note)})`).join("; ")}.</li></ul></div>`;
  [["#o-q", "q", "input"], ["#o-portal", "portal"], ["#o-dir", "dir"], ["#o-sector", "sector"], ["#o-group", "group"]].forEach(([s, k, ev]) => { $(s).value = OS[k]; $(s).addEventListener(ev || "change", e => { OS[k] = e.target.value; OS.page = 0; oList(); }); });
  $("#o-pipe").onchange = e => { OS.pipe = e.target.checked ? "1" : ""; OS.page = 0; oList(); };
  $$("[data-op],[data-od]", vb("opendata")).forEach(b => b.onclick = () => { Object.assign(OS, {portal: b.dataset.op || "", dir: b.dataset.od || "", sector: b.dataset.osec || "", page: 0}); ["portal", "dir", "sector"].forEach(k => $("#o-" + k).value = OS[k]); oList(); $("#o-h").focus(); });
  $("#o-csv").onclick = () => save("open-data-pipelines-" + DATA.meta.ref_date + ".csv", "﻿" + [["repository", "url", "organisation", "sector", "status", "portals", "direction", "pipeline_evidence", "evidence"].join(","), ...oFiltered().map(r => [r.key, ghUrl(r.key), r.x.org, r.x.sector, r.x.st, r.portals.map(p => PORT[p[0]]).join("; ") || "open data only", odDir(r), r.pipe ? "yes" : "no", r.portals.map(p => p[1][0][1]).join(" | ") || r.open].map(csvCell).join(","))].join("\r\n"), $("#o-stl"));
  oList();
};
function oFiltered() { const q = OS.q.toLowerCase(); return ODR.filter(r => (!OS.portal || r.portals.some(p => p[0] === OS.portal)) && (!OS.dir || odDir(r) === OS.dir) && (!OS.pipe || r.pipe) && (!OS.sector || r.x.sector === OS.sector) && (!q || r.x.q.includes(q))).sort((a, b) => (b.x.c90 || 0) - (a.x.c90 || 0) || lastAct(b.x) - lastAct(a.x)); }
function oList() { const l = oFiltered(); $("#o-count").textContent = `${nf(l.length)} of ${nf(ODR.length)} repositories`;
  const row = r => `<tr><td class="repo">${xBtn(r.key, r.x.n)}<small>${esc(r.x.desc)}</small></td><td>${esc(orgName(r.x.org))}</td><td>${pill(r.x.st)}</td><td>${r.portals.map(p => `<span class="chip">${esc(PORT[p[0]])}</span>`).join(" ") || `<span class="muted">Open data</span>`}<br><span class="small">${esc(odDir(r))}${r.pipe ? " · pipeline" : ""}</span></td><td><span class="mono small muted">${esc((r.portals[0]?.[1][0][1]) || r.open)}</span></td></tr>`;
  const head = `<thead><tr><th scope="col">Repository</th><th scope="col">Organisation</th><th scope="col">Status</th><th scope="col">Portal and direction</th><th scope="col">Evidence</th></tr></thead>`;
  if (OS.group) { const gk = OS.group === "org" ? r => [orgName(r.x.org)] : r => r.portals.length ? r.portals.map(p => PORT[p[0]]) : ["Open data only"]; const g = {}; l.forEach(r => gk(r).forEach(k => (g[k] ||= []).push(r)));
    $("#o-list").innerHTML = Object.entries(g).sort((a, b) => b[1].length - a[1].length).slice(0, 50).map(([k, rs]) => `<details class="grpbox"><summary><b>${esc(k)}</b> <span class="muted">${nf(rs.length)}</span></summary><div class="tbl-wrap"><table>${head}<tbody>${rs.slice(0, 50).map(row).join("")}</tbody></table></div></details>`).join(""); }
  else { $("#o-list").innerHTML = `<div class="tbl-wrap"><table id="o-tbl"><caption class="sr-only">Open data repositories, page ${OS.page + 1}</caption>${head}<tbody>${l.slice(OS.page * OS.size, OS.page * OS.size + OS.size).map(row).join("")}</tbody></table></div>`; $("#o-list").appendChild(pager(OS, l.length, oList, () => $("#o-tbl"))); }
  bindX($("#o-list")); }
