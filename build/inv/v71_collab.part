/* ---------- beyond GitHub: where the work around each repository happens in Slack and Google Drive (7.10, R59) ---------- */
const CL = DATA.collab || null;
const CLQ = {ws: "", cat: "", sort: "msgs", n: 30, view: "repos"};
const CL_CAT = {incident: ["Incidents and outages", "c_shield", "red"], release: ["Deploys and releases", "s_active", "green"], security: ["Security and vulnerabilities", "c_shield", "magenta"], migration: ["Migrations and moves", "move", "violet"], support: ["Questions and help", "i_text", "blue"], dependency: ["Uses and depends on", "i_plug", "yellow"], review: ["Reviews and pull requests", "c_readme", "teal"]};
const clWs = w => CL ? CL.slack.ws[w] || w : w;
const clMonth = m => { const [y, mo] = m.split("-"); return new Date(Date.UTC(+y, +mo - 1, 1)).toLocaleDateString("en-GB", {month: "short", year: "numeric", timeZone: "UTC"}); };
const clCrit = r => CL.critical.reduce((s, c) => s + (r.cats[c] || 0), 0);
function clRepos() {
  if (!CL) return [];
  return Object.entries(CL.slack.repos).map(([key, r]) => ({key, r, x: XBY[key] || null, crit: clCrit(r), drive: (CL.drive.accounts[key.split("/")[0]] || {repos: {}}).repos[key.split("/")[1]] || 0}));
}
function clPanelFor(key) {
  if (!CL) return "";
  const r = CL.slack.repos[key], acc = key.split("/")[0], dv = CL.drive.accounts[acc];
  if (!r && !dv) return `<div class="panel" data-new="1"><h2>Talked about beyond GitHub</h2><p class="muted">No links to this project were found in the Slack workspaces or the Google Drive searched on ${esc(gvDate(CL.read))}. That doesn't mean nobody talks about it: links are only one sign.</p></div>`;
  const pubs = r ? Object.entries(r.public_channels).filter(([c]) => !c.endsWith("|")).sort((a, b) => b[1] - a[1]) : [];
  return `<div class="panel" data-new="1"><h2>Talked about beyond GitHub</h2>
    ${r ? `<p><b>${nf(r.msgs)}</b> Slack messages link to it, in ${nf(r.channels)} channels or conversations, from ${esc(clMonth(r.first))} to ${esc(clMonth(r.last))}: ${Object.entries(r.ws).map(([w, n]) => `${esc(clWs(w))} ${nf(n)}`).join(", ")}.${r.private_msgs ? ` ${nf(r.private_msgs)} of them are in private channels or conversations, which aren't named.` : ""}</p>
      ${Object.keys(r.cats).length ? `<p>${Object.entries(r.cats).sort((a, b) => b[1] - a[1]).map(([c, n]) => `<span class="rxbadge c-${CL_CAT[c][2]}"><span>${esc(CL_CAT[c][0])}: ${nf(n)}</span></span>`).join(" ")}</p>` : ""}
      ${pubs.length ? `<p class="small">Public channels: ${pubs.slice(0, 8).map(([c, n]) => `<span class="mono">#${esc(c.split("|")[1])}</span> <span class="muted">(${esc(clWs(c.split("|")[0]))}, ${nf(n)})</span>`).join(", ")}</p>` : ""}` : `<p class="muted">No Slack messages link to it.</p>`}
    ${dv ? `<p class="small">Google Drive: ${nf(dv.docs)} documents refer to the ${esc(acc)} account${dv.repos[key.split("/")[1]] ? `, ${nf(dv.repos[key.split("/")[1]])} of them to this project` : ""}.</p>` : ""}
    <p class="small muted">Counted from links in what one signed-in person can see, on ${esc(gvDate(CL.read))}. Topics are from keywords in each message, not read by a person.</p></div>`;
}
function collabRender() {
  const v = vb("collab");
  if (!CL) { v.innerHTML = `<div class="panel"><h2>Beyond GitHub</h2><p>Not scanned yet in this build.</p></div>`; return; }
  const Q = CLQ, all = clRepos(), S = CL.slack;
  const L = all.filter(z => (!Q.ws || z.r.ws[Q.ws]) && (!Q.cat || z.r.cats[Q.cat])).sort(Q.sort === "crit" ? (a, b) => b.crit - a.crit || b.r.msgs - a.r.msgs : Q.sort === "recent" ? (a, b) => b.r.last.localeCompare(a.r.last) || b.r.msgs - a.r.msgs : (a, b) => b.r.msgs - a.r.msgs);
  const msgs = all.reduce((s, z) => s + z.r.msgs, 0), priv = all.reduce((s, z) => s + z.r.private_msgs, 0);
  const chans = S.channels.filter(c => !Q.ws || c.ws === Q.ws), pubC = chans.filter(c => !c.private).sort((a, b) => b.msgs - a.msgs);
  const byAcc = {}; all.forEach(z => { const a = z.key.split("/")[0]; byAcc[a] = (byAcc[a] || 0) + z.r.msgs; });
  const catN = Object.fromEntries(Object.keys(CL_CAT).map(c => [c, all.filter(z => z.r.cats[c] && (!Q.ws || z.r.ws[Q.ws])).length]));
  const capped = Object.entries(S.searched).filter(([, s]) => s.capped).map(([k]) => k);
  const dA = Object.entries(CL.drive.accounts).sort((a, b) => b[1].docs - a[1].docs);
  v.innerHTML = `<section class="panel rxhero c-violet" data-new="1"><div class="rxh-row"><span class="rxtile xl c-violet" aria-hidden="true">${icon("i_text", 40)}</span><div class="rxh-main"><div class="eyebrow">Insights · beyond GitHub</div><h2>Where the work around the code happens</h2>
      <p class="rx-lede">Much of the talk about public code happens in Slack and shared documents, not in GitHub issues and discussions. This shows which projects are linked from the UK Government Digital and GDS Slack workspaces and the GDS Google Drive, where, and what about.</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(all.length)}</b> projects linked from Slack</span><span>${icon("i_text", 16)} <b>${nf(msgs)}</b> messages</span><span>${icon("i_building", 16)} <b>${nf(S.channels.length)}</b> channels and conversations, ${nf(S.channels.filter(c => !c.private).length)} of them public</span><span>${icon("c_readme", 16)} <b>${nf(CL.drive.totals.distinct_docs)}</b> Drive documents</span></p></div></div></section>
    <div class="panel"><h2>What people talk about</h2><p class="muted small">Select a topic to list its projects. Select it again to clear it. Topics come from keywords in each message.</p><div class="lgtiles">${Object.entries(CL_CAT).map(([c, [l, ic, hue]]) => `<button type="button" class="lgtile c-${hue}" data-clcat="${c}" aria-pressed="${Q.cat === c}"><span class="rxtile c-${hue}" aria-hidden="true">${icon(ic, 20)}</span><span class="lgt-l">${esc(l)}</span><span class="lgt-n">${nf(catN[c])}</span><span class="lgt-s">projects</span></button>`).join("")}</div></div>
    <div class="panel"><h2>Projects services lean on</h2><p class="small">Projects most often linked in messages about incidents, deploys and releases, or security: a sign that a live service depends on them. ${nf(all.filter(z => z.crit).length)} projects have at least one.</p>
      <div class="tbl-wrap"><table><caption class="sr-only">Projects most linked in incident, release and security messages</caption><thead><tr><th scope="col">Project</th><th scope="col" class="n">Incidents</th><th scope="col" class="n">Deploys and releases</th><th scope="col" class="n">Security</th><th scope="col">Last mentioned</th></tr></thead><tbody>${all.filter(z => z.crit).sort((a, b) => b.crit - a.crit).slice(0, 15).map(z => `<tr><td class="repo">${z.x ? `<button type="button" class="linkbtn" data-rx="${esc(z.key)}">${esc(z.key)}</button>` : `<a class="mono" href="https://github.com/${esc(z.key)}" rel="noopener">${esc(z.key)}</a>`}</td><td class="n">${nf(z.r.cats.incident || 0)}</td><td class="n">${nf(z.r.cats.release || 0)}</td><td class="n">${nf(z.r.cats.security || 0)}</td><td>${esc(clMonth(z.r.last))}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="rxsplit"><div class="panel"><h2>Public channels where projects come up</h2>${rxBars(pubC.slice(0, 12).map((c, i) => ({label: `#${c.name} (${clWs(c.ws)}${c.feed ? ", automated feed" : ""}): ${nf(c.repos)} projects`, n: c.msgs, ic: "i_text", c: SV_HUE[i % 8]})), "Public Slack channels by messages linking to catalogue projects")}<p class="small">${nf(chans.filter(c => c.feed).reduce((a, c) => a + c.msgs, 0))} of these ${nf(chans.reduce((a, c) => a + c.msgs, 0))} messages are in ${nf(chans.filter(c => c.feed).length)} channels named as automated feeds (deploy, release, alert and pull request notifications); the rest are people talking in team, help and community channels. Feeds are judged from the channel's name.</p><p class="small muted">No private channels, group or direct messages appeared in the results; if they had, they would count towards the totals without being named.</p></div>
      <div class="panel"><h2>Accounts most talked about</h2>${rxBars(Object.entries(byAcc).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([a, n], i) => ({label: orgName(a), n, ic: "i_building", c: SV_HUE[(i + 3) % 8]})), "GitHub accounts by Slack messages linking to their projects")}</div></div>
    <div class="panel"><h2>Projects <span class="muted">(${nf(L.length)})</span></h2>
      <div class="filters"><label for="cl-ws">Workspace<select id="cl-ws"><option value="">Both</option>${Object.entries(S.ws).map(([k, l]) => `<option value="${k}"${Q.ws === k ? " selected" : ""}>${esc(l)}</option>`).join("")}</select></label><label for="cl-sort">Sort by<select id="cl-sort">${[["msgs", "Most messages"], ["crit", "Most incident, release and security talk"], ["recent", "Most recently mentioned"]].map(([k, l]) => `<option value="${k}"${Q.sort === k ? " selected" : ""}>${l}</option>`).join("")}</select></label></div>
      <div class="tbl-wrap"><table><caption class="sr-only">Projects linked from Slack</caption><thead><tr><th scope="col">Project</th><th scope="col" class="n">Messages</th><th scope="col">Where</th><th scope="col">Topics</th><th scope="col">Mentioned</th></tr></thead><tbody>${L.slice(0, Q.n).map(z => `<tr><td class="repo">${z.x ? `<button type="button" class="linkbtn" data-rx="${esc(z.key)}">${esc(z.key)}</button>` : `<a class="mono" href="https://github.com/${esc(z.key)}" rel="noopener">${esc(z.key)}</a> <span class="muted small">not in the catalogue yet</span>`}</td><td class="n">${nf(z.r.msgs)}</td><td class="small">${Object.entries(z.r.ws).map(([w, n]) => `${esc(clWs(w))} ${nf(n)}`).join(", ")}${z.r.private_msgs ? `<br><span class="muted">${nf(z.r.private_msgs)} private</span>` : ""}</td><td>${Object.entries(z.r.cats).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([c, n]) => `<span class="rxbadge c-${CL_CAT[c][2]}"><span>${esc(CL_CAT[c][0])} ${nf(n)}</span></span>`).join(" ")}</td><td class="small">${esc(clMonth(z.r.first))} to ${esc(clMonth(z.r.last))}</td></tr>`).join("")}</tbody></table></div>
      ${L.length > Q.n ? `<p><button class="btn" type="button" data-clmore>Show ${nf(Math.min(30, L.length - Q.n))} more</button></p>` : ""}</div>
    <div class="panel"><h2>Google Drive</h2><p class="small">${nf(CL.drive.totals.distinct_docs)} documents in the GDS Google Drive refer to ${nf(CL.drive.totals.accounts_with_docs)} of the ${nf(CL.drive.totals.accounts_searched)} GitHub accounts. Most are slides, documents and architecture drawings.</p>${rxBars(dA.slice(0, 10).map(([a, d], i) => ({label: orgName(a), n: d.docs, ic: "c_readme", c: SV_HUE[(i + 5) % 8]})), "GitHub accounts by Drive documents referring to them")}</div>
    <div class="panel"><h2>How this was found, and its limits</h2><ul class="small">
      <li>${esc(S.method)}</li><li>${esc(CL.drive.source)}. Searched for each account's github.com address; a document counts once per account.</li>
      ${(CL.also || []).map(a => `<li>${esc(a.ws)}: searched for ${esc(a.searched)}; ${nf(a.links)} links found. ${esc(a.note)}</li>`).join("")}
      <li>Only what one signed-in person can see: channels they haven't joined count only if they are public, and Drive files only if shared with them. Teams, khub.net, Basecamp and other platforms weren't reachable, so aren't counted.</li>
      <li>Links are one sign of work, not all of it: people often name a project without linking it. So these are lower bounds.${capped.length ? ` For ${capped.map(k => esc(k.split("|")[1]) + " (" + esc(clWs(k.split("|")[0])) + ")").join(", ")}, the search stopped at 3,000 messages.` : ""}</li>
      <li>What's kept: counts, months, keyword topics and public channel names. No message text, document titles, names or user ids, and only public repositories.</li></ul></div>`;
  const re = () => collabRender();
  $$("[data-clcat]", v).forEach(b => b.onclick = () => { Q.cat = Q.cat === b.dataset.clcat ? "" : b.dataset.clcat; Q.n = 30; re(); $(`[data-clcat="${b.dataset.clcat}"]`, vb("collab"))?.focus(); });
  $("#cl-ws").onchange = e => { Q.ws = e.target.value; Q.n = 30; re(); $("#cl-ws").focus(); };
  $("#cl-sort").onchange = e => { Q.sort = e.target.value; re(); $("#cl-sort").focus(); };
  $("[data-clmore]", v) && ($("[data-clmore]", v).onclick = () => { Q.n += 30; re(); });
}
RENDER.collab = collabRender;
{ const _rp2 = rxProfile; rxProfile = function (key) { const r = _rp2(key); const h = $$("#v-profile h2").find(e => e.textContent.trim() === "What it's about"); if (h && CL) h.parentElement.insertAdjacentHTML("afterend", clPanelFor(key)); return r; }; }
