/* ---------- checked against GitHub: live repository lists and a sample of feature settings (7.9.1, R57, R58) ---------- */
const GV = DATA.ghverify || null;
const gvDate = d => new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", {day: "numeric", month: "long", year: "numeric", timeZone: "UTC"});
const GVQ = {sector: "", sort: "change", n: 25};
const gvPct = (a, b) => b ? Math.round(a / b * 100) : 0;
function gvFeatBars() {
  if (!GV) return "";
  const s = GV.sample;
  return `${rxBars(s.est.map(e => ({label: `${e.label}: ${Math.round(e.pct)}% (95% interval ${Math.round(e.lo)}% to ${Math.round(e.hi)}%)`, n: Math.round(e.pct), ic: "i_plug", c: "blue"})), "Estimated share of live projects with each GitHub feature switched on")}
    <p class="small muted">Estimates, not counts: from a stratified random sample of ${nf(s.n)} live, non-fork repositories, read on GitHub on ${esc(gvDate(s.read))}${s.unread ? ` (${nf(s.unread)} pages couldn't be read and are left out)` : ""}. Weighted by each sector's number of live repositories, the estimates are ${s.est.map(e => `${esc(e.label)} ${Math.round(e.weighted)}%`).join(", ")}. A feature counts as switched on when GitHub shows its tab to a signed-in person who isn't a member of the account. Seed ${esc(String(s.seed))}, so anyone can redraw the same sample.</p>`;
}
function ghcheckRender() {
  const v = vb("ghcheck");
  if (!GV) { v.innerHTML = `<div class="panel"><h2>Checked against GitHub</h2><p>Not checked yet in this build.</p></div>`; return; }
  const Q = GVQ, A = GV.accounts, T = GV.totals, diff = A.filter(a => a.status !== "same");
  const secs = [...new Set(A.map(a => a.sector).filter(Boolean))].sort();
  const L = diff.filter(a => !Q.sector || a.sector === Q.sector).sort(Q.sort === "name" ? (a, b) => a.account.localeCompare(b.account) : Q.sort === "added" ? (a, b) => b.added.length - a.added.length : Q.sort === "removed" ? (a, b) => b.removed.length - a.removed.length : (a, b) => (b.added.length + b.removed.length) - (a.added.length + a.removed.length));
  const add = A.reduce((s, a) => s + a.added.length, 0), rem = A.reduce((s, a) => s + a.removed.length, 0), ren = Object.keys(GV.renamed || {}).length, gone = A.filter(a => a.kind === "gone");
  const nm = (o, n) => `<a href="https://github.com/${encodeURIComponent(o)}/${encodeURIComponent(n)}" rel="noopener">${esc(n)}</a>`;
  const live = T.n - T.archived;
  v.innerHTML = `<section class="panel rxhero c-green" data-new="1"><div class="rxh-row"><span class="rxtile xl c-green" aria-hidden="true">${icon("s_active", 40)}</span><div class="rxh-main"><div class="eyebrow">Insights · checked against GitHub</div><h2>Is the catalogue still what GitHub shows?</h2>
      <p class="rx-lede">Every GitHub account in the catalogue, read on ${esc(gvDate(GV.read))} from GitHub's own pages, and compared with what the catalogue holds. Nothing here comes from a third-party feed.</p>
      <p class="rxh-stats"><span>${icon("i_building", 16)} <b>${nf(A.length)}</b> accounts read</span><span>${icon("i_spark", 16)} <b>${nf(T.n)}</b> repositories on GitHub</span><span>${icon("s_active", 16)} <b>${nf(GV.status.same || 0)}</b> accounts exactly match</span><span>${icon("i_plug", 16)} <b>${nf(diff.length)}</b> differ, every difference named</span></p></div></div></section>
    <div class="rxsplit"><div class="panel"><h2>What changed since the catalogue was built</h2><ul class="cmplevels">
        <li><b>${nf(add)}</b> repositories are on GitHub but not yet in the catalogue: new, renamed or moved in.</li>
        <li><b>${nf(rem)}</b> repositories in the catalogue are no longer listed on GitHub. Of these, <b>${nf(ren)}</b> were renamed or moved (GitHub still redirects to them) and <b>${nf(rem - ren)}</b> can't be reached from outside: deleted, or made private or internal. GitHub doesn't say which.</li>
        <li><b>${nf(gone.length)}</b> accounts no longer exist on GitHub: ${gone.map(a => `<span class="mono">${esc(a.account)}</span>`).join(", ") || "none"}. None of them held public repositories when the catalogue was built.</li></ul></div>
      <div class="panel"><h2>What GitHub shows for all ${nf(T.n)} repositories</h2>${rxBars([["Archived", T.archived, "i_text", "violet"], ["Forks", T.forks, "i_plug", "blue"], ["With a description", T.desc, "c_readme", "green"], ["With topics", T.topics, "k_data", "green"], ["With a licence GitHub recognises", T.licence, "c_scale", "green"], ["Updated in the last 90 days", T.p90, "s_active", "yellow"], ["Updated in the last 12 months", T.p365, "s_active", "yellow"]].map(([l, n, ic, c]) => ({label: `${l}: ${nf(n)} (${gvPct(n, T.n)}%)`, n, ic, c})), "Repository settings across all accounts, as GitHub shows them")}<p class="small muted">${nf(live)} repositories aren't archived. 'Updated' is GitHub's own last-updated date, which also moves when settings change.</p></div></div>
    <div class="panel"><h2>Accounts that differ <span class="muted">(${nf(L.length)})</span></h2>
      <div class="filters"><label for="gv-sec">Sector<select id="gv-sec"><option value="">All sectors</option>${secs.map(s => `<option${Q.sector === s ? " selected" : ""}>${esc(s)}</option>`).join("")}</select></label><label for="gv-sort">Sort by<select id="gv-sort">${[["change", "Most changed"], ["added", "Most added on GitHub"], ["removed", "Most no longer listed"], ["name", "Account name"]].map(([k, l]) => `<option value="${k}"${Q.sort === k ? " selected" : ""}>${l}</option>`).join("")}</select></label></div>
      <div class="tbl-wrap"><table><caption class="sr-only">Accounts whose repositories on GitHub differ from the catalogue</caption><thead><tr><th scope="col">Account</th><th scope="col">Sector</th><th scope="col" class="n">In the catalogue</th><th scope="col" class="n">On GitHub now</th><th scope="col">Differences</th></tr></thead>
        <tbody>${L.slice(0, Q.n).map(a => `<tr><th scope="row" style="text-transform:none;font-weight:700"><a href="https://github.com/${encodeURIComponent(a.account)}" rel="noopener" class="mono">${esc(a.account)}</a></th><td>${esc(a.sector)}</td><td class="n">${nf(a.expected)}</td><td class="n">${nf(a.n)}</td><td>${a.added.length ? `<details><summary>${nf(a.added.length)} on GitHub, not in the catalogue</summary><p class="small">${a.added.map(n => nm(a.account, n)).join(", ")}</p></details>` : ""}${a.removed.length ? `<details><summary>${nf(a.removed.length)} no longer listed</summary><p class="small">${a.removed.map(n => GV.renamed[a.account + "/" + n] ? `${esc(n)} <span class="muted">(now <a href="https://github.com/${esc(GV.renamed[a.account + "/" + n])}" rel="noopener">${esc(GV.renamed[a.account + "/" + n])}</a>)</span>` : esc(n)).join(", ")}</p></details>` : ""}</td></tr>`).join("")}</tbody></table></div>
      ${L.length > Q.n ? `<p><button class="btn" type="button" data-gvmore>Show ${nf(Math.min(25, L.length - Q.n))} more</button></p>` : ""}</div>
    ${(() => { const PV = (DATA.provenance || {}).accounts || {}, ks = Object.keys(PV).sort((a, b) => PV[b].confirmed - PV[a].confirmed || a.localeCompare(b)); return ks.length ? `<div class="panel" data-new="1"><h2>Accounts from outside the registry</h2><p class="small">Most accounts come from the government.github.com registry. These ${nf(ks.length)} were added from other sources, so each was opened on GitHub on ${esc(gvDate(DATA.provenance.read))}. Only GitHub's verified-domain badge proves an account belongs to the organisation; a website on the profile is set by the account itself. ${esc(DATA.provenance.method)}</p><div class="tbl-wrap"><table><caption class="sr-only">Provenance of accounts not in the registry</caption><thead><tr><th scope="col">Account</th><th scope="col">Verified by GitHub</th><th scope="col">What was checked</th></tr></thead><tbody>${ks.map(a => `<tr><th scope="row" class="mono" style="text-transform:none">${esc(a)}</th><td>${PV[a].confirmed ? "Yes" : "<b>No</b>"}</td><td class="small">${esc(PV[a].basis)}</td></tr>`).join("")}</tbody></table></div></div>` : ""; })()}
    <div class="panel"><h2>Renamed or moved</h2><p class="small muted">GitHub still redirects the old address to the new one.</p><div class="tbl-wrap"><table><caption class="sr-only">Repositories renamed or moved since the catalogue was built</caption><thead><tr><th scope="col">Was</th><th scope="col">Now</th></tr></thead><tbody>${Object.entries(GV.renamed || {}).map(([o, n]) => `<tr><td class="mono">${esc(o)}</td><td class="mono"><a href="https://github.com/${esc(n)}" rel="noopener">${esc(n)}</a>${GV.accounts.some(a => a.account === n.split("/")[0]) ? "" : ` <span class="rxbadge c-yellow"><span>account not in the catalogue</span></span>`}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>GitHub features switched on: an estimate</h2>${gvFeatBars()}</div>
    <div class="panel"><h2>How this was checked</h2><ul class="small"><li>${esc(GV.method)}</li><li>Each account's list was compared with the catalogue by count and by a fingerprint of the sorted names; where they differ, every name added or no longer listed is shown, and the counts must add up (a build check fails if they don't).</li><li>For every repository no longer listed, git was asked directly whether the old address still answers; GitHub redirects renamed and moved repositories, and asks for a sign-in for deleted and private ones.</li><li>Personal user accounts that aren't organisations, and accounts the signed-in person belongs to, may show more than the public sees; none of the accounts here showed private repositories.</li><li>Codespaces settings aren't shown on public pages, so they aren't measured.</li></ul></div>`;
  const re = () => ghcheckRender();
  $("#gv-sec").onchange = e => { Q.sector = e.target.value; Q.n = 25; re(); $("#gv-sec").focus(); };
  $("#gv-sort").onchange = e => { Q.sort = e.target.value; re(); $("#gv-sort").focus(); };
  $("[data-gvmore]", v) && ($("[data-gvmore]", v).onclick = () => { Q.n += 25; re(); });
}
RENDER.ghcheck = ghcheckRender;
