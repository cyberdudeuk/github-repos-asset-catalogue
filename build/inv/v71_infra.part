
/* ================= 7.8 Data infrastructure: pan-UK public data infrastructure, data interoperability, registers and authoritative sources (R51 to R53) ================= */
const IO = DATA.interop, RG = DATA.registers;
const IOS = IO.standards.map(([name, layer], i) => ({i, name, layer})), IOR = IO.roles.map(([id, name], i) => ({i, id, name})), IOL = IO.layers.map(([id, name, desc]) => ({id, name, desc}));
const IOL_HUE = {semantic: "violet", syntax: "blue", transport: "aqua", organisational: "green", legal: "orange"};
const ioOf = x => IO.recs[x.key] || {}, ioStd = x => (ioOf(x).s || []).map(([i]) => IOS[i]), ioRole = x => (ioOf(x).r || []).map(([i]) => IOR[i]);
const RGK = RG.kinds.map(([id, name, desc], i) => ({i, id, name, desc})), rgOf = x => (RG.recs[x.key] || []).map(([i, ev]) => ({k: RGK[i], ev}));
const RG_HUE = ["red", "orange", "violet", "blue", "green", "magenta", "aqua"];
const NATIONS = [["uk", "UK government"], ["england", "England"], ["scotland", "Scotland"], ["wales", "Wales"], ["ni", "Northern Ireland"], ["cdot", "Crown dependencies and overseas territories"]];
const nationOf = x => { if (x.sector === "Crown dependencies" || x.sector === "Overseas territories") return "cdot"; if (x.sector === "Scotland") return "scotland"; if (x.sector === "Wales") return "wales"; if (x.sector === "Local government") { const c = DV_ACC[x.org]; return c && c.nation === "Scotland" ? "scotland" : "england"; } if (x.sector === "Health and care") return "england"; return "uk"; };
const svCaps = x => (svOf(x).c || []).map(([i]) => SV.capabilities[i][0]);
/* the layers of public data infrastructure, each built from what the catalogue already classifies */
const INFRA = [
 {id: "gov", name: "Governance, law and agreements", ic: "c_scale", c: "orange", desc: "The rules that let data move: data sharing agreements, the Digital Economy Act, licences, data standards bodies and governance.", parts: x => ioStd(x).filter(s => s.layer === "legal" || s.layer === "organisational").map(s => s.name)},
 {id: "reg", name: "Registers and authoritative sources", ic: "i_text", c: "red", desc: "The master copies others rely on: statutory and regulatory registers, official records, reference data and systems of record.", parts: x => rgOf(x).map(z => z.k.name)},
 {id: "ids", name: "Identity and identifiers", ic: "t_identity", c: "magenta", desc: "Knowing who and what a record is about: sign-in and identity checks, unique identifiers such as the UPRN, and record matching.", parts: x => [...(svCaps(x).includes("identity") ? ["Identity and sign-in"] : []), ...ioRole(x).filter(r => r.id === "identity").map(r => r.name), ...ioStd(x).filter(s => s.name === "UPRN and USRN").map(s => s.name)]},
 {id: "std", name: "Standards, vocabularies and schemas", ic: "c_readme", c: "violet", desc: "Shared meaning and structure: vocabularies, ontologies, code lists, data models and schemas, and the crosswalks, converters and validators between them.", parts: x => [...ioStd(x).filter(s => s.layer === "semantic" || s.layer === "syntax").map(s => s.name), ...ioRole(x).filter(r => ["crosswalk", "converter", "validator", "schema", "vocab"].includes(r.id)).map(r => r.name)]},
 {id: "xch", name: "Exchange: APIs and messaging", ic: "i_plug", c: "aqua", desc: "How data moves between organisations: APIs and their descriptions, adapters and gateways, and messaging.", parts: x => [...ioStd(x).filter(s => s.layer === "transport").map(s => s.name), ...ioRole(x).filter(r => r.id === "adapter").map(r => r.name)]},
 {id: "plat", name: "Data platforms and pipelines", ic: "k_data", c: "blue", desc: "Where data is stored, processed and analysed: data platforms, pipelines, analytics and orchestration.", parts: x => [...(svCaps(x).includes("data") ? ["Data, analytics and reporting"] : []), ...((svOf(x).wf || []).some(([i]) => SV.workflows[i][0] === "orchestration") ? ["Data and job orchestration"] : [])]},
 {id: "find", name: "Catalogues, metadata and discovery", ic: "find", c: "green", desc: "How people find data: data catalogues and portals, and the tools that generate and harvest metadata.", parts: x => ioRole(x).filter(r => r.id === "catalogue" || r.id === "metagen").map(r => r.name)},
 {id: "shared", name: "Shared platforms", ic: "l_govuk", c: "slate", desc: "Components every service can reuse: GOV.UK One Login, Pay and Notify, named in the code.", parts: x => svSup(x).filter(s => SV_PLATFORM.has(s))},
 {id: "sec", name: "Security and resilience", ic: "c_shield", c: "yellow", desc: "Keeping data safe and services running: security tooling, monitoring and incident response.", parts: x => svCaps(x).includes("security") ? ["Security and monitoring"] : []},
];
const INFRA_IX = {}; for (const x of ALL) { const r = {}; for (const L of INFRA) { const p = L.parts(x); if (p.length) r[L.id] = [...new Set(p)]; } if (Object.keys(r).length) INFRA_IX[x.key] = r; }
const IFQ = {layer: "", part: "", nation: "", org: "", live: false, n: 24};
function infraRender() {
  const S = IFQ, keys = Object.keys(INFRA_IX), xs = keys.map(k => XBY[k]).filter(Boolean).filter(x => !S.live || live(x));
  const cell = {}; for (const x of xs) { const n = nationOf(x); for (const L of Object.keys(INFRA_IX[x.key])) { (cell[L] ||= {})[n] = (cell[L][n] || 0) + 1; } }
  const mx = Math.max(1, ...Object.values(cell).flatMap(c => Object.values(c)));
  const crumbs = [["Bird's-eye view", {layer: "", part: "", nation: "", org: ""}], ...(S.layer ? [[INFRA.find(l => l.id === S.layer).name, {part: "", nation: "", org: ""}]] : []), ...(S.part ? [[S.part, {nation: "", org: ""}]] : []), ...(S.nation ? [[NATIONS.find(n => n[0] === S.nation)[1], {org: ""}]] : []), ...(S.org ? [[orgName(S.org), {}]] : [])];
  let detail = "";
  if (S.layer) { const L = INFRA.find(l => l.id === S.layer), inL = xs.filter(x => INFRA_IX[x.key][L.id]);
    const parts = {}; for (const x of inL) for (const p of INFRA_IX[x.key][L.id]) { (parts[p] ||= {})[nationOf(x)] = (parts[p]?.[nationOf(x)] || 0) + 1; }
    const sel = inL.filter(x => (!S.part || INFRA_IX[x.key][L.id].includes(S.part)) && (!S.nation || nationOf(x) === S.nation));
    const orgs = svCount(sel, x => x.org), list = sel.filter(x => !S.org || x.org === S.org).sort(RX_SORT.recent[0]);
    detail = `<div class="panel" data-new="1"><h2>${esc(L.name)}: its parts by nation</h2><p class="muted small">${esc(L.desc)} Select a part to narrow, or a number to go down to organisations.</p><div class="tbl-wrap"><table class="svheat"><caption class="sr-only">${esc(L.name)}: parts by nation</caption><thead><tr><th scope="col">Part</th>${NATIONS.map(n => `<th scope="col" class="n">${esc(n[1])}</th>`).join("")}</tr></thead><tbody>${Object.entries(parts).sort((a, b) => Object.values(b[1]).reduce((s, v) => s + v, 0) - Object.values(a[1]).reduce((s, v) => s + v, 0)).map(([p, c]) => `<tr${S.part === p ? ' class="sel"' : ""}><th scope="row"><button type="button" class="linkbtn" data-ifpart="${esc(p)}">${esc(p)}</button></th>${NATIONS.map(n => { const v = c[n[0]] || 0, lv = v ? Math.min(5, 1 + Math.floor(v / Math.max(1, ...Object.values(c)) * 4)) : 0; return `<td class="n hv${lv}">${v ? `<button type="button" class="linkbtn" data-ifpn="${esc(p)}|${n[0]}" aria-label="${nf(v)} projects: ${esc(p)}, ${esc(n[1])}">${nf(v)}</button>` : `<span class="gapmark" title="No project found">0</span>`}</td>`; }).join("")}</tr>`).join("")}</tbody></table></div></div>
      <div class="rxsplit"><div class="panel"><h2>Organisations${S.part ? ": " + esc(S.part) : ""}${S.nation ? ", " + esc(NATIONS.find(n => n[0] === S.nation)[1]) : ""}</h2>${Object.keys(orgs).length ? rxBars(Object.entries(orgs).sort((a, b) => b[1] - a[1]).slice(0, 15).map(([o, n], i) => ({label: orgName(o), n, ic: "i_building", c: SV_HUE[i % 8], btn: `data-iforg="${esc(o)}" aria-pressed="${S.org === o}"`})), "Organisations holding this part of the infrastructure") : `<p class="muted">None.</p>`}</div>
        <div class="panel"><h2>Projects <span class="muted">(${nf(list.length)})</span></h2><div class="rxgrid">${list.slice(0, S.n).map(rxCard).join("")}</div>${list.length > S.n ? `<p><button class="btn" type="button" data-ifmore>Show ${nf(Math.min(24, list.length - S.n))} more</button></p>` : ""}</div></div>`; }
  const gaps = []; for (const L of INFRA) for (const n of NATIONS) if (!(cell[L.id] || {})[n[0]] && n[0] !== "cdot") gaps.push([L.name, n[1]]);
  const NEEDS = [["Every public body's GitHub accounts, in every nation", "partial", `Northern Ireland, the crown dependencies and the overseas territories have no account in the registers this catalogue reads, and only ${nf(Object.values(DV_ACC).filter(c => c.nation === "England").length)} English council accounts are listed out of more than 300 councils.`],
    ["Who sponsors or owns each body, beyond GOV.UK", "partial", "GOV.UK's list gives sponsorship for central government. Councils, NHS bodies and devolved bodies outside it have no sponsor link."],
    ["The datasets each project publishes or uses, joined to data catalogues", "missing", "Projects aren't yet joined to data.gov.uk, statistics.gov.scot, Data Map Wales or NHS catalogues, so the view stops at code, not datasets."],
    ["Which service, register and standard each project implements, confirmed by its owner", "partial", "Found from projects' own words and checked on samples. Owners haven't confirmed them."],
    ["GitHub feature settings and documentation for every project", FEAT ? "available" : "partial", FEAT ? "Collected." : "Documentation is measured from files read; feature settings need the collector in the repository to run."],
    ["Boundaries and locations, for maps", "missing", "No boundary data is held, so nations, authorities and councils are shown as lists and tables, not maps."],
    ["Links between projects across organisations (forks, shared libraries, calls)", "partial", "Related work and dependencies are known for co-cddo projects only."],
    ["Common identifiers: GOV.UK organisation slugs, ODS codes, UPRNs, council codes", "partial", "GOV.UK slugs are used throughout; other identifiers aren't joined yet."]];
  vb("infra").innerHTML = `<section class="panel rxhero c-blue" data-new="1"><div class="rxh-row"><span class="rxtile xl c-blue" aria-hidden="true">${icon("k_graph", 40)}</span><div class="rxh-main"><div class="eyebrow">Data infrastructure · pan-UK</div><h2>Pan-UK public data infrastructure, as seen in public code</h2>
      <p class="rx-lede">The code that makes up the UK's public data infrastructure, layer by layer and nation by nation: governance, registers, identity, standards, exchange, platforms, discovery, shared platforms and security. Start with the whole picture, then go down to a layer, a part of it, a nation, an organisation and a project.</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(xs.length)}</b> projects in at least one layer</span><span>${icon("i_building", 16)} <b>${nf(new Set(xs.map(x => x.org)).size)}</b> GitHub accounts</span></p></div></div></section>
    <nav class="panel ifcrumbs" aria-label="Where you are in the infrastructure view"><ol>${crumbs.map(([l, reset], i) => `<li>${i < crumbs.length - 1 ? `<button type="button" class="linkbtn" data-ifcrumb="${i}">${esc(l)}</button>` : `<span aria-current="location"><b>${esc(l)}</b></span>`}</li>`).join("")}</ol><label class="rxcheck" for="if-live"><input type="checkbox" id="if-live"${S.live ? " checked" : ""}> Being worked on or looked after</label></nav>
    <div class="panel" data-new="1"><h2>Bird's-eye view: layers by nation</h2><p class="muted small">Each number is the projects in that layer and nation. Darker cells hold more. A dash marks a gap: no public code found. Select a layer to go down a level.</p>
      <div class="tbl-wrap"><table class="svheat ifgrid"><caption class="sr-only">Public data infrastructure layers by nation</caption><thead><tr><th scope="col">Layer</th>${NATIONS.map(n => `<th scope="col" class="n">${esc(n[1])}</th>`).join("")}<th scope="col" class="n">All</th></tr></thead>
      <tbody>${INFRA.map(L => { const c = cell[L.id] || {}, tot = Object.values(c).reduce((a, b) => a + b, 0); return `<tr${S.layer === L.id ? ' class="sel"' : ""}><th scope="row"><button type="button" class="linkbtn iflayer c-${L.c}" data-iflayer="${L.id}" data-tip="${esc(L.desc)}">${icon(L.ic, 16)} ${esc(L.name)}</button></th>${NATIONS.map(n => { const v = c[n[0]] || 0, lv = v ? Math.min(5, 1 + Math.floor(v / mx * 5)) : 0; return `<td class="n hv${lv}">${v ? `<button type="button" class="linkbtn" data-ifln="${L.id}|${n[0]}" aria-label="${nf(v)} projects: ${esc(L.name)}, ${esc(n[1])}">${nf(v)}</button>` : `<span class="gapmark" aria-label="Gap: no public code found">–</span>`}</td>`; }).join("")}<td class="n"><b>${nf(tot)}</b></td></tr>`; }).join("")}</tbody></table></div>
      <p class="small muted">"UK government" is central government and its bodies, which mostly serve the whole UK or England and Wales. NHS bodies in this catalogue are English. Local government is counted in its nation.</p></div>
    ${detail}
    <div class="panel"><h2>Gaps</h2><p class="small">${nf(gaps.length)} layer and nation pairs with no public code found${gaps.length ? `, for example ${gaps.slice(0, 8).map(([l, n]) => `${esc(l)} in ${esc(n)}`).join("; ")}` : ""}. A gap here means no public code in the accounts this catalogue lists, not that the infrastructure doesn't exist.</p></div>
    <div class="panel" data-new="1"><h2>What this view needs, to go from bird's eye to full detail</h2><p class="muted small">What the view depends on, and how much of it the catalogue has today.</p>
      <div class="tbl-wrap"><table><caption class="sr-only">What the pan-UK view needs</caption><thead><tr><th scope="col">Needed</th><th scope="col">Today</th><th scope="col">Detail</th></tr></thead><tbody>${NEEDS.map(([n, s, d]) => `<tr><th scope="row">${esc(n)}</th><td><span class="rxbadge c-${s === "available" ? "green" : s === "partial" ? "yellow" : "red"}"><span>${esc(s === "available" ? "Available" : s === "partial" ? "Partial" : "Missing")}</span></span></td><td>${esc(d)}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>How the layers are built</h2><p class="small">Each layer is assembled from classifications shown elsewhere in the catalogue: <button type="button" class="linkbtn" data-ifgo="interop">data interoperability</button>, <button type="button" class="linkbtn" data-ifgo="registers">registers and authoritative sources</button>, <button type="button" class="linkbtn" data-ifgo="capability">capabilities</button> and <button type="button" class="linkbtn" data-ifgo="workflow">workflows</button>. Each comes from projects' own words, checked on samples, so the layers carry the same limits. The layer model was defined for this catalogue.</p></div>`;
  const v = vb("infra"), re = () => { infraRender(); };
  $$("[data-iflayer]", v).forEach(b => b.onclick = () => { Object.assign(S, {layer: S.layer === b.dataset.iflayer ? "" : b.dataset.iflayer, part: "", nation: "", org: "", n: 24}); re(); $(`[data-iflayer="${b.dataset.iflayer}"]`, vb("infra"))?.focus(); });
  $$("[data-ifln]", v).forEach(b => b.onclick = () => { const [l, n] = b.dataset.ifln.split("|"); Object.assign(S, {layer: l, part: "", nation: n, org: "", n: 24}); re(); $(".ifcrumbs", vb("infra"))?.scrollIntoView?.({block: "start"}); });
  $$("[data-ifpart]", v).forEach(b => b.onclick = () => { Object.assign(S, {part: S.part === b.dataset.ifpart ? "" : b.dataset.ifpart, org: "", n: 24}); re(); });
  $$("[data-ifpn]", v).forEach(b => b.onclick = () => { const [p, n] = b.dataset.ifpn.split("|"); Object.assign(S, {part: p, nation: n, org: "", n: 24}); re(); });
  $$("[data-iforg]", v).forEach(b => b.onclick = () => { S.org = S.org === b.dataset.iforg ? "" : b.dataset.iforg; S.n = 24; re(); });
  $$("[data-ifcrumb]", v).forEach(b => b.onclick = () => { Object.assign(S, crumbs[+b.dataset.ifcrumb][1]); re(); $(".ifcrumbs button, .ifcrumbs [aria-current]", vb("infra"))?.focus?.(); });
  $("#if-live").onchange = e => { S.live = e.target.checked; re(); $("#if-live").focus(); };
  $$("[data-ifgo]", v).forEach(b => b.onclick = () => go(b.dataset.ifgo));
  $("[data-ifmore]", v) && ($("[data-ifmore]", v).onclick = () => { S.n += 24; re(); });
}
RENDER.infra = infraRender;

/* ---------- data interoperability ---------- */
const IOQ = {layer: "", std: "", role: "", holder: "", live: false, q: "", n: 24};
function interopRender() {
  const S = IOQ, base = ALL.filter(x => IO.recs[x.key]);
  const L = base.filter(x => (!S.layer || ioStd(x).some(s => s.layer === S.layer)) && (S.std === "" || ioStd(x).some(s => s.i === +S.std)) && (S.role === "" || ioRole(x).some(r => r.i === +S.role)) && (!S.holder || holderOf(x) === S.holder) && (!S.live || live(x)) && (!S.q || x.q.includes(S.q.toLowerCase()))).sort(RX_SORT.recent[0]);
  const sN = svCount(base, x => ioStd(x).map(s => s.i)), rN = svCount(base, x => ioRole(x).map(r => r.i)), lN = svCount(base, x => [...new Set(ioStd(x).map(s => s.layer))]);
  const cross = IOR.map(r => { const c = {}; for (const x of base) if (ioRole(x).some(z => z.i === r.i)) c[holderOf(x)] = (c[holderOf(x)] || 0) + 1; return c; }), mx = Math.max(1, ...cross.flatMap(c => Object.values(c)));
  const none = IOS.filter(s => !sN[s.i]);
  vb("interop").innerHTML = `<section class="panel rxhero c-violet" data-new="1"><div class="rxh-row"><span class="rxtile xl c-violet" aria-hidden="true">${icon("i_link", 40)}</span><div class="rxh-main"><div class="eyebrow">Data infrastructure · interoperability</div><h2>Data interoperability</h2>
      <p class="rx-lede">Which projects help data work across organisations, and how: by sharing meaning (semantic), structure (syntax) or a way to exchange it (transport), and under which rules (organisational and legal). And which projects provide crosswalks, converters, validators, metadata generators, vocabularies, schemas and adapters.</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(base.length)}</b> projects</span><span>${icon("c_readme", 16)} <b>${nf(Object.keys(sN).length)}</b> standards found</span></p></div></div></section>
    <div class="panel"><h2>Layers</h2><p class="muted small">Based on the ${ext(IO.framework.split(": ")[1], "European Interoperability Framework")}, with its technical layer split into syntax and transport so semantic and syntactic interoperability can be compared.</p><div class="rxtopics" role="group" aria-label="Interoperability layers">${IOL.map(l => `<button type="button" class="rxtopic c-${IOL_HUE[l.id]}" data-iolayer="${l.id}" aria-pressed="${S.layer === l.id}" data-tip="${esc(l.desc)}"><span class="rxtile c-${IOL_HUE[l.id]}" aria-hidden="true">${icon(l.id === "semantic" ? "k_graph" : l.id === "syntax" ? "c_readme" : l.id === "transport" ? "i_plug" : l.id === "legal" ? "c_scale" : "i_users", 22)}</span><span class="rxt-l">${esc(l.name)}</span><span class="rxt-n">${nf(lN[l.id] || 0)}</span></button>`).join("")}</div></div>
    <div class="rxsplit"><div class="panel"><h2>Semantic: shared meaning</h2>${rxBars(IOS.filter(s => s.layer === "semantic" && sN[s.i]).sort((a, b) => sN[b.i] - sN[a.i]).map(s => ({label: s.name, n: sN[s.i], ic: "k_graph", c: "violet", btn: `data-iostd="${s.i}" aria-pressed="${S.std === String(s.i)}"`})), "Semantic standards by projects")}</div>
      <div class="panel"><h2>Syntax: shared structure</h2>${rxBars(IOS.filter(s => s.layer === "syntax" && sN[s.i]).sort((a, b) => sN[b.i] - sN[a.i]).map(s => ({label: s.name, n: sN[s.i], ic: "c_readme", c: "blue", btn: `data-iostd="${s.i}" aria-pressed="${S.std === String(s.i)}"`})), "Syntactic standards by projects")}</div></div>
    <div class="rxsplit"><div class="panel"><h2>Transport: shared exchange</h2>${rxBars(IOS.filter(s => s.layer === "transport" && sN[s.i]).sort((a, b) => sN[b.i] - sN[a.i]).map(s => ({label: s.name, n: sN[s.i], ic: "i_plug", c: "aqua", btn: `data-iostd="${s.i}" aria-pressed="${S.std === String(s.i)}"`})), "Transport standards by projects")}</div>
      <div class="panel"><h2>Organisational and legal</h2>${rxBars(IOS.filter(s => (s.layer === "organisational" || s.layer === "legal") && sN[s.i]).sort((a, b) => sN[b.i] - sN[a.i]).map(s => ({label: s.name, n: sN[s.i], ic: "c_scale", c: IOL_HUE[s.layer], btn: `data-iostd="${s.i}" aria-pressed="${S.std === String(s.i)}"`})), "Organisational and legal by projects")}</div></div>
    <div class="panel" data-new="1"><h2>What projects do for interoperability</h2><p class="muted small">Crosswalks, converters, validators, metadata generators and the rest, with who holds them. Select a number to list those projects.</p>
      <div class="tbl-wrap"><table class="svheat"><caption class="sr-only">Interoperability roles by who holds the code</caption><thead><tr><th scope="col">Role</th>${HOLDERS.map(h => `<th scope="col" class="n">${esc(h[1])}</th>`).join("")}<th scope="col" class="n">All</th></tr></thead><tbody>${IOR.map((r, i) => `<tr><th scope="row"><button type="button" class="linkbtn" data-iorole="${i}">${esc(r.name)}</button></th>${HOLDERS.map(h => { const c = cross[i][h[0]] || 0, lv = c ? Math.min(5, 1 + Math.floor(c / mx * 5)) : 0; return `<td class="n hv${lv}">${c ? `<button type="button" class="linkbtn" data-iocell="${i}|${h[0]}" aria-label="${nf(c)} projects: ${esc(r.name)}, ${esc(h[1])}">${nf(c)}</button>` : "0"}</td>`; }).join("")}<td class="n"><b>${nf(rN[i] || 0)}</b></td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>Projects</h2><div class="filters"><label for="io-q">Search<input type="search" id="io-q" value="${esc(S.q)}" placeholder="for example: SKOS, CSV, crosswalk"></label>
      <label for="io-role">Role<select id="io-role"><option value="">Any</option>${IOR.map(r => `<option value="${r.i}"${S.role === String(r.i) ? " selected" : ""}>${esc(r.name)}</option>`).join("")}</select></label>
      <label for="io-std">Standard<select id="io-std"><option value="">Any</option>${IOS.filter(s => sN[s.i]).map(s => `<option value="${s.i}"${S.std === String(s.i) ? " selected" : ""}>${esc(s.name)}</option>`).join("")}</select></label>
      <label for="io-hold">Who holds it<select id="io-hold"><option value="">Anyone</option>${HOLDERS.map(h => `<option value="${h[0]}"${S.holder === h[0] ? " selected" : ""}>${esc(h[1])}</option>`).join("")}</select></label>
      <label class="rxcheck" for="io-live"><input type="checkbox" id="io-live"${S.live ? " checked" : ""}> Being worked on or looked after</label><button class="btn" type="button" data-ioreset>Start again</button></div>
      <p class="count" aria-live="polite">${nf(L.length)} projects${S.layer ? " · " + esc(IOL.find(l => l.id === S.layer).name) + " layer" : ""}</p><div class="rxgrid">${L.slice(0, S.n).map(rxCard).join("")}</div>${L.length > S.n ? `<p><button class="btn" type="button" data-iomore>Show ${nf(Math.min(24, L.length - S.n))} more</button></p>` : ""}</div>
    <div class="panel"><h2>How these are found</h2><ul class="small"><li>From projects' own words. Checked on samples: ${IO.prec.rounds.map(r => `${esc(r[0].toLowerCase())} ${r[2]} of ${r[1]} right`).join("; ")} (${esc(IO.prec.judged_by)}).</li><li>${none.length ? `No project names ${none.map(s => esc(s.name)).join(", ")}. That is a finding about public code descriptions, not proof these standards aren't used.` : "Every standard listed is found."}</li><li>Only ${nf(rN[IOR.findIndex(r => r.id === "crosswalk")] || 0)} projects say they provide a crosswalk or mapping between identifiers or schemas, which is a gap for joining data across organisations.</li></ul></div>`;
  const v = vb("interop"), re = () => interopRender();
  $$("[data-iolayer]", v).forEach(b => b.onclick = () => { S.layer = S.layer === b.dataset.iolayer ? "" : b.dataset.iolayer; S.n = 24; re(); });
  $$("[data-iostd]", v).forEach(b => b.onclick = () => { S.std = S.std === b.dataset.iostd ? "" : b.dataset.iostd; S.n = 24; re(); $("#io-std").focus(); });
  $$("[data-iorole]", v).forEach(b => b.onclick = () => { S.role = b.dataset.iorole; S.holder = ""; S.n = 24; re(); $("#io-role").focus(); });
  $$("[data-iocell]", v).forEach(b => b.onclick = () => { const [r, h] = b.dataset.iocell.split("|"); Object.assign(S, {role: r, holder: h, n: 24}); re(); $("#io-role").focus(); });
  let tq; $("#io-q").oninput = e => { clearTimeout(tq); tq = setTimeout(() => { S.q = e.target.value; re(); $("#io-q").focus(); }, 250); };
  for (const [id, k] of [["role", "role"], ["std", "std"], ["hold", "holder"]]) $("#io-" + id).onchange = e => { S[k] = e.target.value; re(); $("#io-" + id).focus(); };
  $("#io-live").onchange = e => { S.live = e.target.checked; re(); $("#io-live").focus(); };
  $("[data-ioreset]", v).onclick = () => { Object.assign(S, {layer: "", std: "", role: "", holder: "", live: false, q: "", n: 24}); re(); };
  $("[data-iomore]", v) && ($("[data-iomore]", v).onclick = () => { S.n += 24; re(); });
}
RENDER.interop = interopRender;

/* ---------- registers and authoritative sources ---------- */
const RGQ = {kind: "", holder: "", live: false, n: 30};
function registersRender() {
  const S = RGQ, base = ALL.filter(x => RG.recs[x.key]), kN = svCount(base, x => rgOf(x).map(z => z.k.id));
  const L = base.filter(x => (!S.kind || rgOf(x).some(z => z.k.id === S.kind)) && (!S.holder || holderOf(x) === S.holder) && (!S.live || live(x))).sort(RX_SORT.recent[0]);
  const byOrg = svCount(L, x => x.org);
  vb("registers").innerHTML = `<section class="panel rxhero c-red" data-new="1"><div class="rxh-row"><span class="rxtile xl c-red" aria-hidden="true">${icon("i_text", 40)}</span><div class="rxh-main"><div class="eyebrow">Data infrastructure · registers</div><h2>Registers and authoritative sources</h2>
      <p class="rx-lede">Projects that keep a public, statutory, regulatory or other legal register, or that are the authoritative source of some content, data or knowledge: the master copies other services rely on.</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(base.length)}</b> projects</span><span>${icon("i_building", 16)} <b>${nf(new Set(base.map(x => x.org)).size)}</b> GitHub accounts</span><span>${icon("s_active", 16)} <b>${nf(base.filter(live).length)}</b> being worked on or looked after</span></p></div></div></section>
    <div class="panel"><h2>Kinds</h2><p class="muted small">Select a kind to list its projects. Select it again to clear it.</p><div class="lgtiles">${RGK.map((k, i) => `<button type="button" class="lgtile c-${RG_HUE[i]}" data-rgkind="${k.id}" aria-pressed="${S.kind === k.id}" data-tip="${esc(k.desc)}"><span class="rxtile c-${RG_HUE[i]}" aria-hidden="true">${icon(["c_scale", "c_shield", "i_text", "k_data", "i_open", "c_owner", "l_govuk"][i] || "i_text", 20)}</span><span class="lgt-l">${esc(k.name)}</span><span class="lgt-n">${nf(kN[k.id] || 0)}</span><span class="lgt-s">${esc(k.desc)}</span></button>`).join("")}</div></div>
    <div class="rxsplit"><div class="panel"><h2>Who keeps them</h2>${rxBars(HOLDERS.map(h => ({label: h[1], n: L.filter(x => holderOf(x) === h[0]).length, ic: h[3], c: h[2], btn: `data-rghold="${h[0]}" aria-pressed="${S.holder === h[0]}"`})).filter(r => r.n), "Registers by who holds the code")}</div>
      <div class="panel"><h2>Organisations</h2>${rxBars(Object.entries(byOrg).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([o, n], i) => ({label: orgName(o), n, ic: "i_building", c: SV_HUE[i % 8]})), "Organisations with most register projects")}</div></div>
    <div class="panel"><h2>Projects <span class="muted">(${nf(L.length)})</span></h2><div class="filters"><label for="rg-hold">Who holds it<select id="rg-hold"><option value="">Anyone</option>${HOLDERS.map(h => `<option value="${h[0]}"${S.holder === h[0] ? " selected" : ""}>${esc(h[1])}</option>`).join("")}</select></label><label class="rxcheck" for="rg-live"><input type="checkbox" id="rg-live"${S.live ? " checked" : ""}> Being worked on or looked after</label></div>
      <div class="tbl-wrap"><table><caption class="sr-only">Register and authoritative source projects</caption><thead><tr><th scope="col">Project</th><th scope="col">Publisher</th><th scope="col">Status</th><th scope="col">Kind, and why</th></tr></thead><tbody>${L.slice(0, S.n).map(x => `<tr><td class="repo"><button type="button" class="linkbtn" data-rx="${esc(x.key)}">${esc(rxNm(x))}</button><br><small class="mono">${esc(x.key)}</small></td><td>${esc(orgName(x.org))}</td><td>${rxBadge(rxStat(x))}</td><td><ul class="lgev">${rgOf(x).map(z => `<li><span class="rxbadge c-${RG_HUE[z.k.i]}"><span>${esc(z.k.name)}</span></span> <span class="muted small">“${esc(z.ev)}”</span></li>`).join("")}</ul></td></tr>`).join("")}</tbody></table></div>${L.length > S.n ? `<p><button class="btn" type="button" data-rgmore>Show ${nf(Math.min(30, L.length - S.n))} more</button></p>` : ""}</div>
    <div class="panel"><h2>How these are found</h2><ul class="small"><li>From projects' own words. Checked on samples: ${RG.prec.rounds.map(r => `${r[2]} of ${r[1]} right`).join("; ")} (${esc(RG.prec.judged_by)}). ${esc(RG.prec.rounds[0][3])}</li><li>Whether a register is statutory in law is assessed from how the project describes it, not checked against legislation.</li><li>A project that uses a register's data is not counted: only projects that say they keep, publish or serve it.</li></ul></div>`;
  const v = vb("registers"), re = () => registersRender();
  $$("[data-rgkind]", v).forEach(b => b.onclick = () => { S.kind = S.kind === b.dataset.rgkind ? "" : b.dataset.rgkind; S.n = 30; re(); $(`[data-rgkind="${b.dataset.rgkind}"]`, vb("registers"))?.focus(); });
  $$("[data-rghold]", v).forEach(b => b.onclick = () => { S.holder = S.holder === b.dataset.rghold ? "" : b.dataset.rghold; re(); $("#rg-hold").focus(); });
  $("#rg-hold").onchange = e => { S.holder = e.target.value; re(); $("#rg-hold").focus(); }; $("#rg-live").onchange = e => { S.live = e.target.checked; re(); $("#rg-live").focus(); };
  $("[data-rgmore]", v) && ($("[data-rgmore]", v).onclick = () => { S.n += 30; re(); });
}
RENDER.registers = registersRender;
