<script>
const DATA = /*__DATA__*/null;
document.documentElement.lang = "en-GB";
const $ = (s, el=document) => el.querySelector(s), $$ = (s, el=document) => [...el.querySelectorAll(s)];
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const nf = n => (typeof n === "number" ? n : Number(n) || 0).toLocaleString("en-GB");
const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
/* GOV.UK dates: "8 October 2026"; short form "8 Oct 2026" for tables */
function fmtD(v, short=false) {
  if (v === null || v === undefined || v === "" || v === 0) return "—";
  const d = typeof v === "number" ? new Date(v * 1000) : new Date(String(v).length === 10 ? v + "T00:00:00Z" : v);
  if (isNaN(d)) return "—";
  const m = MONTHS[d.getUTCMonth()]; return `${d.getUTCDate()} ${short ? m.slice(0, 3) : m} ${d.getUTCFullYear()}`;
}
const REF = new Date(DATA.meta.ref_date + "T00:00:00Z"), REFD = fmtD(DATA.meta.ref_date), XREF_EPOCH = DATA.meta.xref_epoch, DAY = 864e5;

/* destination groups: keys are the data's values; labels are plain English */
const GROUPS = [
  ["1 Migrate — wave 1 (shared dependencies)", "Wave 1: shared dependencies", "--w1"], ["2 Migrate — wave 2", "Wave 2: active products", "--w2"],
  ["3 Migrate — wave 3", "Wave 3: low-activity keepers", "--w3"], ["4 Owner decision (gds-dtx / alphagov / keep)", "Owner decision (gds-dtx, alphagov or keep)", "--dec"],
  ["5 Consolidate into existing repo", "Consolidate into another repository", "--cons"], ["6 Leave archived", "Already archived", "--keep"],
  ["7 Archive in place", "Archive in place", "--arch"], ["8 Delete (empty or unmodified fork)", "Delete (empty or unmodified fork)", "--del"]];
const GKEYS = new Set(GROUPS.map(g => g[0]));
const GLABEL = Object.fromEntries(GROUPS.map(g => [g[0], g[1]])), GCOL = Object.fromEntries(GROUPS.map(g => [g[0], g[2]]));
const STATUSES = ["Active","Maintained","Dormant","Inactive","Archived","Empty"];
const XSTATUSES = ["Active","Maintained","Automated only","Dormant","Inactive","Archived","Empty","Unverified"];
const CODE_KINDS = ["uses","pkg","pages","oidc","team","hardorg"];
const KIND_LABEL = {uses:"Reusable workflow or action (uses:)",pkg:"Package, module or raw file source",pages:"co-cddo.github.io address",oidc:"OIDC trust (repo:co-cddo/…)",team:"@co-cddo/ team",hardorg:"Hard-coded organisation name",other:"Other mention",link:"Documentation link",domain:"cddo web domain"};
const KIND_DASH = {uses:"", pkg:"7 4", pages:"2 3", oidc:"10 3 2 3", team:"1 4", hardorg:"1 4"};
const STRAT = Object.fromEntries(DATA.strategy.map(s => [s.id, s]));
const RULES = DATA.gdsway_rules, RULE = Object.fromEntries(RULES.map(r => [r.id, r]));
const PREC = DATA.precision || {};
const precInfo = t => { const p = PREC[t]; if (!p || !p.n) return {txt: "precision not measured", cand: false, p: null};
  const pc = Math.round(100 * p.precision); return {txt: `precision ${pc}% (${p.tp} of ${p.tp + p.fp} judged correct${p.unsure ? ", " + p.unsure + " unsure" : ""})`, cand: p.precision < .7, p: p.precision}; };
const stCls = s => "st-" + String(s).split(" ")[0];
const pill = s => `<span class="pill ${stCls(s)}">${esc(s)}</span>`;

/* ---------- co-cddo rows (status comes from the build; one model everywhere) ---------- */
const rows = DATA.rows, byName = Object.fromEntries(rows.map(r => [r.repo, r]));
for (const r of rows) {
  r.days = r.last_human_commit ? Math.round((REF - new Date(r.last_human_commit + "T00:00:00Z")) / DAY) : null;
  r.breaking = CODE_KINDS.reduce((a, k) => a + (r["ref_" + k] || 0), 0);
  r.gwFail = Object.values(r.gdsway).filter(v => v[0] === "fail").length;
  r.gwMustFail = Object.entries(r.gdsway).filter(([k, v]) => v[0] === "fail" && RULE[k]?.strength === "MUST").length;
  r.flags = [];
  if (r.inbound_code_refs) r.flags.push([`${r.inbound_code_refs} depend on it`, "dep"]);
  if (r.ref_uses) r.flags.push(["calls co-cddo workflows", "risk"]);
  if (r.pages) r.flags.push([r.pages_custom ? "Pages: " + r.pages_custom : "Pages site", "pg"]);
  if (r.ref_oidc) r.flags.push(["OIDC trust", "risk"]);
  if (r.ref_pkg) r.flags.push(["package sources", "risk"]);
  if (r.ref_hardorg) r.flags.push(["hard-coded organisation", "risk"]);
  if (r.cname) r.flags.push(["CNAME file", "risk"]);
  if (r.fork_parent) r.flags.push(["fork", ""]);
  r.search = [r.repo, r.description, r.readme_summary, r.inferred_team, r.top_contributors_12m, r.top_contributors_all, r.codeowners, r.capability, r.theme, r.topics, r.language, r.kind, Object.keys(r.tags).join(" "), r.standards.join(" "), r.dam || ""].join(" ").toLowerCase();
}

/* ---------- government rows: compact arrays decoded by the field list shipped with the data ---------- */
const XO = DATA.xorgs, XF = DATA.xf, LICN = {M:"MIT",O:"OGL",A:"Apache-2.0",G:"GPL family",P:"MPL-2.0",U:"Unlicense",B:"BSD",C:"Creative Commons",X:"other","-":"none found"};
const X = DATA.xrows.map(a => { const o = {}; XF.forEach((k, i) => o[k] = a[i]); const org = XO[o.oi]; o.org = org.org; o.sector = org.sector;
  o.tags = o.g ? o.g.split(",") : []; o.stds = o.s ? o.s.split("|") : []; o.ev = Object.fromEntries((o.ge || "").split(";").filter(Boolean).map(p => { const i = p.indexOf(":"); return [p.slice(0, i), p.slice(i + 1)]; }));
  o.key = o.org + "/" + o.n; o.desc = o.d || o.ld || ""; o.q = (o.key + " " + o.d + " " + o.ld + " " + o.t + " " + o.l + " " + o.g + " " + o.s + " " + o.dam).toLowerCase();
  o.hy = o.h ? {lic: LICN[o.h[0]] || "other", codeowners: !!o.h[1], dependabot: !!o.h[2], security: !!o.h[3], workflows: o.h[4], third: o.h[5], unpinned: o.h[6], noperm: o.h[7], wf_read: o.h[8], readme: !!o.h[9], contributing: !!o.h[10]} : null; return o; });
/* ---------- asset catalogue: catalogue-only records and v1 names that are not publicly visible ---------- */
const LICS = {M:"MIT",O:"OGL",A:"Apache-2.0",G:"GPL family",P:"MPL-2.0",U:"Unlicense",B:"BSD",C:"Creative Commons",X:"Other","-":"None detected","":"Not in the scraper"};
const BODIES = DATA.bodies || [];
for (const o of X) { o.basis = "git"; if (o.li === undefined) o.li = ""; }
const CATX = (DATA.cat || []).map(a => { const o = {}; DATA.cf.forEach((k, i) => o[k] = a[i]); const org = XO[o.oi]; o.org = org.org; o.sector = org.sector;
  o.tags = o.g ? o.g.split(",") : []; o.stds = o.s ? o.s.split("|") : []; o.ev = Object.fromEntries((o.ge || "").split(";").filter(Boolean).map(p => { const i = p.indexOf(":"); return [p.slice(0, i), p.slice(i + 1)]; }));
  Object.assign(o, {key: o.org + "/" + o.n, desc: o.d || "", ld: "", t: "", pg: 0, pu: "", cd: "", h: 0, hy: null, a12: null, b: "", nw: 0, lc: o.pd, catOnly: true});
  o.q = (o.key + " " + o.d + " " + o.l + " " + o.g + " " + o.s + " " + o.dam).toLowerCase(); return o; });
const COI = XO.findIndex(o => o.org === "co-cddo");
const UNL = (DATA.unlisted || []).map(u => ({org: "co-cddo", oi: COI, n: u.name, key: "co-cddo/" + u.name, st: "Not publicly visible", basis: "git asks for sign-in", d: u.description || "", desc: u.description || "", ld: "", t: "", l: "",
  tags: [], stds: [], ev: {}, dam: "", sector: XO[COI]?.sector || "", li: "", sg: null, fk: null, pd: 0, cr: 0, lh: 0, c90: 0, c12: 0, pg: 0, pu: "", h: 0, hy: null, unlisted: u, q: ("co-cddo/" + u.name + " " + (u.description || "")).toLowerCase()}));
const ALL = X.concat(CATX, UNL);
const XBY = Object.fromEntries(ALL.map(x => [x.key, x]));
/* repositories GitHub no longer lists publicly (check against GitHub, 1 November 2026): kept, marked, and left out of live counts */
const GONE = new Set(((DATA.ghverify || {}).accounts || []).flatMap(a => a.removed.filter(n => !(DATA.ghverify.renamed || {})[a.account + "/" + n]).map(n => (a.account + "/" + n).toLowerCase())));
ALL.forEach(x => { if (GONE.has(x.key.toLowerCase())) x.gone = true; });
const bodyOf = x => { const i = XO[x.oi]?.body; return i >= 0 ? BODIES[i] : null; };
const lastAct = x => x.basis === "git" || String(x.basis).startsWith("git") ? (x.lh || 0) : (x.pd || 0);
const CSTAT = ["Active","Maintained","Recently pushed","Automated only","Dormant","Inactive","Archived","Empty","Unverified","Not publicly visible"];
const CTL_SHORT = ["Classification","Ownership","Admins","CODEOWNERS","README and support","Licence","Security alerts","CI health","Secrets","Branch protection","Pages and domains","Activity","Archive notice","Mirrors and packages"];
const ckS = s => `<span class="gw ${s === "n/a" ? "na" : s === "unknown" ? "na" : esc(s)}">${s === "n/a" ? "not applicable" : esc(s)}</span>`;
const EVBY = Object.fromEntries((DATA.v1?.evidence || []).map(e => [e.id, e]));
const isLive = x => x.st === "Active" || x.st === "Maintained";
const XLIVE = X.filter(isLive);
const SECTORS = [...new Set(XO.map(o => o.sector))].sort();

/* ---------- shared decisions: validated on read (D2), never trusted ---------- */
const decisions = {}; let decRejected = 0;
let db = null, userCap = null, myId = null, canWrite = null, readOnly = false, profiles = {}, sampleFn = null, dl = null, unsub = null, resubTries = 0;
const DEC_STATES = ["agreed","changed","discuss"];
const DEC_LABEL = {none:"Not yet reviewed", agreed:"Agreed", changed:"Changed", discuss:"Needs discussion"};
function validDecision(id, v) {
  if (!byName[id] || !v || typeof v !== "object" || Array.isArray(v)) return null;
  if (!DEC_STATES.includes(v.state)) return null;
  if (v.state === "changed" && !GKEYS.has(v.group)) return null;
  if (v.repo !== undefined && v.repo !== id) return null;
  const at = typeof v.at === "string" && v.at.length <= 40 && !isNaN(Date.parse(v.at)) ? v.at : null;
  return {repo: id, state: v.state, group: v.state === "changed" ? v.group : null, note: typeof v.note === "string" ? v.note.slice(0, 2000) : "",
          by: typeof v.by === "string" && v.by.length <= 200 ? v.by : null, at, ai: v.ai === true, proposed: GKEYS.has(v.proposed) ? v.proposed : null};
}
const effGroup = r => decisions[r.repo]?.state === "changed" ? decisions[r.repo].group : r.destination_group;
const decState = r => decisions[r.repo]?.state || "none";
const moving = g => /^[123]/.test(g), movingOrDecide = g => /^[1234]/.test(g);

/* ---------- small helpers ---------- */
const toast = msg => { const t = $("#toast"); t.textContent = msg; t.hidden = false; clearTimeout(toast._t); toast._t = setTimeout(() => t.hidden = true, 3200); };
const sw = g => `<span class="sw" style="background:var(${GCOL[g] || "--line"})" aria-hidden="true"></span>`;
const dgroup = r => { const g = effGroup(r); return `<span class="dg">${sw(g)}${esc(GLABEL[g] || g)}</span>`; };
const decTag = r => { const s = decState(r); return `<span class="dec ${s}">${DEC_LABEL[s]}</span>`; };
const gwTag = v => `<span class="gw ${v[0] === "n/a" ? "na" : esc(v[0])}">${v[0] === "n/a" ? "not applicable" : esc(v[0])}</span>`;
const stratChips = tags => Object.keys(tags || {}).map(k => `<span class="chip str" title="${esc(STRAT[k]?.label)}: matched “${esc(tags[k])}”">${esc(k)}</span>`).join("");
const openBtn = (name, label) => `<button class="openb" type="button" data-open="${esc(name)}">${esc(label || name)}</button>`;
const xBtn = (key, label) => `<button class="openb" type="button" data-x="${esc(key)}">${esc(label || key)}</button>`;
/* T2 (threat model): addresses on shared hosting can be claimed by anyone once the original app is deleted, and plain http can be tampered with,
   so they are shown as text, never as links. The list comes from build/dama/security.py through DATA.sec so the two can't drift. */
const SEC_RISKY = (DATA.sec && DATA.sec.risky) || [];
const riskyUrl = u => { const m = /^(https?):\/\/([^/?#@]*@)?([^/?#:]+)/i.exec(String(u || "")); if (!m) return true; const h = m[3].toLowerCase(); return m[1].toLowerCase() === "http" || SEC_RISKY.some(r => h === r || h.endsWith("." + r)); };
const ext = (url, label) => riskyUrl(url) ? `<span class="nolink" tabindex="0" data-tip="Not linked: ${/^http:/i.test(String(url)) ? "this address isn't secure (http)" : "this is shared hosting, which anyone can take over once the original app is deleted"}. Copy it only if you trust it.">${esc(label)} <span class="faint small">(${esc(String(url).replace(/^https?:\/\//i, "").slice(0, 60))}, not linked)</span></span>` : `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(label)}<span class="sr-only"> (opens in a new tab)</span></a>`;
const ghUrl = key => "https://github.com/" + key.split("/").map(encodeURIComponent).join("/");
const safeUrl = u => /^https?:\/\//i.test(String(u || "")) ? String(u) : "";
function spark(vals, w=96, h=22) { const max = Math.max(1, ...vals), bw = w / vals.length;
  return `<svg class="spark" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" role="img" aria-label="${vals.reduce((a,b)=>a+b,0)} human commits in 24 months">` + vals.map((v, i) => `<rect x="${(i*bw+.5).toFixed(1)}" y="${v ? (h - Math.max(1.5, v/max*(h-2))).toFixed(1) : h-1}" width="${Math.max(1,bw-1).toFixed(1)}" height="${v ? Math.max(1.5, v/max*(h-2)).toFixed(1) : 1}" fill="${v ? "var(--accent)" : "var(--line)"}"/>`).join("") + `</svg>`; }
async function copy(text, statusEl) { try { await navigator.clipboard.writeText(text); toast("Copied"); } catch { if (statusEl) statusEl.textContent = "Copy isn't available here. Select the text and copy it."; } }
/* null-safe stable comparator */
function cmp(a, b) { const na = a === null || a === undefined || a === "", nb = b === null || b === undefined || b === ""; if (na || nb) return na === nb ? 0 : na ? -1 : 1;
  if (typeof a === "number" && typeof b === "number") return a - b; return String(a).localeCompare(String(b), "en-GB", {numeric: true}); }
/* pager moves focus to the results heading after a page change (D14) */
function pager(state, total, rerender, focusEl) { const pages = Math.max(1, Math.ceil(total / state.size)); if (state.page >= pages) state.page = pages - 1;
  const el = document.createElement("div"); el.className = "pager";
  el.innerHTML = `<button class="btn sm" type="button" ${state.page ? "" : "disabled"} data-p="-1">Previous page</button><span class="count">Page ${state.page + 1} of ${pages} · ${nf(total)} rows</span><button class="btn sm" type="button" ${state.page < pages - 1 ? "" : "disabled"} data-p="1">Next page</button>`;
  $$("button", el).forEach(b => b.addEventListener("click", () => { state.page += +b.dataset.p; rerender(); const f = typeof focusEl === "function" ? focusEl() : focusEl; if (f) { f.setAttribute("tabindex", "-1"); f.focus(); } })); return el; }
const kv = pairs => `<dl class="kv">${pairs.filter(p => p[1] !== undefined && p[1] !== null && p[1] !== "").map(([k, v]) => `<dt>${esc(k)}</dt><dd>${v}</dd>`).join("")}</dl>`;

/* ---------- navigation: real history entries, ignores non-view hashes (D4, D18) ---------- */
/* ---------- information architecture (v6): eight hubs, each for a set of audiences and questions, colour-coded, plain-English labels.
   View ids are unchanged from v5 so links, history and tests keep working. ---------- */
const HUBS = [
  {id:"home", label:"Home", c:"blue", icon:"home", blurb:"Start here. Pick the kind of work you do, or the question you have, and go straight to the answer.", who:"Everyone", tabs:[["home","Home"],["briefing","The briefing"],["guide","User guide"],["search","Search everything"],["discover","Explore repos"],["profile","Repo profile"]]},
  {id:"insights", label:"Insights and analytics", c:"red", icon:"chart", blurb:"Charts and dashboards for the whole catalogue. See the tools and suppliers behind public sector data work too.", who:"Anyone who needs the big picture: leaders, analysts, data and policy colleagues", tabs:[["insights","Analytics dashboard"],["ghcheck","Checked against GitHub"],["collab","Beyond GitHub: Slack"],["dama","Data management wheel"],["suppliers","Data tools and suppliers"],["legacy","Legacy and technical debt"],["gds","GDS responsibilities and connections"]]},
  {id:"topics", label:"Topics and priorities", c:"violet", icon:"topics", blurb:"Browse by policy area or government priority, not by technology.", who:"Policy, strategy, data and analysis colleagues", tabs:[["topics","Browse by topic"],["reuse","What government builds on"],["strategy","Government priorities"],["dam","Data and metadata management"],["standards","Data catalogues and standards"],["guidance","Guidance, policy and playbooks"],["journeys","Public service journeys"],["nations","Devolution and the UK's nations"],["international","International and partners"]]},
  {id:"services", label:"Public services", c:"red", icon:"t_socialcare", blurb:"Local services such as social care, and the steps behind them. Follow the code across councils, the NHS, charities and suppliers.", who:"Service owners, commissioners, architects and policy colleagues", tabs:[["local","Local public services"],["socialcare","Social care"],["capability","Capabilities"],["process","Processes"],["workflow","Workflows"]]},
  {id:"datainfra", label:"Data infrastructure", c:"blue", icon:"k_graph", blurb:"The UK's public data infrastructure as seen in public code: a pan-UK view from layers down to projects, data interoperability, and the registers and authoritative sources others rely on.", who:"Data leaders, architects, standards and policy colleagues", tabs:[["infra","Pan-UK public data infrastructure"],["interop","Data interoperability"],["registers","Registers and authoritative sources"]]},
  {id:"orgs", label:"Organisations", c:"orange", icon:"orgs", blurb:"See any public body's code estate on one page, compare it with others and find peers doing similar work.", who:"Leaders of departments and arm's-length bodies, and anyone supporting them", tabs:[["orgs","Organisation profile"],["family","Department family tree"],["gdsx","GDS estate explorer"],["publishers","All organisations"],["landscape","Recent work across government"],["strategic","Strategic authorities"]]},
  {id:"find", label:"Find code", c:"aqua", icon:"find", blurb:"Search every public code project before you build something new. Find its APIs, data and websites too.", who:"Service, product and engineering teams; spend controls", tabs:[["catalogue","Search all code projects"],["apis","API catalogue"],["opendata","Open data pipelines"],["pages","Websites published from GitHub"]]},
  {id:"practice", label:"Good practice", c:"green", icon:"practice", blurb:"How well public code is looked after: how it is built, tested, run, kept safe and written up.", who:"Security, assurance and engineering leads", tabs:[["practice","How well code is looked after"],["practice2","Practice across disciplines"]]},
  {id:"move", label:"co-cddo move", c:"magenta", icon:"move", blurb:"The workspace for a proposed move of repositories out of the co-cddo GitHub organisation. The approach and every destination are proposals: nothing has been confirmed.", who:"Repository owners and the migration lead", tabs:[["start","Migration in short"],["overview","Migration overview"],["repos","Repositories to move"],["reconcile","Names checked against the v1 workbook"],["assess","Assessment scores"],["controls","Assurance controls"],["lineage","How the repositories connect"],["safe","Moving safely"],["plan","Plan and waves"],["gdsway","GDS Way checks"],["evidence","Evidence and actions"]]},
  {id:"ask", label:"Ask AI", c:"yellow", icon:"ask", blurb:"Ask a question in your own words. Answers come from this catalogue's data, and show which tools were used.", who:"Anyone", tabs:[["ask","Ask a question"],["ai","How AI is used here"]]},
  {id:"about", label:"About", c:"slate", icon:"about", blurb:"A plain English guide, how this site was made and checked, problems found and fixed, and how well it works for everyone.", who:"Anyone checking the evidence", tabs:[["glossary","Plain-English guide"],["knowledge","Knowledge layer"],["service","Service design"],["govukos","govukOS connections"],["design","How this portal is designed"],["docs","Documents"],["trace","How requirements are checked"],["defects","Defects and releases"],["about","Method and checks"],["a11y","Accessibility"]]},
];
const NAV = HUBS.map(h => [h.label, h.tabs]);
const TABS = NAV.flatMap(g => g[1].map(t => t[0])), TITLE = Object.fromEntries(NAV.flatMap(g => g[1]));
const HUB_OF = Object.fromEntries(HUBS.flatMap(h => h.tabs.map(t => [t[0], h])));
const ICONS = {
  home:'<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  topics:'<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="4"/><rect x="3" y="13" width="8" height="8" rx="4"/><rect x="13" y="13" width="8" height="8" rx="2"/>',
  orgs:'<path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-5h6v5M8 11h2M14 11h2"/>',
  find:'<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>',
  practice:'<path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  move:'<path d="M4 7h11M11 3l4 4-4 4"/><path d="M20 17H9M13 13l-4 4 4 4"/>',
  ask:'<path d="M4 5h16v11H9l-5 4z"/><path d="M10 9.5a2 2 0 1 1 2.5 1.9c-.4.2-.5.5-.5.9v.3M12 14.5v.1"/>',
  about:'<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.1"/>',
  chart:'<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  wheel:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3v5.5M12 15.5V21M3 12h5.5M15.5 12H21M5.6 5.6l3.9 3.9M14.5 14.5l3.9 3.9M18.4 5.6l-3.9 3.9M9.5 14.5l-3.9 3.9"/>',
  menu:'<path d="M4 7h16M4 12h16M4 17h16"/>'};
const icon = (k, sz=22) => `<svg class="ico" width="${sz}" height="${sz}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${ICONS[k] || ICONS.about}</svg>`;
$("#main").innerHTML = TABS.map(t => `<section class="view" id="v-${t}" aria-labelledby="vh-${t}" hidden><h2 class="sr-only" id="vh-${t}">${esc(TITLE[t])}</h2><div class="vbody"></div></section>`).join("");
const vb = t => $(`#v-${t} .vbody`);
$("#rail").innerHTML = `<ul class="hubs">${HUBS.map(h => `<li class="hub"><button type="button" class="hubb c-${h.c}" data-hub="${h.id}">${icon(h.icon, 20)}<span>${esc(h.label)}</span></button></li>`).join("")}<li class="more" hidden><button type="button" class="hubb c-slate" id="more-b" aria-expanded="false" aria-controls="more-list">${icon("menu", 20)}<span>More</span></button><ul id="more-list" class="more-list" hidden></ul></li></ul>` +
  HUBS.map(h => `<div class="grp sub c-${h.c}" role="group" aria-label="${esc(h.label)}: sections" data-subof="${h.id}" hidden>${h.tabs.length > 1 ? `<span class="gl">${esc(h.label)}</span>` : ""}${h.tabs.map(([id, l]) => `<button type="button" data-tab="${id}">${esc(l)}</button>`).join("")}</div>`).join("");
const VIEW_SUM = {
  briefing:"Public sector code on GitHub on one screen, for leaders: what there is, what changed, where the risks are and where reuse is paying off.", reuse:"Parts made in government that other public projects use. See who makes each one and how many others use it.", collab:"Which projects come up in the UK Government Digital and GDS Slack workspaces, where, and what about: incidents, releases, security, migrations, questions and dependencies.", ghcheck:"Every GitHub account in the catalogue read directly from GitHub and compared with the catalogue: what was added, renamed, moved or removed, and an estimate of which GitHub features projects switch on.", infra:"The UK's public data infrastructure, by layer and by nation. Start with the whole picture, then go down to single projects. See the gaps too.", interop:"How well data can be shared and understood between bodies. Find the projects that map, convert and check data, and that describe it.", registers:"Projects that keep an official register, or hold the master copy of some data that others rely on.",
  local:"Local public services and whose code runs them: councils, central government, the NHS, the voluntary sector and the suppliers named in the code.", socialcare:"Social care for adults and children. See the code used by councils, the NHS, charities and central government, and the journeys it helps.", capability:"What each project does for a service, such as sign-in, payments or case management, and who holds it.", process:"Where in a service each project helps, in the order people meet it.", workflow:"How work moves through the code: pipelines, process engines, orchestration, automation and queues.", strategic:"England's strategic authorities, mayoral and foundation, and the councils inside them that publish code.",
  guidance:"Projects that hold or support guidance, policy, playbooks, manuals and standards.",
  journeys:"Public service journeys, life events and work that runs across government.",
  nations:"Work for the UK's four nations and the islands linked to the UK. Includes work by devolved governments.",
  international:"Work with other countries and with international bodies. UK allies and partners are marked.",
  service:"Who this catalogue is for and what they need to do. Each need links to the pages and tests that meet it.",
  knowledge:"How the catalogue's facts, words and sources link up. Includes the word lists and the data dictionary.",
  search:"Search everything in one place: projects, organisations, topics, tools, words and pages.",
  govukos:"How this catalogue links to GTI, ANA, LIAH and the other govukOS apps: what each holds, the shared key, what is in the way, and feeds they can read.",
  legacy:"Public code that uses old technology, is about old systems, or has gone quiet. See how each one was found.",
  discover:"Every public code project explained in plain English: browse by topic, search in everyday words, and open any project for its story.",
  profile:"One project in plain English: what it does, whether it is still worked on, who it belongs to, where each fact came from and what it connects to.",
  family:"Each department and the bodies under it, down to where their code lives. See it as a picture or a tree.",
  home:"What this catalogue is, who it is for and where to start.",
  insights:"Interactive charts across every code project: filter once and every chart updates. Each chart has the numbers behind it.",
  dama:"Public sector code mapped to the DAMA data management wheel: select a slice, then a capability, to drill down to the repositories and the evidence for each.",
  gds:"What GDS looks after and the code it builds. See where others in the public sector build on it.",
  practice2:"Good practice in how code is built, tested, run, kept safe and written up. Compare sectors and organisations.",
  gdsx:"GDS's own repositories in alphagov, gds-dtx and its other accounts, seen from any point of view and crossed with any other.",
  apis:"Projects that offer or use an API, a way for systems to talk to each other. Checked against the government API catalogue.",
  opendata:"Projects that load or publish open data, on data.gov.uk or other data sites.",
  suppliers:"The data tools and suppliers that public code relies on. See how each one was found.", topics:"Public code grouped by policy area, found by matching words in names and descriptions.",
  strategy:"Live work tagged to Data Foundations, firmer foundations and other priorities, with how accurate each tag is.", dam:"Work that helps manage data well: data about data, data catalogues and lists of data held.",
  standards:"Which bodies run a data catalogue, who supplies it, and which standards they follow.",
  orgs:"One public body's code estate on a page: what it publishes, how active it is, how well it is looked after and who does similar work.",
  publishers:"Every public body with code on GitHub, and how much each publishes.", landscape:"Recently updated code across government, checked with git so activity means people, not bots.",
  catalogue:"Search and filter every public sector code project, then download the results.", pages:"Websites published straight from code projects, and the ones at risk of being taken over.",
  practice:"How often public code has a licence and a named owner. See if it says how to report a security problem, and if it updates itself.",
  start:"The proposed migration in six sentences. Nothing has been confirmed.", overview:"Where co-cddo's repositories are proposed to go, and the decisions recorded so far.", repos:"Every co-cddo project, where it might move to, its risks, and the decision.",
  reconcile:"How the v1 workbook's names match the repositories as they are now.", assess:"The v1 scoring model, re-run with observed evidence.", controls:"Fourteen checks that each project is in a safe state to move.",
  lineage:"Which repositories depend on which, as a family tree, a line map and a list.", safe:"GitHub's documented behaviour when repositories move, and what can break.", plan:"The order of moves, in waves.",
  gdsway:"Checks against the GDS Way, the engineering standard for GDS.", evidence:"Evidence and actions carried over from the v1 workbook.",
  ask:"Ask in your own words. Answers use this catalogue's data.", ai:"Every AI feature on this page, what it can see and how you stay in control.",
  glossary:"GitHub and catalogue words explained in plain English.", design:"How this site's layout, words and colours were tested and changed for people who don't code.",
  docs:"All the supporting documents: why this exists, user research, plans, specifications and word lists.", trace:"Each requirement and the checks that prove it.", defects:"Every defect found, its cause and its fix, and each release.", about:"How the data was collected, and every check.", a11y:"How well this site works for everyone, and how it was tested."};
/* ---------- left drawer: in-page navigation only, built from the current view's section headings (design canon) ---------- */
const NEW_IN = new Set(["guide", "service", "guidance", "journeys", "nations", "international", "knowledge", "search", "discover", "profile", "family", "legacy", "govukos"]);
const drawerOpen = () => { let v = null; try { v = localStorage.getItem("ghrac-drawer"); } catch {} return v === null ? (window.innerWidth || 0) >= 1180 : v === "1"; };
function setDrawer(open) { try { localStorage.setItem("ghrac-drawer", open ? "1" : "0"); } catch {} document.body.classList.toggle("drawer-on", open); $("#drawer").hidden = !open; const sw = $("#drawer-switch"); if (sw) sw.setAttribute("aria-checked", String(open)); }
function buildDrawer(t) {
  const hub = HUB_OF[t], v = $("#v-" + t), heads = $$(".vbody h2:not(.sr-only), .vbody h3.drawer-h", v).filter(h => !h.closest("[hidden]"));
  heads.forEach((h, i) => { if (!h.id) h.id = `dh-${t}-${i}`; });
  const groups = []; let cur = null;
  for (const h of heads) { if (h.tagName === "H2") { cur = {h, kids: []}; groups.push(cur); } else if (cur) cur.kids.push(h); else groups.push(cur = {h, kids: []}); }
  const cnt = h => { const c = h.closest("[data-count]")?.dataset.count ?? h.dataset.count; return c ? `<span class="dr-count">${esc(c)}</span>` : ""; };
  const isNew = h => h.closest("[data-new]") || h.dataset.new ? `<span class="dr-new">New</span>` : "";
  $("#drawer").innerHTML = `<div class="dr-head">${icon(hub.icon, 18)}<span><b>On this page</b><small>${esc(TITLE[t])}${NEW_IN.has(t) ? " · new in " + esc(DATA.version.split(".").slice(0, 2).join(".")) : ""}</small></span></div>
    <ul class="dr-list">${groups.map((g, i) => `<li><div class="dr-row">${g.kids.length ? `<button type="button" class="dr-tog" aria-expanded="true" aria-controls="drk-${i}"><span class="sr-only">Show or hide items under ${esc(g.h.textContent)}</span>▾</button>` : `<span class="dr-dot" aria-hidden="true"></span>`}<a href="#${g.h.id}" data-drh="${g.h.id}">${esc(g.h.textContent.trim().length > 64 ? g.h.textContent.trim().slice(0, 62) + "…" : g.h.textContent.trim())}</a>${cnt(g.h)}${isNew(g.h)}</div>${g.kids.length ? `<ul id="drk-${i}">${g.kids.map(k => `<li><a href="#${k.id}" data-drh="${k.id}">${esc(k.textContent.trim().slice(0, 60))}</a>${cnt(k)}</li>`).join("")}</ul>` : ""}</li>`).join("") || `<li class="muted small">This page has one section.</li>`}</ul>`;
  $$("[data-drh]", $("#drawer")).forEach(a => a.onclick = e => { e.preventDefault(); const h = document.getElementById(a.dataset.drh); if (h) { h.setAttribute("tabindex", "-1"); h.focus(); h.scrollIntoView?.({block: "start"}); } });
  $$(".dr-tog", $("#drawer")).forEach(b => b.onclick = () => { const open = b.getAttribute("aria-expanded") !== "true"; b.setAttribute("aria-expanded", String(open)); document.getElementById(b.getAttribute("aria-controls")).hidden = !open; });
  const sw = $("#drawer-switch"); if (sw) sw.onclick = () => setDrawer(sw.getAttribute("aria-checked") !== "true");
  setDrawer(drawerOpen());
}
/* ---------- global bar never wider than the screen: hubs that don't fit fold into a More menu ---------- */
function foldCount(widths, avail, moreW, gap = 6) { let used = 0, n = 0; const total = widths.reduce((a, b) => a + b + gap, 0); if (total <= avail) return widths.length;
  for (const w of widths) { if (used + w + gap + moreW + gap > avail) break; used += w + gap; n++; } return Math.max(1, n); }
function fitHubs() {
  const ul = $("#rail .hubs"); if (!ul) return; const items = $$("li.hub", ul), more = $("li.more", ul); items.forEach(li => li.hidden = false); more.hidden = true;
  const avail = ul.clientWidth; if (!avail) return;
  const widths = items.map(li => li.getBoundingClientRect().width); const n = foldCount(widths, avail, 96);
  items.forEach((li, i) => li.hidden = i >= n); more.hidden = n >= items.length;
  $("#more-list").innerHTML = items.slice(n).map(li => `<li>${li.innerHTML}</li>`).join("");
  $$("#more-list [data-hub]").forEach(b => b.addEventListener("click", () => { $("#more-list").hidden = true; $("#more-b").setAttribute("aria-expanded", "false"); hubGo(b.dataset.hub); }));
  const cur = $("#more-list [aria-current]"); $("#more-b").classList.toggle("has-current", !!cur);
}
const SPOTWRAP = $("#spotwrap"); /* kept by reference: Home moves it under its content, and re-rendering Home must not lose it */
const RENDER = {}, rendered = new Set();
let current = null;
function showTab(t, how="push") {
  if (!TABS.includes(t)) t = "home";
  const hub = HUB_OF[t];
  for (const b of $$("#rail [data-tab]")) { if (b.dataset.tab === t) b.setAttribute("aria-current", "page"); else b.removeAttribute("aria-current"); }
  for (const b of $$("#rail [data-hub]")) { if (b.dataset.hub === hub.id) b.setAttribute("aria-current", "true"); else b.removeAttribute("aria-current"); }
  try { fitHubs(); } catch {}
  for (const g of $$("#rail [data-subof]")) g.hidden = g.dataset.subof !== hub.id || hub.tabs.length < 2;
  $("#hubband").className = "hubband c-" + hub.c;
  $("#hubband").innerHTML = `<div class="hb-icon">${icon(hub.icon, 30)}</div><div class="hb-text"><p class="hb-hub">${esc(hub.label)}${hub.tabs.length > 1 ? ` <span aria-hidden="true">›</span> <span>${esc(TITLE[t])}</span>` : ""}</p><p class="hb-sum">${esc(VIEW_SUM[t] || hub.blurb)}</p><p class="hb-who"><b>For:</b> ${esc(hub.who)}</p>${window.tourBtn ? window.tourBtn(t) : ""}</div>`;
  SPOTWRAP.hidden = t !== "home";
  for (const id of TABS) $("#v-" + id).hidden = id !== t;
  current = t;
  if (!rendered.has(t)) { RENDER[t]?.(); rendered.add(t); }
  try { buildDrawer(t); } catch {}
  document.title = TITLE[t] + " · GitHub Repos Asset Catalogue";
  try { if (how === "push" && location.hash !== "#" + t) history.pushState({t}, "", "#" + t); else if (how === "replace") history.replaceState({t}, "", "#" + t); } catch {}
  try { localStorage.setItem("ghrac-tab6", t); } catch {}
}
function go(t) { showTab(t); $("#main").focus({preventScroll: false}); }
$$("#rail [data-tab]").forEach(b => b.addEventListener("click", () => go(b.dataset.tab)));
function hubGo(id) { const h = HUBS.find(x => x.id === id); go(h.tabs.some(t => t[0] === current) ? current : h.tabs[0][0]); }
$$("#rail .hub [data-hub]").forEach(b => b.addEventListener("click", () => hubGo(b.dataset.hub)));
$("#more-b").addEventListener("click", () => { const l = $("#more-list"); l.hidden = !l.hidden; $("#more-b").setAttribute("aria-expanded", String(!l.hidden)); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !$("#more-list").hidden) { $("#more-list").hidden = true; $("#more-b").setAttribute("aria-expanded", "false"); $("#more-b").focus(); } });
try { new ResizeObserver(() => fitHubs()).observe($("#rail")); } catch { window.addEventListener("resize", fitHubs); }
document.addEventListener("click", e => { const g = e.target.closest("[data-go]"); if (g && TABS.includes(g.dataset.go)) { e.preventDefault(); if (!$("#sheet").hidden) closeSheet(false); go(g.dataset.go); } });
$("#skip").addEventListener("click", e => { e.preventDefault(); $("#main").focus(); $("#main").scrollIntoView(); });
window.addEventListener("popstate", () => { const h = location.hash.slice(1); if (typeof osRoute === "function" && osRoute(h)) return; if (TABS.includes(h)) showTab(h, "none"); });
window.addEventListener("hashchange", () => { const h = location.hash.slice(1); if (typeof osRoute === "function" && osRoute(h)) return; if (TABS.includes(h) && h !== current) showTab(h, "none"); });
/* invalidate everything that depends on decisions (D5) */
function invalidateAll() {
  rendered.clear();
  if (current === "repos" && $("#repo-table")) { rendered.add("repos"); renderTable(); }
  else if (current) { const keep = document.activeElement?.id; RENDER[current]?.(); rendered.add(current); if (keep && $("#" + keep)) $("#" + keep).focus(); }
  if (openRepo) renderDecisionBox(byName[openRepo], true);
}

/* ---------- theme ---------- */
(() => { const sel = $("#theme"); let t = ""; try { t = localStorage.getItem("cddo-theme") || ""; } catch {}
  const apply = v => { if (v) document.documentElement.setAttribute("data-theme", v); else document.documentElement.removeAttribute("data-theme"); };
  sel.value = t; apply(t); sel.onchange = () => { apply(sel.value); try { localStorage.setItem("cddo-theme", sel.value); } catch {} }; })();

/* ---------- spotlight (score disclosed, D11) ---------- */
function renderSpot() {
  const S = DATA.spotlight;
  $("#spot").innerHTML = S.map((s, i) => { const key = s.o + "/" + s.n, org = XO.find(o => o.org === s.o);
    return `<article class="card" aria-labelledby="spc-${i}">
    <div class="eyebrow">${esc(s.o)} · ${esc(org?.sector || "")}</div><h3 id="spc-${i}">${ext(ghUrl(key), s.n)}</h3>
    <p style="font-size:14px">${esc(s.d || "No description on GitHub.")}</p>
    <ul>${s.why.map(w => `<li>${esc(w)}</li>`).join("")}</ul>
    <div class="chips">${s.tags.map(t => `<span class="chip ${t === "DAM" ? "dam" : "str"}">${esc(t)}</span>`).join("")}${safeUrl(s.pg) ? ext(s.pg, "Pages site") : ""}</div>
    <p class="score">Score ${s.score} = new ${s.parts.new} + DAM ${s.parts.dam} + tags ${s.parts.tags} + activity ${s.parts.activity} + Pages ${s.parts.pages}</p>
    <button class="btn sm" type="button" data-x="${esc(key)}">Details<span class="sr-only"> for ${esc(key)}</span></button></article>`; }).join("") || `<p class="muted">No repositories met the spotlight rule.</p>`;
  $("#spot-rule").textContent = `Card ${S.length ? "1–" + S.length : "0"}. Picked by a declared rule, then ranked by score: a person committed in the last 90 days; tagged to Data Foundations, firmer foundations or DAM and metadata, using only tags whose measured precision is 70% or more; outside co-cddo; not a backup, test, sandbox, demo, proof of concept or template; at most two per organisation. Score: 3 if the first commit was in the last 12 months, 2 for DAM, 1 per tag, up to 2 for activity (commits in 90 days ÷ 15, capped at 30 commits), 0.5 for a Pages site. Tags are leads, not owner-confirmed.`;
  bindX($("#spot"));
  const tr = $("#spot"), step = () => tr.clientWidth * .9, rm = () => matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
  $("#sp-prev").onclick = () => tr.scrollBy({left: -step(), behavior: rm()});
  $("#sp-next").onclick = () => { if (tr.scrollLeft + tr.clientWidth >= tr.scrollWidth - 4) tr.scrollTo({left: 0}); else tr.scrollBy({left: step(), behavior: rm()}); };
  let timer = null; const play = $("#sp-play");
  play.onclick = () => { if (timer) { clearInterval(timer); timer = null; play.setAttribute("aria-pressed", "false"); play.textContent = "Play"; } else { timer = setInterval(() => $("#sp-next").click(), 6000); play.setAttribute("aria-pressed", "true"); play.textContent = "Pause"; } };
  tr.addEventListener("focusin", () => { if (timer) play.click(); });
  tr.addEventListener("pointerenter", () => { if (timer) play.click(); });
}

/* ---------- START HERE ---------- */
RENDER.start = () => {
  const act = rows.filter(r => r.status === "Active").length, mig = rows.filter(r => moving(effGroup(r))).length, hubs = rows.filter(r => r.inbound_code_refs > 0 && !r.archived).length;
  vb("start").innerHTML = `
  <div class="panel"><h2>In short</h2><ul style="margin:.5em 0 0;padding-left:20px;display:grid;gap:4px;max-width:80ch">
    <li>co-cddo has <b>${rows.length}</b> public repositories. <b>${act}</b> had a person commit in the last 90 days. <b>${mig}</b> are proposed to move to gds-dtx.</li>
    <li><b>${hubs}</b> shared repositories are called by others, so they move first. Moving them in the wrong order breaks builds and deployments.</li>
    <li>Do not delete or rename the co-cddo organisation, and do not create repositories at the paths you vacate. Archive each repository after it moves, and archive the organisation only after the last move.</li>
    <li>The catalogue holds <b>${nf(ALL.length)}</b> records for public sector repositories from <b>${BODIES.length}</b> public bodies. The earlier v1 migration workbook is merged in: its owners, targets, evidence, actions, scores and assurance controls sit beside the observed facts.</li>
    <li>co-cddo's deprecation notice names <b>uk-gov-cyber</b> as well as gds-dtx. <b>${rows.filter(r => r.dest_org.includes("uk-gov-cyber")).length}</b> security repositories are offered uk-gov-cyber.</li>
    <li>Across government, <b>${nf(X.length)}</b> recently updated repositories in <b>${XO.filter(o => !o.deleted).length}</b> public sector organisations were checked with git. <b>${nf(XLIVE.length)}</b> are active or maintained.</li></ul></div>
  <h2>What do you need to do?</h2>
  <div class="grid3">${DATA.needs.map(([t, n, gotab, cta]) => `<div class="task"><h3>${esc(t)}</h3><p class="need">${esc(n)}</p><button class="btn primary" type="button" data-go="${esc(gotab)}">${esc(cta)}</button></div>`).join("")}</div>
  <div class="panel"><h2>Words used here</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Term</th><th scope="col">Meaning</th><th scope="col">Also called</th></tr></thead><tbody>${DATA.glossary.map(([k, v, a]) => `<tr><th scope="row" style="text-transform:none;letter-spacing:0;font:700 14px var(--f-body);color:var(--fg);white-space:normal">${esc(k)}</th><td>${esc(v)}</td><td class="muted">${esc(a)}</td></tr>`).join("")}</tbody></table></div></div>`;
};

/* ---------- OVERVIEW ---------- */
RENDER.overview = () => {
  const n = s => rows.filter(r => r.status === s).length, reviewed = rows.filter(r => decState(r) !== "none").length, N = rows.length;
  const counts = GROUPS.map(g => [g, rows.filter(r => effGroup(r) === g[0]).length]);
  const hubs = rows.filter(r => r.inbound_code_refs > 0 && !r.archived).sort((a, b) => b.inbound_code_refs - a.inbound_code_refs || a.repo.localeCompare(b.repo));
  const need = rows.filter(r => effGroup(r).startsWith("4") || decState(r) === "discuss");
  vb("overview").innerHTML = `
  <div class="stats">${[[N,"repositories in co-cddo"],[n("Active"),"active: a person committed in the last 90 days","hl"],[n("Maintained"),"maintained: within 12 months"],[rows.filter(r=>moving(effGroup(r))).length,"proposed to move to gds-dtx"],[rows.filter(r=>effGroup(r).startsWith("4")).length,"need an owner decision"],[rows.filter(r=>r.pages).length,"serve a live GitHub Pages site"],[rows.filter(r=>r.gwMustFail && movingOrDecide(effGroup(r))).length,"moving repositories missing a GDS Way MUST"],[db ? reviewed + " of " + N : "—", db ? "destinations reviewed" : "decisions need a signed-in view"]].map(([b,s,c]) => `<div class="stat ${c||""}"><b>${esc(b)}</b><span>${esc(s)}</span></div>`).join("")}</div>
  <div class="panel"><div class="panel-head"><h2>Where the ${N} repositories are proposed to go</h2><span class="muted">${db ? `${reviewed} reviewed · ${rows.filter(r=>decState(r)==="agreed").length} agreed · ${rows.filter(r=>decState(r)==="changed").length} changed · ${rows.filter(r=>decState(r)==="discuss").length} to discuss` : ""}</span></div>
    <div class="dbar" role="group" aria-label="Destination groups. Select one to list its repositories.">${counts.filter(c => c[1]).map(([g, c]) => `<button type="button" style="flex:${c};background:var(${g[2]})" aria-label="${esc(g[1])}: ${c} repositories" title="${esc(g[1])}: ${c}" data-g="${esc(g[0])}"></button>`).join("")}</div>
    <div class="legend">${counts.map(([g, c]) => `<button type="button" data-g="${esc(g[0])}"><span class="sw" style="background:var(${g[2]})"></span>${esc(g[1])} <b class="num">${c}</b></button>`).join("")}</div></div>
  <div class="grid2">
    <div class="panel"><div class="panel-head"><h2>Activity across co-cddo</h2><span class="muted">commits by people per month</span></div><div id="orgchart"></div></div>
    <div class="panel"><div class="panel-head"><h2>Activity by destination</h2></div><div class="tbl-wrap"><table class="matrix"><caption class="muted" style="font-weight:400">Select a number to list those repositories</caption>
      <thead><tr><th scope="col">Activity</th>${GROUPS.map(g => `<th scope="col" class="n">${sw(g[0])} ${esc(g[1].split(":")[0].replace(" (gds-dtx, alphagov or keep)", ""))}</th>`).join("")}<th class="n" scope="col">Total</th></tr></thead><tbody>
      ${STATUSES.map(s => `<tr><th scope="row">${pill(s)}</th>${GROUPS.map(g => { const c = rows.filter(r => r.status === s && effGroup(r) === g[0]).length; return `<td class="cell">${c ? `<button type="button" data-s="${s}" data-g="${esc(g[0])}" aria-label="${c} ${s} repositories, ${esc(g[1])}">${c}</button>` : `<span class="faint"><span aria-hidden="true">·</span><span class="sr-only">none</span></span>`}</td>`; }).join("")}<td class="n"><b>${n(s)}</b></td></tr>`).join("")}</tbody></table></div></div>
  </div>
  <div class="grid2">
    <div class="panel"><div class="panel-head"><h2>Move these first</h2><span class="muted">other repositories break if these move late</span></div><div class="tbl-wrap"><table><thead><tr><th scope="col">Repository</th><th scope="col" class="n">Depended on by</th><th scope="col">Activity</th><th scope="col">Proposed destination</th></tr></thead><tbody>${hubs.map(r => `<tr><td>${openBtn(r.repo)}</td><td class="n">${r.inbound_code_refs}</td><td>${pill(r.status)}</td><td>${dgroup(r)}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><div class="panel-head"><h2>Waiting on an owner decision</h2></div><div class="tbl-wrap"><table><thead><tr><th scope="col">Repository</th><th scope="col">Proposal</th><th scope="col">Decision</th></tr></thead><tbody>${need.map(r => `<tr><td>${openBtn(r.repo)}</td><td style="max-width:44ch">${esc(r.destination)}</td><td>${decTag(r)}</td></tr>`).join("") || `<tr><td colspan="3" class="muted">None.</td></tr>`}</tbody></table></div></div>
  </div>`;
  $$("[data-g]", vb("overview")).forEach(b => b.addEventListener("click", () => filterTo({dest: b.dataset.g, status: b.dataset.s || ""})));
  orgChart(); bindOpen(vb("overview"));
};
function orgChart() {
  const v = DATA.meta.org_month, m = DATA.meta.months, W = 640, H = 200, pl = 36, pb = 26, pt = 8, max = Math.max(50, Math.ceil(Math.max(...v) / 50) * 50);
  const mlab = s => MONTHS[+s.slice(5, 7) - 1].slice(0, 3) + " " + s.slice(0, 4);
  const x = i => pl + i * (W - pl - 8) / v.length, bw = (W - pl - 8) / v.length - 3, y = val => pt + (H - pt - pb) * (1 - val / max);
  let s = `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-labelledby="oc-t"><title id="oc-t">Commits by people per month across co-cddo, ${mlab(m[0])} to ${mlab(m.at(-1))}. Peak ${Math.max(...v)}.</title>`;
  for (let t = 0; t <= max; t += max / 4) s += `<line x1="${pl}" x2="${W-4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="10" fill="var(--muted)" font-family="var(--f-data)">${t}</text>`;
  v.forEach((val, i) => { s += `<rect x="${x(i)}" y="${y(val)}" width="${bw}" height="${y(0)-y(val)}" fill="${i === v.length-1 ? "var(--dec)" : "var(--accent)"}"><title>${mlab(m[i])}: ${val}</title></rect>`; if (i % 3 === 0) s += `<text x="${x(i)+bw/2}" y="${H-8}" text-anchor="middle" font-size="10" fill="var(--muted)" font-family="var(--f-data)">${mlab(m[i]).replace(" 20", " ")}</text>`; });
  $("#orgchart").innerHTML = s + `</svg><details style="margin-top:8px"><summary>Show as a table</summary><div class="tbl-wrap"><table><thead><tr><th scope="col">Month</th><th scope="col" class="n">Commits by people</th></tr></thead><tbody>${m.map((mm, i) => `<tr><td>${mlab(mm)}</td><td class="n">${v[i]}</td></tr>`).join("")}</tbody></table></div></details><p class="faint" style="font-size:12.5px">The last month (${mlab(m.at(-1))}) is partial.</p>`;
}

/* ---------- REPOSITORIES (co-cddo) ---------- */
const F0 = {q:"", status:"", dest:"", domain:"", risk:"", decision:"", strat:"", gw:""}, F = {...F0};
let sortKey = "last_human_commit", sortDir = -1; const RP = {page:0, size:50};
const riskTest = {any: r => r.breaking > 0, inbound: r => r.inbound_code_refs > 0, pagesLive: r => r.pages, uses: r => r.ref_uses > 0, oidc: r => r.ref_oidc > 0, fork: r => !!r.fork_parent, nocodeowners: r => !r.codeowners};
function filtered() { const q = F.q.trim().toLowerCase();
  return rows.filter(r => (!q || q.split(/\s+/).every(t => r.search.includes(t))) && (!F.status || r.status === F.status) && (!F.dest || effGroup(r) === F.dest) && (!F.domain || r.domain === F.domain) &&
    (!F.risk || (riskTest[F.risk] || (() => true))(r)) && (!F.decision || decState(r) === F.decision) && (!F.strat || (F.strat === "DAM" ? !!r.dam : F.strat in r.tags)) && (!F.gw || (F.gw === "must" ? r.gwMustFail > 0 : r.gwFail === 0))); }
RENDER.repos = () => {
  const opt = (arr, all) => `<option value="">${all}</option>` + arr.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join("");
  vb("repos").innerHTML = `<div class="panel"><h2 style="margin-bottom:10px">co-cddo repositories</h2><div class="filters">
    <label class="grow" for="f-q">Search<input type="search" id="f-q" placeholder="name, description, team, standard, contributor"></label>
    <label for="f-status">Activity<select id="f-status">${opt(STATUSES.map(s => [s, s]), "Any")}</select></label>
    <label for="f-dest">Destination<select id="f-dest">${opt(GROUPS.map(g => [g[0], g[1]]), "Any")}</select></label>
    <label for="f-domain">Domain<select id="f-domain">${opt([...new Set(rows.map(r => r.domain))].sort().map(d => [d, d.replace(/&/g, "and")]), "Any")}</select></label>
    <label for="f-strat">Strategy or DAM<select id="f-strat">${opt([["DAM","DAM and metadata"], ...DATA.strategy.map(s => [s.id, s.id + ": " + s.short])], "Any")}</select></label>
    <label for="f-risk">Migration risk<select id="f-risk">${opt([["any","Has breaking references"],["inbound","Others depend on it"],["pagesLive","Serves GitHub Pages"],["uses","Calls co-cddo workflows"],["oidc","OIDC trust"],["fork","Fork of another project"],["nocodeowners","No CODEOWNERS"]], "Any")}</select></label>
    <label for="f-gw">GDS Way<select id="f-gw">${opt([["must","Fails a MUST"],["clean","No failures"]], "Any")}</select></label>
    <label for="f-decision">Decision<select id="f-decision">${opt(Object.entries(DEC_LABEL), "Any")}</select></label>
    <button class="btn" id="f-reset" type="button">Clear filters</button><button class="btn" id="export" type="button" ${dl ? "" : "hidden"}>Download CSV</button></div>
    <p class="count" id="count" role="status" aria-live="polite" style="margin-top:10px"></p></div>
    <div class="panel" style="padding:0"><div class="tbl-wrap"><table id="repo-table"></table></div><div id="repo-pager"></div></div>`;
  [["#f-q","q","input"],["#f-status","status"],["#f-dest","dest"],["#f-domain","domain"],["#f-strat","strat"],["#f-risk","risk"],["#f-gw","gw"],["#f-decision","decision"]].forEach(([id, k, ev]) => { $(id).value = F[k]; if ($(id).value !== F[k]) F[k] = ""; $(id).addEventListener(ev || "change", e => { F[k] = e.target.value; RP.page = 0; renderTable(); }); });
  $("#f-reset").onclick = () => filterTo({}); $("#export").onclick = exportCSV;
  renderTable();
};
const COLS = [["repo","Repository"],["status","Activity"],["last_human_commit","Last commit by a person"],["spark","24 months",false],["human_commits_365d","Commits in 12 months","n"],["inferred_team","Inferred owner"],["dest","Proposed destination"],["flags","Flags",false],["gw","GDS Way MUST gaps","n"],["decision","Decision"]];
function renderTable() {
  if (!$("#repo-table")) return;
  const list = filtered();
  const val = r => sortKey === "dest" ? GROUPS.findIndex(g => g[0] === effGroup(r)) : sortKey === "decision" ? decState(r) : sortKey === "status" ? STATUSES.indexOf(r.status) : sortKey === "gw" ? r.gwMustFail : r[sortKey];
  list.sort((a, b) => (cmp(val(a), val(b)) * sortDir) || a.repo.localeCompare(b.repo));
  const pg = list.slice(RP.page * RP.size, RP.page * RP.size + RP.size);
  $("#count").textContent = `${list.length} of ${rows.length} repositories` + (Object.values(F).some(Boolean) ? " match the filters" : "");
  if ($("#export")) $("#export").textContent = `Download CSV (${list.length} row${list.length === 1 ? "" : "s"})`;
  $("#repo-table").innerHTML = `<caption class="muted" style="padding:10px 12px 0;font-weight:400;text-align:left" id="repo-cap">co-cddo repositories, page ${RP.page + 1}. Select a repository name for details, risks, dependencies, decisions and AI drafts.</caption><thead><tr>${COLS.map(([k, l, n]) => n === false ? `<th scope="col">${esc(l)}</th>` : `<th scope="col" class="${n === "n" ? "n" : ""}" aria-sort="${sortKey === k ? (sortDir > 0 ? "ascending" : "descending") : "none"}"><button class="sortb" type="button" data-k="${k}">${esc(l)}<span class="sr-only">, sort</span></button></th>`).join("")}</tr></thead><tbody>` +
    pg.map(r => `<tr><td class="repo">${openBtn(r.repo)}<small>${esc(r.description || r.readme_summary || "")}</small></td><td>${pill(r.status)}</td><td class="num">${fmtD(r.last_human_commit, true)}</td><td>${spark(r.spark)}</td><td class="n">${r.human_commits_365d}</td><td style="min-width:16ch">${esc(r.inferred_team)}</td><td>${dgroup(r)}<br><span class="muted" style="font-size:12px">${esc(r.dest_org)}</span></td><td><div class="chips">${r.dam ? `<span class="chip dam" title="matched “${esc(r.dam)}”">DAM</span>` : ""}${stratChips(r.tags)}${r.flags.map(k => `<span class="chip ${k[1]}">${esc(k[0])}</span>`).join("")}</div></td><td class="n">${r.gwMustFail || `<span aria-hidden="true">·</span><span class="sr-only">none</span>`}</td><td>${decTag(r)}</td></tr>`).join("") +
    (list.length ? "" : `<tr><td colspan="${COLS.length}" class="muted" style="padding:24px">No repositories match these filters.</td></tr>`) + `</tbody>`;
  $$("#repo-table .sortb").forEach(b => b.onclick = () => { const k = b.dataset.k, numeric = ["human_commits_365d","gw","last_human_commit"].includes(k); sortDir = sortKey === k ? -sortDir : (numeric ? -1 : 1); sortKey = k; renderTable(); $(`#repo-table .sortb[data-k="${k}"]`)?.focus(); });
  $("#repo-pager").replaceChildren(pager(RP, list.length, renderTable, () => $("#repo-cap")));
  bindOpen($("#repo-table"));
  try { localStorage.setItem("cddo-filters4", JSON.stringify(F)); } catch {}
}
function filterTo(p) { Object.assign(F, F0, p); RP.page = 0; rendered.delete("repos"); go("repos"); }

/* ---------- details sheet ---------- */
let lastFocus = null, openRepo = null;
function bindOpen(root) { $$("[data-open]", root).forEach(el => { if (el._b) return; el._b = 1; el.addEventListener("click", () => openAny(el.dataset.open));
  if (el.tagName !== "BUTTON") el.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openAny(el.dataset.open); } }); }); }
function bindX(root) { $$("[data-x]", root).forEach(el => { if (el._b) return; el._b = 1; el.addEventListener("click", () => openX(el.dataset.x)); }); }
/* fallback: a co-cddo name missing from the inventory opens the government panel (D13) */
function openAny(name) { if (byName[name]) openSheet(name); else if (XBY["co-cddo/" + name]) openX("co-cddo/" + name); else toast("No details found for " + name); }
function closeSheet(restore=true) { $("#sheet").hidden = true; $("#scrim").hidden = true; openRepo = null; if (restore && lastFocus && document.contains(lastFocus)) lastFocus.focus(); }
$("#scrim").addEventListener("click", () => closeSheet());
document.addEventListener("keydown", e => { if ($("#sheet").hidden) return; if (e.key === "Escape") { e.preventDefault(); closeSheet(); return; }
  if (e.key === "Tab") { const f = $$("#sheet a[href],#sheet button:not([disabled]),#sheet textarea,#sheet select:not([disabled]),#sheet input:not([disabled]),#sheet [tabindex='0'],#sheet summary").filter(x => !x.closest("[hidden]")); if (!f.length) return; const first = f[0], last = f.at(-1);
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); } else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); } } });
function openShell(title, sub, inner) {
  if ($("#sheet").hidden) lastFocus = document.activeElement;
  $("#sheet").innerHTML = `<div class="sheet-head"><div style="min-width:0">${sub}<h2 id="sh-title" class="mono" style="font-size:1.15rem;overflow-wrap:anywhere">${esc(title)}</h2></div><button class="btn" id="sh-close" type="button">Close<span class="sr-only"> details</span></button></div><div class="body">${inner}</div>`;
  $("#sheet").hidden = false; $("#scrim").hidden = false; $("#sh-close").onclick = () => closeSheet(); $("#sh-close").focus(); bindOpen($("#sheet")); bindX($("#sheet"));
}
/* per-repository impact assessment from observed facts and GitHub's documented behaviour; plain text only */
function impact(r) {
  const it = [];
  if (r.inbound_code_refs) it.push(["red", `${r.inbound_code_refs} co-cddo repositories reference this one in code (${r.depended_on_by}).`, "Move it in an early wave and update every caller in the same change window. Pin new references to a commit SHA."]);
  if (r.ref_uses) it.push(["red", `Calls ${r.ref_uses} reusable workflow or action line(s) under co-cddo.`, "Point uses: at gds-dtx after the called repository moves. GitHub does not redirect calls to actions in a renamed repository, and does not document redirects for reusable workflows."]);
  if (r.pages) it.push(["red", `Serves a live GitHub Pages site (${r.pages_url}).`, r.pages_custom ? `Custom domain ${r.pages_custom}: verify it under gds-dtx before cutover so it can't be taken over.` : "GitHub doesn't redirect co-cddo.github.io addresses after a transfer. Set a custom domain or tell users the new address."]);
  if (r.ref_pages) it.push(["amber", `Contains ${r.ref_pages} line(s) pointing at co-cddo.github.io.`, "Update after the Pages sites move."]);
  if (r.ref_oidc) it.push(["red", `Contains OIDC trust text naming repo:co-cddo (${r.ref_oidc}).`, "Transfers after 15 July 2026 switch to immutable subject claims (owner and repository IDs), so trust conditions written as repo:co-cddo/… or repo:gds-dtx/… will not match. Update cloud trust to the immutable format or repository_id claims and prove it with a dry-run deploy before cutover."]);
  if (r.ref_pkg) it.push(["amber", `Contains ${r.ref_pkg} package, module or raw-file source reference(s) to co-cddo.`, "Republish or re-point sources. Packages may move or lose their link depending on the registry; an npm scope named after co-cddo can't move."]);
  if (r.ref_team || String(r.codeowners).includes("@co-cddo/")) it.push(["amber", `CODEOWNERS uses co-cddo teams (${r.codeowners}).`, "Recreate the teams in gds-dtx and rewrite CODEOWNERS in the same change, or required reviews lapse."]);
  if (r.ref_hardorg) it.push(["amber", `Hard-codes the co-cddo organisation name ${r.ref_hardorg} time(s).`, "Parameterise or update the organisation name."]);
  if (r.cname) it.push(["amber", `Has a CNAME file (${r.cname}).`, "Check DNS still points to a live site; remove records for retired sites."]);
  if (r.gwMustFail) it.push(["amber", `${r.gwMustFail} GDS Way MUST requirement(s) not met.`, "Fix them in the change that moves the repository (see the GDS Way table below)."]);
  if (r.stars >= 10 || r.network_forks >= 5) it.push(["amber", `Signs of outside use (${r.stars} stars, ${r.network_forks} forks).`, "Check clone and Actions traffic in Insights before choosing names: GitHub permanently retires an owner and name combination with more than 100 clones or Actions uses in the week before transfer."]);
  if (r.fork_parent) it.push(["info", `Fork of ${r.fork_parent}.`, "Prefer the upstream project; delete the fork only after confirming it has no local commits."]);
  if (!it.length) it.push(["info", "No breaking references or published sites found.", "Low risk: standard transfer, then an archive notice in the old location."]);
  return it;
}
function openSheet(name) {
  const r = byName[name]; if (!r) return openAny(name); openRepo = name;
  const out = DATA.edges.filter(e => e.source === name && e.kind !== "link"), inn = DATA.edges.filter(e => e.target === name && e.kind !== "link");
  const el = (list, side) => list.length ? `<ul style="margin:0;padding-left:18px;display:grid;gap:3px">${list.map(e => { const o = side === "out" ? e.target : e.source; return `<li>${openBtn(o)} <span class="muted">${esc(KIND_LABEL[e.kind] || e.kind)}, ${e.refs} line${e.refs > 1 ? "s" : ""}</span></li>`; }).join("")}</ul>` : `<p class="muted">None found.</p>`;
  const pu = safeUrl(r.pages_url);
  openShell(r.repo, `<div class="eyebrow">${esc(r.listing_status)}${r.fork_parent ? " · fork of " + esc(r.fork_parent) : ""}</div>`, `
    <p class="muted">${esc(r.description || r.readme_summary || "No description")}</p>
    <p style="font-size:14px">${ext(r.url, "Open on GitHub")}${r.pages && pu ? " · " + ext(pu, "Open its GitHub Pages site") : ""}</p>
    <div class="box decision" id="decbox"></div>
    <div class="box"><div><span class="prov c">Impact assessment</span> <span class="muted" style="font-size:12.5px">from observed facts and GitHub's documented behaviour, checked ${esc(DATA.risks_checked)}</span></div>
      ${impact(r).map(([lvl, what, act]) => `<div class="warn ${lvl === "red" ? "" : "amber"}" ${lvl === "info" ? 'style="border-color:var(--line);background:var(--bg)"' : ""}><b>${lvl === "red" ? "Warning" : lvl === "amber" ? "Check" : "Note"}</b><span>${esc(what)}</span><span class="muted">${esc(act)}</span></div>`).join("")}</div>
    <div class="box assessed"><div><span class="prov a">Assessed</span></div>${kv([["Proposed destination", `${esc(GLABEL[r.destination_group])}<br>${esc(r.destination)}`],["Proposed destination organisation", `${esc(r.dest_org)}${r.v1?.target ? `<br><span class="muted">v1 workbook: ${esc(r.v1.target)} (${esc(r.v1.agreement)})</span>` : ""}`],["Why", esc(r.rationale)],["Related outside co-cddo", esc(r.related_external)],["Domain", esc(r.domain)],["Capability", esc(r.capability)],["Inferred owning team", esc(r.inferred_team)],["Kind", esc(r.kind)]])}</div>
    <div class="box"><div><span class="prov g">Auto-tagged</span> <span class="muted" style="font-size:12.5px">declared phrase rules; matched words and measured precision shown</span></div>
      ${kv([["Strategy alignment", Object.keys(r.tags).length ? Object.entries(r.tags).map(([k, v]) => { const p = precInfo(k); return `<b>${esc(k)}</b> ${esc(STRAT[k]?.label)} <span class="muted">(matched “${esc(v)}”; ${esc(p.txt)})</span>${p.cand ? ' <span class="cand">candidate</span>' : ""}`; }).join("<br>") : "<span class='muted'>none matched</span>"],
        ["DAM and metadata", r.dam ? `relevant <span class="muted">(${esc(r.dam_basis || "matched “" + r.dam + "”")}; ${esc(precInfo("DAM").txt)})</span>` : "<span class='muted'>no match</span>"],
        ["Open standards", r.standards.length ? r.standards.map(s => `${esc(s)}${r.std_files[s] ? ` <span class="muted">(${r.std_files[s]} file${r.std_files[s] > 1 ? "s" : ""})</span>` : ""}`).join(", ") : "<span class='muted'>none detected</span>"]])}</div>
    <div class="box"><div><span class="prov o">Observed</span> <span class="muted" style="font-size:12.5px">git history, all branches, bots excluded</span></div>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">${pill(r.status)}${spark(r.spark, 240, 40)}</div>
      ${kv([["Last commit by a person", `${fmtD(r.last_human_commit)}${r.days != null ? ` <span class="muted">(${r.days} days before ${REFD})</span>` : ""}`],["First commit", fmtD(r.first_commit)],["Commits by people", `${r.human_commits_90d} in 90 days · ${r.human_commits_365d} in 12 months`],
        ["People committing", `${r.authors_90d} in 90 days · ${r.authors_365d} in 12 months · ${r.authors_all} in all <span class="faint">(upper bounds)</span>`],["Top contributors, 12 months", esc(r.top_contributors_12m) || "<span class='muted'>none</span>"],
        ["CODEOWNERS", r.codeowners ? `<span class="mono">${esc(r.codeowners)}</span>` : "<span class='muted'>none</span>"],["Licence", esc(r.licence)],["Default branch", `<span class="mono">${esc(r.branch || r.default_branch)}</span>`],
        ["Open issues and pull requests", `${r.open_issues ?? "—"} issues · ${r.open_prs ?? "—"} pull requests`],
        ["GitHub Pages", r.pages && pu ? `live at ${ext(pu, pu)}${r.pages_custom ? ` (custom domain ${esc(r.pages_custom)})` : ""}` : "no live site found"],
        ["Stars and forks", `${r.stars} stars · ${r.network_forks} forks`],["Language and topics", esc([r.language, r.topics].filter(Boolean).join(" · "))]])}</div>
    <div class="box"><div><span class="prov o">Observed</span> <b>GDS Way</b> <span class="muted" style="font-size:12.5px">checked at the latest commit</span></div>
      <div class="tbl-wrap"><table><thead><tr><th scope="col">Requirement</th><th scope="col">Level</th><th scope="col">Result</th><th scope="col">Evidence</th></tr></thead><tbody>${RULES.map(x => { const v = r.gdsway[x.id]; return `<tr><td>${ext(x.url, x.text)}</td><td>${esc(x.strength)}</td><td>${gwTag(v)}</td><td class="muted">${esc(v[1])}</td></tr>`; }).join("")}</tbody></table></div></div>
    ${v1Box(r)}
    <div class="box"><div><span class="prov c">Calculated</span> <b>Assurance controls</b> <span class="muted" style="font-size:12.5px">the v1 workbook's 14 controls, from observed and v1 evidence</span></div>
      <div class="tbl-wrap"><table><thead><tr><th scope="col">Control</th><th scope="col">Result</th><th scope="col">Evidence</th></tr></thead><tbody>${r.controls.map(c => `<tr><td>${esc(c[0].replace(/&/g, "and"))}</td><td>${ckS(c[1])}</td><td class="muted">${esc(c[2])}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="box"><div><span class="prov o">Observed</span> <b>Code references</b></div><h3>This repository depends on</h3>${el(out, "out")}<h3>Depended on by</h3>${el(inn, "in")}</div>
    <div class="box"><div><span class="prov g">Auto-linked</span> <b>Similar work across government</b> <span class="muted" style="font-size:12.5px">text similarity of name, description, topics and README</span></div>
      ${r.related_xgov.length ? `<ul style="margin:0;padding-left:18px">${r.related_xgov.map(([o, n, s]) => `<li>${xBtn(o + "/" + n)} <span class="muted">similarity ${esc(s)}</span></li>`).join("")}</ul>` : `<p class="muted">No close matches.</p>`}</div>
    <div class="box ai" id="aibox"></div>`);
  renderDecisionBox(r); renderAIBox(r);
}

/* decision form: no default choice (D15), GOV.UK error message, edits kept when someone else saves (D6), per-code errors (D16) */
let shownDec = null;
const decSig = d => d ? JSON.stringify([d.state, d.group, d.note, d.at, d.by]) : "none";
function renderDecisionBox(r, fromSnapshot=false) {
  const box = $("#decbox"); if (!box) return; const d = decisions[r.repo];
  const form = $("#decform");
  if (fromSnapshot && form && form.dataset.dirty === "1") {
    if (decSig(d) !== shownDec && !$("#dec-newer")) {
      const n = document.createElement("div"); n.className = "newer"; n.id = "dec-newer"; n.setAttribute("role", "status");
      n.innerHTML = `<span>Someone else has recorded a newer decision for this repository. Your unsaved changes are kept.</span><button class="btn sm" type="button">Show the newer decision</button>`;
      $("button", n).onclick = () => { delete form.dataset.dirty; renderDecisionBox(r); $("#decbox h3")?.setAttribute("tabindex", "-1"); $("#decbox h3")?.focus(); };
      box.prepend(n);
    }
    return;
  }
  shownDec = decSig(d);
  const who = d?.by ? (profiles[d.by]?.name || "Someone") : "Someone";
  const head = `<div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap"><h3>Decision on the proposed destination</h3>${decTag(r)}</div>`;
  if (!db) { box.innerHTML = head + `<p class="muted">Recording decisions needs a signed-in claude.ai view of this page.</p>`; return; }
  const cur = d?.state || "";
  box.innerHTML = head + (d ? `<p class="muted" style="font-size:13.5px">Last recorded by ${esc(who)}${d.at ? " on " + fmtD(d.at) : ""}${d.state === "changed" ? ` · now <b>${esc(GLABEL[d.group])}</b>` : ""}${d.ai ? " · used an AI suggestion" : ""}</p>${d.note ? `<p style="white-space:pre-wrap">${esc(d.note)}</p>` : ""}` : `<p class="muted" style="font-size:13.5px">Nobody has reviewed this proposal yet.</p>`) +
  ((canWrite === false || readOnly) ? `<p class="muted">You can view decisions but not record them on this page.</p>` : `<form id="decform" novalidate><div id="dec-err-sum"></div><div class="radios" id="dec-fs-wrap"><fieldset style="border:0;padding:0;margin:0;display:grid;gap:6px" aria-describedby="dec-err"><legend style="font-size:14px;margin-bottom:4px;font-weight:700">Your decision</legend>
    <p class="errmsg" id="dec-err" hidden></p>
    <label><input type="radio" name="st" value="agreed" ${cur==="agreed"?"checked":""}> <span><b>Agree with the proposal</b><br><span class="muted">${esc(GLABEL[r.destination_group])}</span></span></label>
    <label><input type="radio" name="st" value="changed" ${cur==="changed"?"checked":""}> <span><b>Change the destination</b></span></label>
    <label for="dec-group" class="muted" style="font-size:13.5px;padding-left:26px">New destination</label><select id="dec-group" style="margin-left:26px;width:calc(100% - 26px)">${GROUPS.map(g => `<option value="${esc(g[0])}" ${(d?.group || r.destination_group) === g[0] ? "selected" : ""}>${esc(g[1])}</option>`).join("")}</select>
    <label><input type="radio" name="st" value="discuss" ${cur==="discuss"?"checked":""}> <span><b>Needs discussion</b></span></label></fieldset></div>
    <label for="dec-note" style="display:block;font-size:14px;font-weight:700;margin-top:8px">Note <span class="muted" style="font-weight:400">(optional: owner, reason, target organisation, dates)</span></label><textarea id="dec-note" rows="3" maxlength="2000">${esc(d?.note || "")}</textarea>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px"><button class="btn primary" type="submit">Save decision</button>${d ? `<button class="btn" type="button" id="dec-clear">Clear decision</button>` : ""}<span class="status-line" id="dec-status" role="status"></span></div></form>`);
  const f = $("#decform"); if (!f) return;
  const stVal = () => f.elements.st ? (f.elements.st.value || "") : "";
  const sync = () => { $("#dec-group").disabled = stVal() !== "changed"; }; sync();
  f.addEventListener("change", () => { f.dataset.dirty = "1"; sync(); }); f.addEventListener("input", () => { f.dataset.dirty = "1"; });
  const showErr = msg => { const e = $("#dec-err"); if (!msg) { e.hidden = true; $("#dec-fs-wrap").classList.remove("fieldset-error"); $("#dec-err-sum").innerHTML = ""; return; }
    e.hidden = false; e.innerHTML = `<span class="sr-only">Error: </span>${esc(msg)}`; $("#dec-fs-wrap").classList.add("fieldset-error");
    $("#dec-err-sum").innerHTML = `<div class="errsum" role="alert" tabindex="-1"><b>There is a problem</b><a href="#dec-err">${esc(msg)}</a></div>`; $("#dec-err-sum .errsum").focus();
    $("#dec-err-sum a").onclick = ev => { ev.preventDefault(); f.querySelector('input[name="st"]')?.focus(); }; };
  f.addEventListener("submit", async e => { e.preventDefault(); const state = stVal(), group = state === "changed" ? $("#dec-group").value : null;
    if (!state) return showErr("Select whether you agree, want to change the destination, or need to discuss it");
    if (state === "changed" && group === r.destination_group) return showErr("Select a destination different from the proposal, or select Agree with the proposal");
    showErr("");
    const body = {repo: r.repo, state, group, note: $("#dec-note").value.trim().slice(0, 2000), proposed: r.destination_group, by: myId, at: new Date().toISOString(), ai: f.dataset.ai === "1"};
    $("#dec-status").textContent = "Saving…";
    const ok = await dbWrite(() => db.collection("decisions").doc(r.repo).set(body), $("#dec-status"));
    if (ok) { delete f.dataset.dirty; dbWrite(() => db.collection("decision_log").add(body), null); toast("Decision saved for " + r.repo); } });
  $("#dec-clear")?.addEventListener("click", async () => { $("#dec-status").textContent = "Clearing…"; const ok = await dbWrite(() => db.collection("decisions").doc(r.repo).delete(), $("#dec-status"));
    if (ok) { dbWrite(() => db.collection("decision_log").add({repo: r.repo, state: "cleared", by: myId, at: new Date().toISOString(), proposed: r.destination_group}), null); toast("Decision cleared"); } });
}
const DB_MSG = {
  invalid_argument: "You can view decisions but can't record them on this page. Ask the page owner for Contributor access.",
  transform_error: "That decision couldn't be prepared for saving. Reload the page and try again.",
  resource_exhausted: "Too many saves just now. Wait a moment, then try again.",
  quota_exceeded: "The decision store for this page is full. Tell the page owner.",
  unavailable: "Couldn't reach the decision store. Try again in a minute.",
  revoked: "Recording decisions is no longer available in this view.",
  not_granted: "Recording decisions isn't available in this view.", capability_disabled: "Recording decisions isn't available in this view.", capability_removed: "Recording decisions isn't available in this view."};
async function dbWrite(fn, statusEl, retried=false) {
  try { await fn(); if (statusEl) statusEl.textContent = ""; return true; }
  catch (err) { const code = DB_MSG[err?.code] ? err.code : "unavailable";
    if (code === "unavailable" && !retried) { await new Promise(res => setTimeout(res, 400 + Math.random() * 800)); return dbWrite(fn, statusEl, true); }
    if (code === "invalid_argument" && canWrite !== true) { readOnly = true; }
    if (statusEl) statusEl.textContent = DB_MSG[code];
    return false; }
}
function v1Box(r) {
  const v = r.v1 || {}; if (!v.v1_name && !v.obs_score && v.obs_score !== 0) return "";
  const ev = (v.evidence_ids || []).map(id => { const e = EVBY[id]; return e ? (e.link ? ext(e.link, id) : `<abbr title="${esc(e.shows)}">${esc(id)}</abbr>`) + ` <span class="muted">${esc(e.shows)}</span>` : esc(id); });
  const C = v.v1_criteria, O = v.obs_criteria || {}, crit = DATA.v1.criteria;
  return `<div class="box"><div><span class="prov a">v1 workbook</span> <span class="muted" style="font-size:12.5px">${esc(DATA.v1.source)}</span></div>
    ${v.v1_name ? kv([["Name in v1", esc(v.v1_name) + (v.renamed ? " <span class='muted'>(old name; same HEAD commit as this repository)</span>" : "")], ["Owning unit", esc(v.owning_unit)], ["Owner or contact", esc(v.owner)], ["Proposed target (not confirmed)", esc(v.target)], ["Why", esc(v.rationale)],
      ["Notes and risks", esc(v.notes)], ["Activity evidence", esc(v.activity_evidence)], ["Evidence confidence", esc(v.confidence)], ["Evidence", ev.join("<br>")],
      ["Also listed under", v.duplicate_row ? `${esc(v.duplicate_row.v1_name)}: target ${esc(v.duplicate_row.target)}, outcome ${esc(v.duplicate_row.outcome)}` : ""],
      ["Collected in v1", Object.entries(v.collected || {}).map(([k, x]) => `${esc(k)}: ${esc(x)}`).join("<br>")]]) : `<p class="muted">Not in the v1 workbook.</p>`}
    <h3>Migration score (v1 model)</h3><div class="tbl-wrap"><table><thead><tr><th scope="col">Criterion</th><th scope="col" class="n">Weight</th><th scope="col" class="n">v1</th><th scope="col" class="n">Re-run</th><th scope="col">Re-run basis</th></tr></thead><tbody>
    ${crit.map(c => `<tr><td>${esc(c.id)} ${esc(c.name)}</td><td class="n">${c.weight}</td><td class="n">${C ? C[c.id] : "—"}</td><td class="n"><b>${O[c.id] ?? "—"}</b></td><td class="muted">${esc((v.obs_basis || {})[c.id])}</td></tr>`).join("")}
    <tr><th scope="row">Score and outcome</th><td></td><td class="n">${v.v1_score ?? "—"}</td><td class="n"><b>${v.obs_score}</b></td><td>${v.v1_outcome ? esc(v.v1_outcome) + " → " : ""}<b>${esc(v.obs_outcome)}</b></td></tr></tbody></table></div></div>`;
}
function openX(key) {
  const x = XBY[key]; if (!x) { toast("No details found for " + key); return; }
  const co = rows.filter(r => r.related_xgov.some(([o, n]) => o + "/" + n === key)), hy = x.hy, pu = safeUrl(x.pu), b = bodyOf(x);
  const rec = kv([["Identifier", `<span class="mono">${esc(x.key)}</span>`], ["Publisher", b ? `${esc(b.name)} <span class="muted">(${esc(b.type)})</span>` : `<span class="muted">GitHub account ${esc(x.org)}; not mapped to a public body</span>`], ["Sector", esc(x.sector)],
    ["Status", `${pill(x.st)} <span class="muted">basis: ${esc(x.basis)}</span>`], ["Created", x.cr ? fmtD(x.cr) : "—"], ["Last push", x.pd ? fmtD(x.pd) : "—"],
    ["Licence (GitHub detection)", esc(LICS[x.li] ?? "—")], ["Stars, forks, open issues", x.sg === null || x.sg === undefined ? "—" : `${nf(x.sg)} stars · ${nf(x.fk)} forks${x.oiss !== undefined ? " · " + nf(x.oiss) + " open issues" : ""}`], ["Language", esc(x.l) || "—"]]);
  openShell(x.key, `<div class="eyebrow">Asset record · ${esc(x.sector)}${x.org === "co-cddo" ? " · co-cddo" : ""}</div>`, `
    <p class="muted">${esc(x.d || "No description on GitHub.")}</p>${x.ld ? `<p style="font-size:14px"><span class="prov o">README</span> ${esc(x.ld)}</p>` : ""}
    <p style="font-size:14px">${x.unlisted ? "" : ext(ghUrl(x.key), "Open on GitHub")}${x.pg && pu ? " · " + ext(pu, "GitHub Pages site") : ""}${x.org === "co-cddo" && byName[x.n] ? ` · <button class="btn sm" type="button" data-open="${esc(x.n)}">Open the co-cddo inventory entry</button>` : ""}</p>
    <div class="box"><div><span class="prov o">Catalogue record</span> <span class="muted" style="font-size:12.5px">${x.unlisted ? "named in the v1 workbook; not visible in public data" : "X-Gov repo scraper, read " + fmtD(DATA.catsrc.scraper_read)}</span></div>${rec}</div>
    ${x.unlisted ? `<div class="box"><div><span class="prov a">v1 workbook</span></div>${kv([["Why it's here", esc(x.unlisted.basis)], ["Owning unit", esc(x.unlisted.owning_unit)], ["Owner or contact", esc(x.unlisted.owner)], ["Proposed target (not confirmed)", esc(x.unlisted.target)], ["Activity evidence", esc(x.unlisted.activity_evidence)], ["Notes and risks", esc(x.unlisted.notes)], ["Evidence", esc((x.unlisted.evidence_ids || []).join(", "))]])}</div>` : ""}
    ${!x.catOnly && !x.unlisted ? `<div class="box"><div><span class="prov o">Observed</span> <span class="muted" style="font-size:12.5px">git, default branch, bots excluded; names are not shown outside co-cddo</span></div>
    ${kv([["Activity", pill(x.st)],["Last commit by a person", fmtD(x.lh)],["Last commit by anyone", fmtD(x.lc)],["Commits by people", `${x.c90} in 90 days · ${x.c12} in 12 months`],["People committing, 12 months", esc(x.a12)],["First commit", x.nw ? "in the last 12 months (" + fmtD(x.fc) + ")" : "more than 12 months ago"],["Default branch", `<span class="mono">${esc(x.b)}</span>`],["Archived", x.ar ? "yes" : "no"],["GitHub Pages", x.pg && pu ? `${ext(pu, pu)}${x.cd ? " (custom domain)" : ""}` : "none found"],["Language and topics", esc([x.l, x.t].filter(Boolean).join(" · ")) || "—"]])}</div>` : ""}
    ${x.catOnly && String(x.basis).startsWith("git") ? `<div class="box"><div><span class="prov o">Observed</span> <span class="muted" style="font-size:12.5px">checked with git on 8 October 2026</span></div>${kv([["Last commit by a person", fmtD(x.lh)], ["Commits by people", `${x.c90} in 90 days · ${x.c12} in 12 months`]])}</div>` : ""}
    ${hy ? `<div class="box"><div><span class="prov o">Observed</span> <b>Engineering practice</b> <span class="muted" style="font-size:12.5px">files at the latest commit, read ${fmtD(DATA.meta.enr_date)}</span></div>${kv([["README", hy.readme ? "yes" : "no"],["Licence file", esc(hy.lic)],["CODEOWNERS", hy.codeowners ? "yes" : "no"],["Dependabot or Renovate", hy.dependabot ? "yes" : "no"],["SECURITY.md in the repository", hy.security ? "yes" : "no (the organisation may have one)"],["Workflows", `${hy.workflows} found, ${hy.wf_read} read`],["Third-party actions", hy.third ? `${hy.third}, of which ${hy.unpinned} not pinned to a SHA` : "none in the workflows read"],["Workflows without a permissions block", hy.wf_read ? String(hy.noperm) : "—"]])}</div>` : ""}
    ${x.unlisted ? "" : `<div class="box"><div><span class="prov g">Auto-tagged</span>${x.catOnly ? ' <span class="muted" style="font-size:12.5px">name and description only</span>' : ""}</div>${kv([["Strategy alignment", x.tags.length ? x.tags.map(t => { const p = precInfo(t); return `<b>${esc(t)}</b> ${esc(STRAT[t]?.label)} <span class="muted">(matched “${esc(x.ev[t])}”; ${esc(p.txt)})</span>${p.cand ? ' <span class="cand">candidate</span>' : ""}`; }).join("<br>") : "<span class='muted'>none matched</span>"],["DAM and metadata", x.dam ? `relevant (matched “${esc(x.dam)}”)` : "—"],["Open standards", esc(x.stds.join(", ")) || "—"]])}</div>`}
    ${(() => { const sr = DATA.std.repos[x.key]; if (!sr) return ""; return `<div class="box"><div><span class="prov o">Catalogues and standards</span> <span class="muted" style="font-size:12.5px">graded 1 mentioned to 4 every record</span></div>${kv([...Object.entries(sr.p).map(([p, v]) => [p, `${esc(v[0])}<br><span class="muted">${v[1].map(esc).join("<br>")}</span>`]), ...Object.entries(sr.s).sort((a, b) => b[1][0] - a[1][0]).map(([s, v]) => [s, `${lvlTag(v[0])}<br><span class="muted">${v[1].map(esc).join("<br>")}</span>`])])}</div>`; })()}
    ${co.length ? `<div class="box"><b>Similar co-cddo repositories</b><div class="chips">${co.map(r => `<button class="btn sm" type="button" data-open="${esc(r.repo)}"><span class="mono">${esc(r.repo)}</span></button>`).join("")}</div></div>` : ""}`);
}
