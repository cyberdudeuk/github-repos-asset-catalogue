
/* ---------- LINEAGE: line map, family tree, reference graph (each with a list alternative) ---------- */
const FAM = {"gds-idea":"GDS IDEA platform","idea-apps":"IDEA applications","domains":"Domains and cyber services","email-sec":"Email and web security","gc3":"GC3","sbd":"Secure by Design","observ":"Observability","finops":"FinOps","cloud":"Cloud","api":"APIs and standards","metadata":"Metadata and standards","marketplace":"Data marketplace","datashare":"Data sharing","dataarch":"Data architecture","ethics":"Responsible data","proto":"Prototypes","community":"Community","platform":"Organisation platform","mog":"Machinery of government","fork":"Forks","ndx":"NDX"};
RENDER.lineage = () => {
  vb("lineage").innerHTML = `
  <div class="panel"><div class="panel-head"><h2>Migration line map</h2><span class="muted">one line per family of work · stations are repositories · the end of each line is its destination</span></div>
    <p class="lede">Read each line left to right in the order it should move: wave 1, wave 2, wave 3, then repositories awaiting a decision. Thick rings mark interchanges, which other repositories depend on. Select a station for details.</p>
    <div class="graph-wrap" id="tube"></div><details style="margin-top:8px"><summary>Show the line map as a list</summary><div id="tube-list"></div></details></div>
  <div class="panel"><div class="panel-head"><h2>Family tree</h2><span class="muted">organisation, domain, theme, repository, then what uses it and similar work across government</span></div><div class="tree" id="tree"></div></div>
  <div class="panel"><div class="panel-head"><h2>Code references between co-cddo repositories</h2><label class="muted" style="font-size:13.5px;display:flex;gap:6px;align-items:center" for="g-arch"><input type="checkbox" id="g-arch"> Include archived repositories</label></div>
    <p class="lede">Left: the repository containing the reference. Right: the co-cddo repository it points at. Line style shows the kind of reference. Select a repository to trace it; select it again to open it; press Escape to clear.</p><div class="legend" id="glegend"></div><div class="graph-wrap" id="graph"></div>
    <details style="margin-top:8px"><summary>Show the references as a table</summary><div id="graph-list"></div></details></div>`;
  drawTube(); drawTree(); drawGraph(); $("#g-arch").onchange = () => { gSel = null; drawGraph(); };
};
function drawTube() {
  const fams = {}; const order = g => ({"1":0,"2":1,"3":2,"4":3,"5":4}[g[0]] ?? 9);
  for (const r of rows) { const g = effGroup(r); if (!/^[12345]/.test(g)) continue; (fams[r.family] ||= []).push(r); }
  const lines = Object.entries(fams).map(([f, rs]) => [f, rs.sort((a, b) => order(effGroup(a)) - order(effGroup(b)) || b.human_commits_365d - a.human_commits_365d || a.repo.localeCompare(b.repo))]).sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
  if (!lines.length) { $("#tube").innerHTML = `<p class="muted">No repositories are proposed to move.</p>`; $("#tube-list").innerHTML = ""; return; }
  const maxN = Math.max(...lines.map(l => l[1].length)), gap = 64, left = 200, top = 40, lh = 92, W = left + (maxN + 1) * gap + 120, H = top + lines.length * lh;
  const pos = {}; lines.forEach(([f, rs], li) => rs.forEach((r, i) => pos[r.repo] = [left + i * gap, top + li * lh + 20]));
  const hubSet = new Set(rows.filter(r => r.inbound_code_refs > 0).map(r => r.repo));
  let s = `<svg class="tube" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="group" aria-labelledby="tube-t"><title id="tube-t">Migration line map: ${lines.length} lines, ${Object.keys(pos).length} stations</title>`;
  for (const e of DATA.edges) { if (!CODE_KINDS.includes(e.kind) || !pos[e.source] || !pos[e.target]) continue; if (byName[e.source].family === byName[e.target].family) continue;
    const [x1, y1] = pos[e.source], [x2, y2] = pos[e.target]; s += `<path d="M${x1},${y1} C${x1},${(y1+y2)/2} ${x2},${(y1+y2)/2} ${x2},${y2}" stroke="var(--faint)" stroke-dasharray="3 3" fill="none" aria-hidden="true"/>`; }
  lines.forEach(([f, rs], li) => { const y = top + li * lh + 20, col = `var(--l${(li % 8) + 1})`, xEnd = left + rs.length * gap;
    const term = effGroup(rs.at(-1)); const termLabel = moving(term) ? "gds-dtx" : term.startsWith("4") ? "decision" : "consolidate";
    s += `<text x="0" y="${y + 4}" style="font-weight:600">${esc(FAM[f] || f)}</text><line x1="${left - 14}" y1="${y}" x2="${xEnd}" y2="${y}" stroke="${col}" stroke-width="7" stroke-linecap="round" aria-hidden="true"/>`;
    s += `<rect x="${xEnd + 6}" y="${y - 11}" width="80" height="22" rx="11" fill="var(--surface)" stroke="${col}" stroke-width="3"/><text x="${xEnd + 46}" y="${y + 4}" text-anchor="middle" style="font-weight:600">${termLabel}</text>`;
    rs.forEach((r, i) => { const x = left + i * gap, hub = hubSet.has(r.repo), lab = r.repo.length > 20 ? r.repo.slice(0, 19) + "…" : r.repo;
      s += `<g class="st" data-open="${esc(r.repo)}" tabindex="0" role="button" aria-label="${esc(r.repo)}, ${esc(GLABEL[effGroup(r)])}${hub ? ", interchange: other repositories depend on it" : ""}"><title>${esc(r.repo)}: ${esc(GLABEL[effGroup(r)])}</title><circle cx="${x}" cy="${y}" r="${hub ? 9 : 6}" fill="var(--surface)" stroke="${hub ? "var(--fg)" : col}" stroke-width="${hub ? 4 : 3}"/><text x="${x}" y="${y + 24}" transform="rotate(30 ${x} ${y + 24})">${esc(lab)}</text></g>`; }); });
  $("#tube").innerHTML = s + `</svg>`;
  $("#tube-list").innerHTML = lines.map(([f, rs]) => `<h3 style="margin-top:10px">${esc(FAM[f] || f)}</h3><ol>${rs.map(r => `<li>${openBtn(r.repo)} ${esc(GLABEL[effGroup(r)])}${r.inbound_code_refs ? ". Interchange: " + r.inbound_code_refs + " repositories depend on it" : ""}</li>`).join("")}</ol>`).join("");
  bindOpen($("#tube")); bindOpen($("#tube-list"));
}
function drawTree() {
  const doms = {}; for (const r of rows) ((doms[r.domain] ||= {})[r.theme] ||= []).push(r);
  const leaf = r => { const kids = [...new Set(DATA.edges.filter(e => e.target === r.repo && CODE_KINDS.includes(e.kind)).map(e => e.source))], sim = r.related_xgov.slice(0, 2);
    return `<li><div class="leaf">${openBtn(r.repo)}${pill(r.status)}${dgroup(r)}${r.fork_parent ? `<span class="chip">fork of ${esc(r.fork_parent)}</span>` : ""}${r.inbound_code_refs ? `<span class="chip dep">${r.inbound_code_refs} depend on it</span>` : ""}${r.dam ? `<span class="chip dam">DAM</span>` : ""}</div>
    ${(kids.length || sim.length) ? `<ul>${kids.map(k => `<li class="leaf"><span class="muted">used by</span> ${openBtn(k)}</li>`).join("")}${sim.map(([o, n, sc]) => `<li class="leaf"><span class="muted">similar across government</span> ${xBtn(o + "/" + n)} <span class="faint">${esc(sc)}</span></li>`).join("")}</ul>` : ""}</li>`; };
  $("#tree").innerHTML = `<ul><li><details open><summary>co-cddo <span class="muted">(${rows.length})</span></summary><ul>${Object.entries(doms).sort().map(([d, th]) => `<li><details><summary>${esc(d.replace(/&/g, "and"))} <span class="muted">(${Object.values(th).flat().length})</span></summary><ul>${Object.entries(th).sort().map(([t, rs]) => `<li><details><summary>${esc(t.replace(/&/g, "and"))} <span class="muted">(${rs.length})</span></summary><ul>${rs.map(leaf).join("")}</ul></details></li>`).join("")}</ul></details></li>`).join("")}</ul></details></li></ul>`;
  bindOpen($("#tree")); bindX($("#tree"));
}
let gSel = null;
function drawGraph() {
  const incArch = $("#g-arch")?.checked; const es = DATA.edges.filter(e => CODE_KINDS.includes(e.kind) && (incArch || (!byName[e.source].archived && !byName[e.target].archived)));
  const pair = {}; for (const e of es) { const k = e.source + "→" + e.target; (pair[k] ||= {source:e.source, target:e.target, kinds:[], refs:0}); pair[k].kinds.push(e.kind); pair[k].refs += e.refs; }
  const P = Object.values(pair), L = [...new Set(P.map(p => p.source))], R = [...new Set(P.map(p => p.target))];
  const sb = (arr, key) => arr.sort((a, b) => byName[a].family.localeCompare(byName[b].family) || key(b) - key(a) || a.localeCompare(b));
  sb(L, n => P.filter(p => p.source === n).length); sb(R, n => P.filter(p => p.target === n).length);
  const rowH = 24, top = 30, W = 900, nodeW = 270, mx = Math.max(L.length, R.length, 1), H = top + mx * rowH + 10;
  const ly = i => top + i * rowH + (mx - L.length) * rowH / 2, ry = i => top + i * rowH + (mx - R.length) * rowH / 2, kc = k => ["oidc","uses","pages","pkg","team","hardorg"].find(x => k.includes(x));
  let s = `<svg class="graph" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="group" aria-label="${P.length} references between ${L.length} referencing and ${R.length} referenced repositories"><text x="0" y="14" style="fill:var(--muted)">CONTAINS THE REFERENCE (${L.length})</text><text x="${W}" y="14" text-anchor="end" style="fill:var(--muted)">REFERENCED REPOSITORY (${R.length})</text>`;
  for (const p of P) { const y1 = ly(L.indexOf(p.source)) + 9, y2 = ry(R.indexOf(p.target)) + 9, x1 = nodeW, x2 = W - nodeW, m = (x1 + x2) / 2, k = kc(p.kinds);
    s += `<path class="k-${k}" ${KIND_DASH[k] ? `stroke-dasharray="${KIND_DASH[k]}"` : ""} data-s="${esc(p.source)}" data-t="${esc(p.target)}" d="M${x1},${y1} C${m},${y1} ${m},${y2} ${x2},${y2}" aria-hidden="true"><title>${esc(p.source)} to ${esc(p.target)}: ${esc([...new Set(p.kinds)].map(k => KIND_LABEL[k]).join(", "))} (${p.refs})</title></path>`; }
  const node = (n, x, y, a) => `<g class="node" data-n="${esc(n)}" tabindex="0" role="button" aria-label="${esc(n)}: trace references"><rect x="${x}" y="${y-2}" width="${nodeW-6}" height="${rowH-4}" rx="3"/><rect x="${a === "start" ? x : x + nodeW - 10}" y="${y-2}" width="4" height="${rowH-4}" style="fill:var(${GCOL[effGroup(byName[n])]})"/><text x="${a === "start" ? x + 10 : x + nodeW - 16}" y="${y+13}" text-anchor="${a}">${esc(n.length > 36 ? n.slice(0, 35) + "…" : n)}</text></g>`;
  L.forEach((n, i) => s += node(n, 0, ly(i), "start")); R.forEach((n, i) => s += node(n, W - nodeW + 6, ry(i), "end"));
  $("#graph").innerHTML = P.length ? s + `</svg>` : `<p class="muted">No references between non-archived repositories.</p>`;
  $("#glegend").innerHTML = [["uses","--w1"],["pkg","--dec"],["pages","--cons"],["oidc","--bad"],["team","--keep"]].map(([k, c]) => `<span class="edgekey"><svg width="34" height="10" aria-hidden="true"><line x1="0" y1="5" x2="34" y2="5" stroke="var(${c})" stroke-width="2.4" ${KIND_DASH[k] ? `stroke-dasharray="${KIND_DASH[k]}"` : ""}/></svg>${esc(KIND_LABEL[k])}</span>`).join("");
  $("#graph-list").innerHTML = P.length ? `<div class="tbl-wrap"><table><thead><tr><th scope="col">Contains the reference</th><th scope="col">Referenced repository</th><th scope="col">Kind</th><th scope="col" class="n">Lines</th></tr></thead><tbody>${[...P].sort((a, b) => a.source.localeCompare(b.source) || a.target.localeCompare(b.target)).map(p => `<tr><td>${openBtn(p.source)}</td><td>${openBtn(p.target)}</td><td>${esc([...new Set(p.kinds)].map(k => KIND_LABEL[k]).join(", "))}</td><td class="n">${p.refs}</td></tr>`).join("")}</tbody></table></div>` : "";
  bindOpen($("#graph-list"));
  const hl = n => { gSel = n; $$("#graph path").forEach(p => { const on = !n || p.dataset.s === n || p.dataset.t === n; p.classList.toggle("dim", !on); p.classList.toggle("hot", !!n && on); });
    const linked = new Set([n]); if (n) $$("#graph path").forEach(p => { if (p.dataset.s === n) linked.add(p.dataset.t); if (p.dataset.t === n) linked.add(p.dataset.s); }); $$("#graph .node").forEach(g => g.classList.toggle("dim", !!n && !linked.has(g.dataset.n))); };
  $$("#graph .node").forEach(g => { const act = () => gSel === g.dataset.n ? openSheet(g.dataset.n) : hl(g.dataset.n); g.onclick = act; g.onkeydown = e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); act(); } if (e.key === "Escape") hl(null); }; });
}

/* ---------- MOVING SAFELY ---------- */
RENDER.safe = () => {
  const crit = rows.filter(r => movingOrDecide(effGroup(r))).map(r => [r, impact(r).filter(i => i[0] === "red").length]).filter(x => x[1]).sort((a, b) => b[1] - a[1] || a[0].repo.localeCompare(b[0].repo));
  vb("safe").innerHTML = `
  <div class="warn"><b>Before anything moves</b><span>Do not delete or rename the co-cddo organisation, and do not create repositories or forks at paths you have vacated in co-cddo. Each of these breaks redirects that other teams and departments rely on, and some cannot be undone. Archive each repository after it moves; archive the organisation only after the last move. Run the impact assessment in each repository's details before moving it.</span></div>
  <div class="panel"><h2>GitHub's recommended approach, in order</h2><p class="lede" style="margin:6px 0 12px">From GitHub's migration documentation and the GitHub Well-Architected repository checklist, read on ${esc(DATA.risks_checked)}. GitHub doesn't publish one organisation-to-organisation playbook, so this combines its pages.</p>
    <div class="steps">${DATA.phases.map(([t, d, u], i) => `<div class="step"><span class="w" aria-hidden="true">${i + 1}</span><h3>${esc(t)}</h3><p>${esc(d)} ${ext(u, "Source")}</p></div>`).join("")}</div></div>
  <div class="panel"><h2>Actions that can break repositories or the services that depend on them</h2><p class="lede" style="margin:6px 0 12px">Each needs an impact assessment first. The quotation is GitHub's own wording, checked ${esc(DATA.risks_checked)}. Where GitHub says nothing, the basis says “inference”.</p>
    <div class="tbl-wrap"><table><caption class="sr-only">Risky actions, what breaks, whether it can be undone, what to check, GitHub's wording and the basis</caption><thead><tr><th scope="col">Action</th><th scope="col">What breaks</th><th scope="col">Can it be undone?</th><th scope="col">Check first</th><th scope="col">GitHub says</th><th scope="col">Basis</th></tr></thead><tbody>${DATA.risks.map(([a, b, rev, u, chk, quote, basis]) => `<tr><th scope="row" style="text-transform:none;letter-spacing:0;font:700 14px var(--f-body);color:var(--fg);white-space:normal">${esc(a)}</th><td>${esc(b)}</td><td>${esc(rev)}</td><td>${esc(chk)}</td><td><q>${esc(quote)}</q><br>${ext(u, "GitHub Docs")}</td><td class="muted">${esc(basis)}</td></tr>`).join("")}</tbody></table></div></div>
  <div class="grid2">
  <div class="panel"><h2>Transfer or GitHub Enterprise Importer?</h2><div class="tbl-wrap"><table><thead><tr><th scope="col">What</th><th scope="col">Transfer</th><th scope="col">Importer</th></tr></thead><tbody>${DATA.transfer.map(([f, t, g]) => `<tr><td>${esc(f)}</td><td>${esc(t)}</td><td>${esc(g)}</td></tr>`).join("")}</tbody></table></div>
    <p class="muted" style="font-size:13.5px;margin-top:8px">Transfer keeps redirects and repository secrets, which matters here because other teams reference co-cddo paths. Confirm whether co-cddo and gds-dtx are in the same enterprise before planning internal repositories.</p></div>
  <div class="panel"><h2>Repositories with warnings to resolve before moving</h2><div class="tbl-wrap"><table><thead><tr><th scope="col">Repository</th><th scope="col" class="n">Warnings</th><th scope="col">Destination</th></tr></thead><tbody>${crit.map(([r, n]) => `<tr><td>${openBtn(r.repo)}</td><td class="n">${n}</td><td>${dgroup(r)}</td></tr>`).join("") || `<tr><td colspan="3" class="muted">None.</td></tr>`}</tbody></table></div></div></div>`;
  bindOpen(vb("safe"));
};

/* ---------- PLAN ---------- */
RENDER.plan = () => {
  vb("plan").innerHTML = `<div class="panel"><div class="panel-head"><h2>Repositories by wave</h2><span class="muted">includes decisions recorded on this page</span></div><div class="waves">${GROUPS.map(g => { const rs = rows.filter(r => effGroup(r) === g[0]).sort((a, b) => b.human_commits_365d - a.human_commits_365d || a.repo.localeCompare(b.repo));
    return `<div class="wave" style="--c:var(${g[2]})"><div style="display:flex;justify-content:space-between;gap:8px"><h3>${esc(g[1])}</h3><b class="num">${rs.length}</b></div><ul>${rs.map(r => `<li><button type="button" data-open="${esc(r.repo)}">${esc(r.repo)}</button></li>`).join("")}</ul></div>`; }).join("")}</div></div>
    <div class="panel"><h2>Steps</h2><div class="steps" style="margin-top:10px">${DATA.plan.map((p, i) => `<div class="step"><span class="w" aria-hidden="true">${i + 1}</span><p><b>${esc(p.wave)}</b>: ${esc(p.action)}</p>${p.why ? `<p class="muted" style="font-size:13.5px">${esc(p.why)}</p>` : "<span></span>"}</div>`).join("")}</div></div>`;
  bindOpen(vb("plan"));
};

/* ---------- GDS WAY ---------- */
RENDER.gdsway = () => {
  const mv = rows.filter(r => movingOrDecide(effGroup(r)));
  const cnt = (id, v, set = rows) => set.filter(r => r.gdsway[id][0] === v).length;
  vb("gdsway").innerHTML = `<div class="panel"><div class="panel-head"><h2>GDS Way conformance</h2><span class="muted">checked at the latest commit of every co-cddo repository</span></div>
    <p class="lede">Requirements from ${ext("https://gds-way.digital.cabinet-office.gov.uk/standards/source-code/use-github.html", "Use GitHub")}, ${ext("https://gds-way.digital.cabinet-office.gov.uk/standards/source-code/", "How to store source code")} and ${ext("https://gds-way.digital.cabinet-office.gov.uk/standards/source-code/using-github-actions.html", "Using GitHub Actions")}. Actions owned by GDS organisations count as first party. Account rules (two-factor authentication, email) and branch protection can't be read from public data, so they aren't scored. Fix MUST gaps in the change that moves the repository.</p>
    <div class="warn amber" style="margin-top:10px"><b>Security contact</b><span>gds-dtx has no organisation SECURITY.md. Repositories that rely on co-cddo's are marked “review”: add a SECURITY.md to gds-dtx/.github, or to each repository, before moving.</span></div></div>
    <div class="panel"><div class="tbl-wrap"><table><thead><tr><th scope="col">Requirement</th><th scope="col">Level</th><th scope="col" class="n">Pass</th><th scope="col" class="n">Fail</th><th scope="col" class="n">Review</th><th scope="col" class="n">Fail among repositories moving</th><th scope="col">List</th></tr></thead><tbody>
    ${RULES.map(x => `<tr><td>${ext(x.url, x.text)}</td><td>${esc(x.strength)}</td><td class="n">${cnt(x.id, "pass")}</td><td class="n">${cnt(x.id, "fail")}</td><td class="n">${cnt(x.id, "review")}</td><td class="n"><b>${cnt(x.id, "fail", mv)}</b></td><td><button class="btn sm" type="button" data-rule="${esc(x.id)}">Show failing<span class="sr-only">: ${esc(x.text)}</span></button></td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel" id="gw-list"><p class="muted">Select “Show failing” to list repositories.</p></div>`;
  $$("[data-rule]", vb("gdsway")).forEach(b => b.onclick = () => { const x = RULE[b.dataset.rule]; const rs = rows.filter(r => ["fail","review"].includes(r.gdsway[x.id][0])).sort((a, b) => (movingOrDecide(effGroup(b)) - movingOrDecide(effGroup(a))) || a.repo.localeCompare(b.repo));
    $("#gw-list").innerHTML = `<h2 tabindex="-1" id="gw-h">${esc(x.text)}: ${rs.length} to fix or review</h2><div class="tbl-wrap"><table><thead><tr><th scope="col">Repository</th><th scope="col">Result</th><th scope="col">Evidence</th><th scope="col">Destination</th></tr></thead><tbody>${rs.map(r => `<tr><td>${openBtn(r.repo)}</td><td>${gwTag(r.gdsway[x.id])}</td><td class="muted">${esc(r.gdsway[x.id][1])}</td><td>${dgroup(r)}</td></tr>`).join("")}</tbody></table></div>`; bindOpen($("#gw-list")); $("#gw-h").focus(); });
};

/* ---------- LANDSCAPE (across government) ---------- */
const XS0 = {q:"", sector:"", status:"live", tag:"", org:"", pages:"", page:0, size:50}, XS = {...XS0};
function xMatchTag(x, t) { return t === "DAM" ? !!x.dam : t === "new" ? !!x.nw : t.startsWith("std:") ? x.stds.includes(t.slice(4)) : x.tags.includes(t); }
function xFiltered() { const q = XS.q.trim().toLowerCase();
  return X.filter(x => (!q || q.split(/\s+/).every(t => x.q.includes(t))) && (!XS.sector || x.sector === XS.sector) && (!XS.org || x.org === XS.org) && (!XS.status || (XS.status === "live" ? isLive(x) : x.st === XS.status)) &&
    (!XS.tag || xMatchTag(x, XS.tag)) && (!XS.pages || x.pg)); }
function xTable(target, list, state, rerender, label) {
  const pg = list.slice(state.page * state.size, state.page * state.size + state.size), capId = target.slice(1) + "-cap";
  $(target).innerHTML = `<div class="tbl-wrap"><table><caption class="sr-only" id="${capId}">${esc(label || "Repositories")}, page ${state.page + 1}</caption><thead><tr><th scope="col">Repository</th><th scope="col">Sector</th><th scope="col">Activity</th><th scope="col">Last commit by a person</th><th scope="col" class="n">Commits in 12 months</th><th scope="col" class="n">People in 12 months</th><th scope="col">Flags</th></tr></thead><tbody>${pg.map(x => `<tr><td class="repo">${xBtn(x.key)}<small>${esc(x.desc)}</small></td><td>${esc(x.sector)}</td><td>${pill(x.st)}</td><td>${fmtD(x.lh, true)}</td><td class="n">${x.c12}</td><td class="n">${x.a12}</td><td><div class="chips">${x.nw ? `<span class="chip dep" title="first commit in the last 12 months">new</span>` : ""}${x.dam ? `<span class="chip dam">DAM</span>` : ""}${x.tags.map(t => `<span class="chip str">${esc(t)}</span>`).join("")}${x.pg ? `<span class="chip pg">Pages</span>` : ""}${x.stds.slice(0,3).map(s => `<span class="chip">${esc(s)}</span>`).join("")}</div></td></tr>`).join("") || `<tr><td colspan="7" class="muted" style="padding:20px">No repositories match.</td></tr>`}</tbody></table></div>`;
  $(target).appendChild(pager(state, list.length, rerender, () => $("#" + capId)?.closest("table")));
  bindX($(target));
}
RENDER.landscape = () => {
  const live = XO.filter(o => !o.deleted), sec = SECTORS.map(s => { const os = live.filter(o => o.sector === s); return [s, os.length, os.reduce((a, o) => a + (o.total_on_github || 0), 0), os.reduce((a, o) => a + o.listed, 0), os.reduce((a, o) => a + o.active90, 0), os.reduce((a, o) => a + o.active365, 0), os.reduce((a, o) => a + o.commits12, 0), os.reduce((a, o) => a + o.new12, 0), os.reduce((a, o) => a + o.pages, 0)]; });
  const tot = k => live.reduce((a, o) => a + (o[k] || 0), 0), dead = XO.filter(o => o.deleted);
  vb("landscape").innerHTML = `
  <div class="stats">${[[live.length,"organisations checked"],[nf(tot("total_on_github")),"public repositories on GitHub"],[nf(tot("listed")),"updated in the last 12 months, read and checked with git"],[nf(X.filter(x => x.st === "Active").length),"active: a person committed in 90 days","hl"],[nf(XLIVE.length),"active or maintained"],[nf(X.filter(x => x.nw).length),"first commit in the last 12 months"],[nf(X.filter(x => x.pg).length),"serve GitHub Pages"]].map(([b, s, c]) => `<div class="stat ${c||""}"><b>${esc(b)}</b><span>${esc(s)}</span></div>`).join("")}</div>
  <div class="panel"><h2>What was read</h2><p class="lede" style="margin-top:6px">GitHub reports ${nf(tot("total_on_github"))} public repositories across ${live.length} organisations. Each organisation's list was read newest-updated first and stopped once repositories were more than 12 months old, so the rows here are the ${nf(X.length)} updated in that window, each confirmed with git. Older repositories are counted in the totals but not listed. ${dead.length ? `${dead.length} organisation${dead.length > 1 ? "s" : ""} in GitHub's registry no longer exist${dead.length > 1 ? "" : "s"} (${esc(dead.map(o => o.org).join(", "))}).` : ""} Public sector bodies that use other platforms or keep code private aren't represented, so councils and devolved bodies are under-represented.</p></div>
  <div class="panel"><h2>By sector</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Sector</th><th scope="col" class="n">Organisations</th><th scope="col" class="n">Public repositories</th><th scope="col" class="n">Updated in 12 months</th><th scope="col" class="n">Active</th><th scope="col" class="n">Active or maintained</th><th scope="col" class="n">Commits by people, 12 months</th><th scope="col" class="n">New</th><th scope="col" class="n">Pages</th></tr></thead><tbody>${sec.map(s => `<tr><td><button class="btn sm" type="button" data-sec="${esc(s[0])}">${esc(s[0])}</button></td>${s.slice(1).map(v => `<td class="n">${nf(v)}</td>`).join("")}</tr>`).join("")}</tbody></table></div></div>
  <div class="panel"><h2>Organisations</h2><div class="tbl-wrap" style="margin-top:8px;max-height:480px;overflow-y:auto" tabindex="0" role="region" aria-label="Organisations table, scrollable"><table><thead><tr><th scope="col">Organisation</th><th scope="col">Sector</th><th scope="col" class="n">Public repositories</th><th scope="col" class="n">Updated in 12 months</th><th scope="col" class="n">Active</th><th scope="col" class="n">Commits by people, 12 months</th><th scope="col" class="n">People, 12 months</th><th scope="col" class="n">New</th><th scope="col" class="n">Pages</th><th scope="col" class="n">Default branch “main”</th></tr></thead><tbody>${[...XO].sort((a, b) => b.commits12 - a.commits12 || a.org.localeCompare(b.org)).map(o => `<tr><td><button class="btn sm" type="button" data-org="${esc(o.org)}"><span class="mono">${esc(o.org)}</span></button>${String(o.source).startsWith("added") ? ' <span class="chip">added</span>' : ""}${o.deleted ? ' <span class="chip risk">no longer exists</span>' : ""}</td><td>${esc(o.sector)}</td><td class="n">${o.deleted ? "—" : nf(o.total_on_github)}</td><td class="n">${o.listed}</td><td class="n">${o.active90}</td><td class="n">${nf(o.commits12)}</td><td class="n">${o.authors12}</td><td class="n">${o.new12}</td><td class="n">${o.pages}</td><td class="n">${o.main + o.master ? Math.round(100 * o.main / (o.main + o.master)) + "%" : "—"}</td></tr>`).join("")}</tbody></table></div></div>
  <div class="panel"><h2 style="margin-bottom:10px" id="x-h" tabindex="-1">Search every repository</h2><div class="filters">
    <label class="grow" for="x-q">Search<input type="search" id="x-q" placeholder="for example metadata, dcat, legacy, llm, one login"></label>
    <label for="x-sector">Sector<select id="x-sector"><option value="">Any</option>${SECTORS.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("")}</select></label>
    <label for="x-status">Activity<select id="x-status"><option value="">Any</option><option value="live">Active or maintained</option>${XSTATUSES.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("")}</select></label>
    <label for="x-tag">Tag<select id="x-tag"><option value="">Any</option><option value="new">First commit in the last 12 months</option><option value="DAM">DAM and metadata</option>${DATA.strategy.map(s => `<option value="${esc(s.id)}">${esc(s.id)}: ${esc(s.short)}</option>`).join("")}${DATA.standards.map(s => `<option value="std:${esc(s)}">Standard: ${esc(s)}</option>`).join("")}</select></label>
    <label for="x-org">Organisation<select id="x-org"><option value="">Any</option>${XO.map(o => o.org).sort((a, b) => a.localeCompare(b)).map(o => `<option value="${esc(o)}">${esc(o)}</option>`).join("")}</select></label>
    <label for="x-pages" style="flex-direction:row;display:flex;gap:6px;align-items:center"><input type="checkbox" id="x-pages"> Has a Pages site</label><button class="btn" type="button" id="x-reset">Clear filters</button></div>
    <p class="count" id="x-count" role="status" aria-live="polite" style="margin-top:8px"></p><div id="x-table"></div></div>`;
  const rer = () => { const l = xFiltered().sort((a, b) => (b.lh || 0) - (a.lh || 0) || a.key.localeCompare(b.key)); $("#x-count").textContent = `${nf(l.length)} repositories`; xTable("#x-table", l, XS, rer, "Repositories across government"); };
  const syncInputs = () => [["#x-q","q"],["#x-sector","sector"],["#x-status","status"],["#x-tag","tag"],["#x-org","org"]].forEach(([id, k]) => { $(id).value = XS[k]; });
  [["#x-q","q","input"],["#x-sector","sector"],["#x-status","status"],["#x-tag","tag"],["#x-org","org"]].forEach(([id, k, ev]) => { $(id).addEventListener(ev || "change", e => { XS[k] = e.target.value; XS.page = 0; rer(); }); });
  syncInputs(); $("#x-pages").checked = !!XS.pages; $("#x-pages").onchange = e => { XS.pages = e.target.checked ? "1" : ""; XS.page = 0; rer(); };
  $("#x-reset").onclick = () => { Object.assign(XS, XS0); syncInputs(); $("#x-pages").checked = false; rer(); };
  $$("[data-sec]", vb("landscape")).forEach(b => b.onclick = () => { Object.assign(XS, XS0, {sector: b.dataset.sec}); syncInputs(); rer(); $("#x-h").focus(); });
  $$("[data-org]", vb("landscape")).forEach(b => b.onclick = () => { Object.assign(XS, XS0, {org: b.dataset.org, status: ""}); syncInputs(); rer(); $("#x-h").focus(); });
  rer();
};
/* every drill-down uses the same defaults (active or maintained unless stated) (D18) */
function xgoTo(p) { Object.assign(XS, XS0, p); rendered.delete("landscape"); go("landscape"); setTimeout(() => { $("#x-h")?.focus(); }, 0); }

/* ---------- STRATEGY ALIGNMENT ---------- */
RENDER.strategy = () => {
  const live = XLIVE, groups = [...new Set(DATA.strategy.map(s => s.group))];
  const pTag = id => { const p = precInfo(id); return `<span class="${p.cand ? "cand" : "faint"}" style="font-size:12px">${p.cand ? "Candidates only: " : ""}${esc(p.txt)}</span>`; };
  const bar = (label, n, max, attrs, id) => `<div class="bar"><button type="button" ${attrs}>${esc(label)}</button><div class="track" aria-hidden="true"><div class="fill" style="width:${max ? (100 * n / max).toFixed(1) : 0}%"></div></div><span class="num">${nf(n)}</span></div>${id ? `<div style="margin:-2px 0 6px">${pTag(id)}</div>` : ""}`;
  const cnt = id => live.filter(x => x.tags.includes(id)).length, maxC = Math.max(1, ...DATA.strategy.map(s => cnt(s.id)), live.filter(x => x.dam).length);
  const coCnt = id => rows.filter(r => id === "DAM" ? r.dam : id in r.tags).length;
  vb("strategy").innerHTML = `
  <div class="panel"><h2>How active work lines up with government priorities</h2><p class="lede" style="margin-top:6px">A repository is tagged when its name, description, topics or the first paragraph of its README match a declared phrase list for a strategy or programme. Tags show what matched. An AI reviewer checked a sample of each tag; the share it judged correct is shown as precision, and tags under 70% are labelled as candidates. Tags find work to look at, not proof of contribution: check with the owning team before citing it. Data Foundations numbers (DF1 to DF6) are this page's shorthand.</p></div>
  <div class="grid2">${groups.map(g => `<div class="panel"><div class="panel-head"><h2>${esc(g)}</h2><span class="muted">active or maintained repositories</span></div><div class="bars">${DATA.strategy.filter(s => s.group === g).map(s => bar(`${s.id}: ${s.short}`, cnt(s.id), maxC, `data-tag="${esc(s.id)}" title="${esc(s.label)}"`, s.id)).join("")}${g.startsWith("Government Data") ? bar("DAM and metadata", live.filter(x => x.dam).length, maxC, 'data-tag="DAM"', "DAM") : ""}</div>
    <p class="faint" style="font-size:12.5px;margin-top:8px">Sources: ${DATA.strategy.filter(s => s.group === g).map(s => ext(s.url, s.id)).join(" · ")}</p></div>`).join("")}</div>
  <div class="panel"><div class="panel-head"><h2>Sector by priority</h2><span class="muted">active or maintained repositories · select a number to list them</span></div><div class="tbl-wrap"><table class="matrix"><thead><tr><th scope="col">Sector</th>${[...DATA.strategy.map(s => s.id), "DAM"].map(id => `<th scope="col" class="n"><abbr title="${esc(STRAT[id]?.label || "DAM and metadata")}">${esc(id)}</abbr></th>`).join("")}</tr></thead><tbody>
    ${SECTORS.map(sc => { const sl = live.filter(x => x.sector === sc); const vals = [...DATA.strategy.map(s => [s.id, sl.filter(x => x.tags.includes(s.id)).length]), ["DAM", sl.filter(x => x.dam).length]]; const mx = Math.max(1, ...vals.map(v => v[1]));
      return `<tr><th scope="row">${esc(sc)}</th>${vals.map(([id, v]) => `<td class="cell heat" style="--h:${(v / mx).toFixed(2)}">${v ? `<button type="button" data-tag="${esc(id)}" data-sec="${esc(sc)}" aria-label="${v} ${esc(sc)} repositories tagged ${esc(id)}">${v}</button>` : '<span class="faint"><span aria-hidden="true">·</span><span class="sr-only">none</span></span>'}</td>`).join("")}</tr>`; }).join("")}</tbody></table></div></div>
  <div class="grid2"><div class="panel"><h2>co-cddo repositories by priority</h2><div class="bars" style="margin-top:8px">${[...DATA.strategy.map(s => [s.id, s.short]), ["DAM", "DAM and metadata"]].map(([id, l]) => bar(`${id}: ${l}`, coCnt(id), rows.length, `data-cotag="${esc(id)}"`)).join("")}</div></div>
    <div class="panel"><h2>Most active organisations on Government Data and OCTO priorities</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Organisation</th><th scope="col" class="n">Data Foundations</th><th scope="col" class="n">Firmer foundations</th><th scope="col" class="n">DAM and metadata</th></tr></thead><tbody>${XO.map((o, oi) => { const ol = live.filter(x => x.oi === oi); return [o.org, ol.filter(x => x.tags.some(t => t.startsWith("DF"))).length, ol.filter(x => x.tags.includes("FF")).length, ol.filter(x => x.dam).length]; }).filter(r => r[1] + r[2] + r[3]).sort((a, b) => (b[1] + b[3]) - (a[1] + a[3]) || a[0].localeCompare(b[0])).slice(0, 15).map(r => `<tr><td><button class="btn sm" type="button" data-org="${esc(r[0])}"><span class="mono">${esc(r[0])}</span></button></td><td class="n">${r[1]}</td><td class="n">${r[2]}</td><td class="n">${r[3]}</td></tr>`).join("")}</tbody></table></div></div></div>`;
  $$("[data-tag]", vb("strategy")).forEach(b => b.onclick = () => xgoTo({tag: b.dataset.tag, sector: b.dataset.sec || ""}));
  $$("[data-cotag]", vb("strategy")).forEach(b => b.onclick = () => filterTo({strat: b.dataset.cotag}));
  $$("[data-org]", vb("strategy")).forEach(b => b.onclick = () => xgoTo({org: b.dataset.org}));
};

/* ---------- DAM AND METADATA ---------- */
RENDER.dam = () => {
  const dx = XLIVE.filter(x => x.org !== "co-cddo" && (x.dam || x.tags.includes("DF5") || x.tags.includes("DF3"))).sort((a, b) => (b.dam ? 1 : 0) - (a.dam ? 1 : 0) || b.c90 - a.c90 || a.key.localeCompare(b.key));
  const coD = rows.filter(r => r.dam || "DF5" in r.tags || "DF3" in r.tags);
  const stdCount = DATA.standards.map(s => [s, XLIVE.filter(x => x.org !== "co-cddo" && x.stds.includes(s)).length, rows.filter(r => r.standards.includes(s)).length]).filter(s => s[1] + s[2]).sort((a, b) => b[1] + b[2] - a[1] - a[2] || a[0].localeCompare(b[0]));
  const DS = {page:0, size:25}, p = precInfo("DAM");
  vb("dam").innerHTML = `
  <div class="panel"><h2>Supporting the Data Asset Management policy rollout</h2><p class="lede" style="margin-top:6px">Code that helps departments identify, describe and catalogue critical data assets: metadata models, data catalogues, information asset registers, data quality and ownership tooling, and the open standards they use. Relevant to the ${ext("https://www.gov.uk/government/publications/data-asset-management-policy-in-government", "DAM policy")}, the ${ext("https://www.gov.uk/government/publications/identify-and-record-critical-data-assets", "critical data assets guidance")} and ${ext("https://www.gov.uk/government/collections/metadata-standards-for-sharing-and-publishing-data", "metadata standards")}.</p>
  <p class="${p.cand ? "cand" : "faint"}" style="margin-top:6px;font-size:13px">DAM tag: ${esc(p.txt)}.${p.cand ? " Treat these as candidates." : ""}</p></div>
  <div class="stats">${[[coD.length,"co-cddo repositories relevant to DAM or data infrastructure","hl"],[dx.length,"active or maintained repositories across government"],[new Set(dx.map(x => x.org)).size,"organisations"],[dx.filter(x => x.nw).length,"first commit in the last 12 months"],[stdCount.length,"open standards in use"]].map(([b, s, c]) => `<div class="stat ${c||""}"><b>${esc(b)}</b><span>${esc(s)}</span></div>`).join("")}</div>
  <div class="grid2"><div class="panel"><h2>co-cddo repositories to carry across carefully</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Repository</th><th scope="col">Why</th><th scope="col">Standards</th><th scope="col">Destination</th></tr></thead><tbody>${coD.map(r => `<tr><td>${openBtn(r.repo)}</td><td class="muted">${esc([r.dam_basis, ...Object.entries(r.tags).filter(([k]) => k === "DF5" || k === "DF3").map(([k, v]) => k + " “" + v + "”")].filter(Boolean).join("; "))}</td><td>${esc(r.standards.join(", "))}</td><td>${dgroup(r)}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>Open standards found</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Standard</th><th scope="col" class="n">Active or maintained across government</th><th scope="col" class="n">co-cddo</th></tr></thead><tbody>${stdCount.map(([s, a, c]) => `<tr><td><button class="btn sm" type="button" data-std="${esc(s)}">${esc(s)}</button></td><td class="n">${a}</td><td class="n">${c}</td></tr>`).join("")}</tbody></table></div>
    <p class="faint" style="font-size:12.5px;margin-top:8px">Across government: matched in name, description, topics, README first paragraph or standard files (for example catalog-info.yaml, .ttl). co-cddo: also matched in file contents.</p></div></div>
  <div class="panel"><div class="panel-head"><h2>Across government</h2><span class="muted">DAM, metadata, catalogues and data infrastructure (DF3, DF5)</span></div><div id="dam-table"></div></div>`;
  const rer = () => xTable("#dam-table", dx, DS, rer, "DAM and metadata repositories across government"); rer(); bindOpen(vb("dam"));
  $$("[data-std]", vb("dam")).forEach(b => b.onclick = () => xgoTo({tag: "std:" + b.dataset.std}));
};

/* ---------- GITHUB PAGES ---------- */
RENDER.pages = () => {
  const pg = X.filter(x => x.pg && safeUrl(x.pu)).sort((a, b) => (b.org === "co-cddo") - (a.org === "co-cddo") || a.key.localeCompare(b.key)), co = pg.filter(x => x.org === "co-cddo");
  const PS = {page:0, size:50, q:""};
  vb("pages").innerHTML = `
  <div class="warn"><b>co-cddo has ${co.length} live GitHub Pages site${co.length === 1 ? "" : "s"}.</b><span>GitHub doesn't redirect co-cddo.github.io addresses when a repository moves. Sites on a custom domain must have the domain verified under the new organisation first, or the domain can be taken over.</span></div>
  <div class="panel"><h2>co-cddo sites</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Repository</th><th scope="col">Site</th><th scope="col">Custom domain</th><th scope="col">Destination</th><th scope="col">Action</th></tr></thead><tbody>${co.map(x => { const r = byName[x.n]; return `<tr><td>${openBtn(x.n)}</td><td>${ext(x.pu, x.pu)}</td><td>${esc(x.cd) || "—"}</td><td>${r ? dgroup(r) : "<span class='muted'>not in inventory</span>"}</td><td class="muted">${x.cd ? "Verify the domain under the new organisation before cutover" : "Agree a stable address or custom domain; tell users"}</td></tr>`; }).join("")}</tbody></table></div></div>
  <div class="panel"><div class="panel-head"><h2>All GitHub Pages sites found across government</h2><span class="muted">${nf(pg.length)} sites in ${new Set(pg.map(x => x.org)).size} organisations</span></div>
    <div class="filters"><label class="grow" for="p-q">Filter<input type="search" id="p-q" placeholder="organisation, repository or domain"></label></div><p class="count" id="p-count" role="status" aria-live="polite"></p><div id="p-table" style="margin-top:8px"></div>
    <p class="faint" style="font-size:12.5px;margin-top:8px">Found by requesting each repository's organisation.github.io address and following redirects; a site counts when the final response is 200. Organisations whose github.io domain redirects everything to a custom domain were tested with a control address. Only repositories updated in the last 12 months were probed.</p></div>`;
  const rer = () => { const q = PS.q.toLowerCase(); const l = pg.filter(x => !q || (x.key + " " + x.pu + " " + x.cd).toLowerCase().includes(q)); const sl = l.slice(PS.page * PS.size, PS.page * PS.size + PS.size);
    $("#p-count").textContent = `${nf(l.length)} sites`;
    $("#p-table").innerHTML = `<div class="tbl-wrap"><table id="p-tbl"><caption class="sr-only">GitHub Pages sites, page ${PS.page + 1}</caption><thead><tr><th scope="col">Repository</th><th scope="col">Sector</th><th scope="col">Site</th><th scope="col">Activity</th></tr></thead><tbody>${sl.map(x => `<tr><td>${xBtn(x.key)}</td><td>${esc(x.sector)}</td><td>${ext(x.pu, x.cd || x.pu.replace(/^https?:\/\//, ""))}</td><td>${pill(x.st)}</td></tr>`).join("")}</tbody></table></div>`; $("#p-table").appendChild(pager(PS, l.length, rer, () => $("#p-tbl"))); bindX($("#p-table")); };
  $("#p-q").oninput = e => { PS.q = e.target.value; PS.page = 0; rer(); }; rer(); bindOpen(vb("pages"));
};

/* ---------- ENGINEERING PRACTICE benchmark ---------- */
const BM = [["readme","README"],["mitogl","MIT or OGL licence"],["anylic","Any licence"],["codeowners","CODEOWNERS"],["dependabot","Dependabot or Renovate"],["security","SECURITY.md in the repository"],["pinned","Third-party actions all pinned to a SHA"],["perms","Workflows all set permissions"]];
RENDER.practice = () => {
  const B = DATA.bench, entries = [["co-cddo (active or maintained)", DATA.bench_co, true], ...Object.entries(B).map(([k, v]) => [k, v, false])];
  const cell = v => { if (!v || v[1] === 0 || v[2] === null) return `<td class="n faint">—</td>`; return `<td class="n cell heat" style="--h:${(v[2] / 100).toFixed(2)}"><b>${v[2]}%</b><br><span class="muted" style="font-size:12px">${nf(v[0])} of ${nf(v[1])}</span></td>`; };
  vb("practice").innerHTML = `
  <div class="panel"><h2>Engineering practice across government</h2><p class="lede" style="margin-top:6px">How often active and maintained repositories meet signals from the GDS Way, read from files at each repository's latest commit on ${fmtD(DATA.meta.enr_date)}. co-cddo is measured the same way from its full inventory. This compares practice, not quality: a repository can be well run without these files, and organisation-level files (like a shared SECURITY.md) are not counted here.</p></div>
  <div class="panel"><div class="tbl-wrap"><table class="matrix"><caption class="sr-only">Share of repositories meeting each practice signal, by group</caption><thead><tr><th scope="col">Group</th><th scope="col" class="n">Repositories</th>${BM.map(([k, l]) => `<th scope="col" class="n" style="white-space:normal;min-width:9ch">${esc(l)}</th>`).join("")}</tr></thead><tbody>
    ${entries.map(([k, v, co]) => `<tr${co ? ' style="outline:2px solid var(--accent);outline-offset:-2px"' : ""}><th scope="row" style="white-space:normal">${esc(k)}</th><td class="n">${nf(v.n)}</td>${BM.map(([m]) => cell(v[m])).join("")}</tr>`).join("")}</tbody></table></div>
    <p class="faint" style="font-size:12.5px;margin-top:8px">Pinning is out of repositories with third-party actions; permissions is out of repositories whose workflows were read (up to 6 per repository). GDS-owned actions count as first party. A dash means no repositories in that group had the signal to measure.</p></div>`;
};
