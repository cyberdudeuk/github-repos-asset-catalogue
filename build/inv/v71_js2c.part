
/* ================= v5.1: Catalogues and standards ================= */
const STDD = DATA.std, LVL = STDD.levels, LVLS = ["1","2","3","4"];
const lvlTag = l => `<span class="ck ${l >= 4 ? "pass" : l >= 3 ? "live" : "notrun"}">${esc(LVL[l])}</span>`;
const SORG = Object.entries(STDD.orgs).map(([org, v]) => ({org, ...v, maxStd: Math.max(0, ...Object.values(v.standards).map(x => x.level)), hasCode: Object.values(v.platforms).some(p => p.level === "Code or configuration")}));
const STDS = [...new Set(SORG.flatMap(o => Object.keys(o.standards)))].sort();
const PLATS = [...new Set(SORG.flatMap(o => Object.keys(o.platforms)))].sort();
const SS0 = {q:"", pclass:"", std:"", lvl:"", sector:"", has:"", page:0, size:40}, SSF = {...SS0};
function stdFiltered() { const q = SSF.q.toLowerCase();
  return SORG.filter(o => (!q || (o.org + " " + (o.body || "")).toLowerCase().includes(q)) && (!SSF.sector || o.sector === SSF.sector) &&
    (!SSF.pclass || Object.values(o.platforms).some(p => p.class === SSF.pclass)) && (!SSF.std || (o.standards[SSF.std] && o.standards[SSF.std].level >= (+SSF.lvl || 1))) && (SSF.std || !SSF.lvl || o.maxStd >= +SSF.lvl) &&
    (!SSF.has || (SSF.has === "platform" ? Object.keys(o.platforms).length : SSF.has === "code" ? o.hasCode : SSF.has === "data" ? Object.keys(o.publishing).length && o.maxStd < 3 : true)))
    .sort((a, b) => (b.hasCode - a.hasCode) || (b.maxStd - a.maxStd) || (Object.keys(b.platforms).length - Object.keys(a.platforms).length) || a.org.localeCompare(b.org)); }
RENDER.standards = () => {
  const reposAt = (st, l) => Object.entries(STDD.repos).filter(([k, v]) => v.s[st] && v.s[st][0] === l).map(([k]) => k);
  const memRefs = Object.entries(STDD.repos).filter(([k, v]) => v.s["xGov MEM"]).map(([k]) => k);
  const dcat4 = reposAt("DCAT", 4), dcat3 = reposAt("DCAT", 3);
  const pubOnly = Object.keys(STDD.pub).filter(k => !STDD.repos[k] || !Object.values(STDD.repos[k].s).some(x => x[0] >= 3)).length;
  const classes = [...new Set(Object.values(STDD.pclass))].sort();
  vb("standards").innerHTML = `
  <div class="panel"><h2>Data catalogues and metadata standards across government</h2><p class="lede" style="margin-top:6px">Which organisations have data catalogues and from which vendors, which metadata and other open standards they apply, and whether in the data itself and at record level. Platforms are “mentioned” or found in <b>code or configuration</b>. Standards are graded per repository from 1 to 4: ${LVLS.map(l => lvlTag(+l)).join(" ")}. ${STDD.fetched.files_parsed} files from ${STDD.fetched.repos} repositories were fetched and parsed to grade levels 2 to 4.</p>
    <div class="warn amber" style="margin-top:10px"><b>Read this before quoting a number</b><span>${esc(STDD.note)} Catalogue records usually live in a catalogue's database, not in git, so record-level use is better tested against catalogue APIs. Use this as a lead list and corroborating evidence beside departmental returns, not as a census.</span></div></div>
  <div class="stats">${[[SORG.filter(o => Object.keys(o.platforms).length).length, "organisations with a catalogue platform signal", "hl"], [SORG.filter(o => o.hasCode).length, "with platform code or configuration"], [SORG.filter(o => o.maxStd >= 3).length, "applying a metadata standard in data files"], [SORG.filter(o => o.maxStd >= 4).length, "with record-level use"], [memRefs.length, "repositories carrying the xGov MEM"], [pubOnly, "repositories publishing data files without a metadata standard"]].map(([b, s, c]) => `<div class="stat ${c || ""}"><b>${b}</b><span>${esc(s)}</span></div>`).join("")}</div>
  <div class="panel"><h2>What stands out</h2><ul style="margin:.5em 0 0;padding-left:20px;display:grid;gap:4px;max-width:85ch">
    <li>DCAT is applied to every record in a data file in ${dcat4.length} repositor${dcat4.length === 1 ? "y" : "ies"} (${dcat4.map(k => esc(k)).join(", ") || "none"}), and in data files in ${dcat3.length} more. Most DCAT in government is served by catalogue software (for example CKAN's DCAT plugin on data.gov.uk), not held in git.</li>
    <li>The xGov MEM is carried by ${memRefs.length} repositor${memRefs.length === 1 ? "y" : "ies"} (${memRefs.map(k => esc(k)).join(", ") || "none"})${memRefs.every(k => k.startsWith("co-cddo/")) ? ", all in co-cddo: no other public repository yet references it in its name, description, README or schemas" : ""}.</li>
    <li>Record-level use found: ${STDS.map(st => [st, reposAt(st, 4)]).filter(x => x[1].length).sort((a, b) => b[1].length - a[1].length).map(([st, r]) => `${esc(st)} in ${r.length} (${r.map(esc).join(", ")})`).join("; ") || "none"}.</li>
    <li>OpenAPI (${Object.values(STDD.repos).filter(v => v.s.OpenAPI).length} repositories) and JSON Schema (${Object.values(STDD.repos).filter(v => v.s["JSON Schema"]).length}) are the most widely used open standards for describing interfaces and payloads.</li></ul></div>
  ${relElse("standards")}
  <div class="panel"><h2>Platforms and vendors</h2><div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th scope="col">Platform</th><th scope="col">Class</th><th scope="col">Vendor or steward</th><th scope="col">Model</th><th scope="col" class="n">Organisations with code or configuration</th><th scope="col" class="n">Organisations mentioning it</th><th scope="col">Organisations</th></tr></thead><tbody>
    ${PLATS.map(p => { const os = SORG.filter(o => o.platforms[p]), code = os.filter(o => o.platforms[p].level === "Code or configuration"); return `<tr><th scope="row" style="text-transform:none;letter-spacing:0;font:700 13.5px var(--f-body);color:var(--fg);white-space:normal">${esc(p)}</th><td>${esc(STDD.pclass[p] || "")}</td><td>${esc((STDD.vendor[p] || [])[0] || "")}</td><td>${esc((STDD.vendor[p] || [])[1] || "")}</td><td class="n">${code.length}</td><td class="n">${os.length - code.length}</td><td>${os.map(o => `<button class="btn sm" type="button" data-sorg="${esc(o.org)}">${esc(o.org)}</button>`).join(" ")}</td></tr>`; }).join("")}</tbody></table></div></div>
  <div class="panel"><h2>Standards by level</h2><p class="muted" style="font-size:13.5px">Repositories at each level. Select a number to list them.</p><div class="tbl-wrap" style="margin-top:8px"><table class="matrix"><thead><tr><th scope="col">Standard</th>${LVLS.map(l => `<th scope="col" class="n">${esc(LVL[l])}</th>`).join("")}<th scope="col" class="n">Organisations</th></tr></thead><tbody>
    ${STDS.map(st => `<tr id="std-${esc(stdId(st))}"><th scope="row" style="white-space:normal">${esc(st)}</th>${LVLS.map(l => { const r = reposAt(st, +l); return `<td class="cell">${r.length ? `<button type="button" data-std="${esc(st)}" data-lvl="${l}" aria-label="${r.length} repositories at ${esc(LVL[l])} for ${esc(st)}">${r.length}</button>` : `<span class="faint"><span aria-hidden="true">·</span><span class="sr-only">none</span></span>`}</td>`; }).join("")}<td class="n">${SORG.filter(o => o.standards[st]).length}</td></tr>`).join("")}</tbody></table></div>
    <div id="std-list"></div></div>
  <div class="panel"><h2 id="sd-h" tabindex="-1">Directory of data catalogues, by organisation</h2><p class="muted" style="font-size:13.5px">Shaped for the Directory of Data Catalogues: platform, vendor and class, standards with their highest level, and data publishing signals. Select an organisation for its evidence.</p>
    <div class="filters" style="margin-top:8px"><label class="grow" for="sd-q">Organisation or body<input type="search" id="sd-q"></label>
    <label for="sd-pc">Platform class<select id="sd-pc"><option value="">Any</option>${classes.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join("")}</select></label>
    <label for="sd-st">Standard<select id="sd-st"><option value="">Any</option>${STDS.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("")}</select></label>
    <label for="sd-lv">At least<select id="sd-lv"><option value="">Any level</option>${LVLS.map(l => `<option value="${l}">${esc(LVL[l])}</option>`).join("")}</select></label>
    <label for="sd-sec">Sector<select id="sd-sec"><option value="">Any</option>${SECTORS.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("")}</select></label>
    <label for="sd-has">Show<select id="sd-has"><option value="">All with any signal</option><option value="platform">With a platform</option><option value="code">With platform code or configuration</option><option value="data">Publishing data without a standard in data</option></select></label>
    <button class="btn" type="button" id="sd-reset">Clear filters</button></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px"><p class="count" id="sd-count" role="status" aria-live="polite"></p><button class="btn sm" type="button" id="sd-csv">Download for the Directory of Data Catalogues (CSV)</button><span class="status-line" id="sd-st2" role="status"></span></div>
    <div id="sd-table"></div></div>`;
  const ids = [["#sd-q","q","input"],["#sd-pc","pclass"],["#sd-st","std"],["#sd-lv","lvl"],["#sd-sec","sector"],["#sd-has","has"]];
  const rer = () => { const l = stdFiltered(), pg = l.slice(SSF.page * SSF.size, SSF.page * SSF.size + SSF.size);
    $("#sd-count").textContent = `${l.length} organisations`;
    $("#sd-table").innerHTML = `<div class="tbl-wrap"><table id="sd-tbl"><caption class="sr-only">Organisations, page ${SSF.page + 1}</caption><thead><tr><th scope="col">Organisation</th><th scope="col">Public body</th><th scope="col">Catalogue platforms</th><th scope="col">Standards (highest level)</th><th scope="col">Data files published</th></tr></thead><tbody>${pg.map(o => `<tr><td><button class="btn sm" type="button" data-sorg="${esc(o.org)}"><span class="mono">${esc(o.org)}</span></button></td><td>${esc(o.body || "—")}<br><span class="muted" style="font-size:12px">${esc(o.body_type || o.sector || "")}</span></td><td>${Object.entries(o.platforms).map(([p, x]) => `<span class="chip ${x.level === "Code or configuration" ? "dep" : ""}">${esc(p)}${x.level === "Code or configuration" ? " · code" : " · mentioned"}</span>`).join(" ") || '<span class="muted">none found</span>'}</td><td>${Object.entries(o.standards).sort((a, b) => b[1].level - a[1].level).slice(0, 6).map(([s, x]) => `<span class="chip">${esc(s)}: ${esc(LVL[x.level])}</span>`).join(" ")}</td><td class="muted" style="font-size:13px">${esc(Object.entries(o.publishing).map(([k, n]) => `${k} in ${n} repo${n > 1 ? "s" : ""}`).join("; ")) || "—"}</td></tr>`).join("") || `<tr><td colspan="5" class="muted">No organisations match.</td></tr>`}</tbody></table></div>`;
    $("#sd-table").appendChild(pager(SSF, l.length, rer, () => $("#sd-tbl"))); bindSorg($("#sd-table")); };
  ids.forEach(([id, k, ev]) => { $(id).value = SSF[k]; $(id).addEventListener(ev || "change", e => { SSF[k] = e.target.value; SSF.page = 0; rer(); }); });
  $("#sd-reset").onclick = () => { Object.assign(SSF, SS0); ids.forEach(([id, k]) => $(id).value = SSF[k]); rer(); };
  $("#sd-csv").onclick = () => save("directory-of-data-catalogues-evidence-" + DATA.meta.ref_date + ".csv", stdCsv(stdFiltered()), $("#sd-st2"));
  $$("[data-std]", vb("standards")).forEach(b => b.onclick = () => { const st = b.dataset.std, l = +b.dataset.lvl, ks = reposAt(st, l);
    $("#std-list").innerHTML = `<h3 tabindex="-1" id="std-lh" style="margin-top:12px">${esc(st)}: ${esc(LVL[l])} (${ks.length})</h3><div class="tbl-wrap"><table><thead><tr><th scope="col">Repository</th><th scope="col">Evidence</th></tr></thead><tbody>${ks.map(k => `<tr><td>${XBY[k] ? xBtn(k) : byName[k.split("/")[1]] && k.startsWith("co-cddo/") ? openBtn(k.split("/")[1], k) : esc(k)}</td><td class="muted" style="font-size:13px">${STDD.repos[k].s[st][1].map(esc).join("<br>")}</td></tr>`).join("")}</tbody></table></div>`;
    bindX($("#std-list")); bindOpen($("#std-list")); $("#std-lh").focus(); });
  bindSorg(vb("standards")); rer();
};
function bindSorg(root) { $$("[data-sorg]", root).forEach(b => { if (b._s) return; b._s = 1; b.onclick = () => openSorg(b.dataset.sorg); }); }
function openSorg(org) {
  const o = STDD.orgs[org]; if (!o) return;
  const repos = Object.entries(STDD.repos).filter(([k]) => k.split("/")[0] === org);
  openShell(org, `<div class="eyebrow">Catalogues and standards · ${esc(o.body || o.sector || "")}</div>`, `
    <div class="box"><div><span class="prov o">Platforms</span></div>${Object.keys(o.platforms).length ? `<div class="tbl-wrap"><table><thead><tr><th scope="col">Platform</th><th scope="col">Class</th><th scope="col">Vendor</th><th scope="col">Level</th><th scope="col">Repositories</th></tr></thead><tbody>${Object.entries(o.platforms).map(([p, x]) => `<tr><td>${esc(p)}</td><td>${esc(x.class)}</td><td>${esc(x.vendor)} <span class="muted">(${esc(x.model)})</span></td><td>${esc(x.level)}</td><td>${x.repos.map(k => esc(k.split("/")[1])).join(", ")}</td></tr>`).join("")}</tbody></table></div>` : '<p class="muted">No platform signal found in public code.</p>'}</div>
    <div class="box"><div><span class="prov o">Standards</span> <span class="muted" style="font-size:12.5px">highest level per standard</span></div>${kv(Object.entries(o.standards).sort((a, b) => b[1].level - a[1].level).map(([s, x]) => [s, `${lvlTag(x.level)} <span class="muted">in ${x.n} repositor${x.n === 1 ? "y" : "ies"}</span>`]))}</div>
    <div class="box"><div><span class="prov o">Evidence by repository</span></div>${repos.map(([k, v]) => `<details><summary class="mono" style="font-size:13px">${esc(k.split("/")[1])}</summary><ul style="margin:.3em 0 .6em;padding-left:18px;font-size:13px">${Object.entries(v.p).map(([p, x]) => `<li><b>${esc(p)}</b> (${esc(x[0])}): ${x[1].map(esc).join("; ")}</li>`).join("")}${Object.entries(v.s).map(([s, x]) => `<li><b>${esc(s)}</b> (${esc(LVL[x[0]])}): ${x[1].map(esc).join("; ")}</li>`).join("")}</ul>${XBY[k] ? xBtn(k, "Open the catalogue record") : ""}</details>`).join("") || '<p class="muted">Signals come only from data files published.</p>'}
    ${Object.keys(o.publishing).length ? `<p class="muted" style="font-size:13px;margin-top:6px">Data files published: ${esc(Object.entries(o.publishing).map(([k, n]) => `${k} in ${n} repositories`).join("; "))}.</p>` : ""}</div>`);
}
function stdCsv(list) {
  const head = ["github_account","public_body","body_type","sector","platform","platform_class","vendor","vendor_model","platform_evidence_level","platform_repositories","standards_highest_level","record_level_standards","data_files_published","evidence_source"];
  const rowsOut = [];
  for (const o of list) { const stds = Object.entries(o.standards).sort((a, b) => b[1].level - a[1].level).map(([s, x]) => `${s} (${LVL[x.level]})`).join("; "), rec = Object.entries(o.standards).filter(([s, x]) => x.level >= 4).map(([s]) => s).join("; "), pub = Object.entries(o.publishing).map(([k, n]) => `${k}: ${n}`).join("; ");
    const ps = Object.entries(o.platforms); if (!ps.length) rowsOut.push([o.org, o.body, o.body_type, o.sector, "", "", "", "", "", "", stds, rec, pub, "public GitHub, " + DATA.meta.ref_date]);
    for (const [p, x] of ps) rowsOut.push([o.org, o.body, o.body_type, o.sector, p, x.class, x.vendor, x.model, x.level, x.repos.join(" "), stds, rec, pub, "public GitHub, " + DATA.meta.ref_date]); }
  return "﻿" + [head.join(","), ...rowsOut.map(r => r.map(csvCell).join(","))].join("\r\n");
}
