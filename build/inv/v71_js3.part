/* Views left out of the open edition (ADR 0004) render a short notice instead. */
for (const t of HIDDEN_VIEWS) RENDER[t] = () => { vb(t).innerHTML = `<div class="panel" data-hiddenview="1"><h2>${esc(TITLE[t] || t)}</h2><p>This view is only in the government edition of the catalogue, for government and public sector users. It covers ${MOVE_TABS.includes(t) ? "the proposed move of repositories out of the co-cddo GitHub organisation, which the repositories' owners haven't agreed yet" : "where projects are discussed in government Slack workspaces"}.</p><p><button type="button" class="btn" onclick="go('home')">Go to the home page</button></p></div>`; };

/* ---------- AI: declared features, tools, agentic Q&A, generative drafts ---------- */
const AI_FEATURES = [
  {id:"ask", name:"Ask a question", kind:"Agentic", purpose:"Answer plain-English questions about co-cddo and repositories across government.", user_need:"As anyone using this page, I need answers grounded in this data, not general knowledge.",
   tools:["search_cocddo","get_repo","dependents","search_government","search_catalogue","strategy_counts"], output:"Plain text answer naming repositories and the facts used.", tier:"default", oversight:"Advisory only. Answers name repositories so you can check them on the page.", limits:"Sees only the data on this page. Can be wrong. Can't see private repositories or live GitHub."},
  {id:"suggest", name:"Suggest a destination", kind:"Agentic, structured output", purpose:"Propose a destination for one repository with reasons and risks.", user_need:"As a repository owner, I need a second opinion before I record a decision.",
   tools:["get_repo","dependents","search_government"], output:"JSON: group, confidence, reasons, risks", tier:"complex", oversight:"Never saved automatically. You choose whether to copy it into the decision form, and the decision records that AI was used.", limits:"Judgement, not policy. The owner's decision prevails."},
  {id:"notice", name:"Draft an archive or move notice", kind:"Generative", purpose:"Write the README notice the GDS Way asks for when archiving or moving.", user_need:"As a repository owner, I need wording that explains why and links to the new home.",
   tools:[], output:"Markdown text", tier:"quick", oversight:"A draft for you to edit and commit yourself.", limits:"Check the new location and dates before publishing."},
  {id:"impact", name:"Draft an impact assessment", kind:"Generative", purpose:"Turn the observed risks for one repository into a short impact assessment for the change record.", user_need:"As a migration lead, I need a written assessment before approving a move.",
   tools:[], output:"Markdown text", tier:"default", oversight:"A draft. The facts come from this page and GitHub's documented behaviour.", limits:"Doesn't see private settings (secrets, webhooks, environments)."},
  {id:"consumers", name:"Draft a message to consumers", kind:"Generative", purpose:"Tell teams that depend on a repository what will change and what to update.", user_need:"As a repository owner, I need to warn the teams using my module or workflow.",
   tools:[], output:"Plain text email or issue body", tier:"quick", oversight:"A draft only. This page never sends messages.", limits:"Only knows co-cddo consumers found in code."},
];
const AI_ERR = {not_granted:"AI isn't allowed for this page. You can change that in the page's permissions.", sampling_disabled:"AI isn't available for this account or page.", not_declared:"AI isn't available on this page.", session_expired:"Your session has expired. Reload the page and try again.",
  rate_limited:"Too many requests just now. Try again in a minute.", prompt_too_large:"That request was too large. Ask about fewer repositories.", refused:"The AI declined this request.", empty_completion:"The AI returned nothing. Try again.",
  invalid_json:"The suggestion came back in the wrong format. Try again.", tools_unavailable:"AI tools aren't available here, so this can't run.", cancelled:"Stopped."};
const aiMsg = e => AI_ERR[e?.code] || "The AI request didn't complete. Try again.";
function repoFacts(r) { return { repo: r.repo, url: r.url, status: r.status, archived: r.archived, last_human_commit: r.last_human_commit, human_commits_12m: r.human_commits_365d, authors_12m: r.authors_365d, description: r.description || r.readme_summary,
  proposed_destination: GLABEL[r.destination_group], destination_detail: r.destination, rationale: r.rationale, decision: decisions[r.repo] ? {state: decisions[r.repo].state, group: GLABEL[decisions[r.repo].group] || null, note: decisions[r.repo].note} : null, inferred_team: r.inferred_team, codeowners: r.codeowners, licence: r.licence,
  pages_site: r.pages ? r.pages_url : null, custom_domain: r.pages_custom || null, depended_on_by: r.depended_on_by, refs: {uses: r.ref_uses, oidc: r.ref_oidc, packages: r.ref_pkg, pages_urls: r.ref_pages, team: r.ref_team, hardcoded_org: r.ref_hardorg},
  gds_way_failures: Object.entries(r.gdsway).filter(([k, v]) => v[0] === "fail").map(([k, v]) => RULE[k].text + ": " + v[1]), strategy_tags: r.tags, dam: r.dam, standards: r.standards,
  impact: impact(r).map(i => i[0] + ": " + i[1] + " Action: " + i[2]), similar_across_government: r.related_xgov.slice(0, 3).map(x => x[0] + "/" + x[1]) }; }
const TOOLS = {
  search_cocddo: {description:`Search the ${rows.length} co-cddo repositories. Optional filters. Returns up to 15 compact rows.`, inputSchema:{type:"object",properties:{query:{type:"string"},status:{type:"string",enum:STATUSES},destination:{type:"string",enum:GROUPS.map(g => g[1])},tag:{type:"string",description:"strategy tag id like DF3, FF, BP2, or DAM"}}},
    execute: a => rows.filter(r => (!a.query || String(a.query).toLowerCase().split(/\s+/).every(t => r.search.includes(t))) && (!a.status || r.status === a.status) && (!a.destination || GLABEL[effGroup(r)] === a.destination) && (!a.tag || (a.tag === "DAM" ? !!r.dam : String(a.tag) in r.tags))).slice(0, 15).map(r => ({repo: r.repo, status: r.status, destination: GLABEL[effGroup(r)], commits_12m: r.human_commits_365d, depended_on_by: r.inbound_code_refs, pages: r.pages, tags: Object.keys(r.tags)}))},
  get_repo: {description:"Full facts for one co-cddo repository by exact name.", inputSchema:{type:"object",properties:{repo:{type:"string"}},required:["repo"]}, execute: a => byName[String(a.repo)] ? repoFacts(byName[String(a.repo)]) : {error:"not found", hint:"use search_cocddo"}},
  dependents: {description:"Code-level references to and from a co-cddo repository.", inputSchema:{type:"object",properties:{repo:{type:"string"}},required:["repo"]}, execute: a => ({depends_on: DATA.edges.filter(e => e.source === String(a.repo) && e.kind !== "link"), depended_on_by: DATA.edges.filter(e => e.target === String(a.repo) && e.kind !== "link")})},
  search_government: {description:`Search ${X.length} recently updated repositories in ${XO.length} UK public sector organisations (co-cddo included). Returns up to 15 rows, most active first.`, inputSchema:{type:"object",properties:{query:{type:"string"},sector:{type:"string",enum:SECTORS},tag:{type:"string",description:"DF1..DF6, FF, BP1, BP2, BP3, BP6, NHS, LOCAL, DAM, new"},active_only:{type:"boolean",description:"default true: active or maintained only"}}},
    execute: a => X.filter(x => (!a.query || String(a.query).toLowerCase().split(/\s+/).every(t => x.q.includes(t))) && (!a.sector || x.sector === a.sector) && (!a.tag || xMatchTag(x, String(a.tag))) && (a.active_only === false || isLive(x))).sort((p, q) => q.c90 - p.c90 || p.key.localeCompare(q.key)).slice(0, 15).map(x => ({repo: x.key, sector: x.sector, status: x.st, last_human_commit: fmtD(x.lh), commits_12m: x.c12, description: x.desc.slice(0, 160), tags: x.tags, dam: x.dam, pages: x.pg ? x.pu : null}))},
  search_catalogue: {description:`Search all ${ALL.length} asset records (every public sector repository in the X-Gov scraper plus git-checked repositories). Filters: publisher (public body name), status, licence. Returns up to 15 rows with status basis.`, inputSchema:{type:"object",properties:{query:{type:"string"},publisher:{type:"string"},status:{type:"string",enum:CSTAT},licence:{type:"string",description:"MIT, OGL, Apache-2.0, None detected, ..."}}},
    execute: a => ALL.filter(x => (!a.query || String(a.query).toLowerCase().split(/\s+/).every(t => x.q.includes(t))) && (!a.publisher || (bodyOf(x)?.name || "").toLowerCase().includes(String(a.publisher).toLowerCase())) && (!a.status || x.st === a.status) && (!a.licence || (LICS[x.li] || "") === a.licence)).sort((p, q) => lastAct(q) - lastAct(p)).slice(0, 15).map(x => ({repo: x.key, publisher: bodyOf(x)?.name || x.org, status: x.st, basis: x.basis, last_activity: lastAct(x) ? fmtD(lastAct(x)) : null, licence: LICS[x.li] ?? null, stars: x.sg ?? null, description: (x.desc || "").slice(0, 140)}))},
  strategy_counts: {description:"Counts of active or maintained repositories per strategy tag, overall or for one sector, with each tag's measured precision.", inputSchema:{type:"object",properties:{sector:{type:"string",enum:SECTORS}}},
    execute: a => Object.fromEntries([...DATA.strategy.map(s => [s.id + " " + s.short, {count: XLIVE.filter(x => (!a.sector || x.sector === a.sector) && x.tags.includes(s.id)).length, precision: precInfo(s.id).txt}]), ["DAM", {count: XLIVE.filter(x => (!a.sector || x.sector === a.sector) && x.dam).length, precision: precInfo("DAM").txt}]])},
};
let aiTrace = [];
const toolList = names => names.map(n => ({name: n, description: TOOLS[n].description, inputSchema: TOOLS[n].inputSchema, execute: a => { aiTrace.push(n); return TOOLS[n].execute(a || {}); }}));
const GROUND = `You are helping UK government staff plan moving GitHub repositories out of the deprecated co-cddo organisation (to gds-dtx or alphagov) and find related work across the UK public sector. Use only facts from the provided data or tools; say when something isn't in the data. Write in plain UK English, short sentences, no jargon without explanation. Name repositories exactly. Reference date ${REFD}. Key rules: GitHub doesn't redirect GitHub Pages addresses after a transfer; it doesn't redirect calls to actions in a renamed repository; transfers after 15 July 2026 use immutable OIDC subject claims, so cloud trust must be updated; never recommend deleting or renaming the co-cddo organisation; co-cddo's deprecation notice names uk-gov-cyber and gds-dtx as destinations; archive the organisation only after every move; the GDS Way requires a README, an MIT or OGL licence, a security contact, third-party actions pinned to a SHA, minimal workflow permissions and OIDC for AWS. Strategy tags are keyword matches with measured precision, so call them candidates.`;
function renderAIBox(r) {
  const box = $("#aibox"); if (!box) return;
  const feats = AI_FEATURES.filter(f => f.id !== "ask");
  box.innerHTML = `<div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap"><h3>AI assistance <span class="prov g">AI-generated</span></h3><button class="btn sm" type="button" data-go="ai">How AI is used</button></div>
    ${sampleFn ? `<div class="chips">${feats.map(f => `<button class="btn sm" type="button" data-ai="${esc(f.id)}">${esc(f.name)}</button>`).join("")}</div><div id="ai-out"></div><p class="status-line" id="ai-st" role="status"></p>` : `<p class="muted">AI drafting works when this page is opened signed in to claude.ai and you allow it. Everything else on the page works without it.</p>`}`;
  $$("[data-ai]", box).forEach(b => b.onclick = () => runRepoAI(b.dataset.ai, r));
}
async function runRepoAI(id, r) {
  const out = $("#ai-out"), st = $("#ai-st"), f = AI_FEATURES.find(x => x.id === id); out.innerHTML = ""; st.textContent = `Working on “${f.name}”…`; aiTrace = [];
  const facts = JSON.stringify(repoFacts(r));
  if (id === "suggest") {
    try {
      const res = await sampleFn.json(`${GROUND}\n\nSuggest the destination group for repository ${r.repo}. Use the tools to check dependents and similar work. Groups: ${GROUPS.map(g => g[1]).join("; ")}.\nFacts: ${facts}\n\nReturn JSON {"group": one of the groups exactly, "confidence": "low"|"medium"|"high", "reasons": [short strings], "risks": [short strings]}.`, {tools: toolList(f.tools), modelTier: "complex"});
      const g = GROUPS.find(x => x[1] === res?.group), arr = v => Array.isArray(v) ? v.map(String).slice(0, 8) : [];
      if (!g) { st.textContent = "The suggestion didn't name a known destination. Try again."; return; }
      const conf = ["low","medium","high"].includes(res.confidence) ? res.confidence : "unstated";
      out.innerHTML = `<div class="box ai"><b>Suggestion: ${esc(g[1])} <span class="muted">(${esc(conf)} confidence)</span></b><ul>${arr(res.reasons).map(x => `<li>${esc(x)}</li>`).join("")}</ul>${arr(res.risks).length ? `<b>Risks</b><ul>${arr(res.risks).map(x => `<li>${esc(x)}</li>`).join("")}</ul>` : ""}<p class="faint" style="font-size:12.5px">Tools used: ${esc(aiTrace.join(", ") || "none")}. AI-generated: check before relying on it.</p>${$("#decform") ? `<button class="btn sm" type="button" id="ai-apply">Put this in the decision form</button>` : ""}</div>`;
      st.textContent = "Suggestion ready.";
      $("#ai-apply")?.addEventListener("click", () => { const form = $("#decform"); if (!form) return; const want = g[0] === r.destination_group ? "agreed" : "changed";
        form.querySelector(`input[name="st"][value="${want}"]`).checked = true; if (want === "changed") $("#dec-group").value = g[0];
        $("#dec-note").value = ("AI suggestion (" + conf + "): " + arr(res.reasons).join("; ")).slice(0, 2000); form.dataset.ai = "1"; form.dispatchEvent(new Event("change")); $("#dec-note").focus(); toast("Review the form, then save it yourself"); });
    } catch (e) { st.textContent = aiMsg(e); }
    return;
  }
  const prompts = {
    notice: `Write a short README notice (Markdown) for ${r.repo} following the GDS Way: say whether it has moved or been archived, why, and link to the new home. Destination: ${GLABEL[effGroup(r)]}. Use placeholders like [new location] where you don't know a value. Facts: ${facts}`,
    impact: `Write an impact assessment (Markdown, under 300 words) for moving ${r.repo}. Sections: What changes; Who is affected (upstream and downstream); Risks and mitigations (cite GitHub's documented behaviour); Checks before and after cutover; Rollback. Facts: ${facts}`,
    consumers: `Draft a short message (plain text) to teams that depend on ${r.repo}, telling them what will change, when (use [date]), and exactly which references to update. Facts: ${facts}`,
  };
  const lab = document.createElement("label"); lab.textContent = f.name + " (AI-generated draft, editable)"; lab.htmlFor = "ai-draft"; lab.style.fontWeight = "700"; lab.style.fontSize = "14px";
  const ta = document.createElement("textarea"); ta.rows = 12; ta.id = "ai-draft";
  const cp = document.createElement("button"); cp.className = "btn sm"; cp.type = "button"; cp.textContent = "Copy draft"; const cst = document.createElement("span"); cst.className = "status-line";
  out.replaceChildren(lab, ta, cp, cst); cp.onclick = () => copy(ta.value, cst);
  try { const res = await sampleFn(`${GROUND}\n\n${prompts[id]}`, {modelTier: f.tier, onText: ({text}) => { ta.value = text; }});
    ta.value = res.text; st.textContent = res.truncated ? "Draft ready, but it was cut short. Check the ending." : "Draft ready. Check every fact before you use it."; }
  catch (e) { if (e?.text) ta.value = e.text; st.textContent = aiMsg(e) + (e?.text ? " The partial draft is kept." : ""); }
}
RENDER.ask = () => {
  vb("ask").innerHTML = `<div class="panel ask"><div class="panel-head"><h2>Ask a question</h2><span class="prov g">AI-generated answers</span></div>
    <p class="lede">Ask in plain English. The assistant can search co-cddo and government repositories, read a repository's facts and trace dependencies, all from this page's data. It can't see GitHub live or anything private.</p>
    ${sampleFn ? `<div class="chips" style="margin:10px 0">${["Which repositories must move first and why?","What across government relates to critical data assets and metadata?","Which co-cddo repositories have GitHub Pages sites and what do I need to do?","Who else is building LLM tooling in health?","Which moving repositories fail a GDS Way MUST?","Which public bodies publish the most active repositories without a licence?"].map(q => `<button class="btn sm" type="button" data-q="${esc(q)}">${esc(q)}</button>`).join("")}</div>
    <div class="chat" id="chat" role="log" aria-label="Conversation"></div><p class="sr-only" id="ask-live" role="status" aria-live="polite"></p><form id="askform" style="display:grid;gap:8px;margin-top:10px"><label for="askq" style="font-weight:700;font-size:14px">Your question</label><textarea id="askq" rows="3" maxlength="1200"></textarea><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn primary" type="submit">Ask</button><button class="btn" type="button" id="askstop" disabled>Stop</button></div></form>` : `<p class="muted" style="margin-top:10px">The assistant needs this page to be opened signed in to claude.ai, with AI allowed. Every other part of the page works without it.</p>`}</div>`;
  if (!sampleFn) return;
  const hist = []; let ctl = null, busy = false;
  const send = async q => { q = q.trim(); if (!q || busy) return; busy = true; const chat = $("#chat");
    const u = document.createElement("div"); u.className = "msg user"; u.textContent = q; chat.append(u);
    const b = document.createElement("div"); b.className = "msg bot"; b.textContent = "Thinking…"; chat.append(b); b.scrollIntoView({block: "nearest"});
    $("#ask-live").textContent = "Working on your question…";
    hist.push({role: "user", content: hist.length ? q : `${GROUND}\n\nQuestion: ${q}`}); aiTrace = []; ctl = new AbortController(); $("#askstop").disabled = false;
    try { const res = await sampleFn(hist, {tools: toolList(AI_FEATURES[0].tools), cache: false, signal: ctl.signal, onText: ({text}) => { b.textContent = text; }});
      b.textContent = res.text; hist.push({role: "assistant", content: res.text}); const t = document.createElement("div"); t.className = "tools"; t.textContent = "Tools used: " + (aiTrace.join(", ") || "none") + ". AI-generated: check before relying on it."; b.append(t);
      $("#ask-live").textContent = "Answer ready."; }
    catch (e) { b.textContent = (e?.text ? e.text + "\n\n" : "") + aiMsg(e); hist.pop(); $("#ask-live").textContent = aiMsg(e); }
    $("#askstop").disabled = true; busy = false; };
  $("#askform").onsubmit = e => { e.preventDefault(); const v = $("#askq").value; $("#askq").value = ""; send(v); };
  $("#askstop").onclick = () => ctl?.abort();
  $$("[data-q]", vb("ask")).forEach(b => b.onclick = () => send(b.dataset.q));
};
RENDER.ai = () => {
  vb("ai").innerHTML = `<div class="panel"><h2>How this page uses AI</h2><p class="lede" style="margin-top:6px">Every AI feature is declared below before it runs: what it's for, what data and tools it can use, what it produces and who stays in control. The page builds its AI buttons from this list. Nothing AI produces is saved or sent unless a person chooses to.</p></div>
  <div class="grid2">${AI_FEATURES.map(f => `<div class="panel"><div class="panel-head"><h3>${esc(f.name)}</h3><span class="chip">${esc(f.kind)}</span></div>${kv([["Purpose", esc(f.purpose)],["User need", esc(f.user_need)],["Tools it may call", f.tools.length ? f.tools.map(t => `<code>${esc(t)}</code>`).join(", ") : "none (uses facts passed in)"],["Output", esc(f.output)],["Model tier", esc(f.tier)],["Human oversight", esc(f.oversight)],["Limitations", esc(f.limits)]])}</div>`).join("")}</div>
  <div class="panel"><h2>Algorithmic transparency record (summary)</h2><p class="muted" style="margin:6px 0 10px">Structured after the ${ext("https://www.gov.uk/government/collections/algorithmic-transparency-recording-standard-hub", "Algorithmic Transparency Recording Standard")}. This is not a published ATRS record.</p>${kv([
    ["Tool", "GitHub Repos Asset Catalogue, AI features"],["Owner", "The catalogue's maintainers, contacted through the repository's issues"],["What it does", "Answers questions and drafts text about repository migration from data on this page."],
    ["Decision role", "Advisory. People make and record every decision; a decision records when an AI suggestion was used."],["Model", "Claude (Anthropic), called through the claude.ai artifact runtime under the viewer's own account."],
    ["Data sent", esc(`Public GitHub metadata gathered on ${REFD}. When you use an AI feature, the facts for that repository or question are sent to Claude, including public contributor names and any decision note recorded for a co-cddo repository.`)],
    ["Risks", "Wrong or overconfident answers; over-reliance. Mitigations: answers grounded in page data, tools used are shown, labels, a person approves anything saved."],["Also used to build this page", "Claude wrote the data pipeline, tagging rules and this page under the owner's direction. Every figure is reproducible from the build scripts, and tag precision was estimated by an AI reviewer on a labelled sample."]])}</div>
  <div class="panel"><h2>Declared feature list (machine-readable)</h2><pre class="mono" style="white-space:pre-wrap;font-size:12.5px;overflow-x:auto">${esc(JSON.stringify(AI_FEATURES, null, 2))}</pre></div>`;
};

/* ---------- DOCUMENTS: artefact pack generated from the same data ---------- */
const DOC_KEYS = Object.keys(DATA.docs);
let docSel = DOC_KEYS[0];
function renderBlocks(blocks) { return blocks.map(b => {
  if (b[0] === "h") return `<h3>${esc(b[1])}</h3>`; if (b[0] === "p") return `<p>${esc(b[1])}</p>`;
  if (b[0] === "ul") return `<ul>${b[1].map(i => `<li>${esc(i)}</li>`).join("")}</ul>`;
  if (b[0] === "note") return `<div class="warn amber"><b>Note</b><span>${esc(b[1])}</span></div>`;
  if (b[0] === "table") return `<div class="tbl-wrap"><table><thead><tr>${b[1].map(h => `<th scope="col">${esc(h)}</th>`).join("")}</tr></thead><tbody>${b[2].map(r => `<tr>${r.map(c => `<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
  return ""; }).join(""); }
function blocksMd(title, blocks) { const cell = c => String(c ?? "").replace(/\|/g, "\\|").replace(/\n/g, " ");
  return `## ${title}\n\n` + blocks.map(b => b[0] === "h" ? `### ${b[1]}\n` : b[0] === "p" ? `${b[1]}\n` : b[0] === "note" ? `> **Note:** ${b[1]}\n` : b[0] === "ul" ? b[1].map(i => `- ${i}`).join("\n") + "\n" :
    b[0] === "table" ? `| ${b[1].map(cell).join(" | ")} |\n| ${b[1].map(() => "---").join(" | ")} |\n` + b[2].map(r => `| ${r.map(cell).join(" | ")} |`).join("\n") + "\n" : "").join("\n"); }
function packMd() { return `# GitHub Repos Asset Catalogue: artefact pack\n\nVersion ${DATA.version} · ${DATA.docid} · data as at ${REFD}\n\nGenerated from the same data as the page.\n\n` + DOC_KEYS.map(k => blocksMd(DATA.docs[k][0], DATA.docs[k][1])).join("\n") +
  `\n## Requirements\n\n| ID | Requirement | Source | Checks |\n| --- | --- | --- | --- |\n` + DATA.requirements.map(q => `| ${q[0]} | ${q[1]} | ${q[2]} | ${q[4].join(", ")} |`).join("\n") +
  `\n\n## Defect register\n\n| ID | Found | Severity | What | Fix | Status |\n| --- | --- | --- | --- | --- | --- |\n` + DATA.defects.map(d => `| ${d[0]} | ${d[1]} | ${d[2]} | ${d[3].replace(/\|/g, "/")} | ${d[5].replace(/\|/g, "/")} | ${d[7]} |`).join("\n") + "\n"; }
const NS = DATA.url + "#";
function knowledgeGraph() {
  const g = [], id = (t, k) => `cmx:${t}/${encodeURIComponent(k)}`;
  for (const o of XO) g.push({"@id": id("org", o.org), "@type": ["cmx:Organisation", "schema:Organization"], "schema:name": o.org, "cmx:sector": id("sector", o.sector), "cmx:publicRepositories": o.total_on_github});
  for (const s of SECTORS) g.push({"@id": id("sector", s), "@type": ["cmx:Sector", "skos:Concept"], "skos:prefLabel": s});
  for (const s of DATA.strategy) g.push({"@id": id("tag", s.id), "@type": ["cmx:StrategyTag", "skos:Concept"], "skos:prefLabel": s.label, "schema:url": s.url, "cmx:precision": PREC[s.id]?.precision ?? null});
  for (const gr of GROUPS) g.push({"@id": id("destination", gr[0].slice(0, 1)), "@type": ["cmx:DestinationGroup", "skos:Concept"], "skos:prefLabel": gr[1]});
  for (const r of rows) g.push({"@id": id("repo", "co-cddo/" + r.repo), "@type": ["cmx:Repository", "schema:SoftwareSourceCode"], "schema:name": r.repo, "schema:codeRepository": r.url, "cmx:ownedBy": {"@id": id("org", "co-cddo")},
    "cmx:activityStatus": r.status, "cmx:proposedDestination": {"@id": id("destination", r.destination_group.slice(0, 1))}, "cmx:effectiveDestination": {"@id": id("destination", effGroup(r).slice(0, 1))}, "cmx:taggedWith": Object.keys(r.tags).map(t => ({"@id": id("tag", t)})),
    "cmx:usesStandard": r.standards, "cmx:pagesSite": r.pages ? r.pages_url : null, "cmx:similarTo": r.related_xgov.map(([o, n]) => ({"@id": id("repo", o + "/" + n)}))});
  for (const e of DATA.edges) if (e.kind !== "link") g.push({"@id": id("ref", e.source + ">" + e.target + ">" + e.kind), "@type": "cmx:CodeReference", "cmx:from": {"@id": id("repo", "co-cddo/" + e.source)}, "cmx:to": {"@id": id("repo", "co-cddo/" + e.target)}, "cmx:kind": e.kind, "cmx:lines": e.refs});
  for (const x of X) if (x.org !== "co-cddo" && (x.tags.length || x.dam || x.stds.length)) g.push({"@id": id("repo", x.key), "@type": ["cmx:Repository", "schema:SoftwareSourceCode"], "schema:name": x.n, "cmx:ownedBy": {"@id": id("org", x.org)}, "cmx:activityStatus": x.st, "cmx:taggedWith": x.tags.map(t => ({"@id": id("tag", t)})), "cmx:damRelevant": !!x.dam, "cmx:usesStandard": x.stds});
  for (const q of DATA.requirements) g.push({"@id": id("req", q[0]), "@type": "cmx:Requirement", "schema:description": q[1], "prov:wasDerivedFrom": q[2], "cmx:verifiedBy": q[4].map(c => ({"@id": id("check", c)}))});
  for (const c of DATA.registry) g.push({"@id": id("check", c.id), "@type": "cmx:Check", "schema:description": c.text, "cmx:status": c.status, "cmx:group": c.group});
  for (const d of DATA.defects) g.push({"@id": id("defect", d[0]), "@type": "cmx:Defect", "schema:description": d[3], "cmx:severity": d[2], "cmx:status": d[7], "cmx:guardedBy": d[6].map(c => ({"@id": id("check", c)}))});
  return {"@context": {"cmx": NS, "schema": "https://schema.org/", "dcat": "http://www.w3.org/ns/dcat#", "prov": "http://www.w3.org/ns/prov#", "skos": "http://www.w3.org/2004/02/skos/core#", "dcterms": "http://purl.org/dc/terms/"},
    "@id": NS + "graph", "schema:name": "GitHub Repos Asset Catalogue knowledge graph", "schema:version": DATA.version, "schema:dateModified": DATA.meta.ref_date, "@graph": g};
}
function ontologyTtl() {
  const tbl = DATA.docs.ontology[1].find(b => b[0] === "table"), lines = [`@prefix cmx: <${NS}> .`, "@prefix owl: <http://www.w3.org/2002/07/owl#> .", "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .", "@prefix skos: <http://www.w3.org/2004/02/skos/core#> .",
    "@prefix schema: <https://schema.org/> .", "@prefix dcterms: <http://purl.org/dc/terms/> .", "@prefix prov: <http://www.w3.org/ns/prov#> .", "@prefix dcat: <http://www.w3.org/ns/dcat#> .", "",
    `<${NS}ontology> a owl:Ontology ; rdfs:label "GitHub Repos Asset Catalogue ontology" ; owl:versionInfo "${DATA.version}" .`, ""];
  const lit = s => '"' + String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"@en';
  for (const [term, kind, meaning, maps] of (tbl ? tbl[2] : [])) { if (!/^cmx:\w+$/.test(term)) continue;
    const t = kind === "Class" ? "owl:Class" : "owl:DatatypeProperty"; const m = /^(schema|skos|dcterms|prov|dcat):\w+$/.test(maps) ? ` ;\n  skos:closeMatch ${maps}` : "";
    lines.push(`${term} a ${t} ;\n  rdfs:label ${lit(term.slice(4))} ;\n  rdfs:comment ${lit(meaning)}${m} .`); }
  return lines.join("\n") + "\n";
}
async function save(filename, data, st) {
  if (!dl) { st.textContent = "Downloads need a signed-in claude.ai view of this page."; return; }
  try { const r = await dl.save({filename, data}); st.textContent = r?.status === "delivered" ? "Sent." : "Saved."; }
  catch (e) { st.textContent = e?.code === "declined" ? "" : e?.code === "rate_limited" ? "A download prompt is already open." : "Download isn't available here."; }
}
RENDER.docs = () => {
  vb("docs").innerHTML = `<div class="panel"><div class="panel-head"><h2>Documents</h2><span class="muted">generated from the same data as the page, so the numbers match</span></div>
    <p class="lede">The usual artefact pack: theory of change, user research, service blueprint, product requirements, integration requirements, architecture, designs, data dictionary, glossary, taxonomies and ontology. Requirements link to checks and defects under Traceability.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px"><button class="btn" type="button" id="dl-md">Download the pack (Markdown)</button><button class="btn" type="button" id="dl-kg">Download the knowledge graph (JSON-LD)</button><button class="btn" type="button" id="dl-ttl">Download the ontology (Turtle, as text)</button><span class="status-line" id="dl-st" role="status"></span></div></div>
    <div class="doclayout"><nav aria-label="Documents"><ul>${DOC_KEYS.map(k => `<li><button type="button" data-doc="${esc(k)}" ${k === docSel ? 'aria-current="true"' : ""}>${esc(DATA.docs[k][0])}</button></li>`).join("")}</ul></nav>
    <article class="panel doc" id="doc-body" aria-labelledby="doc-h"></article></div>`;
  const show = (k, focus) => { docSel = k; $$("[data-doc]", vb("docs")).forEach(b => b.dataset.doc === k ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current"));
    $("#doc-body").innerHTML = `<h2 id="doc-h" tabindex="-1">${esc(DATA.docs[k][0])}</h2>${renderBlocks(DATA.docs[k][1])}`; if (focus) $("#doc-h").focus(); };
  $$("[data-doc]", vb("docs")).forEach(b => b.onclick = () => show(b.dataset.doc, true)); show(docSel, false);
  const st = $("#dl-st");
  $("#dl-md").onclick = () => save("co-cddo-artefact-pack-" + DATA.version + ".md", packMd(), st);
  $("#dl-kg").onclick = () => save("co-cddo-knowledge-graph-" + DATA.version + ".json", JSON.stringify(knowledgeGraph(), null, 1), st);
  $("#dl-ttl").onclick = () => save("co-cddo-ontology-" + DATA.version + ".ttl.txt", ontologyTtl(), st);
};

/* ---------- TRACEABILITY: requirement → views → checks → defects ---------- */
const REG = Object.fromEntries(DATA.registry.map(c => [c.id, c]));
const ckTag = id => { const c = REG[id], s = c ? c.status : "missing", live = s === "live" ? (pageCheckById(id) ?? null) : null;
  const shown = s === "live" ? (live === null ? "live" : live ? "pass" : "fail") : s; const cls = {pass:"pass", fail:"fail", live:"live", "not run":"notrun", missing:"fail"}[shown] || "notrun";
  return `<span class="ck ${cls}" title="${esc(c?.text || "not registered")}">${esc(id)}: ${esc(shown)}</span>`; };
RENDER.trace = () => {
  const VIEWS = {related: "plan", spotlight: "start", footer: "about"};
  vb("trace").innerHTML = `<div class="panel"><h2>Traceability</h2><p class="lede" style="margin-top:6px">Each requirement, from your requests and standing rules, links to the views that meet it, the checks that prove it and the defects found against it. Page self-checks run in your browser now; build checks ran when the data was assembled.</p></div>
    ${DATA.requirements.map(([id, stmt, src, views, checks]) => { const ds = DATA.defects.filter(d => d[6].some(c => checks.includes(c)));
      return `<div class="panel"><div class="panel-head"><h3>${esc(id)}: ${esc(stmt)}</h3><span class="muted">${esc(src)}</span></div><div class="chainrow">
        <div><span class="eyebrow">Views</span>${views.map(v => { const t = TABS.includes(v) ? v : VIEWS[v]; return t ? `<button class="btn sm" type="button" data-go="${esc(t)}">${esc(TITLE[t])}${TABS.includes(v) ? "" : " (" + esc(v) + ")"}</button>` : `<span class="muted">${esc(v)}</span>`; }).join("")}</div>
        <div><span class="eyebrow">Checks</span><div class="chips">${checks.map(ckTag).join("")}</div></div>
        <div><span class="eyebrow">Defects</span>${ds.length ? ds.map(d => `<span><b>${esc(d[0])}</b> <span class="sev-${esc(d[2])}">${esc(d[2])}</span>: ${esc(d[7])}</span>`).join("") : '<span class="muted">none recorded</span>'}</div></div></div>`; }).join("")}`;
};

/* ---------- DEFECTS AND RELEASES ---------- */
RENDER.defects = () => {
  const open = DATA.defects.filter(d => !/^Fixed/.test(d[7])).length;
  vb("defects").innerHTML = `<div class="panel"><h2>Defect register</h2><p class="lede" style="margin-top:6px">Every defect found, by an independent review or while building, with its cause, fix and the checks that now guard it. ${open ? `<b>${open} open.</b>` : "None open."}</p>
    <div class="tbl-wrap" style="margin-top:10px"><table><thead><tr><th scope="col">ID</th><th scope="col">Found</th><th scope="col">Severity</th><th scope="col">What went wrong</th><th scope="col">Cause</th><th scope="col">Fix</th><th scope="col">Guarded by</th><th scope="col">Status</th></tr></thead><tbody>
    ${DATA.defects.map(d => `<tr><th scope="row">${esc(d[0])}</th><td>${esc(d[1])}</td><td class="sev-${esc(d[2])}">${esc(d[2])}</td><td>${esc(d[3])}</td><td class="muted">${esc(d[4])}</td><td>${esc(d[5])}</td><td><div class="chips">${d[6].map(ckTag).join("")}</div></td><td>${esc(d[7])}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>Releases</h2><ol class="steps" style="list-style:none;padding:0;margin-top:10px">${[...DATA.releases].reverse().map(([v, d, t]) => `<li class="step"><span class="w" aria-hidden="true">${esc(v)}</span><h3>Version ${esc(v)}, ${esc(d)}</h3><p>${esc(t)}</p></li>`).join("")}</ol></div>`;
};

/* ---------- METHOD AND CHECKS ---------- */
RENDER.about = () => {
  const pc = pageChecks(), groups = [...new Set(DATA.registry.map(c => c.group))];
  const counts = DATA.registry.reduce((a, c) => { const s = c.status === "live" ? (pageCheckById(c.id) ? "pass" : "fail") : c.status; a[s] = (a[s] || 0) + 1; return a; }, {});
  vb("about").innerHTML = `
  <div class="grid2"><div class="panel"><h2>How this was built</h2><dl class="kv" style="margin-top:8px">${DATA.method.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join("")}
    <dt>Personal data</dt><dd>For co-cddo repositories, contributor names from public git history are shown to help find owners. Elsewhere only counts are shown. No email addresses are published. Decisions store an opaque user ID.</dd></dl></div>
  <div class="panel"><h2>Page self-checks</h2><p class="muted" style="font-size:13.5px">Run now in your browser.</p><ol class="checks" style="margin-top:6px">${pc.map(([id, ok, m]) => `<li class="${ok ? "pass" : "fail"}">${ok ? "PASS" : "FAIL"} ${esc(id)} ${esc(m)}</li>`).join("")}</ol></div></div>
  <div class="panel"><div class="panel-head"><h2>Check registry</h2><span class="muted">${DATA.registry.length} checks: ${Object.entries(counts).map(([k, v]) => `${v} ${esc(k)}`).join(", ")}</span></div>
    <p class="lede">Every check has an ID used by Traceability and the defect register. The suite only grows: each defect adds a check, and checks marked “n” are negative tests that prove a check can fail.</p>
    ${groups.map(g => `<h3 style="margin-top:12px">${esc(g)}</h3><div class="tbl-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">Result</th><th scope="col">What it checks</th><th scope="col">Guards against</th></tr></thead><tbody>${DATA.registry.filter(c => c.group === g).map(c => `<tr><th scope="row" class="mono" style="text-transform:none">${esc(c.id)}</th><td>${ckTag(c.id)}</td><td>${esc(c.text)}</td><td class="muted">${esc(c.guards)}</td></tr>`).join("")}</tbody></table></div>`).join("")}</div>`;
};
RENDER.a11y = () => { const d = DATA.docs.a11y; vb("a11y").innerHTML = `<div class="panel doc"><h2>${esc(d[0])}</h2>${renderBlocks(d[1])}</div>`; };

/* ---------- page self-checks P-01..P-14 ---------- */
let _pc = null;
function pageChecks() {
  const pc = []; const ck = (id, ok, m) => pc.push([id, !!ok, m]);
  const N = DATA.meta.repo_count;
  ck("P-01", rows.length === N && new Set(rows.map(r => r.repo)).size === N, `${N} unique co-cddo repositories loaded, matching GitHub's count`);
  { const OPEN = DATA.sec && DATA.sec.audience === "public";
  ck("P-02", OPEN ? rows.every(r => /^0 Not published/.test(r.destination_group) && !r.destination) : rows.every(r => GKEYS.has(r.destination_group)), OPEN ? "open edition: no proposed destination is published" : "every proposed destination maps to a known group"); }
  ck("P-03", STATUSES.reduce((a, s) => a + rows.filter(r => r.status === s).length, 0) === N && rows.filter(r => r.status === "Active").every(r => r.human_commits_90d > 0), "activity statuses cover every repository once; every Active one has a commit by a person in 90 days");
  ck("P-04", DATA.edges.every(e => byName[e.source] && byName[e.target]), "every dependency points at a known repository");
  ck("P-05", rows.every(r => r.inbound_code_refs === new Set(DATA.edges.filter(e => e.target === r.repo && CODE_KINDS.includes(e.kind)).map(e => e.source)).size), "inbound dependency counts agree with the reference list");
  ck("P-06", decRejected === 0, decRejected ? `${decRejected} stored decision(s) failed validation and were ignored` : "every stored decision passed validation");
  ck("P-07", !rows.some(r => r.archived && moving(r.destination_group)), "no archived repository is proposed for a migration wave");
  ck("P-08", rows.every(r => RULES.every(x => Array.isArray(r.gdsway[x.id]))), "every co-cddo repository has a result for every GDS Way rule");
  ck("P-09", XO.every((o, i) => X.filter(x => x.oi === i).length === o.listed), "government rows equal each organisation's listed count");
  ck("P-10", X.filter(x => x.st === "Active").every(x => x.c90 > 0 && x.lh >= XREF_EPOCH - 91 * 86400), "every Active government repository has a commit by a person in 90 days");
  ck("P-11", X.every(x => !x.pg || /^https?:\/\//.test(x.pu)), "every GitHub Pages flag has a site address");
  ck("P-12", DATA.spotlight.every(s => { const x = XBY[s.o + "/" + s.n]; return x && x.st === "Active" && x.c90 > 0 && Math.abs(Object.values(s.parts).reduce((a, b) => a + b, 0) - s.score) < .02; }), "every spotlight repository is Active and its score equals its disclosed parts");
  ck("P-13", AI_FEATURES.every(f => f.tools.every(t => TOOLS[t])), "every declared AI tool exists");
  const okS = new Set(["pass","review","fail","unknown","n/a"]);
  { const OPEN = DATA.sec && DATA.sec.audience === "public";
  ck("P-15", OPEN ? !DATA.v1.reconciliation.length && rows.every(r => r.v1?.obs_score == null) : DATA.v1.reconciliation.filter(r => r.current).every(r => byName[r.current]) && rows.every(r => DATA.v1.reconciliation.some(x => x.current === r.repo) && typeof r.v1?.obs_score === "number"), OPEN ? "open edition: the v1 workbook layer is left out" : "the v1 reconciliation covers every co-cddo repository and every one has a re-run score"); }
  ck("P-16", rows.every(r => r.controls.length === DATA.v1.controls.length && r.controls.every(c => okS.has(c[1]))), `every co-cddo repository has a valid result for each of the ${DATA.v1.controls.length} assurance controls`);
  ck("P-17", new Set(ALL.map(x => x.key.toLowerCase())).size === ALL.length && ALL.length === X.length + CATX.length + UNL.length && ALL.every(x => x.org && x.st), `${ALL.length} catalogue records, each unique, with a publisher account and a status`);
  ck("P-18", CATX.every(x => !["Active","Maintained","Automated only"].includes(x.st) || String(x.basis).startsWith("git")), "no catalogue-only record shows activity without git evidence");
  const SR = Object.entries(DATA.std.repos);
  ck("P-19", SR.every(([k, v]) => Object.values(v.s).every(x => x[0] < 4 || x[1].some(e => /\d/.test(e)))) && SR.every(([k, v]) => Object.values(v.s).every(x => [1,2,3,4].includes(x[0]))), "every standards grade is 1 to 4, and every 'every record' grade cites counted records");
  ck("P-20", Object.entries(DATA.std.orgs).every(([o, v]) => Object.entries(v.standards).every(([s, x]) => x.level === Math.max(...SR.filter(([k, r]) => k.split("/")[0] === o && r.s[s]).map(([k, r]) => r.s[s][0]), 0) || !SR.some(([k]) => k.split("/")[0] === o))), "each organisation's highest standard level equals the highest of its repositories");
  ck("P-14", X.filter(x => x.org === "co-cddo" && x.pg).every(x => byName[x.n]?.pages) && rows.filter(r => r.pages).every(r => XBY["co-cddo/" + r.repo]?.pg), "co-cddo Pages sites agree between the inventory and the government scan, and each opens a details panel");
  const hubTabs = HUBS.flatMap(h => h.tabs.map(t => t[0]));
  ck("P-21", hubTabs.length === new Set(hubTabs).size && hubTabs.every(t => RENDER[t]) && HUBS.every(h => DATA.palette.hues[h.c]), `every one of ${hubTabs.length} views sits in exactly one of ${HUBS.length} hubs, renders, and its hub colour passed the contrast build check`);
  const ts = topicStats();
  ck("P-22", TOPICS.length >= 10 && TOPICS.every(t => ts[t.id].live <= ts[t.id].n && ts[t.id].n > 0), `all ${TOPICS.length} topics compile, have matches, and live counts never exceed totals`);
  ck("P-23", LENSES.every(l => l.q.every(([, a]) => { const [k, v] = [a.slice(0, a.indexOf(":")), a.slice(a.indexOf(":") + 1)]; return k === "go" ? TABS.includes(v) : k === "topic" ? !!TOPIC_BY[v] : k === "cat"; })), "every question on the home page leads to a view, topic or search that exists");
  const mapped = ALL.filter(x => XO[x.oi]?.body >= 0).length;
  ck("P-24", BODIES.reduce((a, b, i) => a + profRecords("b:" + i).length, 0) === mapped, `organisation profiles partition the ${nf(mapped)} records whose account maps to a public body: none lost or double counted`);
  const ac = areaCounts(DREC), direct = Object.fromEntries(DM.areas.map(x => [x.id, DREC.filter(r => r.caps.some(c => c.a === x.id)).length]));
  ck("P-25", DREC.length > 0 && DREC.every(r => XBY[r.key]) && DM.areas.every(x => (ac[x.id] || 0) === direct[x.id]) && DREC.every(r => r.caps.every(c => DCAPS[c.i] && DAREA[c.a])), `the DAMA wheel's counts for all ${DM.areas.length} areas equal a direct count of the ${nf(DREC.length)} classified repositories, and every match points at a known capability`);
  ck("P-26", GCAT.every(c => !c.match || XBY[c.match[0]]) && [...inGcat].every(k => XBY[k]) && APIR.every(r => API_KINDS.includes(r.kind)), `all ${GCAT.length} API catalogue entries reconcile to known repositories or to none, and every repository API has a known kind`);
  ck("P-27", ODR.every(r => XBY[r.key] && r.portals.every(p => PORT[p[0]])), `every one of ${ODR.length} open data repositories is a catalogue record and every portal is known`);
  ck("P-28", DV.every(v => v.areas.every(a => DAREA[a])) && DRECALL.every(r => r.vend.every(v => DV[v.i])), `all ${DV.length} tools and suppliers sit in known knowledge areas, and every supplier match points at a known supplier`);
  ck("P-29", GOWN.every(r => GA[r.a] || r.a === "other") && GLINK.every(r => r.h.every(h => GA[h.a])) && !GLINK.some(r => GD.owned[r.key]), `every one of ${nf(GOWN.length)} GDS repositories and ${nf(GLINK.length)} linked repositories sits in a known GDS area, and none is counted on both sides`);
  ck("P-30", Object.keys(PRC.masks).every(k => XBY[k]) && Object.values(PRC.types).every(i => PRC.typeNames[i]) && PORDER.every(p => PLABEL[p] && PD_C[PDISC_OF[p]]), `practice flags for ${nf(Object.keys(PRC.masks).length)} repositories and a type for each of ${nf(Object.keys(PRC.types).length)} records all point at known repositories, types and disciplines`);
  const sample = ALL.filter((x, i) => i % 97 === 0); ck("P-31", XDIMS.every(d => sample.every(x => { const v = d[2](x); return Array.isArray(v) && v.length > 0 && v.every(s => typeof s === "string" && s); })), `every one of ${XDIMS.length} explorer dimensions gives at least one value for every record sampled`);
  ck("P-32", PRC.typeNames.every(t => RXK[t]) && CSTAT.every(t => RXS[t]) && TOPICS.every(t => ICONS[RX_TOPIC_IC[t.id]]) && Object.keys(LICS).every(k => RX_LIC[k]) && Object.values(RXK).every(k => ICONS[k.ic]) && Object.values(RXS).every(k => ICONS[k.ic]),
    `plain-English words and an icon for all ${PRC.typeNames.length} kinds of project, ${CSTAT.length} statuses, ${TOPICS.length} topics and ${Object.keys(LICS).length} licence answers`);
  ck("P-33", rxName("pay-webhooks") === "Pay webhooks" && rxName("govuk-frontend") === "GOV.UK frontend" && rxName("DataSciencePipeline") === "Data science pipeline" && rxName("") === "Untitled project" && rxName("hmrc_api") === "HMRC API",
    "project names are turned into plain words (pay-webhooks becomes Pay webhooks; an empty name becomes Untitled project)");
  { const j = rxJargon("Terraform modules for AWS").map(w => w.t), neg = rxJargon("an apiary of rapid tools"); ck("P-34", j.includes("Terraform") && j.includes("AWS") && !neg.length, "technical words in descriptions are explained, and look-alike words (apiary, rapid) are not mistaken for them"); }
  { const t = rxTerms("payments"), z = rxTerms("zebra"), p = rxTerms("sign in forms"); ck("P-35", t[0].includes("pay") && z.length === 1 && z[0].length === 1 && p.some(a => a.includes("one login")) && p.some(a => a.includes("form")), "everyday search words are widened with the thesaurus (payments also finds pay), and unknown words are searched as typed"); }
  { const F = famIndex(), leaves = Object.values(F.N).filter(n => n.kind !== "org"), inLeaves = leaves.reduce((a, n) => a + n.recs.length, 0), mapped = ALL.filter(x => rxOrgOf(x) !== null).length;
    const okP = HO.every(o => o.p.every(p => HO[p])) && Object.keys(F.recs).length === mapped && inLeaves === mapped && Object.values(F.N).every(n => n.kind === "org" ? !n.recs.length : n.parents.length === 1);
    ck("P-36", okP && F.roots.length > 0 && (GDS_HI === undefined || famPath("o" + GDS_HI).length >= 2), `family tree: ${nf(mapped)} projects each sit in exactly one GitHub account or GDS unit under one of ${nf(HO.length)} GOV.UK organisations; ${F.roots.length} top-level organisations have code`); }
  { const sample = ALL.filter((x, i) => i % 211 === 0); ck("P-37", sample.every(x => { const l = rxLadder(x); return l.length >= 2 && l[0].id === "repo" && l.every(r => r.label && ICONS[r.ic]); }), `every project in a sample of ${sample.length} has a ladder from itself up to an organisation or a stated gap, with a label and an icon on every step`); }
