/* Views left out of the open edition (ADR 0004) render a short notice instead. */
for (const t of HIDDEN_VIEWS) RENDER[t] = () => { vb(t).innerHTML = `<div class="panel" data-hiddenview="1"><h2>${esc(TITLE[t] || t)}</h2><p>This view is only in the government edition of the catalogue, for government and public sector users. It covers ${MOVE_TABS.includes(t) ? "the proposed move of repositories out of the co-cddo GitHub organisation, which the repositories' owners haven't agreed yet" : "where projects are discussed in government Slack workspaces"}.</p><p><button type="button" class="btn" onclick="go('home')">Go to the home page</button></p></div>`; };

/* ---------- ASK, DRAFTS AND DOWNLOADS: everything runs in the page, with no AI service and no sign-in (R72) ----------
   Ask answers from the catalogue's own data: its search, its views and the role-based question shortcuts. Anything it
   can't answer goes to GitHub, where the maintainers answer in the open. Drafts for a co-cddo repository are filled in
   from templates and the facts on its profile, so the same facts always give the same draft. */
const ASK_STOP = new Set(("a about across all already an and any anyone are as at be been by can could do does doing else find for from get looking other others similar someone "
  + "give has have how i if in into is it its just know let me more most my of on or our out please show so some tell than that the their them "
  + "then there these they this those to up us want was we were what when where which who whom why will with would you your").split(" "));
function askTerms(q) { return [...new Set(String(q || "").toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu, " ").split(/\s+/).filter(w => w.length > 1 && !ASK_STOP.has(w)))]; }
const askHidden = a => /^go:/.test(a) && (HIDDEN_VIEWS.has(a.slice(3)) || a === "go:ask");
function askAnswer(q) {
  const ws = askTerms(q); if (!ws.length) return {ws, views: [], lens: [], hits: [], total: 0, exact: false};
  const hit = txt => { const l = String(txt || "").toLowerCase(); return ws.reduce((a, w) => a + (l.includes(w) ? 1 : 0), 0); }, need = Math.min(2, ws.length);   /* a view or question must share two of the words, or the only one */
  const views = TABS.filter(t => !HIDDEN_VIEWS.has(t) && t !== "ask").map(t => [hit((TITLE[t] || "") + " " + (VIEW_SUM[t] || "")) + (hit(TITLE[t]) ? 1 : 0), t])
    .filter(v => v[0] >= need).sort((a, b) => b[0] - a[0] || a[1].localeCompare(b[1])).slice(0, 4).map(v => v[1]);
  const lens = LENSES.flatMap(L => L.q.map(([txt, a]) => [hit(txt), txt, a, L.t])).filter(x => x[0] >= need && !askHidden(x[2])).sort((a, b) => b[0] - a[0] || a[1].localeCompare(b[1])).slice(0, 4);
  let hits = gsSearch(ws.join(" ")); const exact = hits.length > 0;
  if (!exact) { const tally = new Map();   /* no record matches every word: rank by how many of the words each one matches */
    for (const w of ws) for (const e of gsSearch(w)) { const t = tally.get(e) || [0, e]; t[0]++; tally.set(e, t); }
    hits = [...tally.values()].filter(t => ws.length < 3 || t[0] >= 2).sort((a, b) => b[0] - a[0] || (b[1]._s || 0) - (a[1]._s || 0) || a[1].title.localeCompare(b[1].title)).map(t => t[1]); }
  return {ws, views, lens, hits: hits.slice(0, 8), total: hits.length, exact};
}
const askForm = q => /[?&]template=contact\.yml$/.test(DATA.contact_url || "") ? DATA.contact_url + "&" + new URLSearchParams({about: "A question about the catalogue", message: String(q).slice(0, 1500)}).toString() : DATA.contact_url;
const ASK_EXAMPLES = ["Who else is building LLM tooling in health?", "Which public bodies publish data catalogues?", "Find design systems I can reuse", "Where is metadata work happening?", "Which projects use GOV.UK Notify?", "What changed in the last 12 months?"];
RENDER.ask = () => {
  vb("ask").innerHTML = `<div class="panel ask"><div class="panel-head"><h2>Ask a question</h2><span class="prov o">From this catalogue's data</span></div>
    <p class="lede">Ask in your own words. The answer comes from this page: the projects, organisations, topics and words that match your question, the views that cover it, and the questions people in your kind of role usually start with. Nothing you type leaves the page. If the catalogue can't answer it, ask the maintainers on GitHub.</p>
    <div class="chips" style="margin:10px 0">${ASK_EXAMPLES.map(q => `<button class="btn sm" type="button" data-q="${esc(q)}">${esc(q)}</button>`).join("")}</div>
    <form id="askform" role="search" aria-label="Ask a question about the catalogue" style="display:grid;gap:8px;margin-top:6px"><label for="askq" style="font-weight:700;font-size:14px">Your question</label><textarea id="askq" rows="2" maxlength="1200"></textarea><div><button class="btn primary" type="submit">Ask</button></div></form>
    <div id="ask-out" aria-live="polite"></div></div>`;
  const out = $("#ask-out");
  const show = q => { q = String(q || "").trim(); if (!q) { out.innerHTML = ""; return; } const A = askAnswer(q), all = A.ws.join(" ");
    const kindOf = e => (GSK_BY[e.k] || [e.k, e.k])[1];
    out.innerHTML = `<h3 style="margin-top:14px">What the catalogue has on “${esc(q)}”</h3>
      ${!A.ws.length ? `<p class="muted">Add a word or two about what you're looking for, such as a topic, an organisation or a kind of tool.</p>` : `
      ${A.hits.length ? `<p class="small muted">${A.exact ? `${nf(A.total)} record${A.total === 1 ? "" : "s"} match every word that matters (${esc(A.ws.join(", "))}).` : `Nothing matches all of ${esc(A.ws.join(", "))}, so these match the most of them.`}</p>
        <ul class="ask-hits" style="margin:6px 0 0;padding-left:18px;display:grid;gap:4px">${A.hits.map((e, i) => `<li><button type="button" class="linkbtn" data-askhit="${i}">${gsMark(e.title, all)}</button> <span class="chip">${esc(kindOf(e))}</span> <span class="small muted">${gsMark(e.sub, all)}</span></li>`).join("")}</ul>
        <p style="margin-top:6px"><button type="button" class="btn sm" id="ask-all">See every match in Search</button></p>` : `<p class="muted">No project, organisation, topic or word in the catalogue matches ${esc(A.ws.join(", "))}.</p>`}
      ${A.views.length ? `<h3 style="margin-top:12px">Views that cover it</h3><ul style="margin:6px 0 0;padding-left:18px">${A.views.map(t => `<li><button type="button" class="linkbtn" data-go="${esc(t)}">${esc(TITLE[t] || t)}</button> <span class="small muted">${esc(VIEW_SUM[t] || "")}</span></li>`).join("")}</ul>` : ""}
      ${A.lens.length ? `<h3 style="margin-top:12px">Questions people start with</h3><ul style="margin:6px 0 0;padding-left:18px">${A.lens.map(x => `<li><button type="button" class="linkbtn" data-act="${esc(x[2])}">${esc(x[1])}</button> <span class="small muted">${esc(x[3])}</span></li>`).join("")}</ul>` : ""}`}
      <div class="box" style="margin-top:12px"><b>Not what you needed?</b><p class="small" style="margin:4px 0 0">Ask the maintainers through ${ext(askForm(q), "the contact form, with your question filled in")} or in ${ext(DATA.url + "/discussions", "the repository's Discussions")}. Both are on GitHub and public, so leave out personal or sensitive details.</p></div>`;
    $$("[data-askhit]", out).forEach(b => b.onclick = () => gsOpen(A.hits[+b.dataset.askhit]));
    $("#ask-all", out)?.addEventListener("click", () => gsGo(all));
    bindAct(out); };
  $("#askform").onsubmit = e => { e.preventDefault(); show($("#askq").value); };
  $$("[data-q]", vb("ask")).forEach(b => b.onclick = () => { $("#askq").value = b.dataset.q; show(b.dataset.q); });
};

/* Drafts for one co-cddo repository: the GDS Way archive or move notice, an impact assessment and a message to the teams
   that depend on it, each filled in from the facts on the profile. Placeholders in [brackets] are for the owner to complete. */
const DRAFTS = [["notice", "Archive or move notice", "the README notice the GDS Way asks for"], ["impact", "Impact assessment", "for the change record"], ["consumers", "Message to consumers", "for the teams that depend on it"]];
function draftText(id, r) {
  const g = effGroup(r), dest = GLABEL[g] || "", moves = moving(g), arch = /^[67]/.test(g), del = /^8/.test(g), it = impact(r);
  const callers = DATA.edges.filter(e => e.target === r.repo && e.kind !== "link"), users = [...new Set(callers.map(e => e.source))].sort();
  const cons5 = /^5/.test(g), home = moves ? "https://github.com/gds-dtx/" + r.repo : cons5 ? "[the repository it joins]" : "[new location]";
  if (id === "notice") return moves || /^[45]/.test(g)
    ? `> **This repository has ${cons5 ? "been merged into another" : "moved"}.**\n>\n> ${cons5 ? "Its work continues in" : "It now lives at"} ${home}. The co-cddo GitHub organisation is being retired, and its repositories are moving to their long-term owners.\n> Update any links, \`uses:\` lines, package sources and Pages addresses that point here.${r.pages ? `\n> The GitHub Pages site has moved from ${r.pages_url} to [new site address]; GitHub doesn't redirect the old address.` : ""}\n>\n> Moved on [date]. Questions: [team contact route].\n`
    : `> **This repository is archived.**\n>\n> It is no longer maintained${r.last_human_commit ? `; the last change by a person was on ${fmtD(r.last_human_commit)}` : ""}. The code stays here, read-only, for reference.${del ? "\n> [Say where the work continues, if anywhere, before it is deleted.]" : ""}\n> ${arch ? "[If the work continues elsewhere, link to it here.]" : "[Say why it was archived.]"}\n>\n> Archived on [date]. Questions: [team contact route].\n`;
  if (id === "impact") return `# Impact assessment: ${r.repo}\n\n## What changes\n${moves ? `The repository moves from co-cddo to ${home} (${dest}).` : cons5 ? `The repository's work is merged into ${home}, then this repository is archived (${dest}).` : arch || del ? `The repository is ${del ? "deleted" : "archived"} (${dest}).` : `The owner decides where it goes: gds-dtx, alphagov or keep it (${dest}). Destination: ${home}.`} ${r.status === "Active" ? "It is in active use: a person committed in the last 90 days." : "Activity: " + r.status.toLowerCase() + "."}\n\n## Who is affected\n- Upstream: ${r.codeowners ? "code owners " + r.codeowners : "no CODEOWNERS file; owner inferred as " + (r.inferred_team || "unknown")}.\n- Downstream: ${users.length ? users.length + " co-cddo repositories reference it in code: " + users.join(", ") + "." : "no co-cddo repository references it in code."}${r.pages ? `\n- Readers of the GitHub Pages site at ${r.pages_url}.` : ""}\n\n## Risks and actions\n${it.map(i => `- **${i[0] === "red" ? "High" : i[0] === "amber" ? "Medium" : "Note"}:** ${i[1]} Action: ${i[2]}`).join("\n")}\n\n## Checks before and after cutover\n- Before: confirm the destination with the owner; recreate teams and CODEOWNERS; [list secrets, environments and webhooks to recreate — not visible from public data].\n- After: run the default branch's workflows; check every caller listed above; check the Pages address and any custom domain.\n\n## Rollback\nTransfer the repository back and restore the old references. GitHub retires the old owner and name once a repository is transferred, so [check this before choosing a new name].\n`;
  return `Subject: ${r.repo} is ${moves || !cons5 && !arch && !del ? "moving to " + home : cons5 ? "being merged into " + home : del ? "being deleted" : "being archived"}\n\nHello,\n\nYou're getting this because ${users.length ? "your repository (" + users.join(", ") + ") references " + r.repo + " in code" : "you use " + r.repo}.\n\nWhat will change: ${cons5 ? `on [date] its work moves into ${home} and it is archived.` : arch ? "on [date] it will be archived and stop receiving changes." : del ? "on [date] it will be deleted." : `on [date] it moves from co-cddo to ${home}. GitHub doesn't redirect calls to actions or GitHub Pages addresses after a move.`}\n\nWhat to update:\n${it.filter(i => i[0] !== "info").map(i => "- " + i[2]).join("\n") || "- Any link or reference to co-cddo/" + r.repo + "."}\n\nIf you have questions, [team contact route].\n\n[Team name]\n`;
}
function renderDraftBox(r) {
  const box = $("#draftbox"); if (!box) return;
  box.innerHTML = `<h3>Drafts for this repository <span class="prov c">Filled in from the facts above</span></h3><p class="small muted">Each draft is built from this profile's facts, with [placeholders] for what only the owner knows. Edit it, then copy it into a README, the change record or an issue.</p>
    <div class="chips">${DRAFTS.map(([id, name, why]) => `<button class="btn sm" type="button" data-draft="${id}" title="${esc(why)}">${esc(name)}</button>`).join("")}</div><div id="draft-out"></div>`;
  $$("[data-draft]", box).forEach(b => b.onclick = () => { const [id, name] = DRAFTS.find(d => d[0] === b.dataset.draft), out = $("#draft-out");
    const lab = document.createElement("label"); lab.textContent = name + " (editable)"; lab.htmlFor = "draft-ta"; lab.style.fontWeight = "700"; lab.style.fontSize = "14px"; lab.style.display = "block"; lab.style.marginTop = "8px";
    const ta = document.createElement("textarea"); ta.rows = 12; ta.id = "draft-ta"; ta.value = draftText(id, r);
    const cp = document.createElement("button"); cp.className = "btn sm"; cp.type = "button"; cp.textContent = "Copy draft"; const cst = document.createElement("span"); cst.className = "status-line"; cst.setAttribute("role", "status");
    out.replaceChildren(lab, ta, cp, cst); cp.onclick = () => copy(ta.value, cst); });
}
RENDER.ai = () => {
  vb("ai").innerHTML = `<div class="panel"><h2>How AI is used here</h2><p class="lede" style="margin-top:6px">No AI runs in this page. Nothing you type or open is sent anywhere: the page makes no network requests at all, and it works the same for everyone, with no account, licence or sign-in.</p>
    ${kv([["Ask a question", "Answered from the catalogue's own data: its search, its views and the role-based question shortcuts. Questions it can't answer go to the maintainers on GitHub."],
      ["Drafts for a repository", "Filled in from templates and the facts on the repository's profile, so the same facts always give the same draft."],
      ["Decisions", "Recorded by people on GitHub, through an issue form in the private companion repository, and collected when the government edition is built."],
      ["Built with AI", "Claude (Anthropic) helped write the data pipeline, the tagging rules and this page under the owner's direction. Every figure can be reproduced from the build scripts in the repository, and every change went through a pull request and the checks."],
      ["Where AI was used to judge", "The precision of the strategy and DAM tags was estimated by an AI reviewer on a labelled sample. Tags are shown as candidates, with their measured precision."]])}
    <p class="small muted" style="margin-top:8px">This follows the spirit of the ${ext("https://www.gov.uk/government/collections/algorithmic-transparency-recording-standard-hub", "Algorithmic Transparency Recording Standard")}. As no algorithmic tool makes or supports decisions in the page, no ATRS record is needed for it.</p></div>`;
};

/* ---------- DOCUMENTS: artefact pack generated from the same data ---------- */
const DOC_KEYS = Object.keys(DATA.docs);
let docSel = DOC_KEYS[0];
function renderBlocks(blocks) { return blocks.map(b => {
  if (b[0] === "h") return `<h3>${esc(b[1])}</h3>`; if (b[0] === "p") return `<p>${esc(b[1])}</p>`;
  if (b[0] === "ul") return `<ul>${b[1].map(i => `<li>${esc(i)}</li>`).join("")}</ul>`;
  if (b[0] === "note") return `<div class="warn amber"><b>Note</b><span>${esc(b[1])}</span></div>`;
  if (b[0] === "table") return `<div class="tbl-wrap"><table><thead><tr>${b[1].map(h => `<th scope="col">${esc(h)}</th>`).join("")}</tr></thead><tbody>${b[2].map(r => `<tr>${r.map(c => `<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
  return ""; }).join(""); }
function blocksMd(title, blocks) { const cell = c => String(c ?? "").replace(/\|/g, "\\|").replace(/\n/g, " ");
  return `## ${title}\n\n` + blocks.map(b => b[0] === "h" ? `### ${b[1]}\n` : b[0] === "p" ? `${b[1]}\n` : b[0] === "note" ? `> **Note:** ${b[1]}\n` : b[0] === "ul" ? b[1].map(i => `- ${i}`).join("\n") + "\n" :
    b[0] === "table" ? `| ${b[1].map(cell).join(" | ")} |\n| ${b[1].map(() => "---").join(" | ")} |\n` + b[2].map(r => `| ${r.map(cell).join(" | ")} |`).join("\n") + "\n" : "").join("\n"); }
function packMd() { return `# GitHub Repos Asset Catalogue: artefact pack\n\nVersion ${DATA.version} · ${DATA.docid} · data as at ${REFD}\n\nGenerated from the same data as the page.\n\n` + DOC_KEYS.map(k => blocksMd(DATA.docs[k][0], DATA.docs[k][1])).join("\n") +
  `\n## Requirements\n\n| ID | Requirement | Source | Checks |\n| --- | --- | --- | --- |\n` + DATA.requirements.map(q => `| ${q[0]} | ${q[1]} | ${q[2]} | ${q[4].join(", ")} |`).join("\n") +
  `\n\n## Defect register\n\n| ID | Found | Severity | What | Fix | Status |\n| --- | --- | --- | --- | --- | --- |\n` + DATA.defects.map(d => `| ${d[0]} | ${d[1]} | ${d[2]} | ${d[3].replace(/\|/g, "/")} | ${d[5].replace(/\|/g, "/")} | ${d[7]} |`).join("\n") + "\n"; }
const NS = DATA.url + "#";
function knowledgeGraph() {
  const g = [], id = (t, k) => `cmx:${t}/${encodeURIComponent(k)}`;
  for (const o of XO) g.push({"@id": id("org", o.org), "@type": ["cmx:Organisation", "schema:Organization"], "schema:name": o.org, "cmx:sector": id("sector", o.sector), "cmx:publicRepositories": o.total_on_github});
  for (const s of SECTORS) g.push({"@id": id("sector", s), "@type": ["cmx:Sector", "skos:Concept"], "skos:prefLabel": s});
  for (const s of DATA.strategy) g.push({"@id": id("tag", s.id), "@type": ["cmx:StrategyTag", "skos:Concept"], "skos:prefLabel": s.label, "schema:url": s.url, "cmx:precision": PREC[s.id]?.precision ?? null});
  for (const gr of GROUPS) g.push({"@id": id("destination", gr[0].slice(0, 1)), "@type": ["cmx:DestinationGroup", "skos:Concept"], "skos:prefLabel": gr[1]});
  for (const r of rows) g.push({"@id": id("repo", "co-cddo/" + r.repo), "@type": ["cmx:Repository", "schema:SoftwareSourceCode"], "schema:name": r.repo, "schema:codeRepository": r.url, "cmx:ownedBy": {"@id": id("org", "co-cddo")},
    "cmx:activityStatus": r.status, "cmx:proposedDestination": {"@id": id("destination", r.destination_group.slice(0, 1))}, "cmx:effectiveDestination": {"@id": id("destination", effGroup(r).slice(0, 1))}, "cmx:taggedWith": Object.keys(r.tags).map(t => ({"@id": id("tag", t)})),
    "cmx:usesStandard": r.standards, "cmx:pagesSite": r.pages ? r.pages_url : null, "cmx:similarTo": r.related_xgov.map(([o, n]) => ({"@id": id("repo", o + "/" + n)}))});
  for (const e of DATA.edges) if (e.kind !== "link") g.push({"@id": id("ref", e.source + ">" + e.target + ">" + e.kind), "@type": "cmx:CodeReference", "cmx:from": {"@id": id("repo", "co-cddo/" + e.source)}, "cmx:to": {"@id": id("repo", "co-cddo/" + e.target)}, "cmx:kind": e.kind, "cmx:lines": e.refs});
  for (const x of X) if (x.org !== "co-cddo" && (x.tags.length || x.dam || x.stds.length)) g.push({"@id": id("repo", x.key), "@type": ["cmx:Repository", "schema:SoftwareSourceCode"], "schema:name": x.n, "cmx:ownedBy": {"@id": id("org", x.org)}, "cmx:activityStatus": x.st, "cmx:taggedWith": x.tags.map(t => ({"@id": id("tag", t)})), "cmx:damRelevant": !!x.dam, "cmx:usesStandard": x.stds});
  for (const q of DATA.requirements) g.push({"@id": id("req", q[0]), "@type": "cmx:Requirement", "schema:description": q[1], "prov:wasDerivedFrom": q[2], "cmx:verifiedBy": q[4].map(c => ({"@id": id("check", c)}))});
  for (const c of DATA.registry) g.push({"@id": id("check", c.id), "@type": "cmx:Check", "schema:description": c.text, "cmx:status": c.status, "cmx:group": c.group});
  for (const d of DATA.defects) g.push({"@id": id("defect", d[0]), "@type": "cmx:Defect", "schema:description": d[3], "cmx:severity": d[2], "cmx:status": d[7], "cmx:guardedBy": d[6].map(c => ({"@id": id("check", c)}))});
  return {"@context": {"cmx": NS, "schema": "https://schema.org/", "dcat": "http://www.w3.org/ns/dcat#", "prov": "http://www.w3.org/ns/prov#", "skos": "http://www.w3.org/2004/02/skos/core#", "dcterms": "http://purl.org/dc/terms/"},
    "@id": NS + "graph", "schema:name": "GitHub Repos Asset Catalogue knowledge graph", "schema:version": DATA.version, "schema:dateModified": DATA.meta.ref_date, "@graph": g};
}
function ontologyTtl() {
  const tbl = DATA.docs.ontology[1].find(b => b[0] === "table"), lines = [`@prefix cmx: <${NS}> .`, "@prefix owl: <http://www.w3.org/2002/07/owl#> .", "@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .", "@prefix skos: <http://www.w3.org/2004/02/skos/core#> .",
    "@prefix schema: <https://schema.org/> .", "@prefix dcterms: <http://purl.org/dc/terms/> .", "@prefix prov: <http://www.w3.org/ns/prov#> .", "@prefix dcat: <http://www.w3.org/ns/dcat#> .", "",
    `<${NS}ontology> a owl:Ontology ; rdfs:label "GitHub Repos Asset Catalogue ontology" ; owl:versionInfo "${DATA.version}" .`, ""];
  const lit = s => '"' + String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"@en';
  for (const [term, kind, meaning, maps] of (tbl ? tbl[2] : [])) { if (!/^cmx:\w+$/.test(term)) continue;
    const t = kind === "Class" ? "owl:Class" : "owl:DatatypeProperty"; const m = /^(schema|skos|dcterms|prov|dcat):\w+$/.test(maps) ? ` ;\n  skos:closeMatch ${maps}` : "";
    lines.push(`${term} a ${t} ;\n  rdfs:label ${lit(term.slice(4))} ;\n  rdfs:comment ${lit(meaning)}${m} .`); }
  return lines.join("\n") + "\n";
}
/* Downloads are ordinary browser downloads, made in the page from its own data (R72) */
function saveFile(filename, data, type = "text/plain;charset=utf-8") {
  const url = URL.createObjectURL(new Blob([data], {type})), a = document.createElement("a");
  a.href = url; a.download = filename; a.rel = "noopener"; a.hidden = true; document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 4000);
}
function save(filename, data, st) { let msg; try { saveFile(filename, data); msg = "Downloaded " + filename; } catch { msg = "Your browser didn't allow the download"; } if (st) st.textContent = msg + "."; else toast(msg); }
RENDER.docs = () => {
  vb("docs").innerHTML = `<div class="panel"><div class="panel-head"><h2>Documents</h2><span class="muted">generated from the same data as the page, so the numbers match</span></div>
    <p class="lede">The usual artefact pack: theory of change, user research, service blueprint, product requirements, integration requirements, architecture, designs, data dictionary, glossary, taxonomies and ontology. Requirements link to checks and defects under Traceability.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px"><button class="btn" type="button" id="dl-md">Download the pack (Markdown)</button><button class="btn" type="button" id="dl-kg">Download the knowledge graph (JSON-LD)</button><button class="btn" type="button" id="dl-ttl">Download the ontology (Turtle, as text)</button><span class="status-line" id="dl-st" role="status"></span></div></div>
    <div class="doclayout"><nav aria-label="Documents"><ul>${DOC_KEYS.map(k => `<li><button type="button" data-doc="${esc(k)}" ${k === docSel ? 'aria-current="true"' : ""}>${esc(DATA.docs[k][0])}</button></li>`).join("")}</ul></nav>
    <article class="panel doc" id="doc-body" aria-labelledby="doc-h"></article></div>`;
  const show = (k, focus) => { docSel = k; $$("[data-doc]", vb("docs")).forEach(b => b.dataset.doc === k ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current"));
    $("#doc-body").innerHTML = `<h2 id="doc-h" tabindex="-1">${esc(DATA.docs[k][0])}</h2>${renderBlocks(DATA.docs[k][1])}`; if (focus) $("#doc-h").focus(); };
  $$("[data-doc]", vb("docs")).forEach(b => b.onclick = () => show(b.dataset.doc, true)); show(docSel, false);
  const st = $("#dl-st");
  $("#dl-md").onclick = () => save("co-cddo-artefact-pack-" + DATA.version + ".md", packMd(), st);
  $("#dl-kg").onclick = () => save("co-cddo-knowledge-graph-" + DATA.version + ".json", JSON.stringify(knowledgeGraph(), null, 1), st);
  $("#dl-ttl").onclick = () => save("co-cddo-ontology-" + DATA.version + ".ttl.txt", ontologyTtl(), st);
};

/* ---------- TRACEABILITY: requirement → views → checks → defects ---------- */
const REG = Object.fromEntries(DATA.registry.map(c => [c.id, c]));
const ckTag = id => { const c = REG[id], s = c ? c.status : "missing", live = s === "live" ? (pageCheckById(id) ?? null) : null;
  const shown = s === "live" ? (live === null ? "live" : live ? "pass" : "fail") : s; const cls = {pass:"pass", fail:"fail", live:"live", "not run":"notrun", missing:"fail"}[shown] || "notrun";
  return `<span class="ck ${cls}" title="${esc(c?.text || "not registered")}">${esc(id)}: ${esc(shown)}</span>`; };
RENDER.trace = () => {
  const VIEWS = {related: "plan", spotlight: "start", footer: "about"};
  vb("trace").innerHTML = `<div class="panel"><h2>Traceability</h2><p class="lede" style="margin-top:6px">Each requirement, from your requests and standing rules, links to the views that meet it, the checks that prove it and the defects found against it. Page self-checks run in your browser now; build checks ran when the data was assembled.</p></div>
    ${DATA.requirements.map(([id, stmt, src, views, checks]) => { const ds = DATA.defects.filter(d => d[6].some(c => checks.includes(c)));
      return `<div class="panel"><div class="panel-head"><h3>${esc(id)}: ${esc(stmt)}</h3><span class="muted">${esc(src)}</span></div><div class="chainrow">
        <div><span class="eyebrow">Views</span>${views.map(v => { const t = TABS.includes(v) ? v : VIEWS[v]; return t ? `<button class="btn sm" type="button" data-go="${esc(t)}">${esc(TITLE[t])}${TABS.includes(v) ? "" : " (" + esc(v) + ")"}</button>` : `<span class="muted">${esc(v)}</span>`; }).join("")}</div>
        <div><span class="eyebrow">Checks</span><div class="chips">${checks.map(ckTag).join("")}</div></div>
        <div><span class="eyebrow">Defects</span>${ds.length ? ds.map(d => `<span><b>${esc(d[0])}</b> <span class="sev-${esc(d[2])}">${esc(d[2])}</span>: ${esc(d[7])}</span>`).join("") : '<span class="muted">none recorded</span>'}</div></div></div>`; }).join("")}`;
};

/* ---------- DEFECTS AND RELEASES ---------- */
RENDER.defects = () => {
  const open = DATA.defects.filter(d => !/^Fixed/.test(d[7])).length;
  vb("defects").innerHTML = `<div class="panel"><h2>Defect register</h2><p class="lede" style="margin-top:6px">Every defect found, by an independent review or while building, with its cause, fix and the checks that now guard it. ${open ? `<b>${open} open.</b>` : "None open."}</p>
    <div class="tbl-wrap" style="margin-top:10px"><table><thead><tr><th scope="col">ID</th><th scope="col">Found</th><th scope="col">Severity</th><th scope="col">What went wrong</th><th scope="col">Cause</th><th scope="col">Fix</th><th scope="col">Guarded by</th><th scope="col">Status</th></tr></thead><tbody>
    ${DATA.defects.map(d => `<tr><th scope="row">${esc(d[0])}</th><td>${esc(d[1])}</td><td class="sev-${esc(d[2])}">${esc(d[2])}</td><td>${esc(d[3])}</td><td class="muted">${esc(d[4])}</td><td>${esc(d[5])}</td><td><div class="chips">${d[6].map(ckTag).join("")}</div></td><td>${esc(d[7])}</td></tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>Releases</h2><ol class="steps" style="list-style:none;padding:0;margin-top:10px">${[...DATA.releases].reverse().map(([v, d, t]) => `<li class="step"><span class="w" aria-hidden="true">${esc(v)}</span><h3>Version ${esc(v)}, ${esc(d)}</h3><p>${esc(t)}</p></li>`).join("")}</ol></div>`;
};

/* ---------- METHOD AND CHECKS ---------- */
RENDER.about = () => {
  const pc = pageChecks(), groups = [...new Set(DATA.registry.map(c => c.group))];
  const counts = DATA.registry.reduce((a, c) => { const s = c.status === "live" ? (pageCheckById(c.id) ? "pass" : "fail") : c.status; a[s] = (a[s] || 0) + 1; return a; }, {});
  vb("about").innerHTML = `
  <div class="grid2"><div class="panel"><h2>How this was built</h2><dl class="kv" style="margin-top:8px">${DATA.method.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join("")}
    <dt>Personal data</dt><dd>For co-cddo repositories, contributor names from public git history are shown to help find owners. Elsewhere only counts are shown. No email addresses are published. Decisions show the GitHub issue they were recorded in, not who recorded them.</dd></dl></div>
  <div class="panel"><h2>Page self-checks</h2><p class="muted" style="font-size:13.5px">Run now in your browser.</p><ol class="checks" style="margin-top:6px">${pc.map(([id, ok, m]) => `<li class="${ok ? "pass" : "fail"}">${ok ? "PASS" : "FAIL"} ${esc(id)} ${esc(m)}</li>`).join("")}</ol></div></div>
  <div class="panel"><div class="panel-head"><h2>Check registry</h2><span class="muted">${DATA.registry.length} checks: ${Object.entries(counts).map(([k, v]) => `${v} ${esc(k)}`).join(", ")}</span></div>
    <p class="lede">Every check has an ID used by Traceability and the defect register. The suite only grows: each defect adds a check, and checks marked “n” are negative tests that prove a check can fail.</p>
    ${groups.map(g => `<h3 style="margin-top:12px">${esc(g)}</h3><div class="tbl-wrap"><table><thead><tr><th scope="col">ID</th><th scope="col">Result</th><th scope="col">What it checks</th><th scope="col">Guards against</th></tr></thead><tbody>${DATA.registry.filter(c => c.group === g).map(c => `<tr><th scope="row" class="mono" style="text-transform:none">${esc(c.id)}</th><td>${ckTag(c.id)}</td><td>${esc(c.text)}</td><td class="muted">${esc(c.guards)}</td></tr>`).join("")}</tbody></table></div>`).join("")}</div>`;
};
RENDER.a11y = () => { const d = DATA.docs.a11y; vb("a11y").innerHTML = `<div class="panel doc"><h2>${esc(d[0])}</h2>${renderBlocks(d[1])}</div>`; };

/* ---------- page self-checks P-01..P-14 ---------- */
