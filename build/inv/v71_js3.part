function pageCheckById(id) { if (!_pc) pageChecks(); return id in _pc ? _pc[id] : null; }

/* ---------- CSV export (formula-safe, D17) ---------- */
function csvCell(v) { let s = String(v ?? ""); if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; return `"${s.replace(/"/g, '""')}"`; }
function csvText(list) {
  const head = ["repository","url","activity_status","last_human_commit","human_commits_12m","authors_12m","inferred_owning_team","codeowners","licence","domain","capability","theme","kind","proposed_destination_group","proposed_destination","rationale","decision","decided_destination_group","decision_note","depended_on_by","breaking_refs","github_pages","custom_domain","strategy_tags","dam_relevance","open_standards","gds_way_must_failures","impact_warnings"];
  const lines = list.map(r => { const d = decisions[r.repo] || {}; return [r.repo, r.url, r.status, r.last_human_commit, r.human_commits_365d, r.authors_365d, r.inferred_team, r.codeowners, r.licence, r.domain, r.capability, r.theme, r.kind, GLABEL[r.destination_group], r.destination, r.rationale, DEC_LABEL[decState(r)], d.state === "changed" ? GLABEL[d.group] : "", d.note || "", r.depended_on_by, r.breaking, r.pages ? r.pages_url : "", r.pages_custom, Object.keys(r.tags).join(" "), r.dam || "", r.standards.join("; "), r.gwMustFail, impact(r).filter(i => i[0] === "red").length].map(csvCell).join(","); });
  return "﻿" + [head.join(","), ...lines].join("\r\n");
}
async function exportCSV() {
  const list = filtered();
  try { await dl.save({filename: "co-cddo-inventory-" + new Date().toISOString().slice(0, 10) + ".csv", data: csvText(list)}); toast(`CSV with ${list.length} rows saved`); }
  catch (e) { if (e?.code !== "declined") toast(e?.code === "rate_limited" ? "A download prompt is already open" : "Download isn't available here"); }
}

/* ---------- footer: disclaimers, disclosures, contact, colophon ---------- */
const OPEN_ED = HIDDEN_VIEWS.has("repos");
function renderFooter() {
  $("#footer").innerHTML = `<div class="cols">
    <div><h2>Disclaimer</h2><p>A working tool, not an official GDS publication or a statement of government policy.${OPEN_ED ? "" : " Proposed destinations are the author's assessment and need owner agreement."} Strategy and DAM tags come from phrase rules, with precision measured on a sample by an AI reviewer; they show candidates, not confirmed contributions. Data reflects public GitHub on ${REFD} and will go out of date. Private and internal repositories are not visible.</p></div>
    <div><h2>Disclosures and transparency</h2><ul><li>Built with Claude (Anthropic) under the owner's direction. Incorporates ${OPEN_ED ? "" : "the v1 migration workbook supplied on 8 October 2026, "}the X-Gov open-source repo scraper's repos.json and the UK Public Sector Code by Organisation mapping (MIT licence). AI features on this page are declared under <a href="#ai" data-go="ai">How AI is used</a>.</li><li>Sources: public GitHub pages and git history, GitHub Docs, the GDS Way and GOV.UK. Method, checks and defects: <a href="#about" data-go="about">Method and checks</a>, <a href="#defects" data-go="defects">Defects and releases</a>.</li><li>${OPEN_ED ? "Personal data: none beyond the public GitHub account and organisation names the projects belong to; no email addresses. This is the open edition: a government edition with more context is built for government and public sector users from a private companion repository." : "Personal data: public contributor names for co-cddo repositories only; no email addresses. Decisions store an opaque user ID."}</li><li>Fonts are embedded in the page (SIL Open Font License), so opening it makes no requests to third parties. The page has no analytics or tracking scripts.</li><li>Contains public sector information licensed under the Open Government Licence v3.0.</li></ul></div>
    <div><h2>Contact</h2><p>Questions, corrections and feedback go to the catalogue's maintainers through the contact form, which is on GitHub. We don't publish an email address.</p><p style="margin-top:6px"><a href="${esc(DATA.contact_url)}" target="_blank" rel="noopener" id="ft-contact">Contact form<span class="sr-only"> (opens in a new tab)</span></a></p><p class="small muted" style="margin-top:4px">Security problems: see <a href="${esc(DATA.url)}/security/policy" target="_blank" rel="noopener">how to report privately<span class="sr-only"> (opens in a new tab)</span></a>.</p></div>
    <div><h2>Colophon</h2><p>Version ${esc(DATA.version)} · document ${esc(DATA.docid)} · ${OPEN_ED ? "data as at " + REFD : "co-cddo data as at " + REFD}; government scan ${fmtD(DATA.meta.xref_date)}; practice signals ${fmtD(DATA.meta.enr_date)}. Type: Schibsted Grotesk, Atkinson Hyperlegible, JetBrains Mono, embedded from the Fontsource packages under the SIL Open Font License. Colours: a validated categorical palette with a text-safe ink and tint per colour. Single-file page.</p>
      <div class="codes" style="margin-top:10px"><figure style="margin:0"><div class="qr" role="img" aria-label="QR code linking to this page">${DATA.qr}</div><figcaption class="faint" style="font-size:12px;margin-top:4px">Scan to open this page</figcaption></figure>
      <figure style="margin:0"><div class="bc" role="img" aria-label="Barcode of document identifier ${esc(DATA.docid)}">${DATA.barcode}</div><figcaption class="faint" style="font-size:12px;margin-top:4px">Document identifier</figcaption></figure></div>
      <p style="margin-top:6px;font-size:12.5px" class="mono">${esc(DATA.url)}</p></div></div>`;
}

/* ---------- live notices ---------- */
function liveNote(msg) { const n = $("#live-note"); if (!msg) { n.hidden = true; n.textContent = ""; return; } n.hidden = false; n.innerHTML = `<span class="tag">Decisions</span><span>${esc(msg)}</span>`; }
function subscribe() {
  if (!db) return; try { unsub?.(); } catch {}
  unsub = db.collection("decisions").onSnapshot(async snap => {
    resubTries = 0; liveNote("");
    for (const k of Object.keys(decisions)) delete decisions[k]; decRejected = 0;
    for (const doc of snap.docs) { let v; try { v = doc.data(); } catch { v = null; } const ok = validDecision(doc.id, v); if (ok) decisions[doc.id] = ok; else decRejected++; }
    const ids = [...new Set(Object.values(decisions).map(x => x.by).filter(Boolean))];
    if (userCap && ids.length) { try { profiles = await userCap.profiles(ids); } catch {} }
    _pc = null; invalidateAll();
  }, err => {
    const code = err?.code;
    if (code === "revoked") { liveNote("Shared decisions are no longer available in this view."); db = null; invalidateAll(); return; }
    if (code === "unavailable" || !code || !DB_MSG[code]) { if (resubTries < 5) { resubTries++; liveNote("Live updates to decisions paused. Reconnecting…"); setTimeout(subscribe, 1500 * resubTries + Math.random() * 1000); } else liveNote("Live updates to decisions stopped. Reload the page to try again."); return; }
    liveNote(code === "resource_exhausted" ? "Too many live connections. Reload the page to see the latest decisions." : DB_MSG[code]);
  });
}

/* ---------- boot ---------- */
$("#refdate").textContent = REFD; $("#docid").textContent = "version " + DATA.version;
try { const s = JSON.parse(localStorage.getItem("cddo-filters4") || "{}"); for (const k of Object.keys(F0)) if (typeof s[k] === "string") F[k] = s[k]; } catch {}
renderSpot(); renderFooter();
(() => { const h = (location.hash || "").slice(1); if (osRoute(h)) return; let t = TABS.includes(h) ? h : null; if (!t) { try { t = localStorage.getItem("ghrac-tab6"); } catch {} } showTab(TABS.includes(t) ? t : "home", "replace"); })();
