/* ---------- CSV export (formula-safe, D17) ---------- */
function csvCell(v) { let s = String(v ?? ""); if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; return `"${s.replace(/"/g, '""')}"`; }
function csvText(list) {
  const head = ["repository","url","activity_status","last_human_commit","human_commits_12m","authors_12m","inferred_owning_team","codeowners","licence","domain","capability","theme","kind","proposed_destination_group","proposed_destination","rationale","decision","decided_destination_group","decision_note","depended_on_by","breaking_refs","github_pages","custom_domain","strategy_tags","dam_relevance","open_standards","gds_way_must_failures","impact_warnings"];
  const lines = list.map(r => { const d = decisions[r.repo] || {}; return [r.repo, r.url, r.status, r.last_human_commit, r.human_commits_365d, r.authors_365d, r.inferred_team, r.codeowners, r.licence, r.domain, r.capability, r.theme, r.kind, GLABEL[r.destination_group], r.destination, r.rationale, DEC_LABEL[decState(r)], d.state === "changed" ? GLABEL[d.group] : "", d.note || "", r.depended_on_by, r.breaking, r.pages ? r.pages_url : "", r.pages_custom, Object.keys(r.tags).join(" "), r.dam || "", r.standards.join("; "), r.gwMustFail, impact(r).filter(i => i[0] === "red").length].map(csvCell).join(","); });
  return "﻿" + [head.join(","), ...lines].join("\r\n");
}
function exportCSV() {
  const list = filtered();
  try { saveFile("co-cddo-inventory-" + new Date().toISOString().slice(0, 10) + ".csv", csvText(list), "text/csv;charset=utf-8"); toast(`CSV with ${list.length} rows downloaded`); }
  catch { toast("Your browser didn't allow the download"); }
}

/* ---------- footer: disclaimers, disclosures, contact, colophon ---------- */
const OPEN_ED = HIDDEN_VIEWS.has("repos");
function renderFooter() {
  $("#footer").innerHTML = `<div class="cols">
    <div><h2>Disclaimer</h2><p>A working tool, not an official GDS publication or a statement of government policy.${OPEN_ED ? "" : " Proposed destinations are the author's assessment and need owner agreement."} Strategy and DAM tags come from phrase rules, with precision measured on a sample by an AI reviewer; they show candidates, not confirmed contributions. Data reflects public GitHub on ${REFD} and will go out of date. Private and internal repositories are not visible.</p></div>
    <div><h2>Disclosures and transparency</h2><ul><li>Built with Claude (Anthropic) under the owner's direction. Incorporates ${OPEN_ED ? "" : "the v1 migration workbook supplied on 8 October 2026, "}the X-Gov open-source repo scraper's repos.json and the UK Public Sector Code by Organisation mapping (MIT licence). No AI runs in the page and it makes no network requests: see <a href="#ai" data-go="ai">How AI is used</a>.</li><li>Sources: public GitHub pages and git history, GitHub Docs, the GDS Way and GOV.UK. Method, checks and defects: <a href="#about" data-go="about">Method and checks</a>, <a href="#defects" data-go="defects">Defects and releases</a>.</li><li>${OPEN_ED ? "Personal data: none beyond the public GitHub account and organisation names the projects belong to; no email addresses. This is the open edition: a government edition with more context is built for government and public sector users from a private companion repository." : "Personal data: public contributor names for co-cddo repositories only; no email addresses. Decisions show the GitHub issue they were recorded in, not who recorded them."}</li><li>Fonts are embedded in the page (SIL Open Font License), so opening it makes no requests to third parties. The page has no analytics or tracking scripts.</li><li>Contains public sector information licensed under the Open Government Licence v3.0.</li></ul></div>
    <div><h2>Contact</h2><p>Questions, corrections and feedback go to the catalogue's maintainers through the contact form, which is on GitHub. We don't publish an email address.</p><p style="margin-top:6px"><a href="${esc(DATA.contact_url)}" target="_blank" rel="noopener" id="ft-contact">Contact form<span class="sr-only"> (opens in a new tab)</span></a></p><p class="small" style="margin-top:8px"><b>Related open projects:</b> <a href="${REL_P.dam.url}" target="_blank" rel="noopener">DAM capability playbooks<span class="sr-only"> (opens in a new tab)</span></a> · <a href="${REL_P.dqc.url}" target="_blank" rel="noopener">Data Quality Commons<span class="sr-only"> (opens in a new tab)</span></a> · <a href="${REL_P.dqc.url}ecosystem.html" target="_blank" rel="noopener">how the three fit together<span class="sr-only"> (opens in a new tab)</span></a></p><p class="small muted" style="margin-top:4px">Security problems: see <a href="${esc(DATA.url)}/security/policy" target="_blank" rel="noopener">how to report privately<span class="sr-only"> (opens in a new tab)</span></a>.</p></div>
    <div><h2>Colophon</h2><p>Version ${esc(DATA.version)} · document ${esc(DATA.docid)} · ${OPEN_ED ? "data as at " + REFD : "co-cddo data as at " + REFD}; government scan ${fmtD(DATA.meta.xref_date)}; practice signals ${fmtD(DATA.meta.enr_date)}. Type: Schibsted Grotesk, Atkinson Hyperlegible, JetBrains Mono, embedded from the Fontsource packages under the SIL Open Font License. Colours: a validated categorical palette with a text-safe ink and tint per colour. Single-file page.</p>
      <div class="codes" style="margin-top:10px"><figure style="margin:0"><div class="qr" role="img" aria-label="QR code linking to this page">${DATA.qr}</div><figcaption class="faint" style="font-size:12px;margin-top:4px">Scan to open this page</figcaption></figure>
      <figure style="margin:0"><div class="bc" role="img" aria-label="Barcode of document identifier ${esc(DATA.docid)}">${DATA.barcode}</div><figcaption class="faint" style="font-size:12px;margin-top:4px">Document identifier</figcaption></figure></div>
      <p style="margin-top:6px;font-size:12.5px" class="mono">${esc(DATA.url)}</p></div></div>`;
}

/* ---------- related elsewhere (RM-27): signposts to the two sister portals, each named with its status; links only, no requests ---------- */
const REL_P = {
  dam: {name: "DAM capability playbooks", status: "Prototype guidance, centrally owned", url: "https://cyberdudeuk.github.io/dam-capability-playbooks/"},
  dqc: {name: "Public Sector Data Quality Commons", status: "Community project, voluntary", url: "https://cyberdudeuk.github.io/dq-commons/"}};
const REL_AT = {
  dama: [["dam", "capability-model.html", "DAMA wheel with the DAM capabilities", "The capabilities the DAM Policy needs in each knowledge area, with a self-assessment."],
         ["dqc", "wheel.html", "Data management wheel", "The same 11 areas from a data quality angle, with what each audience can do and a maturity overlay."],
         ["dqc", "ecosystem.html", "Three portals, one journey", "Trace a knowledge area, role or standard through this catalogue and the two portals."]],
  standards: [["dqc", "interop.html#catalogue", "Standards catalogue", "Open standards for data, digital, cyber and technology with their GOV.UK status, including DCAT, the MEM and DQV."],
              ["dqc", "weaver.html", "Metadata Weaver", "Describe a dataset once and output DCAT, schema.org, CKAN and more, with its metadata quality as DQV."],
              ["dam", "tooling.html", "Tools and interoperability", "The open standards that connect data management tools, and what to ask suppliers."]],
  suppliers: [["dam", "tooling.html", "Tools and interoperability", "Nine kinds of data management tool, the pairings that work, commercial barriers and 23 questions to ask suppliers."],
              ["dqc", "catalogues.html", "Catalogue and quality tools", "Products compared, a lock-in checker and an RFI and RFP builder, before you buy."],
              ["dqc", "commercial.html", "Buying well", "Contract clauses for data quality and exit, so you can leave a supplier with your data intact."]],
  legacy: [["dam", "change.html", "Delivery and change", "Legacy exits, contracts and handover in programmes under the DAM Policy."],
           ["dqc", "legacy.html", "Legacy and modernisation", "Checking data before and after a migration, and reconciling it."]]};
function relElse(key) {
  const it = REL_AT[key] || [];
  if (!it.length) return "";
  return `<div class="panel" id="rel-${key}"><h2>Related elsewhere</h2><p class="muted" style="font-size:13.5px">Two other open projects cover ground next to this view. Each has its own owner, purpose and status, so they are linked, not merged.</p><ul style="margin:.5em 0 0;padding-left:20px;display:grid;gap:6px;max-width:85ch">${it.map(([p, path, t, why]) => `<li><a href="${esc(REL_P[p].url + path)}" target="_blank" rel="noopener">${esc(t)}<span class="sr-only"> (opens in a new tab)</span></a> in ${esc(REL_P[p].name)} <span class="faint">(${esc(REL_P[p].status)})</span><br><span class="muted small">${esc(why)}</span></li>`).join("")}</ul></div>`;
}

/* ---------- boot ---------- */
$("#refdate").textContent = REFD; $("#docid").textContent = "version " + DATA.version;
try { const s = JSON.parse(localStorage.getItem("cddo-filters4") || "{}"); for (const k of Object.keys(F0)) if (typeof s[k] === "string") F[k] = s[k]; } catch {}
renderSpot(); renderFooter();
(() => { const h = (location.hash || "").slice(1); if (osRoute(h)) return; let t = TABS.includes(h) ? h : null; if (!t) { try { t = localStorage.getItem("ghrac-tab6"); } catch {} } showTab(TABS.includes(t) ? t : "home", "replace"); })();
window.__app = {routeParse, hiddenLinkTargets, iaOrderProblems, HOME_ORDER, HIDDEN_VIEWS, MOVE_TABS, IO, IOQ, IOR, RG, RGQ, INFRA, INFRA_IX, IFQ, nationOf, SV, SVF, SVQ, svList, holderOf, DIMQ, DVN, DV_ACC, RXFA, CMPQ, cmpOf, cmpLevel, LEVELS, CMP, TH_SUB_HUE, thHue, XBY, SB, SBJ, SB_N, subjOf, themesOf, RX_BROWSE, XW, UG, UGS, TR, TOURS, TUTS, tourStart, tourEnd, glossTips, GT_TERMS, SD, SDS, TH, THC, THQ, thQ0, thSigs, thFiltered, TH_ALLY, kvVocabs, kvSkos, klGraph, KS, KO_CLASSES, KO_REL, kgNeighbours, kgRecs, gsIndex, gsSearch, gsOpen, gsGo, gsMark, GSQ, GSK, famFind, XWR, XWQ, XWQ0, xwRows, osElsewhere, osRoute, OS_LINKS, osOrgFeed, osRepoFeed, osDcat, OS_APPS, LGS, LGQ, LGQ0, lgSigs, lgCore, lgFiltered, RXK, RXK_BY, RXS, RX_LIC, RXD, RXD0, RXP, RXF, rxName, rxJargon, rxTerms, rxFiltered, rxKind, rxStat, rxCare, rxLadder, rxTrace, rxSimilar, rxGo, rxDiscover, famIndex, famPath, famGo, famSelect, famKids, famVis, HO, HR, rxOrgOf, PRC, hasP, discShare, pFiltered, PS, XE, XDIMS, xeFiltered, xeCount, GOWN, GLINK, GS7, g7Filtered, VIEW_TYPES, DREC, DS, DS0, dFiltered, areaCounts, wheelSvg, damaGo, damaCsv, damaSkos, VS, vUse, DV, APIR, GCAT, inGcat, aFiltered, AS, ODR, oFiltered, OS, IS, iFiltered, heroCarousel, foldCount, buildDrawer, setDrawer, drawerOpen, columns, heatmap, treemap, scatter, HUBS, TOPICS, topicStats, topicHit, topicGo, profGo, profRecords, peersOf, glossGo, LENSES, act, stdCsv, SORG, openSorg, stdFiltered, ALL, CATX, UNL, catCsv, catDcat, catFiltered, CS, showTab, openSheet, openX, openAny, decisions, validDecision, pageChecks, csvText, csvCell, impact, filtered, F, rows, X, renderTable, invalidateAll, get current() { return current; }, knowledgeGraph, ontologyTtl, packMd, askAnswer, askTerms, draftText, saveFile, loadDecisions, decForm, DEC_SRC};
</script>
<script>
/* Cross-portal journey bar (Commons v2.15, BL-34), for the three portals on the same site.
 * A journey started on the Commons ("Three portals, one journey") is kept in localStorage under "dqp-journey".
 * Any page of the Commons, the DAM capability playbooks or the GitHub repos catalogue that includes this script
 * shows a small bar with the step you are on and a link to the next one. Self-contained: no styles or libraries
 * needed, nothing sent anywhere, and nothing shown unless you started a journey. MIT licence.
 */
(function () {
  var st; try { st = JSON.parse(localStorage.getItem("dqp-journey") || "null"); } catch (e) { return; }
  if (!st || !st.steps || !st.steps.length || document.querySelector(".dqp-jbar")) return;
  var path = location.origin + location.pathname, at = -1, loose = -1;
  st.steps.forEach(function (s, k) {
    try { var u = new URL(s.url, location.href);
      if (u.origin + u.pathname === path) { if (u.hash && u.hash === location.hash) at = k; else if (loose < 0 || (typeof st.i === "number" && k === st.i)) loose = k; }
    } catch (e) {}
  });
  if (at < 0) at = loose;
  if (at < 0) return;
  st.i = at; try { localStorage.setItem("dqp-journey", JSON.stringify(st)); } catch (e) {}
  var n = st.steps.length, nx = st.steps[at + 1], pv = st.steps[at - 1];
  var esc = function (x) { return String(x).replace(/[&<>"]/g, function (c) { return {"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]; }); };
  // Styles are set on the elements themselves (not a style element), so pages whose security policy blocks inline
  // style sheets still show the bar properly.
  var dark = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches;
  var C = dark ? {bg: "#172129", fg: "#e5ecef", line: "#9aa9b3", acc: "#7cc9c4", accFg: "#0b1418"} : {bg: "#ffffff", fg: "#17212b", line: "#56636e", acc: "#0d6b6e", accFg: "#ffffff"};
  var font = "system-ui,-apple-system,'Segoe UI',sans-serif";
  function set(e, o) { Object.keys(o).forEach(function (k) { e.style.setProperty(k, o[k]); }); return e; }
  function btn(e, go) {
    set(e, {"font": "600 15px/1 " + font, "min-height": "40px", "padding": "8px 12px", "border-radius": "8px", "border": "1px solid " + (go ? C.acc : C.line),
      "background": go ? C.acc : "transparent", "color": go ? C.accFg : C.fg, "cursor": "pointer", "text-decoration": "none", "display": "inline-flex", "align-items": "center", "box-sizing": "border-box"});
    e.addEventListener("focus", function () { e.style.setProperty("outline", "3px solid #ffbf47"); e.style.setProperty("outline-offset", "2px"); });
    e.addEventListener("blur", function () { e.style.removeProperty("outline"); });
    return e;
  }
  function add() {
    var bar = set(document.createElement("aside"), {"position": "fixed", "z-index": "2147483000", "left": "50%", "transform": "translateX(-50%)", "bottom": "12px",
      "width": "min(760px, calc(100vw - 24px))", "background": C.bg, "color": C.fg, "border": "2px solid " + C.acc, "border-radius": "12px",
      "box-shadow": "0 10px 30px rgba(0,0,0,.25)", "padding": "10px 14px", "display": "flex", "flex-wrap": "wrap", "gap": "8px 12px", "align-items": "center",
      "font": "500 15px/1.4 " + font, "box-sizing": "border-box", "margin": "0"});
    bar.className = "dqp-jbar"; bar.setAttribute("aria-label", "Your journey");
    var txt = set(document.createElement("span"), {"flex": "1 1 220px"});
    txt.innerHTML = "<b>" + esc(st.name) + "</b> \u00b7 step " + (at + 1) + " of " + n + ": " + esc(st.steps[at].text);
    bar.appendChild(txt);
    if (pv) { var b1 = btn(document.createElement("a")); b1.href = pv.url; b1.textContent = "Back"; bar.appendChild(b1); }
    if (nx) { var b2 = btn(document.createElement("a"), true); b2.href = nx.url; b2.textContent = "Next: " + (nx.portal || "next step") + " \u2192"; bar.appendChild(b2); }
    else { var last = document.createElement("span"); last.innerHTML = "<b>Last step.</b>"; bar.appendChild(last); }
    var stop = btn(document.createElement("button")); stop.type = "button"; stop.textContent = nx ? "Stop the journey" : "Finish"; bar.appendChild(stop);
    document.body.appendChild(bar);
    window.addEventListener("beforeprint", function () { bar.style.display = "none"; });
    window.addEventListener("afterprint", function () { bar.style.display = "flex"; });
    var pad = document.body.style.paddingBottom;
    document.body.style.paddingBottom = Math.max(parseInt(getComputedStyle(document.body).paddingBottom, 10) || 0, bar.offsetHeight + 24) + "px";
    stop.addEventListener("click", function () { try { localStorage.removeItem("dqp-journey"); } catch (e) {} bar.remove(); document.body.style.paddingBottom = pad; });
  }
  if (document.body) add(); else document.addEventListener("DOMContentLoaded", add);
})();
</script>
