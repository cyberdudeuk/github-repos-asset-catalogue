    const ga = RX_GOWN[x.key]; if (ga) push("gds", ga, GA[ga]?.label || ga, "in GDS area", "i_users", "violet"); rxTopicsOf(x).forEach(t => push("topic", t.id, t.label, "about", RX_TOPIC_IC[t.id], t.c));
    const dm = DRECALL.find(r => r.key === x.key); if (dm) { [...new Set(dm.caps.map(c => c.a))].forEach(a => push("dama", a, DAREA[a]?.label || a, "data management", "wheel", "green")); dm.vend.slice(0, 4).forEach(t => push("tool", DV[t.i].id, DV[t.i].name, "uses", "k_tool", "orange")); }
    lgSigs(x).forEach(s => push("legacy", s.s.id, s.s.label, "signal", "legacy", "red")); thSigs(x).forEach(s => push("theme", s.c.theme, TH_META[s.c.theme][0], s.c.label, TH_META[s.c.theme][1], TH_META[s.c.theme][2]));
    rxSimilar(x, 3).forEach(s => push("repo", s.x.key, rxNm(s.x), "similar", rxKind(s.x).ic, rxKind(s.x).c)); }
  else { const recs = kgRecs(focus); const seen = {}; for (const x of recs.slice(0, 400)) { const kk = rxKind(x).id; seen[kk] = (seen[kk] || 0) + 1; }
    if (k === "org") { const n = famIndex().N[id]; if (n) { n.parents.slice(0, 2).forEach(p => push("org", p, famLabel(famIndex().N[p]), "part of", famIcon(famIndex().N[p]), famHue(famIndex().N[p]))); n.kids.slice(0, 8).forEach(p => push(famIndex().N[p].kind === "org" ? "org" : famIndex().N[p].kind === "acct" ? "acct" : "gds", famIndex().N[p].kind === "acct" ? famIndex().N[p].label : famIndex().N[p].kind === "unit" ? famIndex().N[p].area : p, famLabel(famIndex().N[p]), "has", famIcon(famIndex().N[p]), famHue(famIndex().N[p]))); } }
    recs.sort((a, b) => lastAct(b) - lastAct(a)).slice(0, 8).forEach(x => push("repo", x.key, rxNm(x), "repository", rxKind(x).ic, rxKind(x).c)); }
  return out.slice(0, 16);
