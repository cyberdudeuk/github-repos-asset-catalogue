  if (k === "dama") return DRECALL.filter(r => r.caps.some(c => c.a === id)).map(r => r.x); if (k === "tool") { const i = DV.findIndex(v => v.id === id); return DRECALL.filter(r => r.vend.some(t => t.i === i)).map(r => r.x); }
  if (k === "legacy") return ALL.filter(x => lgSigs(x).some(s => s.s.id === id)); if (k === "theme") return ALL.filter(x => thSigs(x).some(s => s.c.theme === id));
