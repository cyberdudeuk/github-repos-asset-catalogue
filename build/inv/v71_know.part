const kgLabel = ([k, id]) => k === "repo" ? rxNm(XBY[id] || {n: id}) : k === "org" ? famLabel(famIndex().N[id] || {kind: "org", label: id, o: {}}) : k === "topic" ? TOPIC_BY[id]?.label : k === "dama" ? DAREA[id]?.label : k === "tool" ? DV.find(v => v.id === id)?.name : k === "legacy" ? LGS.find(s => s.id === id)?.label : k === "theme" ? TH_META[id]?.[0] : k === "gds" ? GA[id]?.label : id;
function kgPanel() {
  if (!KS.focus) KS.focus = ["repo", RXP.key || rxDefaultKey()];
  const nb = kgNeighbours(KS.focus), W = 820, H = 520, cx = W / 2, cy = H / 2, R1 = 200, kind = KS.focus[0], meta = GSK_BY[kind === "theme" ? "view" : kind] || GSK_BY.repo, total = kind === "repo" ? null : kgRecs(KS.focus).length;
  const pos = nb.map((n, i) => { const a = -Math.PI / 2 + i * 2 * Math.PI / Math.max(1, nb.length); return [cx + Math.cos(a) * R1 * 1.75, cy + Math.sin(a) * R1]; });
  $("#kp").innerHTML = `<h2>Knowledge graph</h2><p class="muted small">One thing at the centre, everything it connects to around it. Select any node to move it to the centre; the path you took is kept below. Search to start anywhere.</p>
    <form class="gsform" id="kg-form" role="search" aria-label="Start the knowledge graph"><label for="kg-q" class="sr-only">Start the graph from</label><input type="search" id="kg-q" placeholder="Start from a project, organisation, topic, tool, signal…" autocomplete="off"><button class="btn" type="submit">${icon("search", 16)} Start here</button></form><ul class="gs-list" id="kg-hits"></ul>
    <div class="chartbox"><svg viewBox="0 0 ${W} ${H}" class="chart rxweb kg" role="group" aria-label="Knowledge graph centred on ${esc(kgLabel(KS.focus))}">${pos.map(([px, py], i) => `<line x1="${cx}" y1="${cy}" x2="${px}" y2="${py}" class="rxweb-l c-${nb[i].c}"/><text class="kg-rel" x="${(cx + px) / 2}" y="${(cy + py) / 2 - 4}" text-anchor="middle">${esc(nb[i].rel.slice(0, 22))}</text>`).join("")}
      <g><circle cx="${cx}" cy="${cy}" r="52" class="rxweb-c"/><text x="${cx}" y="${cy - 2}" text-anchor="middle" class="rxweb-ct">${esc(String(kgLabel(KS.focus) || "").slice(0, 18))}</text><text x="${cx}" y="${cy + 14}" text-anchor="middle" class="rxweb-ct sub">${esc(meta[1])}${total !== null ? " · " + nf(total) : ""}</text></g>
      ${nb.map((n, i) => { const [px, py] = pos[i]; const lab = n.label.length > 22 ? n.label.slice(0, 21) + "…" : n.label; return `<g class="rxweb-n c-${n.c}" role="button" tabindex="0" data-kgk="${esc(n.k)}" data-kgid="${esc(n.id)}" aria-label="${esc(n.label)}, ${esc(n.rel)}. Move to the centre" data-tip="${esc(n.label)} · ${esc(n.rel)}"><rect x="${px - 86}" y="${py - 17}" width="172" height="34" rx="17"/><text x="${px}" y="${py + 4}" text-anchor="middle">${esc(lab)}</text></g>`; }).join("")}</svg></div>
    <div class="kg-side"><p><b>Centre:</b> ${esc(kgLabel(KS.focus))} <span class="muted">(${esc(meta[1])})</span> ${kind === "repo" ? `<button class="btn sm" type="button" data-rx="${esc(KS.focus[1])}">Open its profile</button>` : ""}${kind === "org" && famIndex().N[KS.focus[1]] ? `<button class="btn sm" type="button" data-fam="${esc(KS.focus[1])}">Open in the family tree</button>` : ""} <button class="btn sm" type="button" id="kg-json">Download this neighbourhood, JSON-LD</button></p>
      <ul class="rxsim">${nb.map(n => `<li><span class="rxtile sm c-${n.c}" aria-hidden="true">${icon(n.ic, 14)}</span><div><button type="button" class="linkbtn" data-kgk="${esc(n.k)}" data-kgid="${esc(n.id)}">${esc(n.label)}</button> <span class="muted small">${esc(n.rel)}</span></div></li>`).join("") || "<li class='muted'>Nothing connected.</li>"}</ul>
      ${(KS.trail || []).length ? `<p class="small"><b>Path:</b> ${(KS.trail || []).map((f, i) => `<button type="button" class="linkbtn" data-kgback="${i}">${esc(kgLabel(f))}</button>`).join(" › ")} › ${esc(kgLabel(KS.focus))}</p>` : ""}</div>`;
  const p = $("#kp");
  $$("[data-kgk]", p).forEach(b => { const go = () => { (KS.trail ||= []).push(KS.focus); KS.trail = KS.trail.slice(-8); KS.focus = [b.dataset.kgk, b.dataset.kgid]; kgPanel(); $("#kp svg [role=button]")?.focus(); }; b.onclick = go; if (b.tagName === "g") b.onkeydown = e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); e.stopPropagation(); go(); } }; });
  $$("[data-kgback]", p).forEach(b => b.onclick = () => { const i = +b.dataset.kgback; KS.focus = KS.trail[i]; KS.trail = KS.trail.slice(0, i); kgPanel(); });
  $("#kg-form").onsubmit = e => { e.preventDefault(); const hits = gsSearch($("#kg-q").value).filter(h => ["repo", "org", "acct", "topic", "dama", "tool", "legacy", "gds"].includes(h.k)).slice(0, 8);
    $("#kg-hits").innerHTML = hits.map(h => `<li><button type="button" class="gs-hit" data-kgstart="${esc(h.k)}|${esc(h.id)}"><span class="gs-t"><b>${gsMark(h.title, $("#kg-q").value)}</b><span class="small muted">${esc(GSK_BY[h.k][1])} · ${esc(h.sub.slice(0, 100))}</span></span></button></li>`).join("") || `<li class="muted small">Nothing found.</li>`;
    $$("[data-kgstart]", p).forEach(b => b.onclick = () => { let [k, id] = b.dataset.kgstart.split("|"); if (k === "dama" && id.includes(":")) id = id.slice(2).split("-")[0]; if (k === "org" && id.startsWith("b:")) { k = "acct"; id = (BODIES[+id.slice(2)]?.accounts || [])[0] || id; } KS.trail = []; KS.focus = [k, id]; kgPanel(); }); };
  $("#kg-json").onclick = () => save("knowledge-graph-" + DATA.meta.ref_date + ".jsonld", JSON.stringify({"@context": {schema: "https://schema.org/", ghrac: DATA.url + "#"}, "@graph": [{"@id": "ghrac:" + KS.focus.join("/"), "schema:name": kgLabel(KS.focus), "ghrac:kind": KS.focus[0]}, ...nb.map(n => ({"@id": "ghrac:" + n.k + "/" + n.id, "schema:name": n.label, "ghrac:kind": n.k, "ghrac:relation": n.rel, "ghrac:of": {"@id": "ghrac:" + KS.focus.join("/")}}))]}, null, 1));
