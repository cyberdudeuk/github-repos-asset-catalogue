
/* ================= 7.2 Themes: guidance and policy, journeys, the UK's nations, international ================= */
Object.assign(ICONS, {
  th_guidance: '<path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H11v17H5.5A1.5 1.5 0 0 0 4 21.5zM20 4.5A1.5 1.5 0 0 0 18.5 3H13v17h5.5a1.5 1.5 0 0 1 1.5 1.5z"/><path d="M7 8h2M7 12h2M15 8h2"/>',
  th_journeys: '<circle cx="5" cy="18" r="2"/><circle cx="19" cy="6" r="2"/><path d="M7 18h6a3 3 0 0 0 0-6h-2a3 3 0 0 1 0-6h6"/>',
  th_nations: '<path d="M12 3l2.5 4 4.5 1-3 3.5.5 4.5-4.5-2-4.5 2 .5-4.5L5 8l4.5-1z"/><path d="M5 21h14"/>',
  th_international: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"/><path d="M16 17l3 3"/>',
  k_graph: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><circle cx="12" cy="11" r="1.5"/><path d="M8 7.5l3 2.5M16 7.5l-3 2.5M12 12.5v3"/>'});
const TH = DATA.themes, THC = TH.cats.map(([theme, id, label, desc], i) => ({i, theme, id, label, desc})), TH_ALLY = new Set(TH.allies);
const TH_META = {guidance: ["Guidance, policy and playbooks", "th_guidance", "blue", "Repositories that host, maintain or support guidance, policy, playbooks, manuals, standards and codes of practice."],
  journeys: ["Public service journeys", "th_journeys", "green", "Repositories about how people move through public services, life events that touch many parts of government, and work that runs across government."],
  nations: ["Devolution and the UK's nations", "th_nations", "magenta", "Repositories about or for England, Scotland, Wales and Northern Ireland, devolution, the crown dependencies and the overseas territories, and those published by devolved bodies."],
  international: ["International and partners", "th_international", "orange", "Repositories involving international and supranational bodies or partner countries, with those involving a UK alliance or partner flagged."]};
const TH_DEVOLVED_SLUGS = new Set(["the-scottish-government", "welsh-government", "northern-ireland-executive"]);
const thDevolvedPub = x => { const b = XO[x.oi]?.body; if (b !== undefined && b >= 0 && /Scottish|Welsh/.test(HR.body_grp[b] || "")) return true; if (/^(Scotland|Wales)$/.test(x.sector || "")) return true; const oi = rxOrgOf(x); return oi !== null && famPath("o" + oi).some(id => TH_DEVOLVED_SLUGS.has(famIndex().N[id]?.o?.slug)); };
function thSigs(x) { if (x._th) return x._th; const r = (TH.recs[x.key] || []).map(([i, ev]) => ({c: THC[i], ev}));
  if (thDevolvedPub(x)) r.push({c: {i: -1, theme: "nations", id: "devpub", label: "Published by a devolved body", desc: "Published by a Scottish, Welsh or Northern Ireland public body."}, ev: "publisher: " + orgName(x.org)});
  return (x._th = r); }
const THQ = {}; const thQ0 = () => ({sub: "", sector: "", live: false, ally: false, q: "", sort: "recent", n: 40});
function thFiltered(theme, S) { const q = S.q.toLowerCase().trim(); return ALL.filter(x => { const s = thSigs(x).filter(z => z.c.theme === theme); if (!s.length) return false; if (S.sub && !s.some(z => z.c.id === S.sub)) return false;
  return (!S.sector || x.sector === S.sector) && (!S.live || live(x)) && (!S.ally || TH_ALLY.has(x.key)) && (!q || x.q.includes(q)); }); }
function thRender(theme) {
  const [title, ic, c, lede] = TH_META[theme], S = THQ[theme] ||= thQ0(), subs = [...THC.filter(z => z.theme === theme), ...(theme === "nations" ? [{id: "devpub", label: "Published by a devolved body", desc: "Published by a Scottish, Welsh or Northern Ireland public body."}] : [])];
  const base = ALL.filter(x => thSigs(x).some(z => z.c.theme === theme)), cnt = {}, sec = {}; for (const x of base) for (const z of thSigs(x)) if (z.c.theme === theme) { cnt[z.c.id] = (cnt[z.c.id] || 0) + 1; (sec[x.sector || "Other"] ||= {})[z.c.id] = (sec[x.sector || "Other"]?.[z.c.id] || 0) + 1; }
  const prec = TH.prec.rounds.filter(r => subs.some(s => s.label === r[0]));
  vb(theme).innerHTML = `<section class="panel rxhero c-${c}" data-new="1"><div class="rxh-row"><span class="rxtile xl c-${c}" aria-hidden="true">${icon(ic, 40)}</span><div class="rxh-main"><div class="eyebrow">Topics and priorities · ${esc(title)}</div><h2>${esc(title)}</h2><p class="rx-lede">${esc(lede)}</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(base.length)}</b> repositories</span><span>${icon("s_active", 16)} <b>${nf(base.filter(live).length)}</b> being worked on or looked after</span>${theme === "international" ? `<span>${icon("i_link", 16)} <b>${nf(base.filter(x => TH_ALLY.has(x.key)).length)}</b> involve a UK alliance or partner</span>` : ""}</p></div></div></section>
    <div class="panel"><h2>What's here</h2><p class="muted small">Select a kind to list its repositories. Select it again to clear it.</p><div class="lgtiles">${subs.map(s => `<button type="button" class="lgtile c-${c}" data-thsub="${s.id}" aria-pressed="${S.sub === s.id}" data-tip="${esc(s.desc)}"><span class="rxtile c-${c}" aria-hidden="true">${icon(ic, 20)}</span><span class="lgt-l">${esc(s.label)}</span><span class="lgt-n">${nf(cnt[s.id] || 0)}</span><span class="lgt-s">${esc(s.desc)}</span></button>`).join("")}</div>
      ${subs.some(s => !cnt[s.id]) ? `<p class="small muted">${subs.filter(s => !cnt[s.id]).map(s => esc(s.label)).join(", ")}: none found in names, descriptions or README summaries. That is a finding about what's described in public code, not proof the work doesn't exist.</p>` : ""}</div>
    ${chartPanel("Where it is, by sector", heatmap({rows: subs.filter(s => cnt[s.id]).map(s => ({id: s.id, label: s.label})), cols: Object.keys(sec).sort().map(s => ({id: s, label: s})), val: (r, col) => sec[col.id]?.[r.id] || 0, label: title + " by sector", act: (r, col) => `data-thcell="${esc(r.id)}|${esc(col.id)}"`}), {wide: true, isNew: true, lede: "Select a number to list those repositories."})}
    <div class="panel"><div class="panel-head"><h2 id="th-${theme}-lh" tabindex="-1">Repositories</h2><div class="btnrow"><button class="btn" type="button" data-thcsv>Download CSV</button></div></div>
      <div class="filters"><label class="grow" for="th-${theme}-q">Search<input type="search" id="th-${theme}-q" value="${esc(S.q)}" placeholder="name or description"></label>
        <label for="th-${theme}-sector">Sector<select id="th-${theme}-sector"><option value="">All</option>${SECTORS.map(s => `<option${S.sector === s ? " selected" : ""}>${esc(s)}</option>`).join("")}</select></label>
        <label for="th-${theme}-sort">Sort by<select id="th-${theme}-sort"><option value="recent">Most recently changed</option><option value="name"${S.sort === "name" ? " selected" : ""}>Name, A to Z</option><option value="signals"${S.sort === "signals" ? " selected" : ""}>Most signals</option></select></label>
        <label class="rxcheck" for="th-${theme}-live"><input type="checkbox" id="th-${theme}-live"${S.live ? " checked" : ""}> Being worked on or looked after</label>
        ${theme === "international" ? `<label class="rxcheck" for="th-${theme}-ally"><input type="checkbox" id="th-${theme}-ally"${S.ally ? " checked" : ""}> UK alliance or partner only</label>` : ""}<button class="btn" type="button" data-threset>Clear</button></div>
      <p class="count" id="th-${theme}-count" aria-live="polite"></p><div id="th-${theme}-list"></div></div>
    <div class="panel"><h2>How these are found, and how accurate they are</h2><ul class="small"><li>${esc(TH.source)}</li><li>Words are matched whole; short ambiguous words (WHO, UN, EU, US) only count in safe forms, such as "World Health Organization" or "EU regulations".</li>${theme === "nations" ? "<li>'Published by a devolved body' comes from the publisher, not the text: a Scottish, Welsh or Northern Ireland public body, or the Scotland and Wales sectors.</li>" : ""}${theme === "international" ? "<li>'UK alliance or partner' flags work naming NATO, Five Eyes, AUKUS, the G7 or G20, the Commonwealth, the EU, the OECD, the UN, or a close partner country.</li>" : ""}</ul>
      ${prec.length ? `<div class="tbl-wrap"><table><caption>Accuracy of samples, judged by ${esc(TH.prec.judged_by)}</caption><thead><tr><th scope="col">Signal</th><th scope="col" class="n">Sample</th><th scope="col" class="n">Correct</th><th scope="col">What was wrong, and the fix</th></tr></thead><tbody>${prec.map(r => `<tr><td>${esc(r[0])}</td><td class="n">${r[1]}</td><td class="n">${r[2]}</td><td>${esc(r[3] || "—")}</td></tr>`).join("")}</tbody></table></div>` : ""}</div>`;
  const v = vb(theme), re = f => () => { f(); thList(theme); };
  $$("[data-thsub]", v).forEach(b => b.onclick = () => { S.sub = S.sub === b.dataset.thsub ? "" : b.dataset.thsub; S.n = 40; $$("[data-thsub]", v).forEach(x => x.setAttribute("aria-pressed", String(x.dataset.thsub === S.sub))); thList(theme, true); });
  $$("[data-thcell]", v).forEach(b => b.onclick = () => { const [s, col] = b.dataset.thcell.split("|"); Object.assign(S, {sub: s, sector: col, n: 40}); $(`#th-${theme}-sector`).value = col; $$("[data-thsub]", v).forEach(x => x.setAttribute("aria-pressed", String(x.dataset.thsub === S.sub))); thList(theme, true); });
  let tq; $(`#th-${theme}-q`).oninput = e => { clearTimeout(tq); tq = setTimeout(() => { S.q = e.target.value; S.n = 40; thList(theme); }, 160); };
  $(`#th-${theme}-sector`).onchange = e => { S.sector = e.target.value; thList(theme); }; $(`#th-${theme}-sort`).onchange = e => { S.sort = e.target.value; thList(theme); };
  $(`#th-${theme}-live`).onchange = e => { S.live = e.target.checked; thList(theme); }; const al = $(`#th-${theme}-ally`); if (al) al.onchange = e => { S.ally = e.target.checked; thList(theme); };
  $("[data-threset]", v).onclick = () => { THQ[theme] = thQ0(); thRender(theme); };
  $("[data-thcsv]", v).onclick = () => save(`${theme}-${DATA.meta.ref_date}.csv`, "﻿" + [["repository", "url", "organisation", "status", "signals", "evidence", "uk_alliance_or_partner"].map(csvCell).join(","), ...thFiltered(theme, S).map(x => { const z = thSigs(x).filter(s => s.c.theme === theme); return [x.key, ghUrl(x.key), orgName(x.org), x.st, z.map(s => s.c.label).join("; "), z.map(s => s.ev).join("; "), TH_ALLY.has(x.key) ? "yes" : ""].map(csvCell).join(","); })].join("\r\n"));
  thList(theme);
}
function thList(theme, focus) {
  const S = THQ[theme], L = thFiltered(theme, S), srt = [...L].sort(S.sort === "name" ? (a, b) => rxNm(a).localeCompare(rxNm(b)) : S.sort === "signals" ? (a, b) => thSigs(b).length - thSigs(a).length || lastAct(b) - lastAct(a) : (a, b) => lastAct(b) - lastAct(a));
  $(`#th-${theme}-count`).textContent = `${nf(L.length)} ${L.length === 1 ? "repository" : "repositories"}${S.sub ? " · " + ([...THC, {id: "devpub", label: "Published by a devolved body"}].find(z => z.id === S.sub)?.label || "") : ""}${S.sector ? " · " + S.sector : ""}`;
  $(`#th-${theme}-list`).innerHTML = L.length ? `<div class="tbl-wrap"><table><caption class="sr-only">${esc(TH_META[theme][0])}: repositories</caption><thead><tr><th scope="col">Project</th><th scope="col">Publisher</th><th scope="col">Status</th><th scope="col">Why it's here</th></tr></thead><tbody>${srt.slice(0, S.n).map(x => `<tr><td class="repo"><button type="button" class="linkbtn" data-rx="${esc(x.key)}">${esc(rxNm(x))}</button><br><small class="mono">${esc(x.key)}</small>${TH_ALLY.has(x.key) ? ` <span class="rxbadge c-orange">${icon("i_link", 13)}<span>UK alliance or partner</span></span>` : ""}</td><td>${esc(orgName(x.org))}</td><td>${rxBadge(rxStat(x))}</td><td><ul class="lgev">${thSigs(x).filter(z => z.c.theme === theme).map(z => `<li><span><b>${esc(z.c.label)}</b> <span class="muted small">${esc(z.ev)}</span></span></li>`).join("")}</ul></td></tr>`).join("")}</tbody></table></div>${L.length > S.n ? `<p><button class="btn" type="button" data-thmore>Show ${nf(Math.min(40, L.length - S.n))} more</button></p>` : ""}` : `<p class="muted">No repositories match.</p>`;
  const m = $("[data-thmore]", vb(theme)); if (m) m.onclick = () => { S.n += 40; thList(theme); };
  if (focus) $(`#th-${theme}-lh`)?.focus();
}
for (const t of Object.keys(TH_META)) RENDER[t] = () => thRender(t);

/* ================= 7.2 Knowledge layer: vocabularies, taxonomies, ontology, dictionary, thesaurus, knowledge graph, lineage ================= */
/* controlled vocabularies, generated from the data the page actually uses, so they can't drift from it */
function kvVocabs() {
  const V = [];
  const add = (id, label, desc, concepts, broaderOf) => V.push({id, label, desc, concepts, broaderOf});
  add("status", "Activity status", "How recently people changed a repository.", CSTAT.map(s => ({id: s, label: RXS[s]?.w ? `${s} (${RXS[s].w})` : s, def: RXS[s]?.d || ""})));
  add("kind", "Kind of repository", "What a repository is, worked out from its files.", Object.entries(RXK).map(([k, v]) => ({id: v.id, label: `${k} (${v.w})`, def: v.d})));
  add("topic", "Topics", "Policy areas a repository is about.", TOPICS.map(t => ({id: t.id, label: t.label, def: t.desc})));
  add("dama", "Data management (DAMA-DMBOK2)", "Knowledge areas and capabilities of data management.", DM.areas.flatMap(a => [{id: a.id, label: a.label, def: a.desc || ""}, ...a.caps.map(c => ({id: c.id, label: c.label, def: "", broader: a.id}))]));
  add("supplier", "Supplier types", "How a tool is supplied.", [...new Set(DV.map(v => v.type))].map(t => ({id: t, label: t, def: ""})));
  add("legacy", "Legacy and debt signals", "Signals of legacy data, legacy technology and technical debt.", [...Object.entries(LG_GRP).map(([g, v]) => ({id: g, label: v[0], def: ""})), ...LGS.map(s => ({id: s.id, label: s.label, def: s.desc, broader: s.group}))]);
  add("theme", "Themes", "Guidance and policy, journeys, the UK's nations and international work.", [...Object.entries(TH_META).map(([k, v]) => ({id: k, label: v[0], def: v[3]})), ...THC.map(c => ({id: c.id, label: c.label, def: c.desc, broader: c.theme}))]);
  add("practice", "Good practices", "Practices found from files, by discipline.", [...PDISC.map(d => ({id: d.id, label: d.label, def: ""})), ...PORDER.map(p => ({id: p, label: PLABEL[p], def: "", broader: PDISC_OF[p]}))]);
  add("gds", "GDS areas", "GDS's published responsibilities.", Object.values(GA).map(a => ({id: a.id, label: a.label, def: a.desc || ""})));
  add("sector", "Sectors", "Groupings of publishers.", SECTORS.map(s => ({id: s, label: s, def: ""})));
  add("licence", "Licences", "Licence families GitHub detects, in plain words.", Object.entries(LICS).map(([k, v]) => ({id: k || "unknown", label: v, def: RX_LIC[k] || ""})));
  add("orgformat", "Organisation types (GOV.UK)", "GOV.UK's formats for organisations in the family tree.", [...new Set(HO.map(o => o.f).filter(Boolean))].sort().map(f => ({id: f, label: f, def: ""})));
  return V;
}
const kvSkos = () => { const base = DATA.url + "#vocab/"; const g = [];
  for (const v of kvVocabs()) { g.push({"@id": base + v.id, "@type": "skos:ConceptScheme", "skos:prefLabel": v.label, "skos:definition": v.desc});
    for (const c of v.concepts) g.push({"@id": base + v.id + "/" + encodeURIComponent(c.id), "@type": "skos:Concept", "skos:inScheme": {"@id": base + v.id}, "skos:prefLabel": c.label, ...(c.def ? {"skos:definition": c.def} : {}), ...(c.broader ? {"skos:broader": {"@id": base + v.id + "/" + encodeURIComponent(c.broader)}} : {})}); }
  return {"@context": {skos: "http://www.w3.org/2004/02/skos/core#"}, "@graph": g}; };
/* the ontology: classes and the relations the page's data actually holds */
const KO_CLASSES = [["Repository", "A public code project on GitHub", "k_app", "blue"], ["GitHubAccount", "A GitHub organisation account that publishes repositories", "i_account", "aqua"], ["Organisation", "A public body (GOV.UK organisation or other public body)", "i_building", "orange"],
  ["GDSUnit", "An area of GDS's published responsibilities", "i_users", "violet"], ["Topic", "A policy area", "topics", "violet"], ["Capability", "A data management capability (DAMA)", "wheel", "green"], ["Tool", "A data tool, with its supplier", "k_tool", "orange"],
  ["Signal", "A legacy or technical debt signal", "legacy", "red"], ["Theme", "Guidance, journeys, nations or international", "th_guidance", "magenta"], ["Practice", "A good practice found from files", "practice", "green"], ["APIEntry", "An entry in the government API catalogue", "s_api", "violet"],
  ["View", "A page of this catalogue", "s_view", "slate"], ["Requirement", "Something the catalogue was asked to do", "about", "slate"], ["Check", "A test or self-check", "s_kept", "green"], ["Defect", "A fault found and fixed", "i_bug", "red"], ["Source", "Where the data came from", "c_readme", "slate"]];
const KO_REL = [["Repository", "publishedBy", "GitHubAccount"], ["GitHubAccount", "belongsTo", "Organisation"], ["Repository", "inUnit", "GDSUnit"], ["GDSUnit", "partOf", "Organisation"], ["Organisation", "parentOrganisation", "Organisation"], ["Organisation", "succeeded", "Organisation"],
  ["Repository", "about", "Topic"], ["Repository", "hasCapability", "Capability"], ["Repository", "uses", "Tool"], ["Repository", "hasSignal", "Signal"], ["Repository", "inTheme", "Theme"], ["Repository", "hasPractice", "Practice"], ["APIEntry", "implementedBy", "Repository"],
  ["View", "shows", "Repository"], ["Requirement", "realisedIn", "View"], ["Requirement", "verifiedBy", "Check"], ["Defect", "guardedBy", "Check"], ["Repository", "derivedFrom", "Source"]];
/* lineage: sources -> datasets -> views -> requirements -> checks -> defects */
const KL_SOURCES = [["src-listing", "GitHub listing (X-Gov repo scraper)", ["ds-catalogue"]], ["src-git", "git history (clones)", ["ds-catalogue", "ds-practices"]], ["src-readme", "READMEs", ["ds-catalogue", "ds-dama", "ds-apis", "ds-opendata", "ds-legacy", "ds-themes"]],
  ["src-deps", "Dependency and Terraform files", ["ds-dama", "ds-legacy", "ds-gds"]], ["src-tree", "File trees", ["ds-practices", "ds-apis"]], ["src-govuk", "GOV.UK organisations API", ["ds-hier", "ds-crosswalk"]], ["src-apicat", "Government API catalogue", ["ds-apis"]],
  ["src-gdsabout", "GDS's about page on GOV.UK", ["ds-gds"]], ["src-bodies", "publicsectorcodebyorg mapping", ["ds-catalogue", "ds-hier"]], ["src-apps", "GTI and ANA tables", ["ds-crosswalk"]]];
const KL_DATASETS = [["ds-catalogue", "Catalogue records", ["catalogue", "discover", "profile", "search", "insights", "orgs", "publishers", "landscape"]], ["ds-dama", "Data management wheel", ["dama", "suppliers", "dam", "profile"]], ["ds-apis", "APIs and reconciliation", ["apis", "profile"]],
  ["ds-opendata", "Open data pipelines", ["opendata", "profile"]], ["ds-gds", "GDS responsibilities", ["gds", "gdsx", "profile"]], ["ds-practices", "Good practice and types", ["practice", "practice2", "profile", "discover"]], ["ds-legacy", "Legacy and debt signals", ["legacy", "insights", "profile", "discover", "family"]],
  ["ds-themes", "Themes", ["guidance", "journeys", "nations", "international", "profile"]], ["ds-hier", "Organisation hierarchy", ["family", "profile", "govukos"]], ["ds-crosswalk", "Organisation crosswalk", ["govukos", "family"]]];
function klGraph() {
  const N = [], E = [], add = (id, label, col, extra = {}) => N.push({id, label, col, ...extra});
  KL_SOURCES.forEach(([id, l, ds]) => { add(id, l, 0); ds.forEach(d => E.push([id, d])); });
  KL_DATASETS.forEach(([id, l, vs]) => { add(id, l, 1); vs.filter(v => TABS.includes(v)).forEach(v => E.push([id, "v-" + v])); });
  const views = new Set(E.filter(e => e[1].startsWith("v-")).map(e => e[1].slice(2)));
  for (const q of DATA.requirements) for (const v of q[3]) if (TABS.includes(v)) views.add(v);
  [...views].forEach(v => add("v-" + v, TITLE[v], 2, {tab: v}));
  for (const q of DATA.requirements) { add("r-" + q[0], q[0] + " " + q[1], 3, {short: q[0]}); q[3].filter(v => TABS.includes(v)).forEach(v => E.push(["v-" + v, "r-" + q[0]])); q[4].forEach(c => { if (!N.some(n => n.id === "c-" + c)) add("c-" + c, c + " " + (REG[c]?.text || ""), 4, {short: c, status: REG[c]?.status || "missing"}); E.push(["r-" + q[0], "c-" + c]); }); }
  for (const d of DATA.defects) { add("d-" + d[0], d[0] + " " + d[3], 5, {short: d[0]}); d[6].forEach(c => { if (!N.some(n => n.id === "c-" + c)) add("c-" + c, c + " " + (REG[c]?.text || ""), 4, {short: c, status: REG[c]?.status || "missing"}); E.push(["c-" + c, "d-" + d[0]]); }); }
  return {N, E};
}
const KL_COLS = ["Sources", "Datasets", "Pages", "Requirements", "Checks", "Defects"];
const KS = {tab: "graph", focus: null, sel: null, vocab: "dama"};
RENDER.knowledge = () => {
  const V = kvVocabs(), nC = V.reduce((a, v) => a + v.concepts.length, 0), syn = Object.entries(RX_SYN).length;
  vb("knowledge").innerHTML = `<section class="panel rxhero c-violet" data-new="1"><div class="rxh-row"><span class="rxtile xl c-violet" aria-hidden="true">${icon("k_graph", 40)}</span><div class="rxh-main"><div class="eyebrow">About · knowledge layer</div><h2>Knowledge layer</h2>
      <p class="rx-lede">The catalogue's shared language and how everything in it connects: a knowledge graph you can walk, lineage and traceability from source data to every check, ${nf(V.length)} controlled vocabularies with ${nf(nC)} terms, the taxonomies, the ontology, a data dictionary, a thesaurus and the glossary. Each is generated from the data this page uses, so it can't drift from it, and each can be downloaded in an open format.</p></div></div>
      <div class="kl-tabs" role="tablist" aria-label="Parts of the knowledge layer">${[["graph", "Knowledge graph", "k_graph"], ["lineage", "Lineage and traceability", "i_trace"], ["vocab", "Vocabularies and taxonomies", "topics"], ["ontology", "Ontology", "wheel"], ["dict", "Data dictionary", "s_word"], ["thes", "Thesaurus and glossary", "c_readme"]].map(([id, l, ic]) => `<button type="button" role="tab" id="kt-${id}" aria-controls="kp" aria-selected="${KS.tab === id}" tabindex="${KS.tab === id ? 0 : -1}" data-kt="${id}">${icon(ic, 16)} ${esc(l)}</button>`).join("")}</div></section>
    <div class="panel" id="kp" role="tabpanel" aria-labelledby="kt-${KS.tab}"></div>`;
  const v = vb("knowledge"), tabs = $$("[data-kt]", v);
  tabs.forEach((b, i) => { b.onclick = () => { KS.tab = b.dataset.kt; RENDER.knowledge(); $("#kt-" + KS.tab)?.focus(); };
    b.onkeydown = e => { const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (!d) return; e.preventDefault(); const n = tabs[(i + d + tabs.length) % tabs.length]; n.click(); }; });
