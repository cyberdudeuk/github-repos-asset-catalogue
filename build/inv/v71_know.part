/* lineage and traceability: six columns; select any node to light its whole upstream and downstream path */
function klPanel() {
  const {N, E} = klGraph(), by = Object.fromEntries(N.map(n => [n.id, n])), up = {}, dn = {}; E.forEach(([a, b]) => { (dn[a] ||= []).push(b); (up[b] ||= []).push(a); });
  const lit = new Set(); if (KS.sel && by[KS.sel]) { const walk = (id, m, seen = new Set()) => { if (seen.has(id)) return; seen.add(id); lit.add(id); (m[id] || []).forEach(n => walk(n, m, seen)); }; walk(KS.sel, up); walk(KS.sel, dn); }
  const cols = KL_COLS.map((_, c) => N.filter(n => n.col === c));
  $("#kp").innerHTML = `<h2>Lineage and traceability</h2><p class="muted small">From the data sources, through the datasets built from them and the pages that show them, to the requirements those pages meet, the checks that prove them and the defects those checks guard against. Select anything to light up everything it comes from and everything that depends on it. ${nf(N.length)} items, ${nf(E.length)} links.</p>
    <div class="filters"><label class="grow" for="kl-q">Find<input type="search" id="kl-q" placeholder="for example: R33, GOV.UK organisations, T-LEG-01, V7-15"></label>${KS.sel ? `<button class="btn" type="button" id="kl-clear">Clear the selection</button>` : ""}</div>
    ${KS.sel && by[KS.sel] ? `<p class="kl-sel"><b>${esc(by[KS.sel].label.slice(0, 140))}</b>: ${nf(lit.size - 1)} connected items. ${by[KS.sel].tab ? `<button class="btn sm" type="button" data-klopen="${esc(by[KS.sel].tab)}">Open this page</button>` : ""}</p>` : ""}
    <div class="kl-cols">${cols.map((col, c) => `<section class="kl-col"><h3 class="drawer-h">${esc(KL_COLS[c])} <span class="muted">(${nf(col.filter(n => !KS.sel || lit.has(n.id)).length)}${KS.sel ? " of " + nf(col.length) : ""})</span></h3><ul>${col.filter(n => !KS.sel || lit.has(n.id) || col.length < 14).map(n => `<li><button type="button" class="kl-n${lit.has(n.id) ? " lit" : ""}${n.id === KS.sel ? " sel" : ""}${n.status && n.status !== "pass" && n.status !== "live" ? " bad" : ""}" data-kl="${esc(n.id)}" aria-pressed="${n.id === KS.sel}" title="${esc(n.label)}">${esc((n.short ? n.short + " · " : "") + (n.short ? n.label.slice(n.short.length + 1) : n.label).slice(0, 64))}${n.status ? ` <span class="kl-st">${esc(n.status)}</span>` : ""}</button></li>`).join("")}</ul></section>`).join("")}</div>
    <p class="small muted">With nothing selected, long columns (requirements, checks, defects) are shortened: select an item or search to see its full chain. Every requirement and defect must trace to at least one check; the build refuses to publish otherwise (check C-DOC-01).</p>
    <p><button class="btn" type="button" id="kl-json">Download the lineage graph, JSON-LD (PROV)</button></p>`;
  const p = $("#kp");
  $$("[data-kl]", p).forEach(b => b.onclick = () => { KS.sel = KS.sel === b.dataset.kl ? null : b.dataset.kl; klPanel(); $$("[data-kl]", $("#kp")).find(n => n.dataset.kl === b.dataset.kl)?.focus(); });
  $("#kl-clear") && ($("#kl-clear").onclick = () => { KS.sel = null; klPanel(); });
  $$("[data-klopen]", p).forEach(b => b.onclick = () => go(b.dataset.klopen));
  $("#kl-q").onkeydown = e => { if (e.key !== "Enter") return; e.preventDefault(); const q = e.target.value.toLowerCase().trim(); const hit = N.find(n => (n.short || "").toLowerCase() === q) || N.find(n => n.label.toLowerCase().includes(q)); if (hit) { KS.sel = hit.id; klPanel(); } else toast("Nothing in the lineage matches " + e.target.value); };
  $("#kl-json").onclick = () => save("lineage-" + DATA.meta.ref_date + ".jsonld", JSON.stringify({"@context": {prov: "http://www.w3.org/ns/prov#", schema: "https://schema.org/", ghrac: DATA.url + "#"}, "@graph": N.map(n => ({"@id": "ghrac:" + n.id, "@type": ["prov:Entity", "prov:Entity", "schema:WebPage", "ghrac:Requirement", "ghrac:Check", "ghrac:Defect"][n.col], "schema:name": n.label, "prov:wasDerivedFrom": (up[n.id] || []).map(u => ({"@id": "ghrac:" + u}))}))}, null, 1));
}
function kvPanel() {
  const V = kvVocabs(), cur = V.find(v => v.id === KS.vocab) || V[0];
  const kids = c => cur.concepts.filter(k => k.broader === c.id), tops = cur.concepts.filter(c => !c.broader);
  $("#kp").innerHTML = `<h2>Controlled vocabularies and taxonomies</h2><p class="muted small">Every list of values the catalogue uses, as a controlled vocabulary with definitions. Where terms nest (knowledge area and capability, discipline and practice, kind of signal and signal, theme and kind), the vocabulary is also a taxonomy, shown as a tree. Download all of them as SKOS.</p>
    <div class="filters"><label for="kv-sel">Vocabulary<select id="kv-sel">${V.map(v => `<option value="${v.id}"${v.id === cur.id ? " selected" : ""}>${esc(v.label)} (${nf(v.concepts.length)})</option>`).join("")}</select></label><label class="grow" for="kv-q">Search terms<input type="search" id="kv-q" placeholder="term or definition"></label><button class="btn" type="button" id="kv-skos">Download all, SKOS JSON-LD</button><button class="btn" type="button" id="kv-csv">This vocabulary, CSV</button></div>
    <p>${esc(cur.desc)}</p><ul class="kv-tree" id="kv-tree">${tops.map(c => `<li data-kvt="${esc((c.label + " " + c.def + " " + kids(c).map(k => k.label + " " + k.def).join(" ")).toLowerCase())}"><b>${esc(c.label)}</b> <span class="mono small muted">${esc(c.id)}</span>${c.def ? `<br><span class="small">${esc(c.def)}</span>` : ""}${kids(c).length ? `<ul>${kids(c).map(k => `<li data-kvt="${esc((k.label + " " + k.def).toLowerCase())}">${esc(k.label)} <span class="mono small muted">${esc(k.id)}</span>${k.def ? `<br><span class="small">${esc(k.def)}</span>` : ""}</li>`).join("")}</ul>` : ""}</li>`).join("")}</ul>`;
  $("#kv-sel").onchange = e => { KS.vocab = e.target.value; kvPanel(); };
  $("#kv-q").oninput = e => { const q = e.target.value.toLowerCase().trim(); $$("#kv-tree li").forEach(li => li.hidden = q && !li.dataset.kvt.includes(q) && !$$("li", li).some(k => k.dataset.kvt.includes(q))); };
  $("#kv-skos").onclick = () => save("vocabularies-skos-" + DATA.meta.ref_date + ".jsonld", JSON.stringify(kvSkos(), null, 1));
  $("#kv-csv").onclick = () => save(`vocabulary-${cur.id}.csv`, "﻿" + [["id", "label", "definition", "broader"].map(csvCell).join(","), ...cur.concepts.map(c => [c.id, c.label, c.def, c.broader || ""].map(csvCell).join(","))].join("\r\n"));
}
function koPanel() {
  const W = 860, H = 560, cx = W / 2, cy = H / 2, R = 220, pos = Object.fromEntries(KO_CLASSES.map((c, i) => { const a = -Math.PI / 2 + i * 2 * Math.PI / KO_CLASSES.length; return [c[0], [cx + Math.cos(a) * R * 1.65, cy + Math.sin(a) * R]]; }));
  $("#kp").innerHTML = `<h2>Ontology</h2><p class="muted small">The kinds of thing in the catalogue and how they relate. Each relation is held in the page's data and drives a feature; the table below says which.</p>
    <div class="chartbox"><svg viewBox="0 0 ${W} ${H}" class="chart ko" role="img" aria-label="Ontology: ${KO_CLASSES.length} classes and ${KO_REL.length} relations, listed in the table below">${KO_REL.map(([a, r, b]) => { const [x1, y1] = pos[a], [x2, y2] = pos[b]; return a === b ? `<path d="M${x1 + 60},${y1 - 10} q40,-40 0,-60" class="ko-l"/>` : `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" class="ko-l"/>`; }).join("")}
      ${KO_CLASSES.map(([c, d, ic, col]) => { const [x, y] = pos[c]; return `<g class="rxweb-n c-${col}"><rect x="${x - 70}" y="${y - 16}" width="140" height="32" rx="16"/><text x="${x}" y="${y + 4}" text-anchor="middle">${esc(c)}</text></g>`; }).join("")}</svg></div>
    <div class="tbl-wrap"><table><caption>Relations</caption><thead><tr><th scope="col">Subject</th><th scope="col">Relation</th><th scope="col">Object</th></tr></thead><tbody>${KO_REL.map(([a, r, b]) => `<tr><td>${esc(a)}</td><td class="mono small">${esc(r)}</td><td>${esc(b)}</td></tr>`).join("")}</tbody></table></div>
    <div class="tbl-wrap"><table><caption>Classes</caption><thead><tr><th scope="col">Class</th><th scope="col">Meaning</th></tr></thead><tbody>${KO_CLASSES.map(([c, d]) => `<tr><th scope="row">${esc(c)}</th><td>${esc(d)}</td></tr>`).join("")}</tbody></table></div>
    <p><button class="btn" type="button" id="ko-json">Download the ontology, OWL in JSON-LD</button></p>`;
  $("#ko-json").onclick = () => save("ontology-" + DATA.meta.ref_date + ".jsonld", JSON.stringify({"@context": {owl: "http://www.w3.org/2002/07/owl#", rdfs: "http://www.w3.org/2000/01/rdf-schema#", ghrac: DATA.url + "#ontology/"}, "@graph": [...KO_CLASSES.map(([c, d]) => ({"@id": "ghrac:" + c, "@type": "owl:Class", "rdfs:comment": d})), ...KO_REL.map(([a, r, b]) => ({"@id": "ghrac:" + r, "@type": "owl:ObjectProperty", "rdfs:domain": {"@id": "ghrac:" + a}, "rdfs:range": {"@id": "ghrac:" + b}}))]}, null, 1));
}
/* data dictionary: each dataset the page carries, its fields, their meaning and where they come from */
const KD = [["Catalogue records", "One record per repository (government layer and catalogue layer)", [["key", "text", "GitHub account and repository name", "GitHub listing"], ["org", "text", "GitHub account", "GitHub listing"], ["sector", "text", "Publisher sector", "Catalogue mapping"], ["d", "text", "Description on GitHub", "GitHub listing"], ["ld", "text", "README summary (government layer)", "README"], ["l", "text", "Main language", "GitHub listing"], ["li", "code", "Licence code (see the licence vocabulary)", "GitHub listing"], ["st", "code", "Activity status (see the status vocabulary)", "git or listing"], ["basis", "text", "How the status was worked out", "This catalogue"], ["cr", "date", "Created", "GitHub listing"], ["pd", "date", "Last push", "GitHub listing"], ["lh", "date", "Last change by a person", "git"], ["c90, c12", "number", "Changes by people in 90 days and 12 months", "git"], ["sg, fk", "number", "Stars and forks", "GitHub listing"], ["ar", "flag", "Archived", "GitHub listing"], ["pg", "flag", "Publishes a GitHub Pages site", "GitHub listing"], ["tags", "list", "Government priority tags", "This catalogue (rules)"]]],
  ["Data management wheel", "Capabilities, tools and lifecycle stages found per repository", [["caps", "list", "Capability id, how found (n, r, f, i, d) and evidence", "Names, README, files, dependencies, Terraform"], ["vend", "list", "Tool id, how found and evidence", "Dependencies, Terraform, text"], ["mask", "bits", "Lifecycle stages", "This catalogue (rules)"]]],
  ["Legacy and debt signals", "Signals per repository", [["signal", "code", "See the legacy vocabulary", "Dependencies, language, text, status"], ["evidence", "text", "What shows it", "As above"]]],
  ["Themes", "Guidance, journeys, nations and international signals", [["theme, kind", "code", "See the themes vocabulary", "Names, descriptions, README summaries"], ["evidence", "text", "The words matched", "As above"], ["ally", "flag", "Involves a UK alliance or partner", "Text"]]],
  ["Organisation hierarchy", "GOV.UK organisations and their links", [["slug", "text", "GOV.UK organisation slug, the shared key", "GOV.UK organisations API"], ["title, abbreviation, format, status", "text", "As GOV.UK gives them", "GOV.UK organisations API"], ["parents, superseded, superseding", "list", "Links to other organisations", "GOV.UK organisations API"], ["body_org", "map", "Public body to GOV.UK organisation, by exact slug", "This catalogue"]]],
  ["Organisation crosswalk", "GTI and ANA ids to GOV.UK slugs", XW.cols.map(c => [c, "text", {app: "GTI or ANA", table: "The app's table", id: "The app's id", name: "The app's name", govuk_slug: "Matched GOV.UK slug", method: "How it was matched", reason: "Why, or why not"}[c] || c, "GTI, ANA, GOV.UK"])],
  ["Requirements, checks and defects", "The catalogue's own traceability", [["requirement", "text", "What was asked, by whom and when, the pages and the checks", "Requests in this chat"], ["check", "text", "Id, status, what it proves, the defect it guards", "Build, page and test results"], ["defect", "text", "What went wrong, the cause, the fix and the check added", "This catalogue's testing"]]]];
function kdPanel() {
  $("#kp").innerHTML = `<h2>Data dictionary</h2><p class="muted small">Every dataset the page carries, its fields, what each means and where it comes from. The co-cddo migration fields have their own dictionary in the documents.</p>
    ${KD.map(([ds, d, f]) => `<h3 class="drawer-h">${esc(ds)}</h3><p class="small">${esc(d)}</p><div class="tbl-wrap"><table><caption class="sr-only">${esc(ds)}: fields</caption><thead><tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Meaning</th><th scope="col">Source</th></tr></thead><tbody>${f.map(r => `<tr><td class="mono small">${esc(r[0])}</td><td>${esc(r[1])}</td><td>${esc(r[2])}</td><td class="small">${esc(r[3])}</td></tr>`).join("")}</tbody></table></div>`).join("")}
    <p><button class="btn" type="button" id="kd-csv">Download the data dictionary, CSV</button></p>`;
  $("#kd-csv").onclick = () => save("data-dictionary-" + DATA.meta.ref_date + ".csv", "﻿" + [["dataset", "field", "type", "meaning", "source"].map(csvCell).join(","), ...KD.flatMap(([ds, , f]) => f.map(r => [ds, ...r].map(csvCell).join(",")))].join("\r\n"));
}
function ktPanel() {
  const syn = Object.entries(RX_SYN), alsoCalled = (DATA.glossary || []).filter(g => g[2] && g[2] !== "—"), jar = RX_JARGON;
  $("#kp").innerHTML = `<h2>Thesaurus and glossary</h2><p class="muted small">The everyday words the search understands, the other names catalogue terms go by, and technical words explained. The full plain-English glossary has its own page.</p>
    <div class="filters"><label class="grow" for="kt-q">Search<input type="search" id="kt-q" placeholder="word"></label><button class="btn" type="button" data-go-gl>Open the plain-English guide</button><button class="btn" type="button" id="kt-skos">Download the thesaurus, SKOS JSON-LD</button></div>
    <h3 class="drawer-h">Everyday words the search widens</h3><dl class="rxwords kt">${syn.map(([w, alts]) => `<div data-ktt="${esc((w + " " + alts.join(" ")).toLowerCase())}"><dt>${esc(w)}</dt><dd>also finds: ${esc(alts.join(", "))}</dd></div>`).join("")}</dl>
    <h3 class="drawer-h">Other names for catalogue terms</h3><dl class="rxwords kt">${alsoCalled.map(([t, , a]) => `<div data-ktt="${esc((t + " " + a).toLowerCase())}"><dt>${esc(t)}</dt><dd>also called: ${esc(a)}</dd></div>`).join("")}</dl>
    <h3 class="drawer-h">Technical words explained on repo profiles</h3><dl class="rxwords kt">${jar.map(([t, , d]) => `<div data-ktt="${esc((t + " " + d).toLowerCase())}"><dt>${esc(t)}</dt><dd>${esc(d)}</dd></div>`).join("")}</dl>`;
  $("#kt-q").oninput = e => { const q = e.target.value.toLowerCase().trim(); $$("[data-ktt]", $("#kp")).forEach(d => d.hidden = q && !d.dataset.ktt.includes(q)); };
  $("[data-go-gl]", $("#kp")).onclick = () => go("glossary");
  $("#kt-skos").onclick = () => save("thesaurus-skos-" + DATA.meta.ref_date + ".jsonld", JSON.stringify({"@context": {skos: "http://www.w3.org/2004/02/skos/core#"}, "@graph": [...syn.map(([w, a]) => ({"@id": "#thesaurus/" + encodeURIComponent(w), "@type": "skos:Concept", "skos:prefLabel": w, "skos:altLabel": a})), ...alsoCalled.map(([t, m, a]) => ({"@id": "#glossary/" + encodeURIComponent(t), "@type": "skos:Concept", "skos:prefLabel": t, "skos:definition": m, "skos:altLabel": String(a).split(/,\s*/)})), ...jar.map(([t, , d]) => ({"@id": "#jargon/" + encodeURIComponent(t), "@type": "skos:Concept", "skos:prefLabel": t, "skos:definition": d}))]}, null, 1));
}
