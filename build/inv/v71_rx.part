    <g><circle cx="${cx}" cy="${cy}" r="38" class="rxweb-c"/><text x="${cx}" y="${cy + 4}" text-anchor="middle" class="rxweb-ct">This project</text></g>
    ${nodes.map((n, i) => { const [px, py] = pos[i]; const lab = n.lab.length > 22 ? n.lab.slice(0, 21) + "…" : n.lab; return `<g class="rxweb-n c-${n.k.c}" role="button" tabindex="0" ${act(n)} aria-label="${esc(n.lab)}, ${esc(n.sub)}" data-tip="${esc(n.lab)} · ${esc(n.sub)}"><rect x="${px - 82}" y="${py - 17}" width="164" height="34" rx="17"/><text x="${px}" y="${py - 1}" text-anchor="middle">${esc(lab)}</text><text x="${px}" y="${py + 11}" text-anchor="middle" class="sub">${esc(n.sub.slice(0, 26))}</text></g>`; }).join("")}</svg></div>`;
}
