      <div class="rxh-badges">${rxBadge(s, true)}<span class="rxbadge c-${k.c} big">${icon(k.ic, 18)}<span>${esc(k.w)}</span></span><span class="rxbadge c-orange big">${icon("i_building", 18)}<span>${esc(orgName(x.org))}</span></span>${lgCore(x).length ? `<a class="rxbadge c-red big" href="#rx-lg-h">${icon("legacy", 18)}<span>${nf(lgCore(x).length)} legacy ${lgCore(x).length === 1 ? "signal" : "signals"}</span></a>` : ""}</div></div></div>
    <div class="rxh-tools"><fieldset class="rxlevel"><legend>${icon("i_text", 16)} How much detail?</legend>${[["simple", "Simple"], ["standard", "Standard"], ["technical", "Technical"]].map(([v, l]) => `<label><input type="radio" name="rx-level" value="${v}"${RXP.level === v ? " checked" : ""}> ${l}</label>`).join("")}</fieldset>
      <div class="rxh-acts">${hasSpeech ? `<button class="btn" type="button" id="rx-say" aria-pressed="false">${icon("i_speak", 16)} <span>Listen</span></button>` : ""}${gh ? `<a class="btn" href="${esc(gh)}" target="_blank" rel="noopener">${icon("i_ext", 16)} See it on GitHub<span class="sr-only"> (opens in a new tab)</span></a>` : ""}
      <button class="btn lv-std" type="button" data-x="${esc(x.key)}">${icon("i_open", 16)} Full technical record</button><button class="btn" type="button" id="rx-back">${icon("i_back", 16)} Explore repos</button></div></div></section>
  <section class="panel"><h2>At a glance</h2><div class="rxglance">${glance.map(([q, ic, c, w, d]) => `<div class="rxg c-${c}"><span class="rxtile c-${c}" aria-hidden="true">${icon(ic, 24)}</span><div><p class="rxg-q">${esc(q)}</p><p class="rxg-a">${esc(w)}</p><p class="rxg-d">${esc(d)}</p></div></div>`).join("")}</div>
    <p class="faint small">Reuse in plain words is a summary, not legal advice. Check the licence file before reusing.</p></section>
  <section class="panel"><h2>What it's about</h2>${about.length ? `<div class="rxchips">${about.join("")}</div>` : `<p class="muted">We didn't find a topic for this project. Its name and description don't use the words our topics look for.</p>`}</section>
  <section class="panel"><h2>Who it belongs to</h2><p class="muted small">From this project up to the organisation at the top. Select any step to see that part of the family tree.</p>
    <ol class="rxladder">${lad.map((r, i) => `<li class="c-${r.c}${i === 0 ? " me" : ""}"><span class="rxtile c-${r.c}" aria-hidden="true">${icon(r.ic, 20)}</span><div>${r.id.startsWith("o") || r.id.startsWith("a") && r.n || r.id.startsWith("u") ? `<button type="button" class="linkbtn rxl-b" data-fam="${esc(r.id)}">${esc(r.label)}</button>` : `<b>${esc(r.label)}</b>`}<span class="rxl-s">${esc(r.sub)}</span>${r.n && r.n.kind === "org" ? rxOrgNotes(r.n.o) : ""}</div></li>`).join("")}</ol>
    ${osChips(rxOrgOf(x))}${famIndex().recs[x.key] ? `<p><button class="btn" type="button" data-fam="${esc(famPath(famIndex().recs[x.key])[0])}">${icon("family", 16)} Open the whole family tree</button></p>` : ""}</section>
  <section class="panel lv-std"><h2>Lineage and traceability</h2><p class="muted small">Every fact on this page, where it came from and how sure we are. Lines run from the sources on the left, through this project, to what we worked out.</p>${rxFlowSvg(x, tr)}
