  <section class="panel"><h2>How well it's looked after</h2>${care ? `<p class="rxcare-n"><b>${care.filter(c => c.ok).length} of ${care.length}</b> good habits found in its files</p><ul class="rxcare">${care.map(c => `<li class="${c.ok ? "ok" : "no"}"><span class="rxtile sm c-${c.ok ? "green" : "slate"}" aria-hidden="true">${icon(c.ic, 16)}</span><span>${esc(c.w)}</span><span class="rxcare-v">${c.ok ? icon("s_kept", 16) + " Found" : "Not found"}</span></li>`).join("")}</ul><p class="faint small">Found from files in the project. A file shows a habit is set up, not how well it's followed.</p>` : `<p class="muted">Not checked: we haven't read this project's files.</p>`}</section>
  <section class="panel"><h2 id="rx-lg-h" tabindex="-1">Legacy and technical debt</h2>${lgSigs(x).length ? `<ul class="rxcare">${lgSigs(x).map(s => `<li class="no"><span class="rxtile sm c-${LG_GRP[s.s.group][2]}" aria-hidden="true">${icon(LG_GRP[s.s.group][1], 16)}</span><span><b>${esc(s.s.label)}</b><br><span class="small">${esc(s.s.desc)}</span><br><span class="small muted">Evidence: ${esc(s.ev)} · ${esc(LG_HOW[s.s.how] || s.s.how)}</span></span><span></span></li>`).join("")}</ul><p><button class="btn" type="button" data-go-lg="${esc(lgSigs(x)[0].s.id)}">${icon("legacy", 16)} See every project with this signal</button></p>` : `<p class="muted">No legacy or debt signals found. ${PRC.masks[x.key] === undefined && !LG.recs[x.key] ? "We haven't read this project's dependency files, so signals in the code can't show." : ""}</p>`}</section>
  <section class="panel"><h2>Connected to</h2><p class="muted small">Similar projects (sharing topics), its topics and its publisher. Select any of them.</p>${rxWeb(x, sim)}
    <ul class="rxsim">${sim.map(s => `<li>${rxTile(rxKind(s.x), 18, "sm")}<div><button type="button" class="linkbtn" data-rx="${esc(s.x.key)}">${esc(rxName(s.x.n))}</button> <span class="muted small">${esc(orgName(s.x.org))} · ${esc(s.why.join(", "))}</span></div></li>`).join("") || "<li class='muted'>No similar projects found.</li>"}</ul></section>
  <section class="panel"><h2>What you can do</h2><div class="rxacts">
    ${gh ? `<a class="rxact c-blue" href="${esc(gh)}" target="_blank" rel="noopener">${icon("i_ext", 22)}<b>Look at the project</b><span>Anyone can read it on GitHub. You don't need an account.</span><span class="sr-only"> (opens in a new tab)</span></a>
    <a class="rxact c-orange" href="${esc(gh)}/issues" target="_blank" rel="noopener">${icon("i_bug", 22)}<b>Report a problem or suggest something</b><span>Needs a free GitHub account. The owner may have turned this off.</span><span class="sr-only"> (opens in a new tab)</span></a>` : ""}
    <a class="rxact c-green" href="${esc(DATA.issues_url)}" target="_blank" rel="noopener">${icon("i_mail", 22)}<b>Ask about this catalogue</b><span>Raise an issue with the catalogue's maintainers. We can't answer for the project's owner.</span></a>
    <button type="button" class="rxact c-violet" ${tops[0] ? `data-rxgotopic="${tops[0].id}"` : `data-rxacct="${esc(x.org)}"`}>${icon("discover", 22)}<b>Find similar work</b><span>${tops[0] ? "More projects about " + esc(tops[0].label.toLowerCase()) + "." : "More from the same GitHub account."}</span></button></div></section>
  ${words.length ? `<section class="panel"><h2>Words explained</h2><dl class="rxwords">${words.map(w => `<div><dt>${esc(w.t)}</dt><dd>${esc(w.d)}</dd></div>`).join("")}</dl></section>` : ""}
  <section class="panel lv-tech"><h2>Technical details</h2>${kv([["Identifier", `<span class="mono">${esc(x.key)}</span>`], ["Language", esc(x.l) || "—"], ["Licence code", esc(LICS[x.li] ?? "—")], ["Status and basis", `${esc(x.st)} (${esc(x.basis)})`], ["Stars and forks", x.sg == null ? "—" : `${nf(x.sg)} stars · ${nf(x.fk)} forks`], ["Commits by people", x.c12 == null ? "—" : `${nf(x.c90)} in 90 days · ${nf(x.c12)} in 12 months`], ["Type from files", esc(TYPE_OF(x.key))], ["Practices found", PRC.masks[x.key] === undefined ? "not read" : PORDER.filter(p => hasP(x.key, p)).map(p => esc(PLABEL[p])).join(", ") || "none"]])}</section>
  <section class="panel"><h2>How we know this</h2><ul class="small"><li>Facts come from the public GitHub listing, git and the project's files, read in October 2026. Nothing here was confirmed by the project's owner.</li>
    <li>Who it belongs to comes from a mapping of GitHub accounts to public bodies, joined to GOV.UK's list of organisations (read ${esc(fmtD(Date.parse(HR.source.read) / 1000))}). GDS areas are assessed from the account and the project's words.</li>
    <li>Plain-English labels translate the catalogue's categories. The trace table shows the original evidence for each one.</li></ul></section></div>`;
  const v = vb("profile");
  $$("input[name=rx-level]", v).forEach(r => r.onchange = () => { RXP.level = r.value; try { localStorage.setItem("ghrac-level", r.value); } catch {} $(".rxprof", v).dataset.level = r.value; });
  $("#rx-back").onclick = () => showTab("discover");
  const say = $("#rx-say"); if (say) say.onclick = () => { const sp = window.speechSynthesis; if (say.getAttribute("aria-pressed") === "true") { sp.cancel(); say.setAttribute("aria-pressed", "false"); say.lastElementChild.textContent = "Listen"; return; }
    const u = new SpeechSynthesisUtterance(`${rxName(x.n)}. ${sm.t} ${glance.map(g => g[0] + " " + g[3] + ".").join(" ")}`); u.lang = "en-GB"; u.onend = () => { say.setAttribute("aria-pressed", "false"); say.lastElementChild.textContent = "Listen"; };
    sp.cancel(); sp.speak(u); say.setAttribute("aria-pressed", "true"); say.lastElementChild.textContent = "Stop"; };
  bindX(v); try { buildDrawer("profile"); } catch {}
}
function rxOrgNotes(o) {
  const n = []; if (o.p.length > 1) n.push("Also under: " + o.p.slice(1).map(p => HO[p].t).join(", "));
  if (o.sup.length) n.push("Took over from: " + o.sup.map(p => HO[p].t + (HO[p].st === "closed" ? " (closed)" : "")).join(", "));
  if (o.by.length) n.push("Replaced by: " + o.by.map(p => HO[p].t).join(", "));
  return n.length ? `<span class="rxl-n">${n.map(esc).join("<br>")}</span>` : "";
}
const rxGo = (key, how = "push") => { if (!XBY[key]) { toast("No project found for " + key); return; } RXP.key = key; RXP.chosen = true; if (current !== "profile") showTab("profile", how); rxProfile(key); osHash("repo=" + key); const h = $("#rx-title"); if (h) h.focus(); };

/* ---------- Family tree ---------- */
const RXF0 = {root: null, sel: null, open: new Set(), codeOnly: true, closed: false}, RXF = {...RXF0, open: new Set()};
const famVis = id => { const {N, sub} = famIndex(), n = N[id]; return n && (!RXF.codeOnly || sub[id] > 0) && (RXF.closed || n.kind !== "org" || n.o.st !== "closed" || sub[id] > 0); };
const famKids = id => { const {N, sub} = famIndex(); return N[id].kids.filter(famVis).sort((a, b) => sub[b] - sub[a] || famLabel(N[a]).localeCompare(famLabel(N[b]))); };
function famDefault() { const {roots} = famIndex(); const g = GDS_HI !== undefined ? famPath("o" + GDS_HI)[0] : roots[0]; return roots.includes(g) ? g : roots[0]; }
RENDER.family = () => {
  const {N, sub, roots} = famIndex(); if (!RXF.root) { RXF.root = famDefault(); RXF.sel = GDS_HI !== undefined && famPath("o" + GDS_HI)[0] === RXF.root ? "o" + GDS_HI : RXF.root; famPath(RXF.sel).forEach(i => RXF.open.add(i)); }
  const grp = {}; Object.entries(HR.body_grp).forEach(([bi, g]) => { const b = BODIES[bi]; if (!b) return; const n = ALL.filter(x => XO[x.oi]?.body === +bi).length; if (n) (grp[g] ||= []).push([b, n, +bi]); });
  vb("family").innerHTML = `<div class="panel rxhero c-blue" data-new="1"><div class="rxh-row"><span class="rxtile xl c-blue" aria-hidden="true">${icon("family", 40)}</span><div class="rxh-main"><div class="eyebrow">Organisations · family tree</div><h2>Department family tree</h2>
      <p class="rx-lede">Each department and every organisation underneath it, down to the GitHub accounts and GDS units where the code lives, counted from the code's point of view. Open branches in the tree, or select a block in the picture, to see that part of the family and its projects.</p></div></div>
    <div class="filters"><label for="fam-root">Department or top-level organisation<select id="fam-root">${roots.map(r => `<option value="${r}"${RXF.root === r ? " selected" : ""}>${esc(N[r].label)} (${nf(sub[r])})</option>`).join("")}</select></label>
      <label class="rxcheck" for="fam-code"><input type="checkbox" id="fam-code"${RXF.codeOnly ? " checked" : ""}> Only branches with code</label><label class="rxcheck" for="fam-closed"><input type="checkbox" id="fam-closed"${RXF.closed ? " checked" : ""}> Include closed organisations</label>
      <button class="btn" type="button" id="fam-expand">Open every branch</button><button class="btn" type="button" id="fam-collapse">Close every branch</button></div></div>
    <div class="panel"><h2>The family at a glance</h2><p class="muted small">Each row is a level of the family. The wider the block, the more code sits in that branch. Select a block to choose it.</p><div id="fam-ice"></div>${legend([["Ministerial department", "blue"], ["Non-ministerial department", "magenta"], ["Agency", "orange"], ["Non-departmental public body", "green"], ["Other organisation", "slate"], ["GDS unit", "violet"], ["GitHub account", "aqua"]])}</div>
    <div class="famsplit"><div class="panel"><h2>Family tree</h2><p class="muted small">Use the arrow keys to move, right to open, left to close, and Enter to choose.</p><div id="fam-tree"></div></div>
      <div class="panel" id="fam-sel" aria-live="polite"></div></div>
    <div class="panel"><h2>Bodies GOV.UK doesn't list</h2><p class="muted small">Councils, NHS bodies and devolved organisations aren't in GOV.UK's list of organisations, so they're grouped by type here. These groupings are not sponsorship links.</p>
      <div class="rxgroups">${Object.entries(grp).sort((a, b) => b[1].reduce((s, z) => s + z[1], 0) - a[1].reduce((s, z) => s + z[1], 0)).map(([g, bs]) => `<details class="rxgd"><summary><b>${esc(g)}</b> <span class="muted">(${nf(bs.length)} bodies · ${nf(bs.reduce((s, z) => s + z[1], 0))} projects)</span></summary><ul>${bs.sort((a, b) => b[1] - a[1]).map(([b, n, bi]) => `<li>${esc(b.name)} <span class="muted small">${esc(b.type || "")}</span> · ${(b.accounts || []).map(a => `<button type="button" class="linkbtn" data-rxacct="${esc(a)}">${esc(a)}</button>`).join(", ")} <span class="muted">(${nf(n)})</span></li>`).join("")}</ul></details>`).join("")}</div></div>
    <div class="panel"><h2>How the family is built</h2><ul class="small"><li>Organisations and their parents come from GOV.UK's organisations list (${nf(HR.source.n)} organisations, read ${esc(fmtD(Date.parse(HR.source.read) / 1000))}).</li>
      <li>GitHub accounts are joined to organisations by an exact match on the organisation's GOV.UK name (its slug). Nothing is matched by a similar-looking title.</li><li>GDS's projects are split into GDS areas, which are assessed from the account and the project's words, not confirmed by GDS.</li>
      <li>An organisation with two parents appears, and is counted, under both.</li></ul></div>`;
  const v = vb("family");
  $("#fam-root").onchange = e => { RXF.root = e.target.value; RXF.sel = RXF.root; RXF.open = new Set([RXF.root]); famRefresh(); };
  $("#fam-code").onchange = e => { RXF.codeOnly = e.target.checked; famRefresh(); }; $("#fam-closed").onchange = e => { RXF.closed = e.target.checked; famRefresh(); };
  $("#fam-expand").onclick = () => { const walk = id => { RXF.open.add(id); famKids(id).forEach(walk); }; walk(RXF.root); famRefresh(); };
  $("#fam-collapse").onclick = () => { RXF.open = new Set([RXF.root]); famRefresh(); };
  famRefresh();
};
function famIce(root) {
  const {N, sub} = famIndex(), W = 760, rowH = 46, rows = [], maxD = 5;
  const lay = (id, x0, w, d) => { if (d > maxD || w < 1.5) return; rows.push({id, x0, w, d}); let x = x0; const ks = famKids(id), tot = ks.reduce((a, k) => a + sub[k], 0) || 1, own = N[id].recs.length;
    const span = w * (tot / (tot + own)); for (const k of ks) { const kw = span * sub[k] / tot; lay(k, x, kw, d + 1); x += kw; } };
  lay(root, 0, W, 0); const H = (Math.max(...rows.map(r => r.d)) + 1) * rowH;
  return `<div class="chartbox"><svg viewBox="0 0 ${W} ${H}" class="chart famice" role="group" aria-label="Family of ${esc(N[root].label)}, sized by amount of code">${rows.map(r => { const n = N[r.id], lab = famLabel(n), fit = Math.floor((r.w - 10) / 6.4);
    return `<g class="fami c-${famHue(n)}${RXF.sel === r.id ? " sel" : ""}" role="button" tabindex="0" data-fam="${esc(r.id)}" aria-label="${esc(lab)}: ${nf(sub[r.id])} projects" data-tip="${esc(lab)}: ${nf(sub[r.id])} projects"><rect x="${(r.x0 + 1).toFixed(1)}" y="${r.d * rowH + 2}" width="${Math.max(0.5, r.w - 2).toFixed(1)}" height="${rowH - 4}" rx="4"/>${fit >= 4 ? `<text x="${(r.x0 + 6).toFixed(1)}" y="${r.d * rowH + 20}">${esc(lab.length > fit ? lab.slice(0, fit - 1) + "…" : lab)}</text><text class="sub" x="${(r.x0 + 6).toFixed(1)}" y="${r.d * rowH + 35}">${fit >= 6 ? nf(sub[r.id]) : ""}</text>` : ""}</g>`; }).join("")}</svg></div>`;
}
function famTree(root) {
  const {N, sub} = famIndex(); let seq = 0;
  const li = (id, lvl, seen) => { const n = N[id], ks = seen.has(id) ? [] : famKids(id), open = RXF.open.has(id) && ks.length > 0, me = RXF.sel === id; seq++;
    return `<li role="treeitem" id="ft-${esc(id)}" data-fam-node="${esc(id)}" aria-level="${lvl}" aria-selected="${me}"${ks.length ? ` aria-expanded="${open}"` : ""} tabindex="${me ? 0 : -1}"><span class="ft-row c-${famHue(n)}">${ks.length ? `<span class="ft-tw" aria-hidden="true">${open ? "▾" : "▸"}</span>` : '<span class="ft-tw" aria-hidden="true"></span>'}<span class="rxtile sm c-${famHue(n)}" aria-hidden="true">${icon(famIcon(n), 15)}</span><span class="ft-l">${esc(famLabel(n))}</span><span class="ft-n">${nf(sub[id])}</span></span>${open ? `<ul role="group">${ks.map(k => li(k, lvl + 1, new Set([...seen, id]))).join("")}</ul>` : ""}</li>`; };
  return `<ul class="famtree" role="tree" aria-label="Family tree of ${esc(N[root].label)}">${li(root, 1, new Set())}</ul>`;
}
function famRefresh() {
  const {N, sub} = famIndex(), v = vb("family"); if (!N[RXF.sel]) RXF.sel = RXF.root;
  $("#fam-ice").innerHTML = famIce(RXF.root); $("#fam-tree").innerHTML = famTree(RXF.root);
  const n = N[RXF.sel], path = famPath(RXF.sel), recs = []; const walk = (id, seen) => { if (seen.has(id)) return; seen.add(id); recs.push(...N[id].recs); N[id].kids.forEach(k => walk(k, seen)); }; walk(RXF.sel, new Set());
  const uniq = [...new Map(recs.map(x => [x.key, x])).values()].sort((a, b) => lastAct(b) - lastAct(a)), lv = uniq.filter(live).length, kc = {};
  for (const x of uniq) { const k = rxKind(x).id; kc[k] = (kc[k] || 0) + 1; }
  $("#fam-sel").innerHTML = `<h2>${icon(famIcon(n), 22)} ${esc(famLabel(n))}</h2><nav aria-label="Where this sits"><ol class="rxcrumbs">${path.map(id => `<li>${id === RXF.sel ? `<span aria-current="true">${esc(famLabel(N[id]))}</span>` : `<button type="button" class="linkbtn" data-fam="${esc(id)}">${esc(famLabel(N[id]))}</button>`}</li>`).join("")}</ol></nav>
    <p class="rxg-d">${esc(famKind(n))}${n.kind === "org" && n.o.slug ? ` · ${ext("https://www.gov.uk/government/organisations/" + encodeURIComponent(n.o.slug), "GOV.UK page")}` : ""}</p>${n.kind === "org" ? rxOrgNotes(n.o) + osChips(n.o.i) : ""}${n.kind === "org" ? `<p><button class="btn sm" type="button" data-lgorg="${esc(n.o.slug)}">${icon("legacy", 14)} Legacy and debt signals here</button></p>` : ""}
    <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(uniq.length)}</b> projects in this branch</span><span>${icon("s_active", 16)} <b>${nf(lv)}</b> being worked on or looked after</span><span>${icon("family", 16)} <b>${nf(famKids(RXF.sel).length)}</b> branches below</span><span>${icon("legacy", 16)} <b>${nf(uniq.filter(x => lgCore(x).length).length)}</b> with legacy signals</span></p>
    ${uniq.length ? rxBars(Object.entries(kc).sort((a, b) => b[1] - a[1]).slice(0, 6).map(([k, c]) => ({label: RXK_BY[k].w, n: c, ic: RXK_BY[k].ic, c: RXK_BY[k].c})), "Projects in this branch by kind") : ""}
    <h3 class="drawer-h">Most recently changed projects here</h3>${uniq.length ? `<div class="rxgrid one">${uniq.slice(0, 6).map(rxCard).join("")}</div>${n.kind === "acct" ? `<p><button class="btn" type="button" data-rxacct="${esc(n.label)}">See all ${nf(uniq.length)} in Explore repos</button></p>` : uniq.length > 6 ? `<p class="small muted">Showing 6 of ${nf(uniq.length)}. Choose a branch lower down to narrow it, or a GitHub account to see them all.</p>` : ""}` : `<p class="muted">No public code found in this branch.</p>`}`;
  famBindTree(v);
}
function famSelect(id, focus) { const {N} = famIndex(); if (!N[id]) { toast("Not found in the family tree"); return; } const r = famPath(id)[0]; if (r !== RXF.root) { RXF.root = r; RXF.open = new Set(); const sel = $("#fam-root"); if (sel) sel.value = r; }
  RXF.sel = id; famPath(id).forEach(i => RXF.open.add(i)); famRefresh(); const nn = famIndex().N[id]; osHash(nn.kind === "org" ? "org=" + nn.o.slug : nn.kind === "acct" ? "account=" + nn.label : "family"); if (focus) { const el = document.getElementById("ft-" + id); if (el) el.focus(); } }
const famGo = id => { const {N} = famIndex(); if (!N[id]) { toast("Not found in the family tree"); return; } if (!famVis(id)) { RXF.codeOnly = false; RXF.closed = true; }
  if (current !== "family") { RXF.root = famPath(id)[0]; RXF.open = new Set(); showTab("family"); } famSelect(id); const h = $("#fam-sel h2"); if (h) { h.tabIndex = -1; h.focus(); } };
function famBindTree(v) {
  const items = () => $$("#fam-tree [role=treeitem]", v);
  $$("#fam-tree [role=treeitem]", v).forEach(li => {
    li.onclick = e => { e.stopPropagation(); const id = li.dataset.famNode; if (li.hasAttribute("aria-expanded") && e.target.closest(".ft-tw")) { RXF.open.has(id) ? RXF.open.delete(id) : RXF.open.add(id); famRefresh(); document.getElementById("ft-" + id)?.focus(); return; }
      if (li.hasAttribute("aria-expanded")) { RXF.open.add(id); } famSelect(id, true); };
    li.onkeydown = e => { const id = li.dataset.famNode, all = items(), i = all.indexOf(li);
      if (e.key === "ArrowDown") { e.preventDefault(); all[Math.min(all.length - 1, i + 1)]?.focus(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); all[Math.max(0, i - 1)]?.focus(); }
      else if (e.key === "ArrowRight") { e.preventDefault(); e.stopPropagation(); if (li.getAttribute("aria-expanded") === "false") { RXF.open.add(id); famRefresh(); document.getElementById("ft-" + id)?.focus(); } else $("[role=treeitem]", li.querySelector("ul") || document.createElement("ul"))?.focus(); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); e.stopPropagation(); if (li.getAttribute("aria-expanded") === "true") { RXF.open.delete(id); famRefresh(); document.getElementById("ft-" + id)?.focus(); } else li.parentElement.closest("[role=treeitem]")?.focus(); }
      else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); e.stopPropagation(); famSelect(id, true); }
      else if (e.key === "Home") { e.preventDefault(); all[0]?.focus(); } else if (e.key === "End") { e.preventDefault(); all.at(-1)?.focus(); } };
  });
}

/* ---------- shared handlers ---------- */
document.addEventListener("click", e => {
  const t = e.target.closest?.("[data-rx],[data-fam],[data-rxgotopic],[data-rxacct],[data-rxdama],[data-rxgds],[data-go-lg],[data-lgorg],[data-thgo]"); if (!t || t.closest("#fam-tree [role=treeitem]") && !t.matches("[data-rx],[data-rxacct]")) return;
  if (t.dataset.rx) { e.preventDefault(); rxGo(t.dataset.rx); }
  else if (t.dataset.fam) { e.preventDefault(); famGo(t.dataset.fam); }
  else if (t.dataset.rxgotopic) { e.preventDefault(); rxDiscover({topic: t.dataset.rxgotopic}); }
  else if (t.dataset.rxacct) { e.preventDefault(); rxDiscover({acct: t.dataset.rxacct}); }
  else if (t.dataset.rxdama) { e.preventDefault(); damaGo(t.dataset.rxdama); }
  else if (t.dataset.thgo) { e.preventDefault(); const [th, s] = t.dataset.thgo.split("|"); THQ[th] = {...thQ0(), sub: s}; if (current === th) RENDER[th](); else { showTab(th); RENDER[th](); } }
  else if (t.dataset.lgorg) { e.preventDefault(); osRoute("legacy=" + t.dataset.lgorg); }
  else if (t.dataset.goLg) { e.preventDefault(); Object.assign(LGQ, LGQ0, {sig: t.dataset.goLg, core: !LGS.find(s => s.id === t.dataset.goLg) || LGS.find(s => s.id === t.dataset.goLg).group !== "upkeep"}); if (current === "legacy") RENDER.legacy(); else { showTab("legacy"); RENDER.legacy(); } }
  else if (t.dataset.rxgds) { e.preventDefault(); GS7.area = t.dataset.rxgds; showTab("gds"); RENDER.gds(); }
});
document.addEventListener("keydown", e => { if (e.key !== "Enter" && e.key !== " ") return; const g = e.target.closest?.("svg [role=button][data-rx], svg [role=button][data-fam], svg [role=button][data-rxgotopic]"); if (!g) return; e.preventDefault(); g.dispatchEvent(new MouseEvent("click", {bubbles: true})); });

/* Home: a way in for people who don't use GitHub */
{ const _home = RENDER.home; RENDER.home = () => { _home(); const v = vb("home"); if ($("#rx-homecard", v)) return;
  v.insertAdjacentHTML("afterbegin", `<section class="panel rxhomecard c-aqua" id="rx-homecard" data-new="1" aria-labelledby="rxhc-h"><div class="rxh-row"><span class="rxtile xl c-aqua" aria-hidden="true">${icon("discover", 40)}</span><div class="rxh-main"><div class="eyebrow">New in 7.1</div><h2 id="rxhc-h">Explore public code in plain English</h2><p class="rx-lede">No GitHub knowledge needed. Browse by topic, search in everyday words, and open any project for its story: what it does, who looks after it, where it sits in its department's family and where each fact came from.</p>
    <p class="rxh-acts"><button class="btn primary" type="button" id="rxhc-go">${icon("discover", 16)} Explore repos</button><button class="btn" type="button" id="rxhc-fam">${icon("family", 16)} Department family tree</button></p></div></div></section>`);
  $("#rxhc-go").onclick = () => showTab("discover"); $("#rxhc-fam").onclick = () => showTab("family"); }; }

/* ================= 7.1 Legacy data, legacy technology and technical debt ================= */
Object.assign(ICONS, {
  legacy:'<path d="M12 3l9.5 16.5h-19z"/><path d="M12 9.5v4.5M12 17v.1"/>',
  l_govuk:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 13l3 3 5-5"/><path d="M5 2.5l14 19" />',
  l_tech:'<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9zM9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/><path d="M4 20L20 4"/>',
  l_lang:'<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  l_about:'<ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13"/><path d="M8 12l3 3M11 12l-3 3M14 15h3"/>',
  l_selfdep:'<path d="M4 4h16v16H4z"/><path d="M8 8l8 8M16 8l-8 8"/>',
  l_upkeep:'<path d="M7 3h10M7 21h10M8 3c0 5 8 5 8 9s-8 4-8 9M16 3c0 5-8 5-8 9"/><path d="M3 12h2M19 12h2"/>'});
const LG = DATA.legacy, LG_UP = [["quiet_open", "Gone quiet, but still open", "upkeep", "No person has changed it for more than 2 years, but it hasn't been archived, so people may still find and depend on it.", "status"],
  ["retired_site", "Retired, but its website is still published", "upkeep", "Archived on GitHub, but still publishing a GitHub Pages website.", "listing"]];
const LGS = [...LG.sigs, ...LG_UP].map(([id, label, group, desc, how], i) => ({i, id, label, group, desc, how}));
const LG_GRP = {govuk: ["Retired GOV.UK libraries", "l_govuk", "red"], tech: ["End-of-life technology in the code", "l_tech", "orange"], lang: ["Older languages", "l_lang", "yellow"],
  about: ["About legacy data or systems", "l_about", "violet"], selfdep: ["Says it's deprecated, but still open", "l_selfdep", "magenta"], upkeep: ["Upkeep debt", "l_upkeep", "slate"]};
const LG_HOW = {dependency: "In the code: a dependency it declares", language: "The main language GitHub reports", text: "Its name, description or README", status: "Its activity and archive status", listing: "The public GitHub listing"};
function lgSigs(x) { if (x._lg) return x._lg; const r = (LG.recs[x.key] || []).map(([i, ev]) => ({s: LGS[i], ev}));
  if (x.st === "Inactive" && !x.ar) r.push({s: LGS[LG.sigs.length], ev: "last change by a person " + (x.lh || x.pd ? fmtD(x.lh || x.pd) : "not known")});
  if (x.ar && x.pg) r.push({s: LGS[LG.sigs.length + 1], ev: x.pu || "GitHub Pages site"}); return (x._lg = r); }
const lgCore = x => lgSigs(x).filter(s => s.s.group !== "upkeep");
const LGQ0 = {sig: "", grp: "", sector: "", org: "", live: false, q: "", core: true, sort: "recent", n: 50}, LGQ = {...LGQ0};
const lgFiltered = (S = LGQ) => ALL.filter(x => { const ss = S.core ? lgCore(x) : lgSigs(x); if (!ss.length) return false; if (S.sig && !ss.some(s => s.s.id === S.sig)) return false; if (S.grp && !ss.some(s => s.s.group === S.grp)) return false;
  if (S.org) { const oi = rxOrgOf(x); if (oi === null || HO[oi].slug !== S.org) return false; }
  return (!S.sector || x.sector === S.sector) && (!S.live || live(x)) && (!S.q || x.q.includes(S.q.toLowerCase())); });
const lgBadge = x => { const c = lgCore(x); if (!c.length) return ""; return `<span class="rxbadge c-orange" data-tip="${esc("Legacy or debt: " + [...new Set(c.map(s => s.s.label))].join("; "))}">${icon("legacy", 15)}<span>Legacy</span></span>`; };
RENDER.legacy = () => {
  const counts = LGS.map(s => ({s, n: 0, lv: 0})), bySec = {};
  for (const x of ALL) for (const {s} of lgSigs(x)) { counts[s.i].n++; if (live(x)) counts[s.i].lv++; const k = x.sector || "Other"; (bySec[k] ||= {})[s.id] = (bySec[k][s.id] || 0) + 1; }
  const core = ALL.filter(x => lgCore(x).length), coreLive = core.filter(live).length, quiet = counts[LG.sigs.length].n;
  const secs = Object.keys(bySec).sort((a, b) => Object.values(bySec[b]).reduce((s, v) => s + v, 0) - Object.values(bySec[a]).reduce((s, v) => s + v, 0)).slice(0, 10);
  const orgs = {}; for (const x of core) orgs[x.org] = (orgs[x.org] || 0) + 1;
  vb("legacy").innerHTML = `<section class="panel rxhero c-orange" data-new="1"><div class="rxh-row"><span class="rxtile xl c-orange" aria-hidden="true">${icon("legacy", 40)}</span><div class="rxh-main"><div class="eyebrow">Insights · legacy and technical debt</div><h2>Legacy data, legacy technology and technical debt</h2>
      <p class="rx-lede">Which public code is about legacy data or systems, still uses technology its makers have retired, says it's deprecated but is still open, or has gone quiet without being archived. Each signal shows how it was found.</p>
      <p class="rxh-stats"><span>${icon("legacy", 16)} <b>${nf(core.length)}</b> projects with legacy signals</span><span>${icon("s_active", 16)} <b>${nf(coreLive)}</b> of them being worked on or looked after</span><span>${icon("l_upkeep", 16)} <b>${nf(quiet)}</b> gone quiet but still open</span></p></div></div></section>
    <div class="panel"><h2>Signals</h2><p class="muted small">Select a signal to list its projects. Select it again to clear it.</p><div class="lgtiles">${counts.map(({s, n, lv}) => { const g = LG_GRP[s.group]; return `<button type="button" class="lgtile c-${g[2]}" data-lgsig="${s.id}" aria-pressed="${LGQ.sig === s.id}"><span class="rxtile c-${g[2]}" aria-hidden="true">${icon(g[1], 22)}</span><span class="lgt-l">${esc(s.label)}</span><span class="lgt-n">${nf(n)}</span><span class="lgt-s">${nf(lv)} worked on or looked after · ${esc(LG_HOW[s.how] || s.how)}</span></button>`; }).join("")}</div></div>
    ${chartPanel("Where the signals are, by sector", heatmap({rows: LGS.map(s => ({id: s.id, label: s.label})), cols: secs.map(s => ({id: s, label: s})), val: (r, c) => bySec[c.id]?.[r.id] || 0, label: "Legacy and debt signals by sector", act: (r, c) => `data-lgcell="${esc(r.id)}|${esc(c.id)}"`}), {wide: true, isNew: true, lede: "Darker cells have more projects. Select a number to list them.", note: "Upkeep debt counts are large because many old projects were never archived."})}
    <div class="rxsplit"><div class="panel"><h2>Who has the most legacy signals</h2>${rxBars(Object.entries(orgs).sort((a, b) => b[1] - a[1]).slice(0, 10).map(([o, n]) => ({label: orgName(o), n, ic: "i_building", c: "orange", btn: `data-rxacct="${esc(o)}"`})), "GitHub accounts with the most projects with legacy signals; select one to explore its projects")}<p class="faint small">Counts exclude upkeep debt.</p></div>
      <div class="panel"><h2>By kind of signal</h2>${rxBars(Object.entries(LG_GRP).map(([g, v]) => ({label: v[0], n: ALL.filter(x => lgSigs(x).some(s => s.s.group === g)).length, ic: v[1], c: v[2], btn: `data-lggrp="${g}" aria-pressed="${LGQ.grp === g}"`})), "Projects by kind of legacy or debt signal; select one to filter")}</div></div>
    <div class="panel"><div class="panel-head"><h2 id="lg-lh" tabindex="-1">Projects</h2><div class="btnrow"><button class="btn" type="button" id="lg-csv">Download CSV</button></div></div>
      <div class="filters"><label class="grow" for="lg-q">Search<input type="search" id="lg-q" value="${esc(LGQ.q)}" placeholder="name or description"></label>
        <label for="lg-sector">Sector<select id="lg-sector"><option value="">All</option>${SECTORS.map(s => `<option${LGQ.sector === s ? " selected" : ""}>${esc(s)}</option>`).join("")}</select></label>
        <label for="lg-sort">Sort by<select id="lg-sort"><option value="recent">Most recently changed</option><option value="signals"${LGQ.sort === "signals" ? " selected" : ""}>Most signals</option><option value="name"${LGQ.sort === "name" ? " selected" : ""}>Name, A to Z</option></select></label>
        <label class="rxcheck" for="lg-live"><input type="checkbox" id="lg-live"${LGQ.live ? " checked" : ""}> Being worked on or looked after</label><label class="rxcheck" for="lg-core"><input type="checkbox" id="lg-core"${LGQ.core ? "" : " checked"}> Include upkeep debt</label><button class="btn" type="button" id="lg-reset">Clear</button></div>
      <div id="lg-chips" class="chips"></div><p class="count" id="lg-count" aria-live="polite"></p><div id="lg-list"></div></div>
    <div class="panel"><h2>How the signals are found, and how accurate they are</h2><ul class="small"><li>${esc(LG.source.note)}</li><li>Signals in the code come from the dependency files we read for ${nf(DATA.gds.deps_fetched)} projects; projects we didn't read can't show them.</li>
      <li>Fortran and Perl are not counted as older languages: both are still widely used for science and operations.</li><li>Upkeep debt is worked out from activity: a project no person has changed for 2 years that is still open.</li></ul>
      <div class="tbl-wrap"><table><caption>Accuracy of the text-only signals, judged by ${esc(LG.prec.judged_by)}</caption><thead><tr><th scope="col">What was checked</th><th scope="col" class="n">Sample</th><th scope="col" class="n">Correct</th><th scope="col">What was wrong, and the fix</th></tr></thead><tbody>${LG.prec.rounds.map(r => `<tr><td>${esc(r.what)}</td><td class="n">${r.n}</td><td class="n">${r.true}</td><td>${esc(r.note)}</td></tr>`).join("")}</tbody></table></div></div>`;
  const v = vb("legacy");
  $$("[data-lgsig]", v).forEach(b => b.onclick = () => { LGQ.sig = LGQ.sig === b.dataset.lgsig ? "" : b.dataset.lgsig; if (LGS.find(s => s.id === LGQ.sig)?.group === "upkeep") LGQ.core = false; LGQ.n = 50; lgRefresh(true); });
  $$("[data-lggrp]", v).forEach(b => b.onclick = () => { LGQ.grp = LGQ.grp === b.dataset.lggrp ? "" : b.dataset.lggrp; if (LGQ.grp === "upkeep") LGQ.core = false; LGQ.n = 50; lgRefresh(true); });
  $$("[data-lgcell]", v).forEach(b => b.onclick = () => { const [s, c] = b.dataset.lgcell.split("|"); Object.assign(LGQ, {sig: s, sector: c, core: false, n: 50}); $("#lg-sector").value = c; lgRefresh(true); });
  let tq; $("#lg-q").oninput = e => { clearTimeout(tq); tq = setTimeout(() => { LGQ.q = e.target.value; lgRefresh(); }, 160); };
  $("#lg-sector").onchange = e => { LGQ.sector = e.target.value; lgRefresh(); }; $("#lg-sort").onchange = e => { LGQ.sort = e.target.value; lgRefresh(); };
  $("#lg-live").onchange = e => { LGQ.live = e.target.checked; lgRefresh(); }; $("#lg-core").onchange = e => { LGQ.core = !e.target.checked; lgRefresh(); };
  $("#lg-reset").onclick = () => { Object.assign(LGQ, LGQ0); RENDER.legacy(); };
  $("#lg-csv").onclick = () => save("legacy-and-technical-debt-" + DATA.meta.ref_date + ".csv", "﻿" + [["repository", "url", "organisation", "status", "signals", "evidence"].map(csvCell).join(","), ...lgFiltered().map(x => [x.key, ghUrl(x.key), orgName(x.org), x.st, lgSigs(x).map(s => s.s.label).join("; "), lgSigs(x).map(s => s.ev).join("; ")].map(csvCell).join(","))].join("\r\n"));
  lgRefresh();
};
function lgRefresh(focus) {
  const v = vb("legacy"), L = lgFiltered(), srt = [...L].sort(LGQ.sort === "name" ? (a, b) => rxNm(a).localeCompare(rxNm(b)) : LGQ.sort === "signals" ? (a, b) => lgSigs(b).length - lgSigs(a).length || lastAct(b) - lastAct(a) : (a, b) => lastAct(b) - lastAct(a));
  $$("[data-lgsig]", v).forEach(b => b.setAttribute("aria-pressed", String(b.dataset.lgsig === LGQ.sig))); $$("[data-lggrp]", v).forEach(b => b.setAttribute("aria-pressed", String(b.dataset.lggrp === LGQ.grp)));
  $("#lg-core").checked = !LGQ.core;
  const chips = []; if (LGQ.sig) chips.push(["sig", "Signal: " + LGS.find(s => s.id === LGQ.sig)?.label]); if (LGQ.grp) chips.push(["grp", "Kind: " + LG_GRP[LGQ.grp][0]]); if (LGQ.sector) chips.push(["sector", "Sector: " + LGQ.sector]); if (LGQ.org) chips.push(["org", "Organisation: " + (HO[HSLUG[LGQ.org]]?.t || LGQ.org)]);
  $("#lg-chips").innerHTML = chips.map(([k, l]) => `<button type="button" class="chip xchip" data-lgun="${k}">${esc(l)} <span aria-hidden="true">×</span><span class="sr-only"> remove this filter</span></button>`).join(" ");
  $$("[data-lgun]", v).forEach(b => b.onclick = () => { LGQ[b.dataset.lgun] = ""; if (b.dataset.lgun === "sector") $("#lg-sector").value = ""; lgRefresh(); });
  $("#lg-count").textContent = `${nf(L.length)} ${L.length === 1 ? "project" : "projects"}`;
  $("#lg-list").innerHTML = L.length ? `<div class="tbl-wrap"><table><caption class="sr-only">Projects with legacy or technical debt signals</caption><thead><tr><th scope="col">Project</th><th scope="col">Publisher</th><th scope="col">Status</th><th scope="col">Signals and evidence</th></tr></thead><tbody>${srt.slice(0, LGQ.n).map(x => `<tr><td class="repo"><button type="button" class="linkbtn" data-rx="${esc(x.key)}">${esc(rxName(x.n))}</button><br><small class="mono">${esc(x.key)}</small></td><td>${esc(orgName(x.org))}</td><td>${rxBadge(rxStat(x))}</td><td><ul class="lgev">${lgSigs(x).map(s => `<li><span class="rxtile sm c-${LG_GRP[s.s.group][2]}" aria-hidden="true">${icon(LG_GRP[s.s.group][1], 14)}</span><span><b>${esc(s.s.label)}</b> <span class="muted small">${esc(s.ev)}</span></span></li>`).join("")}</ul></td></tr>`).join("")}</tbody></table></div>${L.length > LGQ.n ? `<p><button class="btn" type="button" id="lg-more">Show ${nf(Math.min(50, L.length - LGQ.n))} more</button></p>` : ""}` : `<p class="muted">No projects match.</p>`;
  $("#lg-more") && ($("#lg-more").onclick = () => { LGQ.n += 50; lgRefresh(); });
  if (focus) $("#lg-lh")?.focus();
}
/* Insights dashboard: legacy and debt at a glance */
{ const _ins = RENDER.insights; RENDER.insights = () => { _ins(); const v = vb("insights"); if ($("#lg-ins", v)) return; const n = g => ALL.filter(x => lgSigs(x).some(s => s.s.group === g)).length;
  v.insertAdjacentHTML("beforeend", `<div class="panel chartpanel" id="lg-ins" data-new="1"><div class="panel-head"><h2>Legacy and technical debt at a glance</h2><button class="btn" type="button" data-go-legacy>Open legacy and technical debt</button></div><p class="muted small">Across the whole catalogue (these bars don't follow the filters above).</p>${rxBars(Object.entries(LG_GRP).map(([g, val]) => ({label: val[0], n: n(g), ic: val[1], c: val[2]})), "Projects by kind of legacy or debt signal")}</div>`);
  $("[data-go-legacy]", v).onclick = () => showTab("legacy"); }; }

/* ================= 7.1 govukOS connections: GTI, ANA, LIAH and the shared registers ================= */
const OS_READ = "31 October 2026";
const OS_APPS = [
  {id: "gti", name: "GTI: Government Technology Intelligence", url: "", node: "32b56d7d", holds: "The technology record of the estate. Holds technical debt and legacy scores at organisation level (1 to 5 across five dimensions) and links down to LIAH.", key: "Its own short organisation keys, mapped to GOV.UK slugs through a lookup table", give: "Per organisation, keyed by GOV.UK slug: how many repositories, how many are live, and how many carry each legacy and debt signal. Evidence for GTI's organisation-level debt scores, which today have no code-level evidence.", take: "GTI's organisation debt scores, to show next to the code evidence on the family tree.", status: "Feed ready here; GTI needs to read it"},
  {id: "liah", name: "LIAH: Legacy Insights Hub", url: "", node: "79cd5768", holds: "The asset-level record of legacy, cyber and supplier assurance. Its estate figures are marked illustrative, and it holds no organisation record.", key: "Its own subject codes (F1 to F8 with GTI); no real system or asset identifiers yet", give: "Real, repository-level evidence for its F1 subject (technical debt and the legacy estate): each repository's legacy signals with the file, dependency or wording that shows it. A first non-illustrative source.", take: "Its elevation and verdict records, once they name real systems.", status: "Feed ready here; LIAH needs real system identifiers"},
  {id: "ana", name: "ANA: Anatomy of Government", url: "", node: "1d3fa5f4", holds: "How the state is organised: classification, lineage, machinery-of-government change, devolution and spend. Holds a tech-debt score per organisation and a read-only JavaScript interface.", key: "Short organisation ids (such as homeoffice); 15 of 25 mapped to GOV.UK slugs; arm's-length bodies get guessed slugs", give: "The code estate of each organisation and its family, from GOV.UK's own parent links, keyed by GOV.UK slug.", take: "ANA's classification and machinery-of-government events, once its ids are mapped to GOV.UK slugs.", status: "Needs the shared organisation register (R3) first"},
  {id: "mog", name: "MoG Navigator (organisations register, R3)", url: "", node: "d9273289", holds: "Named master of the organisations register: one record per organisation keyed to the GOV.UK organisation identifier, with machinery-of-government changes as dated events.", key: "GOV.UK organisation slug", give: "This catalogue already reads GOV.UK's organisation list (parents, predecessors, successors) and joins GitHub accounts to it by exact slug. That join table is the missing piece LIAH records as not existing.", take: "The register itself, so every app joins on one organisation list.", status: "Same key; ready to converge"},
  {id: "measr", name: "MEASR Data Asset Register (R1, R2)", url: "", node: "3555f4e4", holds: "Master of the data asset register (identifiers such as IA-275) and the shared vocabulary. Holds 1,176 GOV.UK organisations with their slugs.", key: "GOV.UK slug for organisations; IA- numbers for data assets", give: "Repositories that build, move or publish each organisation's data (pipelines, open data, APIs, data management capabilities).", take: "Asset identifiers, so a repository can name the data asset it serves.", status: "Organisation join ready; asset links need owners"},
  {id: "cat", name: "govukOS unified catalogue (registers R5 to R7)", url: "", node: "GOVUKOS-076", holds: "The catalogue of govukOS nodes and shared masters, with DCAT and SKOS exports. This repository catalogue is not registered there yet; the integration assessment rates connecting it as Should.", key: "Node ids and GOVUKOS-NNN-SLUG-CHECK artefact identifiers", give: "A DCAT description of this catalogue and its feeds, ready to register.", take: "A govukOS identifier for this catalogue, issued by the artefact register (R7).", status: "Not registered; identifier to be issued by Studio"}].map(a => ({...a, url: (DATA.os_urls || {})[a.id] || ""}));
function osOrgFeed() {
  const F = famIndex(); const rows = [];
  for (const o of HO) { const id = "o" + o.i; if (!F.sub[id]) continue; const own = []; const fam = []; const seen = new Set();
    for (const k of F.N[id].kids) if (F.N[k].kind !== "org") own.push(...F.N[k].recs);
    const walk = n => { if (seen.has(n)) return; seen.add(n); fam.push(...F.N[n].recs); F.N[n].kids.forEach(walk); }; walk(id);
    const sig = {}; for (const x of own) for (const s of lgSigs(x)) sig[s.s.id] = (sig[s.s.id] || 0) + 1;
    rows.push({slug: o.slug, name: o.t, format: o.f, parent: o.p.map(p => HO[p].slug).join(" "), repos_own: own.length, repos_family: new Set(fam.map(x => x.key)).size, live_own: own.filter(live).length, legacy_own: own.filter(x => lgCore(x).length).length, quiet_open_own: sig.quiet_open || 0, signals: sig}); }
  return rows.sort((a, b) => b.repos_family - a.repos_family);
}
const osRepoFeed = () => ALL.filter(x => lgSigs(x).length).map(x => { const oi = rxOrgOf(x); return {repository: x.key, url: ghUrl(x.key), org_slug: oi === null ? "" : HO[oi].slug, gds_area: RX_GOWN[x.key] || "", status: x.st, kind: TYPE_OF(x.key), signals: lgSigs(x).map(s => ({id: s.s.id, label: s.s.label, how: s.s.how, evidence: s.ev}))}; });
const osDcat = () => ({"@context": {dcat: "http://www.w3.org/ns/dcat#", dct: "http://purl.org/dc/terms/"}, "@type": "dcat:Catalog", "dct:title": "GitHub Repos Asset Catalogue", "dct:identifier": DATA.docid, "dct:modified": DATA.meta.ref_date,
  "dcat:dataset": [["org-code-estate", "Code estate and legacy signals per organisation, keyed by GOV.UK organisation slug"], ["repo-legacy-signals", "Legacy and technical debt signals per repository, with evidence"], ["org-family", "GitHub accounts joined to GOV.UK organisations, with GOV.UK parent links"]].map(([id, t]) => ({"@type": "dcat:Dataset", "dct:identifier": id, "dct:title": t, "dct:publisher": "The GitHub Repos Asset Catalogue maintainers", "dcat:keyword": ["govukOS", "technical debt", "legacy"], "dcat:distribution": [{"@type": "dcat:Distribution", "dct:format": "application/json"}, {"@type": "dcat:Distribution", "dct:format": "text/csv"}]}))});
window.GHRAC_API = Object.freeze({version: "read-only-1", orgs: () => osOrgFeed(), org: slug => osOrgFeed().find(r => r.slug === slug) || null, repos: () => osRepoFeed(), dcat: () => osDcat()});
RENDER.govukos = () => {
  const feed = osOrgFeed(), top = feed.filter(r => r.repos_own).slice(0, 12);
  vb("govukos").innerHTML = `<section class="panel rxhero c-violet" data-new="1"><div class="rxh-row"><span class="rxtile xl c-violet" aria-hidden="true">${icon("i_link", 40)}</span><div class="rxh-main"><div class="eyebrow">About · govukOS connections</div><h2>How this catalogue links to GTI, ANA, LIAH and the rest of govukOS</h2>
      <p class="rx-lede">This catalogue holds what the govukOS apps don't: repository-level evidence of what each organisation builds and where its legacy and technical debt sits. All of them can join on one key, the GOV.UK organisation slug. The feeds below are ready for the other apps to read.</p></div></div></section>
    <div class="panel"><h2>The apps, what each holds and how they join</h2><p class="muted small">Read from each app on ${OS_READ}. Links to the apps are added when the catalogue is deployed and only work for people the apps are shared with. Where no link is set, the card and the links below show the route to open in that app.</p><div class="osgrid">${OS_APPS.map(a => `<article class="oscard"><h3 class="drawer-h">${a.url ? ext(a.url, a.name) : esc(a.name)}</h3>${a.url ? "" : `<p class="small muted">Link not set in this deployment</p>`}<p class="small muted">govukOS node ${esc(a.node)}</p><p>${esc(a.holds)}</p><dl class="osdl"><div><dt>Joins on</dt><dd>${esc(a.key)}</dd></div><div><dt>This catalogue gives</dt><dd>${esc(a.give)}</dd></div><div><dt>This catalogue would take</dt><dd>${esc(a.take)}</dd></div><div><dt>Status</dt><dd><b>${esc(a.status)}</b></dd></div></dl></article>`).join("")}</div></div>
    <div class="panel"><h2>What joins up, and what's in the way</h2><ul><li><b>One key works everywhere:</b> the GOV.UK organisation slug. This catalogue joins ${nf(Object.keys(HR.body_org).length)} public bodies to GOV.UK by exact slug, and the organisations register (R3) is keyed the same way.</li>
      <li><b>Three organisation id schemes get in the way:</b> GTI's short keys, ANA's ids and guessed slugs for arm's-length bodies. LIAH records that no map from ANA ids to GOV.UK slugs exists. Until the organisations register publishes one, joins from GTI and ANA must go through their own lookup tables.</li>
      <li><b>Technical debt is held at three levels:</b> scores per organisation in GTI and ANA, assessments per asset in LIAH (illustrative today), and evidence per repository here. The feeds below let the scores point at evidence.</li>
      <li><b>No system identifiers yet:</b> none of GTI, ANA or LIAH names systems or repositories, so links from a repository to a system wait for LIAH to hold real system records.</li>
      <li><b>Not registered:</b> this catalogue has no govukOS identifier. Registering it, and adding that identifier here, is the first step the integration assessment recommends.</li></ul></div>
    ${chartPanel("Code and legacy signals by organisation (the feed's first rows)", `<div class="tbl-wrap"><table><caption class="sr-only">Organisation feed preview</caption><thead><tr><th scope="col">Organisation</th><th scope="col">GOV.UK slug</th><th scope="col" class="n">Repositories</th><th scope="col" class="n">Live</th><th scope="col" class="n">With legacy signals</th><th scope="col" class="n">Gone quiet, still open</th></tr></thead><tbody>${top.map(r => `<tr><td><button type="button" class="linkbtn" data-fam="o${HSLUG[r.slug]}">${esc(r.name)}</button></td><td class="mono small">${esc(r.slug)}</td><td class="n">${nf(r.repos_own)}</td><td class="n">${nf(r.live_own)}</td><td class="n">${nf(r.legacy_own)}</td><td class="n">${nf(r.quiet_open_own)}</td></tr>`).join("")}</tbody></table></div>`, {isNew: true, note: `${nf(feed.length)} organisations in the full feed. Counts are for each organisation's own GitHub accounts; the family figure in the feed adds everything below it.`})}
    <div class="panel"><h2>Feeds for the other apps</h2><p>Open formats, keyed by GOV.UK organisation slug, so GTI, ANA, LIAH and the registers can read them without a new key.</p>
      <div class="btnrow"><button class="btn" type="button" id="os-orgjson">Organisations, JSON (${nf(feed.length)})</button><button class="btn" type="button" id="os-orgcsv">Organisations, CSV</button><button class="btn" type="button" id="os-repojson">Repository legacy signals, JSON</button><button class="btn" type="button" id="os-dcat">Catalogue description, DCAT JSON-LD</button></div>
      <p class="small muted">Inside the page, the same data is available read-only as <span class="mono">window.GHRAC_API</span> (orgs, org(slug), repos, dcat), following the pattern ANA uses for its own interface.</p></div>`;
  const stamp = DATA.meta.ref_date;
  $("#os-orgjson").onclick = () => save(`ghrac-org-code-estate-${stamp}.json`, JSON.stringify(osOrgFeed(), null, 1));
  $("#os-orgcsv").onclick = () => { const L = osOrgFeed(), S = LGS.map(s => s.id); save(`ghrac-org-code-estate-${stamp}.csv`, "﻿" + [["org_slug", "name", "format", "parent_slugs", "repos_own", "repos_family", "live_own", "legacy_own", ...S].map(csvCell).join(","), ...L.map(r => [r.slug, r.name, r.format, r.parent, r.repos_own, r.repos_family, r.live_own, r.legacy_own, ...S.map(s => r.signals[s] || 0)].map(csvCell).join(","))].join("\r\n")); };
  $("#os-repojson").onclick = () => save(`ghrac-repo-legacy-signals-${stamp}.json`, JSON.stringify(osRepoFeed(), null, 1));
  $("#os-dcat").onclick = () => save(`ghrac-dcat-${stamp}.jsonld`, JSON.stringify(osDcat(), null, 1));
};

/* ---------- deep links in and out (govukOS link scheme for this catalogue) ---------- */
function osHash(h) { try { if (location.hash !== "#" + h) history.replaceState(null, "", "#" + h); } catch {} }
const OS_LINKS = {repo: "#repo=<github-account>/<repository>", org: "#org=<GOV.UK organisation slug>", legacy: "#legacy=<GOV.UK organisation slug>", account: "#account=<GitHub account>"};
function osRoute(h) {
  const m = /^(repo|org|legacy|account)=(.+)$/.exec(h || ""); if (!m) return false; let v = m[2]; try { v = decodeURIComponent(v); } catch {}
  if (m[1] === "repo") { if (!XBY[v]) { showTab("discover", "replace"); toast("No project found for " + v); return true; } rxGo(v, "replace"); return true; }
  if (m[1] === "account") { rxDiscover({acct: v}); return true; }
  const oi = HSLUG[v]; if (oi === undefined) { showTab("family", "replace"); toast("No GOV.UK organisation called " + v); return true; }
  if (m[1] === "org") { famGo("o" + oi); return true; }
  Object.assign(LGQ, LGQ0, {org: v, core: false}); if (current === "legacy") RENDER.legacy(); else { showTab("legacy", "replace"); RENDER.legacy(); } osHash("legacy=" + v); return true;
}

/* ---------- organisation crosswalk: GTI and ANA ids to GOV.UK slugs, and links out to the govukOS apps ---------- */
const XW = DATA.crosswalk, XWR = XW.rows.map(r => Object.fromEntries(XW.cols.map((c, i) => [c, r[i]])));
const XW_ANA_DEPT = {}; for (const r of XWR) if (r.app === "ANA" && r.table === "DEPTS" && r.govuk_slug) XW_ANA_DEPT[r.govuk_slug] = r.id;
const XW_GTI = {}; for (const r of XWR) if (r.app === "GTI" && r.table === "GK_ORG" && r.govuk_slug) (XW_GTI[r.govuk_slug] ||= []).push(r.id);
const XW_ANA_BODY = {}; for (const r of XWR) if (r.app === "ANA" && r.table !== "DEPTS" && r.govuk_slug) XW_ANA_BODY[r.govuk_slug] = r.name;
function osElsewhere(oi) {
  if (oi === null || oi === undefined || !HO[oi]) return [];
  const slug = HO[oi].slug, out = []; let dept = XW_ANA_DEPT[slug], via = null;
  if (!dept) { let cur = HO[oi], g = 0; while (cur && cur.p.length && g++ < 12) { cur = HO[cur.p[0]]; if (XW_ANA_DEPT[cur.slug]) { dept = XW_ANA_DEPT[cur.slug]; via = cur.t; break; } } }
  if (dept) out.push({app: "ANA", label: via ? `ANA: ${via}, bodies` : "ANA: technology and legacy", path: "#org=" + encodeURIComponent(dept) + "&tab=" + (via ? "bodies" : "digital"), note: via ? `ANA lists ${XW_ANA_BODY[slug] ? "this body" : "bodies"} under ${via}` : "ANA's legacy and digital view for this department"});
  if (XW_GTI[slug]) out.push({app: "GTI", label: "GTI: technology estate, legacy", path: "#anatech/leg", note: `GTI body id ${XW_GTI[slug].join(", ")}. GTI has no organisation link yet; open its Technology estate screen, Legacy estate tab (#anatech/leg).`});
  out.push({app: "LIAH", label: "LIAH: Legacy Insights Hub", path: "", note: "Asset-level legacy assurance. LIAH doesn't hold organisation records yet."});
  const base = {ANA: XW.links.ana || "", GTI: OS_APPS[0].url, LIAH: XW.links.liah || ""};
  return out.map(l => ({...l, href: base[l.app] ? base[l.app] + l.path : ""}));
}
const osChips = oi => { const e = osElsewhere(oi); return e.length ? `<div class="oslinks"><span class="small muted">Elsewhere in govukOS:</span> ${e.map(l => l.href ? `<a class="rxchip c-violet" href="${esc(l.href)}" data-path="${esc(l.path)}" target="_blank" rel="noopener" data-tip="${esc(l.note)}">${icon("i_ext", 14)} ${esc(l.label)}<span class="sr-only"> (opens in a new tab; ${esc(l.note)})</span></a>` : `<span class="rxchip c-violet" data-path="${esc(l.path)}" data-tip="${esc(l.note)}">${esc(l.label)}${l.path ? ` <span class="mono">${esc(l.path)}</span>` : ""}<span class="sr-only"> (${esc(l.note)})</span></span>`).join(" ")}</div>` : ""; };
const XWQ0 = {app: "", method: "", q: ""}, XWQ = {...XWQ0};
function xwRows(S = XWQ) { const q = S.q.toLowerCase(); return XWR.filter(r => (!S.app || r.app === S.app) && (!S.method || r.method === S.method) && (!q || (r.id + " " + r.name + " " + r.govuk_slug).toLowerCase().includes(q))); }
function xwRefresh() { const L = xwRows(); $("#xw-count").textContent = `${nf(L.length)} of ${nf(XWR.length)} identifiers`;
  $("#xw-list").innerHTML = `<div class="tbl-wrap"><table><caption class="sr-only">Organisation identifiers in GTI and ANA and their GOV.UK slugs</caption><thead><tr><th scope="col">App and table</th><th scope="col">Their id</th><th scope="col">Name in the app</th><th scope="col">GOV.UK slug</th><th scope="col">How it was matched</th></tr></thead><tbody>${L.slice(0, 200).map(r => `<tr><td>${esc(r.app)} <span class="muted small">${esc(r.table)}</span></td><td class="mono small">${esc(r.id)}</td><td>${esc(r.name)}</td><td>${r.govuk_slug ? (HSLUG[r.govuk_slug] !== undefined ? `<button type="button" class="linkbtn mono small" data-fam="o${HSLUG[r.govuk_slug]}">${esc(r.govuk_slug)}</button>` : `<span class="mono small">${esc(r.govuk_slug)}</span>`) : '<span class="muted">none</span>'}</td><td class="small">${esc(r.method)}${r.reason ? `<br><span class="muted">${esc(r.reason)}</span>` : ""}</td></tr>`).join("")}</tbody></table></div>${L.length > 200 ? `<p class="small muted">Showing 200. Narrow the search, or download the full crosswalk.</p>` : ""}`; }
{ const _os = RENDER.govukos; RENDER.govukos = () => { _os(); const v = vb("govukos"); const methods = [...new Set(XWR.map(r => r.method))];
  const sum = Object.entries(XW.summary).map(([t, m]) => ({t, n: Object.values(m).reduce((a, b) => a + b, 0), ok: Object.entries(m).filter(([k]) => !/not on GOV.UK|unresolved|not a GOV.UK/.test(k)).reduce((a, [, b]) => a + b, 0)}));
  v.insertAdjacentHTML("beforeend", `<div class="panel" data-new="1"><h2>The organisation crosswalk</h2><p>The missing piece that stopped the apps joining up: every organisation id GTI and ANA use, matched to its GOV.UK slug. Matches are exact or resolved by hand with a stated reason; nothing is matched on a similar-looking name. Ids with no GOV.UK organisation say why.</p>
      ${rxBars(sum.map(s => ({label: s.t, n: s.ok, ic: "i_link", c: s.ok === s.n ? "green" : "orange"})), "Identifiers matched to a GOV.UK slug, by app and table")}<p class="small muted">${sum.map(s => `${esc(s.t)}: ${nf(s.ok)} of ${nf(s.n)} matched`).join(" · ")}</p>
      <div class="filters"><label for="xw-app">App<select id="xw-app"><option value="">Both</option><option>GTI</option><option>ANA</option></select></label><label for="xw-method">How matched<select id="xw-method"><option value="">Any</option>${methods.map(m => `<option>${esc(m)}</option>`).join("")}</select></label><label class="grow" for="xw-q">Search<input type="search" id="xw-q" placeholder="id, name or slug"></label>
        <button class="btn" type="button" id="xw-csv">Download crosswalk, CSV</button><button class="btn" type="button" id="xw-json">JSON</button></div><p class="count" id="xw-count" aria-live="polite"></p><div id="xw-list"></div></div>
    <div class="panel" data-new="1"><h2>Link scheme</h2><p>Other apps can open this catalogue at a precise place. Each link is checked when the page opens, and an unknown value opens the nearest view with a message instead of failing.</p>
      <ul>${Object.entries(OS_LINKS).map(([k, v]) => `<li><span class="mono">${esc(v)}</span>: ${esc({repo: "a project's plain-English profile", org: "an organisation in the department family tree", legacy: "legacy and debt signals for one organisation", account: "every project in one GitHub account"}[k])}</li>`).join("")}</ul>
      <p class="small muted">Links out use each app's own scheme: ANA <span class="mono">#org=&lt;ANA id&gt;&amp;tab=digital</span> for departments; GTI and LIAH open at their front door, because neither accepts an organisation in its link yet.</p></div>`);
  $("#xw-app").onchange = e => { XWQ.app = e.target.value; xwRefresh(); }; $("#xw-method").onchange = e => { XWQ.method = e.target.value; xwRefresh(); };
  let tq; $("#xw-q").oninput = e => { clearTimeout(tq); tq = setTimeout(() => { XWQ.q = e.target.value; xwRefresh(); }, 160); };
  $("#xw-csv").onclick = () => save(`govukos-org-crosswalk-${DATA.meta.ref_date}.csv`, "﻿" + [XW.cols.map(csvCell).join(","), ...XWR.map(r => XW.cols.map(c => csvCell(r[c])).join(","))].join("\r\n"));
  $("#xw-json").onclick = () => save(`govukos-org-crosswalk-${DATA.meta.ref_date}.json`, JSON.stringify(XWR, null, 1));
  xwRefresh(); }; }
