const RX_TOPIC_IC = Object.fromEntries(TOPICS.map(t => [t.id, ICONS["t_" + t.id] ? "t_" + t.id : "topics"]));

/* ---------- plain words for kinds, status and licences ---------- */
const RXK = {
  "Application or service": {id: "app", w: "A service or app", ic: "k_app", c: "blue", d: "Software that does a job for people, such as an online service or a system staff use."},
  "Website or user-facing service": {id: "web", w: "A website", ic: "k_web", c: "aqua", d: "Pages people visit in a web browser."},
  "API or backend service": {id: "api", w: "A connector between systems", ic: "k_api", c: "violet", d: "Lets computer systems swap information automatically. People don't see it directly."},
  "Data and analysis": {id: "data", w: "Data and analysis", ic: "k_data", c: "green", d: "Code that gathers, cleans or analyses data, or produces statistics."},
  "Library, component or SDK": {id: "lib", w: "Building blocks", ic: "k_lib", c: "red", d: "Ready-made parts that other teams reuse to build their own services."},
  "Tool, script or automation": {id: "tool", w: "A handy tool", ic: "k_tool", c: "orange", d: "A small program that saves people time, often by doing a repetitive job automatically."},
  "Documentation or guidance": {id: "docs", w: "Guidance and documents", ic: "k_docs", c: "magenta", d: "Written guidance, standards or a manual, kept as files."},
  "Infrastructure or platform": {id: "infra", w: "Behind-the-scenes hosting", ic: "k_infra", c: "slate", d: "Sets up the computers and cloud services that other things run on."},
  "Prototype": {id: "proto", w: "An early try-out", ic: "k_proto", c: "yellow", d: "A test version made to try an idea with users before building the real thing."},
  "Unclassified": {id: "unknown", w: "Not sure what kind", ic: "k_unknown", c: "slate", d: "We couldn't tell what kind of thing this is: we haven't read its files, or they don't show it clearly."}};
const RXK_BY = Object.fromEntries(Object.entries(RXK).map(([k, v]) => [v.id, {...v, type: k}]));
const rxKind = x => RXK[TYPE_OF(x.key)] || RXK.Unclassified;
const RXS = {
  "Active": {w: "Being worked on", ic: "s_active", c: "green", d: "A person changed it in the last 90 days."},
  "Maintained": {w: "Looked after", ic: "s_kept", c: "green", d: "A person changed it in the last year, but not in the last 90 days."},
  "Recently pushed": {w: "Changed this year", ic: "s_recent", c: "blue", d: "The public listing shows a change in the last year. We haven't checked who made it."},
  "Automated only": {w: "Updated by robots only", ic: "s_robot", c: "aqua", d: "Changes in the last year were all made by automated tools, not people."},
  "Dormant": {w: "Resting", ic: "s_rest", c: "yellow", d: "No person has changed it for 1 to 2 years."},
  "Inactive": {w: "Gone quiet", ic: "s_quiet", c: "orange", d: "No person has changed it for more than 2 years."},
  "Archived": {w: "Retired", ic: "s_retired", c: "slate", d: "Its owner has closed it. You can still read it, but it won't change."},
  "Empty": {w: "Empty", ic: "s_empty", c: "slate", d: "It has no files yet."},
  "Unverified": {w: "Not checked", ic: "s_unknown", c: "slate", d: "We couldn't check its activity."},
  "Not publicly visible": {w: "Private", ic: "s_lock", c: "slate", d: "It's named in our records, but GitHub doesn't show it to the public."}};
const rxStat = x => RXS[x.st] || RXS.Unverified;
const RX_LIC = {M: "Free to reuse, even commercially, as long as the copyright notice is kept (MIT licence).", O: "Free to reuse under the Open Government Licence, as long as you credit the source.",
  A: "Free to reuse, even commercially, with a notice of any changes (Apache licence).", G: "Free to reuse. If you share a changed version, it must use the same licence (GPL family).",
  P: "Free to reuse. Changes to its own files must be shared under the same licence (Mozilla licence).", U: "Given to the public domain: reuse it any way you like (Unlicense).",
  B: "Free to reuse, even commercially, as long as the copyright notice is kept (BSD licence).", C: "A Creative Commons licence. What you can do depends on which version it is: check the licence file.",
  X: "Has a licence we don't recognise. Check its terms before reusing it.", "-": "No licence found. Without one, you'd need to ask the owner before reusing it.", "": "Not known: the public listing doesn't say."};
const RX_REUSE = new Set(["M", "O", "A", "G", "P", "U", "B"]);
const RX_CARE = [["readme", "Instructions to get started", "c_readme"], ["owners", "Named people responsible", "c_owner"], ["secmd", "A way to report security problems", "c_shield"],
  ["ci", "Automatic checks on every change", "s_robot"], ["deps", "Keeps its building blocks up to date", "c_refresh"], ["tests", "Tests that check it works", "c_flask"], ["licence", "A licence saying how it can be reused", "c_scale"]];
const rxCare = x => PRC.masks[x.key] === undefined ? null : RX_CARE.map(([p, w, ic]) => ({p, w, ic, ok: hasP(x.key, p)}));
const rxCareN = x => { const c = rxCare(x); return c ? c.filter(i => i.ok).length : -1; };

/* ---------- names, jargon and everyday search words ---------- */
const RX_ACR = {govuk: "GOV.UK", api: "API", apis: "APIs", nhs: "NHS", uk: "UK", hmrc: "HMRC", dwp: "DWP", ons: "ONS", aws: "AWS", gds: "GDS", ai: "AI", ui: "UI", ux: "UX", sdk: "SDK", cli: "CLI",
  csv: "CSV", json: "JSON", gcp: "GCP", moj: "MoJ", dfe: "DfE", defra: "Defra", cddo: "CDDO", llm: "LLM", sql: "SQL", etl: "ETL", url: "URL", html: "HTML", css: "CSS", pdf: "PDF", dvla: "DVLA", ocr: "OCR", gis: "GIS", ci: "CI", id: "ID", dgu: "DGU", paas: "PaaS", ml: "ML"};
function rxName(n) {
  const s = String(n || "").replace(/gov[ ._-]?uk/gi, " govuk ").replace(/([a-z0-9])([A-Z])/g, "$1 $2").replace(/[-_.\/]+/g, " ").replace(/\s+/g, " ").trim();
  if (!s) return "Untitled project";
  const w = s.split(" ").map(t => RX_ACR[t.toLowerCase()] || t.toLowerCase());
  w[0] = w[0].charAt(0).toUpperCase() + w[0].slice(1); return w.join(" ");
}
const RX_JARGON = [["API", "\\bapis?\\b", "A way for computer systems to ask each other for information automatically."], ["SDK", "\\bsdks?\\b", "A kit of ready-made code that helps developers use a service."],
  ["Terraform", "\\bterraform\\b", "A tool that sets up cloud computers and services from written instructions."], ["Kubernetes", "\\b(?:kubernetes|k8s)\\b", "A system that runs and manages many copies of software in the cloud."],
  ["Docker", "\\bdocker\\b", "A way to package software so it runs the same on any computer."], ["Container", "\\bcontainers?\\b", "Software packaged with everything it needs to run, so it works the same anywhere."],
  ["Microservice", "\\bmicro-?services?\\b", "A small piece of a bigger system that does one job."], ["Repository", "\\b(?:repository|repositories|repos?)\\b", "A project's folder of code and files on GitHub, with its full history."],
  ["Fork", "\\bfork(?:ed|s)?\\b", "A copy of someone else's project, made so it can be changed separately."], ["Pipeline", "\\bpipelines?\\b", "A set of steps that runs automatically, one after another, such as moving and cleaning data."],
  ["ETL", "\\betl\\b", "Extract, transform, load: copying data from one place, tidying it and loading it somewhere else."], ["Schema", "\\bschemas?\\b", "The agreed shape of some data: which fields it has and what each one means."],
  ["Front end", "\\bfront[- ]?end\\b", "The part of a service people see and use in their browser."], ["Back end", "\\bback[- ]?end\\b", "The part of a service that runs behind the scenes, out of sight."],
  ["Library", "\\blibrar(?:y|ies)\\b", "Ready-made code other projects can reuse."], ["CLI", "\\bcli\\b", "A command-line tool: a program you run by typing commands."],
  ["AWS", "\\baws\\b", "Amazon Web Services, a cloud provider that rents out computers and storage."], ["Azure", "\\bazure\\b", "Microsoft's cloud service."], ["GCP", "\\bgcp\\b", "Google Cloud, Google's cloud service."],
  ["Lambda", "\\blambdas?\\b", "Small bits of code that run in the cloud only when needed."], ["Serverless", "\\bserverless\\b", "Running code in the cloud without managing your own servers."],
  ["Webhook", "\\bwebhooks?\\b", "An automatic message one system sends another when something happens."], ["Endpoint", "\\bendpoints?\\b", "An address an API answers on."],
  ["OAuth", "\\boauth2?\\b", "A standard way to let people sign in or give an app permission without sharing their password."], ["Authentication", "\\bauth(?:entication)?\\b", "Checking that someone is who they say they are, usually by signing in."],
  ["JSON", "\\bjson\\b", "A common text format for exchanging data between systems."], ["CSV", "\\bcsv\\b", "A simple spreadsheet file with values separated by commas."], ["YAML", "\\bya?ml\\b", "A text format for settings files."],
  ["Python", "\\bpython\\b", "A popular programming language, often used for data."], ["Ruby", "\\bruby\\b|\\brails\\b", "A programming language (Rails is a toolkit for building websites with it)."],
  ["JavaScript", "\\bjavascript\\b|\\bnode(?:\\.js|js)?\\b|\\breact\\b", "The programming language web browsers run (Node and React are tools built on it)."], ["TypeScript", "\\btypescript\\b", "JavaScript with extra checks that catch mistakes early."],
  ["Java", "\\bjava\\b", "A long-established programming language used in many large systems."], ["Prototype", "\\bprototypes?\\b|\\bprototyping\\b", "An early, rough version made to test an idea."],
  ["Dependabot", "\\bdependabot\\b|\\brenovate\\b", "Robots that suggest updates to the building blocks a project uses."], ["Linting", "\\blint(?:er|ing)?\\b", "Automatic checks that code follows agreed style rules."],
  ["Open source", "\\bopen[- ]source\\b", "Code anyone can read, reuse and improve."], ["LLM", "\\bllms?\\b|\\blarge language models?\\b", "An AI system trained on lots of text that can write and answer questions."],
  ["Machine learning", "\\bmachine learning\\b|\\bml\\b", "Computers learning patterns from data instead of following fixed rules."], ["Metadata", "\\bmetadata\\b", "Data that describes other data, such as who made it, when and what it means."],
  ["CKAN", "\\bckan\\b", "Open source software for running data portals, such as data.gov.uk."], ["GitHub Pages", "\\bgithub pages\\b|\\bgh-pages\\b", "Free website hosting straight from a GitHub project."],
  ["Static site", "\\bstatic (?:site|website)s?\\b", "A website made of fixed pages, which makes it fast and simple to host."], ["Helm", "\\bhelm\\b", "A tool for installing software onto Kubernetes."], ["CI", "\\bci\\b|\\bcontinuous integration\\b", "Automatic checks that run whenever someone changes the code."]];
const RX_JRX = RX_JARGON.map(([t, r, d]) => [t, new RegExp(r, "i"), d]);
const rxJargon = text => { const s = String(text || ""); return RX_JRX.filter(([, r]) => r.test(s)).map(([t, , d]) => ({t, d})); };
const RX_SYN = {payment: ["pay", "payments", "billing", "invoice"], pay: ["payment", "billing"], "sign in": ["login", "log in", "one login", "sign-in", "signin", "authentication", "identity"], login: ["sign in", "one login", "authentication"],
  form: ["forms", "form builder"], map: ["maps", "geospatial", "gis", "mapping", "address", "geo"], address: ["postcode", "addressbase", "uprn"], benefit: ["dwp", "universal credit", "welfare", "pension"],
  tax: ["hmrc", "vat", "customs", "duty"], school: ["education", "pupil", "teacher", "dfe"], doctor: ["nhs", "gp", "health", "patient"], hospital: ["nhs", "patient", "trust"], job: ["employment", "vacancy", "careers", "recruitment"],
  weather: ["met office", "forecast", "climate"], police: ["policing", "crime", "justice"], court: ["justice", "tribunal", "hmcts"], email: ["notify", "notification", "sms"], text: ["sms", "notify"],
  website: ["site", "frontend", "web", "pages"], data: ["dataset", "statistics", "open data", "pipeline"], statistic: ["stats", "ons", "census"], ai: ["artificial intelligence", "machine learning", "llm", "gpt"],
  security: ["cyber", "vulnerability", "secure"], accessibility: ["a11y", "wcag", "screen reader"], design: ["design system", "component", "prototype"], money: ["finance", "budget", "spend", "pay"],
  housing: ["homes", "planning", "property", "land"], transport: ["roads", "rail", "travel", "vehicle", "dvla"], farming: ["agriculture", "rural", "defra"], environment: ["climate", "flood", "nature", "air quality"]};
function rxTerms(q) {
  let s = String(q || "").toLowerCase().trim(); if (!s) return []; const out = [];
  for (const ph of Object.keys(RX_SYN).filter(k => k.includes(" "))) if (s.includes(ph)) { out.push([ph, ...RX_SYN[ph]]); s = s.replace(ph, " "); }
  for (const t of s.split(/\s+/).filter(Boolean)) { const k = RX_SYN[t] ? t : RX_SYN[t.replace(/s$/, "")] ? t.replace(/s$/, "") : null; out.push(k ? [t, k, ...RX_SYN[k]].filter((v, i, a) => a.indexOf(v) === i) : [t]); }
  return out;
}
const rxMatch = (x, terms) => terms.every(alts => alts.some(a => x.q.includes(a)));

/* ---------- small UI pieces ---------- */
const rxBadge = (s, big) => `<span class="rxbadge c-${s.c}${big ? " big" : ""}" data-tip="${esc(s.d)}">${icon(s.ic, big ? 18 : 15)}<span>${esc(s.w)}</span></span>`;
const rxTile = (k, sz = 26, cls = "") => `<span class="rxtile c-${k.c} ${cls}" aria-hidden="true">${icon(k.ic, sz)}</span>`;
const rxAgo = ep => { if (!ep) return "date not known"; const d = (XREF_EPOCH - ep) / 86400; if (d < 1) return "today"; if (d < 31) return Math.round(d) + " days ago"; const m = Math.round(d / 30.44); if (m < 12) return m + (m === 1 ? " month ago" : " months ago"); const y = Math.round(d / 365.25 * 10) / 10; return (y >= 2 ? Math.round(y) : y) + (y === 1 ? " year ago" : " years ago"); };
const rxSummary = x => { const d = (x.d || x.ld || "").trim(); if (d) return {t: d, auto: false};
  const k = rxKind(x), s = rxStat(x); return {t: `${k.id === "unknown" ? "A project" : k.w} published by ${orgName(x.org)}. It's ${s.w.toLowerCase()}, and was last changed ${rxAgo(lastAct(x))}.`, auto: true}; };
const rxNm = x => x._nm || (x._nm = rxName(x.n));
const rxShort = x => { const s = rxSummary(x); return s.t.length > 150 ? s.t.slice(0, 147).replace(/\s+\S*$/, "") + "…" : s.t; };
const rxTopicsOf = x => { const tb = topicBits(x); return TOPICS.filter((t, i) => tb[i]); };
const rxTopicIcons = x => rxTopicsOf(x).slice(0, 3).map(t => `<span class="rxti c-${t.c}" data-tip="${esc(t.label)}">${icon(RX_TOPIC_IC[t.id], 14)}<span class="sr-only">${esc(t.label)}</span></span>`).join("");
function rxCard(x) { const k = rxKind(x), s = rxStat(x), sm = rxSummary(x);
  return `<article class="rxcard c-${k.c}"><div class="rxc-top">${rxTile(k)}<div class="rxc-head"><h3 class="rxc-h"><button type="button" class="rxopen" data-rx="${esc(x.key)}">${esc(rxName(x.n))}</button></h3><p class="rxc-pub">${icon("i_building", 14)} ${esc(orgName(x.org))}</p></div></div>
    <p class="rxc-sum">${esc(rxShort(x))}${sm.auto ? ' <span class="rxauto">automatic</span>' : ""}</p><div class="rxc-foot">${rxBadge(s)}${lgBadge(x)}<span class="rxkind">${esc(k.w)}</span><span class="rxtis">${rxTopicIcons(x)}</span></div></article>`; }
const rxBars = (rows, label) => { const mx = Math.max(1, ...rows.map(r => r.n)); return `<ul class="rxbars" aria-label="${esc(label)}">${rows.map(r => `<li>${r.btn ? `<button type="button" class="rxbar-b" ${r.btn}>` : "<span class='rxbar-b'>"}<span class="rxtile sm c-${r.c}" aria-hidden="true">${icon(r.ic, 16)}</span><span class="rxbar-l">${esc(r.label)}</span><span class="rxbar-t"><span class="rxbar-f c-${r.c}" style="width:${(r.n / mx * 100).toFixed(1)}%"></span></span><span class="rxbar-n">${nf(r.n)}</span>${r.btn ? "</button>" : "</span>"}</li>`).join("")}</ul>`; };

/* ---------- organisation hierarchy: GOV.UK organisations, GitHub accounts and GDS units ---------- */
const HR = DATA.hier, HO = HR.orgs.map((o, i) => ({i, slug: o[0], t: o[1], ab: o[2], f: o[3], st: o[4], p: o[5], sup: o[6], by: o[7]}));
const HSLUG = Object.fromEntries(HO.map(o => [o.slug, o.i])), GDS_HI = HSLUG["government-digital-service"];
const HKIDS = HO.map(() => []); HO.forEach(o => o.p.forEach(p => HKIDS[p].push(o.i)));
const rxOrgOf = x => { const b = XO[x.oi]?.body; if (b !== undefined && b >= 0 && HR.body_org[b] !== undefined) return HR.body_org[b]; return GDS_ACCTS.includes(x.org) && GDS_HI !== undefined ? GDS_HI : null; };
const RX_GOWN = Object.fromEntries(GOWN.map(r => [r.key, r.a]));
/* nodes: "o<i>" GOV.UK organisation, "a<account>" GitHub account, "u<area>" GDS unit; records sit only on account and unit nodes */
let _fam = null;
function famIndex() {
  if (_fam) return _fam; const N = {}, recs = {};
  const node = (id, o) => N[id] || (N[id] = {id, kids: [], parents: [], recs: [], ...o});
  HO.forEach(o => node("o" + o.i, {kind: "org", label: o.t, o}));
  HO.forEach(o => o.p.forEach(p => { N["o" + p].kids.push("o" + o.i); N["o" + o.i].parents.push("o" + p); }));
  for (const x of ALL) { const oi = rxOrgOf(x); if (oi === null) continue; let id;
    if (oi === GDS_HI) { const a = RX_GOWN[x.key] || "none"; id = "u" + a; node(id, {kind: "unit", label: a === "none" ? "Not assigned to a GDS area" : (GA[a]?.unit || GA[a]?.label || a), area: a}); }
    else { id = "a" + x.org; node(id, {kind: "acct", label: x.org}); }
    const n = N[id]; if (!n.parents.length) { n.parents.push("o" + oi); N["o" + oi].kids.push(id); } n.recs.push(x); recs[x.key] = id; }
  const sub = {}; const tot = id => { if (id in sub) return sub[id]; sub[id] = 0; const n = N[id]; return (sub[id] = n.recs.length + n.kids.reduce((a, k) => a + tot(k), 0)); };
  Object.keys(N).forEach(tot);
  const roots = HO.filter(o => !o.p.length && sub["o" + o.i] > 0).map(o => "o" + o.i).sort((a, b) => sub[b] - sub[a]);
  return (_fam = {N, sub, recs, roots});
}
const famPath = id => { const {N} = famIndex(), path = [id]; let cur = N[id], guard = 0; while (cur && cur.parents.length && guard++ < 20) { path.unshift(cur.parents[0]); cur = N[cur.parents[0]]; } return path; };
const FMT_IC = f => /ministerial department/i.test(f) ? "i_crown" : /department/i.test(f) ? "i_crown" : /agency|public body|corporation|tribunal|court/i.test(f) ? "i_building" : "orgs";
const famIcon = n => n.kind === "acct" ? "i_account" : n.kind === "unit" ? "i_users" : FMT_IC(n.o.f);
const famHue = n => n.kind === "acct" ? "aqua" : n.kind === "unit" ? "violet" : /ministerial department/i.test(n.o.f) ? "blue" : /non-ministerial/i.test(n.o.f) ? "magenta" : /agency/i.test(n.o.f) ? "orange" : /non-departmental/i.test(n.o.f) ? "green" : "slate";
const famLabel = n => n.kind === "acct" ? "GitHub account: " + n.label : n.kind === "unit" ? "GDS area: " + n.label : n.label + (n.o.ab && n.o.ab !== n.label ? " (" + n.o.ab + ")" : "");
const famKind = n => n.kind === "acct" ? "GitHub account" : n.kind === "unit" ? "Unit within GDS (assessed)" : (n.o.f || "Organisation") + (n.o.st === "closed" ? " · closed" : "");

/* the ladder for one repository, from the repository up to the top-level organisation */
function rxLadder(x) {
  const {N, recs} = famIndex(), leaf = recs[x.key], rungs = [{id: "repo", label: rxName(x.n), sub: x.key, ic: rxKind(x).ic, c: rxKind(x).c, kind: "This project"}];
  if (leaf) for (const id of famPath(leaf).reverse()) { const n = N[id]; rungs.push({id, label: famLabel(n), sub: famKind(n), ic: famIcon(n), c: famHue(n), kind: n.kind, n}); }
  else { const b = bodyOf(x); rungs.push({id: "a:" + x.org, label: "GitHub account: " + x.org, sub: "GitHub account", ic: "i_account", c: "aqua", kind: "acct"});
    if (b) { rungs.push({id: "b", label: b.name, sub: b.type || "Public body", ic: "i_building", c: "orange", kind: "body"}); const bi = XO[x.oi]?.body; const g = HR.body_grp[bi]; if (g) rungs.push({id: "g", label: g, sub: "Grouping by type, not a sponsor: GOV.UK doesn't list this body", ic: "topics", c: "slate", kind: "group"}); }
    else rungs.push({id: "nb", label: "Not matched to a public body", sub: "This GitHub account isn't linked to a public body in our sources", ic: "s_unknown", c: "slate", kind: "none"}); }
  return rungs;
}

/* ---------- Explore repos (gallery) ---------- */
const RXD0 = {topic: "", q: "", kind: "", live: false, sector: "", reuse: false, legacy: false, acct: "", sort: "recent", group: "", n: 24}, RXD = {...RXD0};
const rxFiltered = (S = RXD) => { const terms = rxTerms(S.q); return ALL.filter(x => (!S.topic || topicHit(S.topic, x)) && (!S.kind || rxKind(x).id === S.kind) && (!S.live || live(x)) && (!S.sector || x.sector === S.sector) && (!S.reuse || RX_REUSE.has(x.li)) && (!S.acct || x.org === S.acct) && (!S.legacy || lgCore(x).length > 0) && (!terms.length || rxMatch(x, terms))); };
const RX_SORT = {recent: [(a, b) => lastAct(b) - lastAct(a), "Most recently changed"], az: [(a, b) => rxNm(a).localeCompare(rxNm(b)), "Name, A to Z"],
  stars: [(a, b) => (b.sg || 0) - (a.sg || 0), "Most starred"], care: [(a, b) => rxCareN(b) - rxCareN(a) || lastAct(b) - lastAct(a), "Best looked after"]};
const RX_GROUP = {"": ["Don't group", null], kind: ["What kind of thing", x => rxKind(x).w], status: ["Is it still being worked on", x => rxStat(x).w], sector: ["Sector", x => x.sector || "Other"]};
RENDER.discover = () => {
  const ts = topicStats();
  vb("discover").innerHTML = `<section class="rxhero2 panel" data-new="1" aria-labelledby="rxd-h"><div class="rxh-text"><div class="eyebrow">Explore repos · plain English</div><h2 id="rxd-h">What has the public sector built?</h2>
      <p class="lede">Every public code project in this catalogue, explained without jargon. Pick something you're interested in, or search in your own words. Open any project for its story: what it does, who looks after it, where it belongs and how it connects.</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(ALL.length)}</b> projects</span><span>${icon("i_building", 16)} <b>${nf(new Set(ALL.map(x => x.org)).size)}</b> GitHub accounts</span><span>${icon("s_active", 16)} <b>${nf(ALL.filter(live).length)}</b> being worked on or looked after</span></p></div>
      <div class="rxh-art" aria-hidden="true">${["k_web", "k_api", "k_data", "k_lib", "k_app", "k_docs", "k_proto", "k_tool", "k_infra"].map((k, i) => `<span class="rxtile lg c-${["aqua", "violet", "green", "red", "blue", "magenta", "yellow", "orange", "slate"][i]}">${icon(k, 30)}</span>`).join("")}</div></section>
    <div class="panel"><h2>1. What are you interested in?</h2><p class="muted small">Choose a topic. Choose it again to clear it.</p>
      <div class="rxtopics" role="group" aria-label="Topics">${[{id: "", label: "Everything", c: "slate"}, ...TOPICS].map(t => `<button type="button" class="rxtopic c-${t.c}" data-rxtopic="${t.id}" aria-pressed="${RXD.topic === t.id}"><span class="rxtile c-${t.c}" aria-hidden="true">${icon(t.id ? RX_TOPIC_IC[t.id] : "discover", 22)}</span><span class="rxt-l">${esc(t.label)}</span><span class="rxt-n">${nf(t.id ? ts[t.id].n : ALL.length)}</span></button>`).join("")}</div></div>
    <div class="panel"><h2>2. Search in everyday words</h2>
      <div class="filters"><label class="grow" for="rx-q">Search<input type="search" id="rx-q" placeholder="for example: payments, maps, schools, sign in" value="${esc(RXD.q)}"></label>
        <label for="rx-kind">What kind of thing<select id="rx-kind"><option value="">Any kind</option>${Object.values(RXK).map(k => `<option value="${k.id}"${RXD.kind === k.id ? " selected" : ""}>${esc(k.w)}</option>`).join("")}</select></label>
        <label for="rx-sector">Who publishes it<select id="rx-sector"><option value="">Anyone</option>${SECTORS.map(s => `<option${RXD.sector === s ? " selected" : ""}>${esc(s)}</option>`).join("")}</select></label>
        <label for="rx-sort">Sort by<select id="rx-sort">${Object.entries(RX_SORT).map(([k, v]) => `<option value="${k}"${RXD.sort === k ? " selected" : ""}>${esc(v[1])}</option>`).join("")}</select></label>
        <label for="rx-group">Group by<select id="rx-group">${Object.entries(RX_GROUP).map(([k, v]) => `<option value="${k}"${RXD.group === k ? " selected" : ""}>${esc(v[0])}</option>`).join("")}</select></label>
        <label class="rxcheck" for="rx-live"><input type="checkbox" id="rx-live"${RXD.live ? " checked" : ""}> Being worked on or looked after</label>
        <label class="rxcheck" for="rx-reuse"><input type="checkbox" id="rx-reuse"${RXD.reuse ? " checked" : ""}> Has an open licence</label>
        <label class="rxcheck" for="rx-legacy"><input type="checkbox" id="rx-legacy"${RXD.legacy ? " checked" : ""}> Has legacy signals</label>
        <button class="btn" type="button" id="rx-reset">Start again</button></div><p class="small muted" id="rx-syn" aria-live="polite"></p><div id="rx-chips" class="chips"></div></div>
    <div class="rxsplit"><div class="panel"><h2>What kinds of things are here</h2><div id="rx-kinds"></div></div><div class="panel"><h2>Are they still being worked on?</h2><div id="rx-stats"></div></div></div>
    <div class="panel"><h2>3. Projects</h2><p class="count" id="rx-count" aria-live="polite"></p><div id="rx-res"></div></div>
    <div class="panel"><h2>How this view works</h2><ul class="small"><li>Descriptions come from GitHub. Where a project has none, the summary is written automatically from its facts and marked <span class="rxauto">automatic</span>.</li>
      <li>"What kind of thing" comes from the project's files. Half the catalogue hasn't had its files read, so it shows as "Not sure what kind".</li><li>Topics come from words in the name, description and README, so a few will be wrong.</li>
      <li>Everyday words are expanded with a small thesaurus, shown under the search box, so "payments" also finds "pay" and "billing".</li></ul></div>`;
  const v = vb("discover");
  $$("[data-rxtopic]", v).forEach(b => b.onclick = () => { RXD.topic = RXD.topic === b.dataset.rxtopic ? "" : b.dataset.rxtopic; RXD.n = 24; $$("[data-rxtopic]", v).forEach(c => c.setAttribute("aria-pressed", String(c.dataset.rxtopic === RXD.topic))); rxRefresh(); });
  let tq; $("#rx-q").oninput = e => { clearTimeout(tq); tq = setTimeout(() => { RXD.q = e.target.value; RXD.n = 24; rxRefresh(); }, 160); };
  for (const [id, k] of [["rx-kind", "kind"], ["rx-sector", "sector"], ["rx-sort", "sort"], ["rx-group", "group"]]) $("#" + id).onchange = e => { RXD[k] = e.target.value; RXD.n = 24; rxRefresh(); };
  $("#rx-live").onchange = e => { RXD.live = e.target.checked; rxRefresh(); }; $("#rx-reuse").onchange = e => { RXD.reuse = e.target.checked; rxRefresh(); }; $("#rx-legacy").onchange = e => { RXD.legacy = e.target.checked; rxRefresh(); };
  $("#rx-reset").onclick = () => { Object.assign(RXD, RXD0); RENDER.discover(); };
  rxRefresh();
};
function rxRefresh() {
  const L = rxFiltered(), terms = rxTerms(RXD.q), v = vb("discover");
  $("#rx-syn").textContent = terms.some(t => t.length > 1) ? "Also looking for: " + terms.filter(t => t.length > 1).map(t => t.slice(1).join(", ")).join("; ") : "";
  const chips = []; if (RXD.topic) chips.push(["topic", "Topic: " + TOPIC_BY[RXD.topic].label]); if (RXD.acct) chips.push(["acct", "GitHub account: " + RXD.acct]); if (RXD.kind) chips.push(["kind", "Kind: " + RXK_BY[RXD.kind].w]);
  if (RXD.sector) chips.push(["sector", "Publisher: " + RXD.sector]); if (RXD.live) chips.push(["live", "Being worked on or looked after"]); if (RXD.reuse) chips.push(["reuse", "Has an open licence"]); if (RXD.legacy) chips.push(["legacy", "Has legacy signals"]);
  $("#rx-chips").innerHTML = chips.map(([k, l]) => `<button type="button" class="chip xchip" data-rxun="${k}">${esc(l)} <span aria-hidden="true">×</span><span class="sr-only"> remove this filter</span></button>`).join(" ");
  $$("[data-rxun]", v).forEach(b => b.onclick = () => { const k = b.dataset.rxun; RXD[k] = RXD0[k]; RENDER.discover(); });
  const kc = {}, sc = {}; for (const x of L) { const k = rxKind(x).id; kc[k] = (kc[k] || 0) + 1; const s = x.st in RXS ? x.st : "Unverified"; sc[s] = (sc[s] || 0) + 1; }
  $("#rx-kinds").innerHTML = rxBars(Object.entries(kc).sort((a, b) => b[1] - a[1]).map(([k, n]) => ({label: RXK_BY[k].w, n, ic: RXK_BY[k].ic, c: RXK_BY[k].c, btn: `data-rxkind="${k}" aria-pressed="${RXD.kind === k}"`})), "Projects by kind of thing; select one to filter");
  $("#rx-stats").innerHTML = rxBars(Object.keys(RXS).filter(s => sc[s]).map(s => ({label: RXS[s].w, n: sc[s], ic: RXS[s].ic, c: RXS[s].c})), "Projects by whether they are still being worked on");
  $$("[data-rxkind]", v).forEach(b => b.onclick = () => { RXD.kind = RXD.kind === b.dataset.rxkind ? "" : b.dataset.rxkind; $("#rx-kind").value = RXD.kind; RXD.n = 24; rxRefresh(); });
  $("#rx-count").textContent = `${nf(L.length)} ${L.length === 1 ? "project matches" : "projects match"}`;
  const srt = [...L].sort(RX_SORT[RXD.sort]?.[0] || RX_SORT.recent[0]), gf = RX_GROUP[RXD.group]?.[1];
  let html = "";
  if (!L.length) html = `<div class="rxempty">${icon("find", 36)}<p><b>Nothing matches yet.</b> Try fewer words, a different topic, or <button type="button" class="linkbtn" id="rx-clear">start again</button>.</p></div>`;
  else if (gf) { const g = {}; for (const x of srt) (g[gf(x)] ||= []).push(x);
    html = Object.entries(g).sort((a, b) => b[1].length - a[1].length).map(([k, xs]) => `<section class="rxgroup"><h3 class="drawer-h">${esc(k)} <span class="muted">(${nf(xs.length)})</span></h3><div class="rxgrid">${xs.slice(0, 8).map(rxCard).join("")}</div>${xs.length > 8 ? `<p class="small muted">Showing 8 of ${nf(xs.length)}. Narrow the search or turn grouping off to see more.</p>` : ""}</section>`).join(""); }
  else html = `<div class="rxgrid">${srt.slice(0, RXD.n).map(rxCard).join("")}</div>${L.length > RXD.n ? `<p><button class="btn" type="button" id="rx-more">Show ${nf(Math.min(24, L.length - RXD.n))} more of ${nf(L.length - RXD.n)}</button></p>` : ""}`;
  $("#rx-res").innerHTML = html;
  $("#rx-more") && ($("#rx-more").onclick = () => { RXD.n += 24; rxRefresh(); }); $("#rx-clear") && ($("#rx-clear").onclick = () => { Object.assign(RXD, RXD0); RENDER.discover(); });
  try { buildDrawer("discover"); } catch {}
}
const rxDiscover = patch => { Object.assign(RXD, RXD0, patch); if (current === "discover") RENDER.discover(); else { showTab("discover"); RENDER.discover(); } };

/* ---------- Repo profile ---------- */
const RXP = {key: null, level: (() => { let v = null; try { v = localStorage.getItem("ghrac-level"); } catch {} return ["simple", "standard", "technical"].includes(v) ? v : "standard"; })()};
const rxDefaultKey = () => { const c = ALL.filter(x => live(x) && x.d && PRC.masks[x.key] !== undefined).sort((a, b) => rxCareN(b) - rxCareN(a) || (b.sg || 0) - (a.sg || 0)); return (c[0] || ALL[0]).key; };
function rxSimilar(x, n = 6) {
  const tb = topicBits(x), k = rxKind(x).id, out = [];
  if (!tb.some(Boolean)) return ALL.filter(y => y.org === x.org && y.key !== x.key).sort((a, b) => lastAct(b) - lastAct(a)).slice(0, n).map(y => ({x: y, why: ["same publisher"]}));
  for (const y of ALL) { if (y.key === x.key) continue; const yb = topicBits(y); let sh = 0; for (let i = 0; i < tb.length; i++) if (tb[i] && yb[i]) sh++; if (!sh) continue;
    const sc = sh * 2 + (y.org === x.org ? 1 : 0) + (live(y) ? 1 : 0) + (rxKind(y).id === k && k !== "unknown" ? 1 : 0); out.push([sc, lastAct(y), y, sh]); }
  return out.sort((a, b) => b[0] - a[0] || b[1] - a[1]).slice(0, n).map(([, , y, sh]) => ({x: y, why: [sh + (sh === 1 ? " shared topic" : " shared topics"), y.org === x.org ? "same publisher" : "", live(y) ? "worked on or looked after" : ""].filter(Boolean)}));
}
function rxTrace(x) {
  const T = [], src = new Set(["GitHub listing"]), topicEv = rxTopicsOf(x).map(t => { const m = x.q.match(t.rx); return {t, m: m ? m[0] : ""}; });
  T.push(["Description", x.d ? "From GitHub" : x.ld ? "From the README" : "None, so the summary was written from the facts", x.d || x.ld || "—", x.d ? "GitHub listing" : x.ld ? "README" : "This portal"]);
  T.push(["Is it still being worked on?", rxStat(x).w, `Status ${x.st}; basis: ${x.basis}; last change by a person ${x.lh ? fmtD(x.lh) : "not checked"}`, String(x.basis).startsWith("git") ? "git history" : "GitHub listing"]);
  if (String(x.basis).startsWith("git")) src.add("git history");
