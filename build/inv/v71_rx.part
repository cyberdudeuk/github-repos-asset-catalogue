  const tops = rxTopicsOf(x), hasSpeech = typeof window.speechSynthesis !== "undefined" && typeof window.SpeechSynthesisUtterance !== "undefined";
  const about = [...tops.map(t => `<button type="button" class="rxchip c-${t.c}" data-rxgotopic="${t.id}">${icon(RX_TOPIC_IC[t.id], 16)} ${esc(t.label)}</button>`),
    ...(tr.dm ? [...new Set(tr.dm.caps.map(c => c.a))].map(a => `<button type="button" class="rxchip c-${AREA_C[a] || "slate"}" data-rxdama="${a}">${icon("wheel", 16)} ${esc(DAREA[a]?.label || "Data management")}</button>`) : []),
    ...(tr.ga ? [`<button type="button" class="rxchip c-violet" data-rxgds="${tr.ga}">${icon("i_users", 16)} GDS: ${esc(GA[tr.ga]?.label || "other")}</button>`] : []),
    ...(tr.ap ? [`<span class="rxchip c-violet">${icon("i_plug", 16)} ${esc(tr.ap.kind)}</span>`] : []), ...(tr.od ? [`<span class="rxchip c-green">${icon("k_data", 16)} Open data</span>`] : []),
    ...x.tags.map(t => `<span class="rxchip c-blue">${icon("i_star", 16)} ${esc(STRAT[t]?.label || t)}</span>`),
    ...(typeof thSigs === "function" ? [...new Map(thSigs(x).map(s => [s.c.id, s])).values()].map(s => `<button type="button" class="rxchip c-${TH_META[s.c.theme][2]}" data-thgo="${esc(s.c.theme)}|${esc(s.c.id)}">${icon(TH_META[s.c.theme][1], 16)} ${esc(s.c.label)}</button>`) : []),
    ...(typeof TH_ALLY !== "undefined" && TH_ALLY.has(x.key) ? [`<span class="rxchip c-orange">${icon("i_link", 16)} UK alliance or partner</span>`] : [])];
  const glance = [["Is it still being worked on?", s.ic, s.c, s.w, `${s.d} Last changed ${rxAgo(lastAct(x))}.`], ["What kind of thing is it?", k.ic, k.c, k.w, k.d],
    ["Who publishes it?", "i_building", "orange", b ? b.name : orgName(x.org), b ? (b.type || "Public body") + " · GitHub account " + x.org : "GitHub account " + x.org],
