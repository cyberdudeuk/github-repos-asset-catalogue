  const rn = right.map((s, i) => `<g><rect class="rxfn r" x="${W - 220}" y="${ry(i) - 11}" width="210" height="22" rx="11"/><text x="${W - 115}" y="${ry(i) + 4}" text-anchor="middle">${esc(s)}</text></g>`).join("");
  return `<div class="chartbox"><svg viewBox="0 0 ${W} ${H}" class="chart rxflowsvg" role="img" aria-label="Lineage of the facts about this project: ${esc(left.join(", "))} lead to ${esc(right.join(", "))}"><text class="ax" x="100" y="14" text-anchor="middle">Where the facts come from</text><text class="ax" x="${W - 115}" y="14" text-anchor="middle">What we worked out</text>${lk}${ln}<g><rect class="rxfc" x="${cx - 60}" y="${my - 18}" width="120" height="36" rx="10"/><text x="${cx}" y="${my + 4}" text-anchor="middle" class="rxfct">${esc(rxName(x.n).slice(0, 16))}${rxName(x.n).length > 16 ? "…" : ""}</text></g>${rn}</svg></div>`;
}
function rxTimeline(x) {
  const ev = [[x.cr, "Created", "i_spark"], [x.lh, "Last change by a person", "c_owner"], [x.pd, "Last update of any kind", "c_refresh"]].filter(e => e[0]);
  if (x.ar || x.st === "Archived") ev.push([Math.max(x.pd || 0, x.lh || 0), "Retired (archived)", "s_retired"]);
  if (!ev.length) return `<p class="muted">No dates are known for this project.</p>`;
  const t0 = Math.min(...ev.map(e => e[0])), t1 = Math.max(XREF_EPOCH, ...ev.map(e => e[0])), W = 760, H = 150, px = t => 30 + (t - t0) / Math.max(1, t1 - t0) * (W - 60);
  const y0 = new Date(t0 * 1000).getUTCFullYear(), y1 = new Date(t1 * 1000).getUTCFullYear(), step = Math.max(1, Math.ceil((y1 - y0) / 8)), ticks = [];
  for (let y = y0 + 1; y <= y1; y += step) ticks.push(y);
