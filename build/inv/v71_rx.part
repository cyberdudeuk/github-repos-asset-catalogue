    ${srt.map((e, i) => `<g><circle cx="${px(e[0])}" cy="70" r="7" class="rxtl-dot${i === srt.length - 1 ? " last" : ""}"/><text class="rxtl-t" x="${Math.min(W - 80, Math.max(80, px(e[0])))}" y="${[50, 110, 32, 128][i % 4]}" text-anchor="middle">${esc(e[1])}</text></g>`).join("")}<text class="ax" x="${W - 30}" y="12" text-anchor="end">catalogue checked ${esc(fmtD(XREF_EPOCH))}</text></svg></div>
    <ol class="rxtl-list">${srt.map(e => `<li>${icon(e[2], 16)} <b>${esc(e[1])}</b>: ${esc(fmtD(e[0]))} <span class="muted">(${esc(rxAgo(e[0]))})</span></li>`).join("")}</ol>`;
}
function rxWeb(x, sim) {
