  treeParts.forEach(p => p.hidden = !(A === "central" || A === "devolved") || !roots.some(r => adminOfRoot(r) === A));
  $$(".rxgd", v).forEach(d => { const g = $("summary b", d)?.textContent || ""; d.hidden = ADMIN_OF_GROUP[g] !== A; });
  const P = $("#fa-panel");
