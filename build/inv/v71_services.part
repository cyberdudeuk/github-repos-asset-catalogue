/* ---------- repository features and documentation completeness (analytics) ---------- */
const CMP = [["desc", "Description", "Says what it is in a sentence on GitHub", x => !!x.d], ["readme", "README", "Has a README that explains it", x => x.hy ? x.hy.readme : x.ld ? true : null], ["topics", "Topics", "Tagged with GitHub topics so people can find it", x => x.t !== undefined ? !!x.t : null],
  ["licence", "Licence", "Says how others may reuse it", x => x.hy ? x.hy.lic !== "none" : x.li ? x.li !== "-" && x.li !== "" : null], ["codeowners", "CODEOWNERS", "Names who looks after each part", x => x.hy ? x.hy.codeowners : null], ["contributing", "Contributing guide", "Explains how to contribute", x => x.hy ? x.hy.contributing : null],
  ["security", "Security policy", "Says how to report a vulnerability", x => x.hy ? x.hy.security : null], ["ci", "Automated checks", "Runs GitHub Actions workflows", x => x.hy ? x.hy.workflows > 0 : null], ["site", "Website or Pages", "Publishes documentation or a site", x => !!x.pg || !!x.cd]];
const FEATS = [["issues", "Issues"], ["projects", "Projects"], ["wiki", "Wiki"], ["discussions", "Discussions"], ["pages", "Pages"]];
const LEVELS = [["Starter", "Description and README", ["desc", "readme"]], ["Findable", "plus topics and a licence", ["desc", "readme", "topics", "licence"]], ["Looked after", "plus code owners, a security policy and automated checks", ["desc", "readme", "topics", "licence", "codeowners", "security", "ci"]], ["Exemplary", "plus a contributing guide and a website or Pages", CMP.map(c => c[0])]];
const CMPQ = {sector: "", live: true};
const cmpOf = x => Object.fromEntries(CMP.map(c => [c[0], c[3](x)]));
const cmpLevel = m => { let lv = -1; LEVELS.forEach((l, i) => { if (l[2].every(k => m[k] === true)) lv = i; }); return lv; };
function cmpPanel() {
  const L = ALL.filter(x => !x.unlisted && !x.ar && (!CMPQ.sector || x.sector === CMPQ.sector) && (!CMPQ.live || live(x)));
  const read = L.filter(x => x.hy), M = L.map(cmpOf), lv = L.map((x, i) => x.hy ? cmpLevel(M[i]) : null).filter(v => v !== null);
  const pc = (a, b) => b ? Math.round(a / b * 100) : 0;
  const rows = CMP.map(([k, l, d]) => { const known = M.filter(m => m[k] !== null), yes = known.filter(m => m[k]).length; return {k, l, d, known: known.length, yes}; });
  const lvN = LEVELS.map((_, i) => lv.filter(v => v >= i).length);
  const bySec = SECTORS.map(s => { const xs = L.filter(x => x.sector === s && x.hy); return [s, xs.length, xs.length ? Math.round(xs.reduce((a, x) => a + CMP.filter(c => c[3](x) === true).length, 0) / xs.length / CMP.length * 100) : 0]; }).filter(r => r[1]);
  const feat = FEAT ? FEATS.map(([k, l]) => { const ks = L.filter(x => FEAT.repos[x.key]); return [l, ks.filter(x => FEAT.repos[x.key][k]).length, ks.length]; }) : null;
  return `<div class="panel" id="cmp" data-new="1"><h2>Documentation completeness and GitHub features</h2>
    <p>How completely projects document themselves, measured from their own files, and the bar for what good looks like. ${CMPQ.live ? "Live projects only" : "All projects not archived"}${CMPQ.sector ? ", " + esc(CMPQ.sector) : ""}: ${nf(L.length)}, of which ${nf(read.length)} had their files read.</p>
    <div class="filters"><label for="cmp-sec">Sector<select id="cmp-sec"><option value="">All sectors</option>${SECTORS.map(s => `<option${CMPQ.sector === s ? " selected" : ""}>${esc(s)}</option>`).join("")}</select></label><label class="rxcheck" for="cmp-live"><input type="checkbox" id="cmp-live"${CMPQ.live ? " checked" : ""}> Live projects only</label></div>
    <h3>What each project has</h3>${rxBars(rows.map((r, i) => ({label: `${r.l}: ${pc(r.yes, r.known)}% of ${nf(r.known)} checked`, n: pc(r.yes, r.known), ic: "c_readme", c: pc(r.yes, r.known) >= 75 ? "green" : pc(r.yes, r.known) >= 40 ? "yellow" : "red"})), "Share of projects with each item, as a percentage")}
    <h3>The bar: what good looks like</h3><p class="small muted">Four levels, each adding to the one before. A project reaches a level when every item for it is present. Proposed by this catalogue from GitHub's community profile, the GDS Way and the Service Manual's guidance on open code.</p>
    <ol class="cmplevels">${LEVELS.map(([n, d], i) => `<li><b>${esc(n)}</b>: ${esc(d)}. <span class="muted">${nf(lvN[i])} of ${nf(lv.length)} (${pc(lvN[i], lv.length)}%) reach it.</span></li>`).join("")}</ol>
    <h3>Completeness by sector</h3><div class="tbl-wrap"><table><caption class="sr-only">Average completeness by sector</caption><thead><tr><th scope="col">Sector</th><th scope="col" class="n">Projects checked</th><th scope="col" class="n">Average of the ${CMP.length} items present</th></tr></thead><tbody>${bySec.sort((a, b) => b[2] - a[2]).map(r => `<tr><th scope="row">${esc(r[0])}</th><td class="n">${nf(r[1])}</td><td class="n">${r[2]}%</td></tr>`).join("")}</tbody></table></div>
    <h3>GitHub features switched on: Issues, Projects, Wiki, Discussions</h3>
    ${feat ? rxBars(feat.map(([l, y, n]) => ({label: `${l}: ${pc(y, n)}% of ${nf(n)}`, n: pc(y, n), ic: "i_plug", c: "blue"})), "Share of projects with each GitHub feature switched on") + `<p class="small muted">Collected ${esc(FEAT.collected)} from GitHub's API.</p>`
      : (typeof GV !== "undefined" && GV) ? gvFeatBars() + `<p class="small">Pages is measured for every project: ${nf(L.filter(x => x.pg).length)} of these projects publish a GitHub Pages site. See <button type="button" class="linkb" data-go="ghcheck">Checked against GitHub</button> for how the sample was drawn. Codespaces settings aren't public, so they can't be measured from outside.</p>`
      : `<p><b>Not collected yet.</b> Whether Issues, Projects, Wiki and Discussions are switched on is only available from GitHub's API, which this build couldn't reach. Pages is measured: ${nf(L.filter(x => x.pg).length)} of these projects publish a GitHub Pages site. The repository includes a collector (build/tools/collect_features.py and a manual GitHub Actions workflow) that reads these settings for every account in the catalogue; once its output is added, this panel fills in by itself. Codespaces settings aren't public, so they can't be measured from outside.</p>`}
    <p class="small muted">Items not yet checked for a project are left out of its percentages, not counted as missing. Archived projects are left out.</p></div>`;
}
{ const _i = RENDER.insights; RENDER.insights = () => { _i(); const v = vb("insights"); v.insertAdjacentHTML("beforeend", cmpPanel()); const wire = () => {
    $("#cmp-sec").onchange = e => { CMPQ.sector = e.target.value; $("#cmp").outerHTML = cmpPanel(); wire(); $("#cmp-sec").focus(); };
    $("#cmp-live").onchange = e => { CMPQ.live = e.target.checked; $("#cmp").outerHTML = cmpPanel(); wire(); $("#cmp-live").focus(); }; }; wire(); }; }
