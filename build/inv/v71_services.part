
/* ================= 7.7 Public services, capabilities, processes and workflows; strategic authorities; family by administration; completeness (R45 to R49) ================= */
const SV = DATA.services, DVN = DATA.devolution, FEAT = DATA.features || null;
const SVF = SV.functions.map(([id, name, lead, journeys, desc], i) => ({i, id, name, lead, journeys, desc}));
const SVF_BY = Object.fromEntries(SVF.map(f => [f.id, f]));
const SVDIM = {capability: {key: "c", list: SV.capabilities, title: "Capabilities", one: "capability", ic: "k_tool", c: "blue", lede: "What each project does for a service, whatever the service is: sign-in, payments, notifications, forms, case management and so on. Use it to find components to reuse before building."},
  process: {key: "p", list: SV.processes, title: "Processes", one: "process step", ic: "i_trace", c: "green", lede: "Where in a service each project helps, in the order a person meets it: finding out, applying, proving eligibility, being assessed, paying, hearing what happens next, getting the service, changing it, complaining, and the reporting behind it."},
  workflow: {key: "wf", list: SV.workflows, title: "Workflows", one: "kind of workflow", ic: "c_refresh", c: "violet", lede: "How work moves through the code: build and release pipelines, process and decision engines, data and job orchestration, low-code automation, messages and queues, and case and task workflows."}};
const SV_IC = {adultcare: "t_socialcare", childcare_sc: "family", education: "t_education", publichealth: "t_health", housing: "t_place", planning: "i_building", revenues: "t_tax", waste: "c_refresh", highways: "k_infra", environment: "t_environment", licensing: "c_scale", culture: "i_star", registration: "i_text", community: "i_users", economy: "t_business", customer: "i_mail"};
const SV_HUE = ["red", "orange", "blue", "green", "aqua", "violet", "magenta", "yellow"];
const svOf = x => SV.recs[x.key] || {};
const svFns = x => (svOf(x).f || []).map(([i]) => SVF[i]);
const HOLDERS = [["local", "Councils and local bodies", "orange", "i_building"], ["central", "Central government and its bodies", "blue", "i_crown"], ["health", "NHS and health bodies", "red", "t_health"], ["devolved", "Devolved administrations and their bodies", "magenta", "th_nations"], ["community", "Community, voluntary and partnership organisations", "green", "i_users"], ["parliament", "Parliaments", "slate", "l_govuk"], ["cdot", "Crown dependencies and overseas territories", "violet", "i_crown"]];
const HOLDER_BY = Object.fromEntries(HOLDERS.map(h => [h[0], h]));
const HOLD_OF_SECTOR = {"Local government": "local", "UK central government and ALBs": "central", "Health and care": "health", "Scotland": "devolved", "Wales": "devolved", "Communities and partnerships": "community", "Parliament": "parliament", "Crown dependencies": "cdot", "Overseas territories": "cdot"};
const holderOf = x => HOLD_OF_SECTOR[x.sector] || "central";
const SV_SUP = SV.suppliers, SV_PLATFORM = new Set(["GOV.UK Pay", "GOV.UK Notify", "GOV.UK One Login"]);
const svSup = x => (svOf(x).s || []).map(([i]) => SV_SUP[i]);
const SVQ0 = {fns: [], holder: "", supplier: "", live: false, q: "", sort: "recent", group: "holder", n: 30}, SVQ = {local: {...SVQ0, fns: ["adultcare"]}, socialcare: {...SVQ0, fns: ["adultcare", "childcare_sc"]}};
const svList = S => { const q = S.q.toLowerCase().trim(), fs = new Set(S.fns); return ALL.filter(x => { const f = svOf(x).f; if (!f || !f.some(([i]) => fs.has(SVF[i].id))) return false;
  if (S.holder && holderOf(x) !== S.holder) return false; if (S.live && !live(x)) return false; if (S.supplier && !svSup(x).includes(S.supplier)) return false; return !q || x.q.includes(q); }); };
const svCount = (L, f) => { const m = {}; for (const x of L) for (const k of [].concat(f(x))) if (k) m[k] = (m[k] || 0) + 1; return m; };
const SV_GROUP = {holder: ["Who holds the code", x => HOLDER_BY[holderOf(x)][1]], org: ["Organisation", x => orgName(x.org)], fn: ["Service", x => svFns(x)[0]?.name || "Other"], cap: ["Capability", x => { const c = svOf(x).c; return c ? SV.capabilities[c[0][0]][1] : "No capability found"; }], "": ["Don't group", null]};
function svChain(L, fns) {
  const by = {}; for (const x of L) (by[holderOf(x)] ||= []).push(x);
  const orgs = xs => { const m = svCount(xs, x => orgName(x.org)); return Object.entries(m).sort((a, b) => b[1] - a[1]); };
  const sup = svCount(L, svSup), plat = Object.entries(sup).filter(([k]) => SV_PLATFORM.has(k)), third = Object.entries(sup).filter(([k]) => !SV_PLATFORM.has(k)).sort((a, b) => b[1] - a[1]);
  const leads = [...new Set(fns.map(f => f.lead))], journeys = [...new Set(fns.flatMap(f => f.journeys))];
  const col = (n, h, body, c, ic) => `<li class="svcol c-${c}"><div class="svcol-h"><span class="rxtile c-${c}" aria-hidden="true">${icon(ic, 20)}</span><span><span class="svn">${n}</span> ${esc(h)}</span></div>${body}</li>`;
  const ol = (rows, k) => rows.length ? `<ul class="svorgs">${rows.slice(0, 6).map(([o, c]) => `<li>${esc(o)} <span class="muted">${nf(c)}</span></li>`).join("")}${rows.length > 6 ? `<li class="muted">and ${nf(rows.length - 6)} more</li>` : ""}</ul>` : `<p class="small muted">${esc(k)}</p>`;
  const hb = h => `<button type="button" class="btn sm" data-svhold="${h}">Show these ${nf((by[h] || []).length)} projects</button>`;
  return `<ol class="svchain" aria-label="The service chain, from the person using the service to the suppliers whose products the code names">
    ${col(1, "People and journeys", `<p class="small">Journeys this service supports (assessed):</p><ul class="svorgs">${journeys.map(j => `<li>${esc(j)}</li>`).join("")}</ul>`, "green", "th_journeys")}
    ${col(2, "Councils and local bodies", ol(orgs(by.local || []), "No council code found for this service.") + ((by.local || []).length ? hb("local") : ""), "orange", "i_building")}
    ${col(3, "Central government", `<p class="small"><b>Lead department (assessed):</b> ${leads.map(esc).join("; ")}</p>` + ol(orgs(by.central || []), "No central government code found.") + ((by.central || []).length ? hb("central") : ""), "blue", "i_crown")}
    ${col(4, "NHS, devolved and other public bodies", ol(orgs([...(by.health || []), ...(by.devolved || []), ...(by.parliament || [])]), "None found."), "red", "t_health")}
    ${col(5, "Community and voluntary sector", ol(orgs(by.community || []), "No community or voluntary organisation in this catalogue holds code for this service.") + ((by.community || []).length ? hb("community") : ""), "aqua", "i_users")}
    ${col(6, "Shared government platforms", plat.length ? `<ul class="svorgs">${plat.map(([k, n]) => `<li>${esc(k)} <span class="muted">${nf(n)}</span></li>`).join("")}</ul>` : `<p class="small muted">None named in the code.</p>`, "violet", "i_plug")}
    ${col(7, "Suppliers and products named in the code", third.length ? `<ul class="svorgs">${third.slice(0, 8).map(([k, n]) => `<li><button type="button" class="linkbtn" data-svsup="${esc(k)}">${esc(k)}</button> <span class="muted">${nf(n)}</span></li>`).join("")}</ul>` : `<p class="small muted">No supplier product is named in this service's public code.</p>`, "slate", "k_lib")}
  </ol>`;
}
function svRender(view, opts) {
  const S = SVQ[view], fns = S.fns.map(id => SVF_BY[id]), L = svList(S), all = svList({...SVQ0, fns: S.fns});
  const fnN = svCount(ALL, x => (svOf(x).f || []).map(([i]) => SVF[i].id));
  const hold = svCount(all, holderOf), caps = svCount(all, x => (svOf(x).c || []).map(([i]) => SV.capabilities[i][1])), co = svCount(all, x => svFns(x).map(f => f.id).filter(id => !S.fns.includes(id)).map(id => SVF_BY[id].name));
  const g = SV_GROUP[S.group]?.[1], srt = [...L].sort(RX_SORT[S.sort]?.[0] || RX_SORT.recent[0]);
  let res = ""; if (!L.length) res = `<p class="muted">No projects match these filters.</p>`;
  else if (g) { const gr = {}; for (const x of srt) (gr[g(x)] ||= []).push(x); res = Object.entries(gr).sort((a, b) => b[1].length - a[1].length).map(([k, xs]) => `<section class="rxgroup"><h3 class="drawer-h">${esc(k)} <span class="muted">(${nf(xs.length)})</span></h3><div class="rxgrid">${xs.slice(0, 6).map(rxCard).join("")}</div>${xs.length > 6 ? `<p class="small muted">${nf(xs.length - 6)} more in this group. Choose it in the filters to see them all.</p>` : ""}</section>`).join(""); }
  else res = `<div class="rxgrid">${srt.slice(0, S.n).map(rxCard).join("")}</div>${L.length > S.n ? `<p><button class="btn" type="button" data-svmore>Show ${nf(Math.min(30, L.length - S.n))} more</button></p>` : ""}`;
  vb(view).innerHTML = `<section class="panel rxhero c-${opts.c}" data-new="1"><div class="rxh-row"><span class="rxtile xl c-${opts.c}" aria-hidden="true">${icon(opts.ic, 40)}</span><div class="rxh-main"><div class="eyebrow">Public services · ${esc(opts.eyebrow)}</div><h2>${esc(opts.title)}</h2><p class="rx-lede">${esc(opts.lede)}</p>
      <p class="rxh-stats"><span>${icon("i_spark", 16)} <b>${nf(all.length)}</b> projects</span><span>${icon("i_building", 16)} <b>${nf(new Set(all.map(x => x.org)).size)}</b> GitHub accounts</span><span>${icon("s_active", 16)} <b>${nf(all.filter(live).length)}</b> being worked on or looked after</span></p></div></div></section>
    ${opts.picker ? `<div class="panel"><h2>Choose a service</h2><p class="muted small">Local public services, named after the LGA's list of local government functions where it has a match. Counts are projects across the whole public sector, not only councils.</p><div class="rxtopics" role="group" aria-label="Local public services">${SVF.map((f, i) => `<button type="button" class="rxtopic c-${SV_HUE[i % 8]}" data-svfn="${f.id}" aria-pressed="${S.fns.includes(f.id)}" data-tip="${esc(f.desc)}"><span class="rxtile c-${SV_HUE[i % 8]}" aria-hidden="true">${icon(SV_IC[f.id] || "topics", 22)}</span><span class="rxt-l">${esc(f.name)}</span><span class="rxt-n">${nf(fnN[f.id] || 0)}</span></button>`).join("")}</div></div>` : ""}
    ${opts.toggle ? `<div class="kl-tabs" role="group" aria-label="Which social care">${[["adultcare", "Adult social care"], ["childcare_sc", "Children's social care"], ["both", "Both"]].map(([k, l]) => { const on = k === "both" ? S.fns.length === 2 : S.fns.length === 1 && S.fns[0] === k; return `<button type="button" class="btn" data-svsc="${k}" aria-pressed="${on}">${esc(l)}</button>`; }).join("")}</div>` : ""}
    <div class="panel" data-new="1"><h2>The service chain: where the code lives</h2><p class="muted small">From the person using the service to the bodies that run it, the shared platforms it uses and the suppliers whose products its code names. ${esc(fns.map(f => f.name).join(" and "))}.</p>${svChain(all, fns)}</div>
    <div class="rxsplit"><div class="panel"><h2>Who holds the code</h2>${rxBars(HOLDERS.filter(h => hold[h[0]]).map(h => ({label: h[1], n: hold[h[0]], ic: h[3], c: h[2], btn: `data-svhold="${h[0]}" aria-pressed="${S.holder === h[0]}"`})), "Projects by who holds the code")}</div>
      <div class="panel"><h2>What the code does</h2>${Object.keys(caps).length ? rxBars(Object.entries(caps).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([k, n], i) => ({label: k, n, ic: "k_tool", c: SV_HUE[i % 8]})), "Projects by capability") : `<p class="muted">No capability found.</p>`}</div></div>
    ${Object.keys(co).length ? `<div class="panel"><h2>Connected services</h2><p class="muted small">Other local public services the same projects support, a sign of where services share code.</p>${rxBars(Object.entries(co).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([k, n], i) => ({label: k, n, ic: "i_link", c: SV_HUE[(i + 3) % 8]})), "Connected services")}</div>` : ""}
    <div class="panel"><h2>Projects</h2><div class="filters"><label for="${view}-q">Search<input type="search" id="${view}-q" value="${esc(S.q)}" placeholder="for example: fostering, care homes, payments"></label>
      <label for="${view}-hold">Who holds it<select id="${view}-hold"><option value="">Anyone</option>${HOLDERS.map(h => `<option value="${h[0]}"${S.holder === h[0] ? " selected" : ""}>${esc(h[1])}</option>`).join("")}</select></label>
      <label for="${view}-sup">Supplier or platform named<select id="${view}-sup"><option value="">Any or none</option>${Object.keys(svCount(all, svSup)).sort().map(k => `<option${S.supplier === k ? " selected" : ""}>${esc(k)}</option>`).join("")}</select></label>
      <label for="${view}-sort">Sort by<select id="${view}-sort">${Object.entries(RX_SORT).map(([k, v]) => `<option value="${k}"${S.sort === k ? " selected" : ""}>${esc(v[1])}</option>`).join("")}</select></label>
      <label for="${view}-grp">Group by<select id="${view}-grp">${Object.entries(SV_GROUP).map(([k, v]) => `<option value="${k}"${S.group === k ? " selected" : ""}>${esc(v[0])}</option>`).join("")}</select></label>
      <label class="rxcheck" for="${view}-live"><input type="checkbox" id="${view}-live"${S.live ? " checked" : ""}> Being worked on or looked after</label><button class="btn" type="button" data-svreset>Start again</button></div>
      <p class="count" aria-live="polite">${nf(L.length)} ${L.length === 1 ? "project" : "projects"}</p>${res}</div>
    <div class="panel"><h2>What this can and can't show</h2><ul class="small">
      <li>Services are found from each project's own words, checked on samples (${SV.prec.rounds.map(r => `${esc(r[0].toLowerCase())}: ${r[2]} of ${r[1]} right`).join("; ")}; ${esc(SV.prec.judged_by)}). Most projects don't say which service they support, so counts are a floor.</li>
      <li>Lead departments and journeys are assessed from public sources, not official assignments.</li>
      <li>Private companies and voluntary organisations that deliver services for councils only appear if they publish code in an account this catalogue lists. Their products show up when public code names them, which is why the chain lists suppliers by product.</li>
      <li>Who holds the code is the sector of the GitHub account's organisation in the cross-government register.</li></ul></div>`;
  const v = vb(view), re = () => svRender(view, opts);
  $$("[data-svfn]", v).forEach(b => b.onclick = () => { S.fns = [b.dataset.svfn]; S.holder = ""; S.supplier = ""; S.n = 30; re(); });
  $$("[data-svsc]", v).forEach(b => b.onclick = () => { S.fns = b.dataset.svsc === "both" ? ["adultcare", "childcare_sc"] : [b.dataset.svsc]; S.n = 30; re(); });
  $$("[data-svhold]", v).forEach(b => b.onclick = () => { S.holder = S.holder === b.dataset.svhold ? "" : b.dataset.svhold; S.group = S.holder ? "org" : S.group; re(); $(`#${view}-hold`)?.focus(); });
  $$("[data-svsup]", v).forEach(b => b.onclick = () => { S.supplier = b.dataset.svsup; re(); $(`#${view}-sup`)?.focus(); });
  let tq; $(`#${view}-q`).oninput = e => { clearTimeout(tq); tq = setTimeout(() => { S.q = e.target.value; re(); $(`#${view}-q`).focus(); }, 250); };
  for (const [id, k] of [["hold", "holder"], ["sup", "supplier"], ["sort", "sort"], ["grp", "group"]]) $(`#${view}-${id}`).onchange = e => { S[k] = e.target.value; re(); $(`#${view}-${id}`)?.focus(); };
  $(`#${view}-live`).onchange = e => { S.live = e.target.checked; re(); $(`#${view}-live`)?.focus(); };
  $("[data-svreset]", v).onclick = () => { Object.assign(S, {...SVQ0, fns: opts.toggle ? ["adultcare", "childcare_sc"] : S.fns}); re(); };
  $("[data-svmore]", v) && ($("[data-svmore]", v).onclick = () => { S.n += 30; re(); });
}
RENDER.local = () => svRender("local", {c: "orange", ic: "i_building", eyebrow: "local public services", title: "Local public services, and everyone whose code runs them", picker: true,
  lede: "Councils run most of the services people use day to day, often with central government setting policy, the NHS and others working alongside, and suppliers providing the systems. Choose a service to see whose code supports it at every link in the chain."});
RENDER.socialcare = () => svRender("socialcare", {c: "red", ic: "t_socialcare", eyebrow: "social care", title: "Adult and children's social care across the public sector", toggle: true,
  lede: "Social care is run by councils, with policy from the Department of Health and Social Care (adults) and the Department for Education (children), and close links to the NHS, regulators and the voluntary sector. This view follows the code across all of them, and the journeys it supports."});

/* ---------- capability, process and workflow views ---------- */
const DIMQ = {capability: {sel: 0, holder: "", fn: "", live: false, n: 24}, process: {sel: 0, holder: "", fn: "", live: false, n: 24}, workflow: {sel: 0, holder: "", fn: "", live: false, n: 24}};
function dimRender(view) {
  const D = SVDIM[view], S = DIMQ[view], k = D.key, has = (x, i) => (svOf(x)[k] || []).some(([j]) => j === i);
  const n = D.list.map((_, i) => 0); const cross = D.list.map(() => ({})); for (const x of ALL) { const v = svOf(x)[k]; if (!v) continue; for (const [i] of v) { n[i]++; const h = holderOf(x); cross[i][h] = (cross[i][h] || 0) + 1; } }
  const L = ALL.filter(x => has(x, S.sel) && (!S.holder || holderOf(x) === S.holder) && (!S.live || live(x)) && (!S.fn || svFns(x).some(f => f.id === S.fn))).sort(RX_SORT.recent[0]);
  const mx = Math.max(1, ...cross.flatMap(c => Object.values(c)));
  const wfMeasured = view === "workflow" ? ALL.filter(x => x.hy && x.hy.workflows > 0).length : 0, wfRead = view === "workflow" ? ALL.filter(x => x.hy).length : 0;
  vb(view).innerHTML = `<section class="panel rxhero c-${D.c}" data-new="1"><div class="rxh-row"><span class="rxtile xl c-${D.c}" aria-hidden="true">${icon(D.ic, 40)}</span><div class="rxh-main"><div class="eyebrow">Public services · ${esc(D.title.toLowerCase())}</div><h2>${esc(D.title)} across public sector code</h2><p class="rx-lede">${esc(D.lede)}</p></div></div></section>
    ${view === "workflow" ? `<div class="panel"><h2>Measured: automated workflows in the code</h2><p>${nf(wfMeasured)} of the ${nf(wfRead)} projects whose files were read have at least one GitHub Actions workflow (${wfRead ? Math.round(wfMeasured / wfRead * 100) : 0}%). The kinds below come from what projects say about themselves.</p></div>` : ""}
    <div class="panel"><h2>${view === "process" ? "The steps, in the order people meet them" : "Choose a " + esc(D.one)}</h2><div class="${view === "process" ? "svsteps" : "rxtopics"}" role="group" aria-label="${esc(D.title)}">${D.list.map(([id, name], i) => `<button type="button" class="rxtopic c-${SV_HUE[i % 8]}" data-dim="${i}" aria-pressed="${S.sel === i}"><span class="rxtile c-${SV_HUE[i % 8]}" aria-hidden="true">${view === "process" ? `<b>${i + 1}</b>` : icon(D.ic, 22)}</span><span class="rxt-l">${esc(name)}</span><span class="rxt-n">${nf(n[i])}</span></button>`).join("")}</div></div>
    <div class="panel"><h2>Who holds it, ${esc(D.one)} by ${esc(D.one)}</h2><p class="muted small">Darker cells hold more projects. Select a number to see those projects.</p><div class="tbl-wrap"><table class="svheat"><caption class="sr-only">${esc(D.title)} by who holds the code</caption><thead><tr><th scope="col">${esc(D.one[0].toUpperCase() + D.one.slice(1))}</th>${HOLDERS.map(h => `<th scope="col" class="n">${esc(h[1])}</th>`).join("")}</tr></thead>
      <tbody>${D.list.map(([id, name], i) => `<tr><th scope="row">${esc(name)}</th>${HOLDERS.map(h => { const c = cross[i][h[0]] || 0, lv = c ? Math.min(5, 1 + Math.floor(c / mx * 5)) : 0; return `<td class="n hv${lv}">${c ? `<button type="button" class="linkbtn" data-dimcell="${i}|${h[0]}" aria-label="${nf(c)} projects: ${esc(name)}, ${esc(h[1])}">${nf(c)}</button>` : "0"}</td>`; }).join("")}</tr>`).join("")}</tbody></table></div></div>
    <div class="panel"><h2>${esc(D.list[S.sel][1])}</h2><div class="filters"><label for="${view}-hold">Who holds it<select id="${view}-hold"><option value="">Anyone</option>${HOLDERS.map(h => `<option value="${h[0]}"${S.holder === h[0] ? " selected" : ""}>${esc(h[1])}</option>`).join("")}</select></label>
      <label for="${view}-fn">Local public service<select id="${view}-fn"><option value="">Any or none</option>${SVF.map(f => `<option value="${f.id}"${S.fn === f.id ? " selected" : ""}>${esc(f.name)}</option>`).join("")}</select></label>
      <label class="rxcheck" for="${view}-live"><input type="checkbox" id="${view}-live"${S.live ? " checked" : ""}> Being worked on or looked after</label></div>
      <p class="count" aria-live="polite">${nf(L.length)} projects, most recently changed first</p><div class="rxgrid">${L.slice(0, S.n).map(rxCard).join("")}</div>${L.length > S.n ? `<p><button type="button" class="btn" data-dimmore>Show ${nf(Math.min(24, L.length - S.n))} more</button></p>` : ""}</div>
    <div class="panel"><h2>How these are found</h2><p class="small">From each project's name, description, README summary and topics, with exclusions for words that only look like a match. ${esc(D.title)} were checked on samples: ${SV.prec.rounds.filter(r => r[0] === D.title).map(r => `${r[2]} of ${r[1]} right`).join("")} (${esc(SV.prec.judged_by)}). A project can have more than one; the strongest is listed first. This model of ${esc(D.title.toLowerCase())} was defined for this catalogue.</p></div>`;
  const v = vb(view), re = () => dimRender(view);
  $$("[data-dim]", v).forEach(b => b.onclick = () => { S.sel = +b.dataset.dim; S.n = 24; re(); $(`[data-dim="${S.sel}"]`, vb(view))?.focus(); });
  $$("[data-dimcell]", v).forEach(b => b.onclick = () => { const [i, h] = b.dataset.dimcell.split("|"); S.sel = +i; S.holder = h; S.n = 24; re(); $(`#${view}-hold`)?.focus(); });
  for (const [id, key] of [["hold", "holder"], ["fn", "fn"]]) $(`#${view}-${id}`).onchange = e => { S[key] = e.target.value; re(); $(`#${view}-${id}`)?.focus(); };
  $(`#${view}-live`).onchange = e => { S.live = e.target.checked; re(); $(`#${view}-live`)?.focus(); };
  $("[data-dimmore]", v) && ($("[data-dimmore]", v).onclick = () => { S.n += 24; re(); });
}
RENDER.capability = () => dimRender("capability"); RENDER.process = () => dimRender("process"); RENDER.workflow = () => dimRender("workflow");

/* ---------- strategic authorities (English devolution) ---------- */
const DV_ACC = DVN.councils, DV_AUTH = Object.fromEntries(DVN.authorities.map(a => [a.id, a]));
const dvRecs = pred => ALL.filter(x => { const c = DV_ACC[x.org]; return c && pred(c); });
RENDER.strategic = () => {
  const rows = DVN.authorities.map(a => { const accs = Object.entries(DV_ACC).filter(([, c]) => c.auth === a.id), xs = dvRecs(c => c.auth === a.id); return {a, accs, xs, councils: [...new Set(accs.map(([, c]) => c.name))]}; });
  const groups = [["Mayoral strategic authorities, established", r => r.a.status === "established" && /^Mayoral/.test(r.a.kind)], ["Foundation strategic authorities", r => /Foundation/.test(r.a.kind)], ["Being created", r => r.a.status === "in creation"]];
  const prop = Object.entries(DVN.pipeline.areas).map(([k, nm]) => ({k, nm, accs: Object.entries(DV_ACC).filter(([, c]) => c.auth === k)})).filter(p => p.accs.length);
  const none = Object.entries(DV_ACC).filter(([, c]) => c.rel === "none found"), scot = Object.entries(DV_ACC).filter(([, c]) => c.nation !== "England");
  const withCode = rows.filter(r => r.xs.length).length;
  const card = r => `<article class="oscard dvcard"><h3>${esc(r.a.name)}</h3><p class="small muted">${esc(r.a.kind)} · ${esc(r.a.status)}${r.a.detail ? ". " + esc(r.a.detail) : ""}</p>
      <p class="small"><b>Councils:</b> ${r.a.constituents.map(esc).join(", ")}</p>
      ${r.xs.length ? `<p><b>${nf(r.xs.length)}</b> projects from ${r.councils.map(esc).join(", ")} (${nf(r.xs.filter(live).length)} being worked on)</p><p class="small">${[...new Set(r.accs.map(([, c]) => c.rel))].map(esc).join(", ")}</p><button type="button" class="btn sm" data-dvgo="${esc(r.a.id)}">Show these projects</button>` : `<p class="small muted">No council in this authority publishes code in an account this catalogue lists.</p>`}
      <p class="small">${ext(r.a.source, "Source")} <span class="muted">(${esc(r.a.confidence)})</span></p></article>`;
  vb("strategic").innerHTML = `<section class="panel rxhero c-magenta" data-new="1"><div class="rxh-row"><span class="rxtile xl c-magenta" aria-hidden="true">${icon("th_nations", 40)}</span><div class="rxh-main"><div class="eyebrow">Organisations · English devolution</div><h2>Strategic authorities and the code of their councils</h2>
      <p class="rx-lede">England's strategic authorities, mayoral and foundation, established and being created, with the councils inside them that publish code. ${nf(withCode)} of ${nf(rows.length)} authorities have at least one council here. Read on ${esc(fmtD(Date.parse(DVN.read) / 1000))}.</p></div></div></section>
    <div class="panel"><h2>Where devolution stands</h2><ul class="small"><li>The ${esc(DVN.act.name)} received Royal Assent on ${esc(fmtD(Date.parse(DVN.act.assent) / 1000))} (${ext(DVN.act.source, "GOV.UK")}).</li><li>${esc(DVN.act.elections)}</li><li>${esc(DVN.act.lgr)}</li><li>${esc(DVN.pipeline.note)} ${ext(DVN.pipeline.source, "Budget 2026 fact sheet")}</li></ul></div>
    ${groups.map(([h, f]) => { const rs = rows.filter(f).sort((a, b) => b.xs.length - a.xs.length); return rs.length ? `<div class="panel"><h2>${esc(h)} <span class="muted">(${nf(rs.length)})</span></h2><div class="osgrid">${rs.map(card).join("")}</div></div>` : ""; }).join("")}
    <div class="panel"><h2>Proposed areas (unconfirmed)</h2>${prop.length ? `<ul>${prop.map(p => `<li><b>${esc(p.nm)}:</b> ${[...new Set(p.accs.map(([, c]) => c.name))].map(esc).join(", ")} (${nf(dvRecs(c => c.auth === p.k).length)} projects)</li>`).join("")}</ul>` : ""}</div>
    <div class="panel"><h2>Councils with code but no strategic authority found</h2><ul class="small">${none.map(([a, c]) => `<li>${esc(c.name)} <span class="muted">(GitHub: ${esc(a)}, ${nf(ALL.filter(x => x.org === a).length)} projects)</span>${c.note ? " · " + esc(c.note) : ""}</li>`).join("")}</ul>
      <p class="small muted">Scotland's councils (${[...new Set(scot.map(([, c]) => c.name))].map(esc).join(", ")}) sit within Scottish devolution, not England's strategic authorities. Wales and Northern Ireland have no council accounts in this catalogue.</p></div>
    <div class="panel"><h2>How this is built</h2><ul class="small"><li>Authorities, their councils and their status come from establishment orders on legislation.gov.uk and GOV.UK's English Devolution Area Factsheets (July 2025), with later status from GOV.UK news. Anything only a secondary source supports is marked.</li><li>A council is "constituent" when the order or factsheet names it, "in the area" when it is a district council inside a constituent county, and a "functional body" when it is part of the authority's group.</li><li>Establishment years before 2025 weren't confirmed from an official source, so they aren't shown.</li><li>Maps aren't shown: the catalogue holds no boundaries.</li></ul></div>`;
  $$("[data-dvgo]", vb("strategic")).forEach(b => b.onclick = () => { const a = b.dataset.dvgo; const accs = Object.entries(DV_ACC).filter(([, c]) => c.auth === a).map(([k]) => k); if (accs.length === 1) rxDiscover({acct: accs[0]}); else { SVQ.local = {...SVQ0, fns: SVF.map(f => f.id)}; showTab("discover"); rxDiscover({q: ""}); toast(`${DV_AUTH[a].name}: ${accs.length} GitHub accounts. Choose one under Who publishes it, or search by council name.`); } });
};

/* ---------- department family tree by administration ---------- */
const ADMIN = [["central", "Central government", "i_crown"], ["devolved", "Devolved administrations", "th_nations"], ["local", "Local government", "i_building"], ["crown", "Crown dependencies", "i_crown"], ["ot", "Overseas territories", "th_international"], ["other", "Other public bodies", "orgs"]];
const ADMIN_OF_GROUP = {"Local government in England": "local", "Fire and rescue services": "local", "Transport authorities": "local", "Scottish public sector": "devolved", "Welsh public sector": "devolved", "NHS bodies": "other", "Parliaments": "other", "Other public bodies": "other"};
const adminOfRoot = id => /devolved/i.test(famIndex().N[id]?.o?.f || "") ? "devolved" : "central";
const RXFA = {admin: "central"};
{ const _f = RENDER.family; RENDER.family = () => { _f(); const v = vb("family"), {N, sub, roots} = famIndex(), A = RXFA.admin;
  const hero = $(".rxhero", v); const sel = $("#fam-root");
  hero.insertAdjacentHTML("afterend", `<div class="panel" data-new="1"><h2>By administration</h2><div class="kl-tabs" role="tablist" aria-label="Administrations">${ADMIN.map(([id, l, ic]) => `<button type="button" role="tab" id="fa-${id}" aria-selected="${A === id}" tabindex="${A === id ? 0 : -1}" aria-controls="fa-panel" data-fa="${id}">${icon(ic, 16)} ${esc(l)}</button>`).join("")}</div><div id="fa-panel" role="tabpanel" aria-labelledby="fa-${A}"></div></div>`);
  const tabs = $$("[data-fa]", v); tabs.forEach((b, i) => { b.onclick = () => { RXFA.admin = b.dataset.fa; if (RXFA.admin === "central" || RXFA.admin === "devolved") { const r = roots.find(r => adminOfRoot(r) === RXFA.admin); if (r) { RXF.root = r; RXF.sel = r; RXF.open = new Set([r]); } } RENDER.family(); $("#fa-" + RXFA.admin)?.focus(); }; b.onkeydown = e => { const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (!d) return; e.preventDefault(); tabs[(i + d + tabs.length) % tabs.length].click(); }; });
  // the root picker only offers this administration's top-level organisations
  if (sel) [...sel.options].forEach(o => { o.hidden = adminOfRoot(o.value) !== A; o.disabled = o.hidden; });
