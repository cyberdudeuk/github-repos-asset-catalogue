    const famRecs = r => { const out = []; const seen = new Set(); const walk = n => { if (seen.has(n)) return; seen.add(n); out.push(...N[n].recs); N[n].kids.forEach(walk); }; walk(r); return [...new Map(out.map(x => [x.key, x])).values()]; };
    const rows = deps.map(r => { const xs = famRecs(r); return {r, n: xs.length, liveN: xs.filter(live).length, own: N[r].recs.length + N[r].kids.filter(k => N[k].kind !== "org").reduce((a, k) => a + N[k].recs.length, 0), bodies: N[r].kids.filter(k => N[k].kind === "org" && sub[k] > 0).length}; }).sort((a, b) => b.n - a.n);
    P.innerHTML = `<h3>Code by sponsoring department</h3><p class="small muted">Each ministerial department with every organisation it sponsors, as GOV.UK lists them. "Its own accounts" is code in the department's own GitHub accounts; the rest sits in the bodies it sponsors.</p><div class="tbl-wrap"><table><caption class="sr-only">Projects by sponsoring department</caption><thead><tr><th scope="col">Department</th><th scope="col" class="n">Projects in its family</th><th scope="col" class="n">Being worked on</th><th scope="col" class="n">In its own accounts</th><th scope="col" class="n">Sponsored bodies with code</th></tr></thead><tbody>${rows.map(z => `<tr><th scope="row"><button type="button" class="linkbtn" data-faroot="${z.r}">${esc(N[z.r].label)}</button></th><td class="n">${nf(z.n)}</td><td class="n">${nf(z.liveN)}</td><td class="n">${nf(z.own)}</td><td class="n">${nf(z.bodies)}</td></tr>`).join("")}</tbody></table></div>`; }
  else if (A === "devolved") { const dr = roots.filter(r => adminOfRoot(r) === "devolved"), ds = ALL.filter(x => x.sector === "Scotland" || x.sector === "Wales");
    P.innerHTML = `<p>${dr.length ? `Devolved governments on GOV.UK's list with code here: ${dr.map(r => `<button type="button" class="linkbtn" data-faroot="${r}">${esc(N[r].label)}</button> (${nf(sub[r])})`).join(", ")}.` : "No devolved government on GOV.UK's list has code here."} Scottish and Welsh public bodies outside GOV.UK's list hold ${nf(ds.length)} more projects (${nf(new Set(ds.map(x => x.org)).size)} GitHub accounts), listed under the groups below. Northern Ireland bodies: none with an account in this catalogue.</p>`; }
  else if (A === "local") { const byA = {}; for (const [acc, c] of Object.entries(DV_ACC)) { const n = ALL.filter(x => x.org === acc).length; if (!n) continue; const k = c.nation !== "England" ? c.nation : c.auth ? (DV_AUTH[c.auth]?.name || DVN.pipeline.areas[c.auth] + " (proposed, unconfirmed)") : "No strategic authority"; (byA[k] ||= []).push([c.name, acc, n]); }
    P.innerHTML = `<p>Councils, fire services and transport bodies aren't on GOV.UK's list of organisations, so they have no sponsoring department. Here they are grouped by the English strategic authority they sit in, or by nation. See ${`<button type="button" class="linkbtn" data-fago="strategic">Strategic authorities</button>`} for each authority's councils and status.</p>
      <div class="rxgroups">${Object.entries(byA).sort((a, b) => b[1].reduce((s, z) => s + z[2], 0) - a[1].reduce((s, z) => s + z[2], 0)).map(([k, cs]) => `<details class="rxgd" open><summary><b>${esc(k)}</b> <span class="muted">(${nf(cs.length)} accounts · ${nf(cs.reduce((s, z) => s + z[2], 0))} projects)</span></summary><ul>${cs.sort((a, b) => b[2] - a[2]).map(([nm, acc, n]) => `<li><button type="button" class="linkbtn" data-faacct="${esc(acc)}">${esc(nm)}</button> <span class="muted">${esc(acc)} · ${nf(n)}</span></li>`).join("")}</ul></details>`).join("")}</div>`; }
