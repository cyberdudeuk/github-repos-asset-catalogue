    const miss = CD ? CD.not_found.filter(n => A === "crown" ? /Guernsey|Jersey|Alderney|Sark|Man/.test(n) : !/Guernsey|Jersey|Alderney|Sark|Man/.test(n)) : [];
    P.innerHTML = (accs.length ? `<p>${nf(accs.length)} ${A === "crown" ? "crown dependency" : "overseas territory"} ${accs.length === 1 ? "government publishes" : "governments publish"} code on GitHub. Every repository below was checked directly against GitHub on ${esc(fmtD(Date.parse(CD.verified) / 1000))}: ${esc(CD.method)}.</p>
      <div class="osgrid">${accs.map(a => { const xs = ALL.filter(x => x.org === a.account); return `<article class="oscard cdcard"><h3>${esc(a.body)}</h3><p class="small muted">GitHub: ${ext("https://github.com/" + a.account, a.account)} · ${esc(a.place)} · ${esc(a.confidence)}</p><ul class="small">${a.evidence.map(e => `<li>${esc(e)}</li>`).join("")}</ul>
        <p><b>${nf(xs.length)}</b> repositories, ${nf(xs.filter(live).length)} being worked on${a.repos.some(r => r.fork) ? `, ${nf(a.repos.filter(r => r.fork).length)} forks of other projects` : ""}${a.repos.some(r => r.empty) ? `, ${nf(a.repos.filter(r => r.empty).length)} empty` : ""}.</p><button type="button" class="btn sm" data-faacct="${esc(a.account)}">Show these repositories</button></article>`; }).join("")}</div>` : `<p>No ${A === "crown" ? "crown dependency" : "overseas territory"} government or public body was confirmed publishing code on GitHub.</p>`)
      + (others.length ? `<h3>Other accounts found, not added to the catalogue</h3><p class="small">Found with GitHub's own search. They are listed so they can be confirmed, but aren't counted until their owner or a verified domain confirms them.</p><div class="tbl-wrap"><table><caption class="sr-only">Other accounts found</caption><thead><tr><th scope="col">Account</th><th scope="col">Says it is</th><th scope="col">Confidence</th><th scope="col" class="n">Public repositories</th><th scope="col">Evidence</th></tr></thead><tbody>${others.map(a => `<tr><th scope="row">${ext("https://github.com/" + a.account, a.account)}</th><td>${esc(a.body)}</td><td><span class="rxbadge c-${a.confidence === "probable" ? "yellow" : "slate"}"><span>${esc(a.confidence)}</span></span></td><td class="n">${nf(a.repos.length)}</td><td class="small">${a.evidence.map(esc).join("; ")}${a.repos.length ? ". Repositories checked over git: " + a.repos.map(r => esc(r.name) + " (" + esc(r.status || "") + ")").join(", ") : ""}</td></tr>`).join("")}</tbody></table></div>` : "")
      + (miss.length ? `<p class="small"><b>Searched for and not found:</b> ${miss.map(esc).join("; ")}. ${CD ? "Searched: " + CD.searched.map(esc).join("; ") + "." : ""} Not finding an account isn't proof none exists: GitHub's own search needs signing in.</p>` : "")
      + `<p class="small muted">${found.length ? `${nf(found.length)} UK projects also mention ${A === "crown" ? "the crown dependencies" : "the overseas territories"}; see <button type="button" class="linkbtn" data-fago="nations">Devolution and the UK's nations</button>.` : ""}</p>`; }
  else { P.innerHTML = `<p>NHS bodies, parliaments and other public bodies outside GOV.UK's list, grouped by type below. These groupings aren't sponsorship links.</p>`; }
